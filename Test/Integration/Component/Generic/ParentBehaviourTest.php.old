<?php declare(strict_types=1);

namespace Yireo\LokiCheckout\Test\Integration\Component\Generic;

use Magento\Framework\View\Element\AbstractBlock;
use Magento\Framework\View\Element\Template;
use Magento\Framework\View\LayoutInterface;
use Yireo\LokiCheckout\Test\Integration\LokiTestCase;
use Yireo\LokiComponents\Component\Component;
use Yireo\LokiComponents\Component\ComponentViewModel;
use Yireo\LokiComponents\Test\Integration\Traits\AssertComponentHasErrors;
use Yireo\LokiComponents\Test\Integration\Traits\AssertComponentHasNoErrors;
use Yireo\LokiComponents\Validator\Validator;

class ParentBehaviourTest extends LokiTestCase
{
    use AssertComponentHasErrors;
    use AssertComponentHasNoErrors;

    public function testComponentWithMaxLength()
    {
        $block = $this->createBlock();
        $block->setData('max_length', 3);

        $component = $this->getComponentInstance(Component::class, [
            'viewModelClass' => ComponentViewModel::class,
        ]);

        $viewModel = $component->getViewModel();
        $viewModel->setBlock($block);

        $validator = $this->getObjectManager()->get(Validator::class);

        $value = 'toolong';
        $validator->validate($component, $value);

        $this->assertComponentHasErrors($component);

        $component->getBlock()->setData('max_length', 8);

        $validator->validate($component, $value);
        $this->assertComponentHasNoErrors($component);
    }

    private function createBlock(): Template
    {
        $block = $this->getObjectManager()->get(LayoutInterface::class)->createBlock(Template::class);
        $this->assertInstanceOf(Template::class, $block);
        return $block;
    }
}
