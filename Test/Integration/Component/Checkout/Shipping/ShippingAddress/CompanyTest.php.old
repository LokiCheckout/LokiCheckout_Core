<?php declare(strict_types=1);

namespace Yireo\LokiCheckout\Test\Integration\Component\Checkout\Shipping\ShippingAddress;

use Magento\Catalog\Test\Fixture\Product as ProductFixture;
use Magento\Quote\Test\Fixture\AddProductToCart as AddProductToCartFixture;
use Magento\Quote\Test\Fixture\GuestCart as GuestCartFixture;
use Magento\TestFramework\Fixture\AppArea;
use Magento\TestFramework\Fixture\DataFixture;
use Yireo\LokiCheckout\Component\Checkout\Shipping\ShippingAddress\Company;
use Yireo\LokiCheckout\Test\Integration\LokiCheckoutTestCase;

#[
    AppArea('frontend'),
    DataFixture(ProductFixture::class, ['price' => 100], as: 'p1'),
    DataFixture(GuestCartFixture::class, as: 'cart'),
    DataFixture(AddProductToCartFixture::class, ['cart_id' => '$cart.id$', 'product_id' => '$p1.id$','qty' => 1])
]
class CompanyTest extends LokiCheckoutTestCase
{
    const BLOCK_NAME = 'loki-checkout.shipping-address.company';

    public function testComponentWithoutValue()
    {
        $cart = $this->getCart();
        $cart->getShippingAddress()->addData(['company' => '']);
        $this->dispatchToCheckout($cart);

        $component = $this->getObjectManager()->get(Company::class);
        $this->assertComponentExistsOnPage(self::BLOCK_NAME);

        $component->validate();
        $this->assertComponentHasNoErrors($component);
    }

    public function testComponentWithValue()
    {
        $cart = $this->getCart();
        $cart->getShippingAddress()->addData(['company' => 'Yireo']);
        $this->dispatchToCheckout($cart);

        $component = $this->getObjectManager()->get(Company::class);
        $this->assertComponentExistsOnPage(self::BLOCK_NAME);

        $component->validate();
        $this->assertComponentHasNoErrors($component);
    }
}
