<?php declare(strict_types=1);

namespace Yireo\LokiCheckout\Test\Integration\Validator\Component;

use Magento\Framework\App\ObjectManager;
use Magento\TestFramework\Fixture\AppArea;
use PHPUnit\Framework\TestCase;
use Yireo\LokiCheckout\Test\Integration\LokiTestCase;
use Yireo\LokiCheckout\Validator\Component\PostcodeFormatValidator;
use Yireo\LokiCheckout\ViewModel\State\ShippingAddressState;
use Yireo\LokiComponents\Component\Component;
use Yireo\LokiComponents\Test\Integration\Traits\CreateComponent;

#[AppArea('frontend')]
class PostcodeFormatValidatorTest extends LokiTestCase
{
    use CreateComponent;

    #[AppArea('frontend')]
    public function testValidateWithEmptyValues(): void
    {
        $postcodeFormatValidator = ObjectManager::getInstance()->get(PostcodeFormatValidator::class);
        $component = $this->getComponent('loki-checkout.shipping.address.postcode');

        $result = $postcodeFormatValidator->validate($component, '');
        $this->assertTrue($result);
    }

    /**
     * @param string $postcode
     * @param string $countryId
     * @param bool $return
     * @return void
     * @dataProvider getValues
     */
    public function testValidateWithValues(string $postcode, string $countryId, bool $return): void
    {
        $postcodeFormatValidator = ObjectManager::getInstance()->get(PostcodeFormatValidator::class);

        $component = $this->getComponent('loki-checkout.shipping.address.postcode');

        $addressState = ObjectManager::getInstance()->get(ShippingAddressState::class);
        $addressState->save('postcode', $postcode);
        $addressState->save('country_id', $countryId);

        $this->assertSame($return, $this->getValidator()->validate($component, $postcode));

        $result = $postcodeFormatValidator->validate($component, $postcode);
        $this->assertSame($return, $result);
    }

    public function getValues(): array
    {
        return [
            ['1111 AA', 'NL', true],
            ['111AA', 'NL', false],
            ['11111', 'US', true],
            ['1111', 'US', false],
        ];
    }
}
