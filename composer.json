{
    "name": "yireo/magento2-frigga-checkout",
    "version": "0.0.4",
    "description": "A Magewire-based checkout for Magento 2",
    "type": "magento2-module",
    "require": {
        "magento/framework": "^103.0",
        "magewirephp/magewire": "^1.11",
        "magewirephp/magewire-requirejs": "^1.1"
    },
    "require-dev": {
        "yireo/magento2-integration-test-helper": "@dev",
        "yireo/magento2-magewire-test-utils": "@dev"
    },
    "suggest": {
        "yireo/magento2-frigga-checkout-luma": "Luma compatibility for Frigga Checkout"
    },
    "license": [
        "OSL-3.0"
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Yireo\\FriggaCheckout\\": ""
        }
    }
}
