{
  "name": "loki-checkout/magento2-core",
  "version": "2.0.12",
  "description": "A developer-friendly AlpineJS-based checkout for Magento 2",
  "keywords": ["loki-core"],
  "type": "magento2-module",
  "homepage": "https://loki-checkout.com/",
  "authors": [
    {
      "name": "Jisse Reitsma (Yireo)",
      "email": "jisse@yireo.com"
    }
  ],
  "require": {
    "magento/framework": "^103.0",
    "magento/module-backend": "^102.0",
    "magento/module-catalog": "^103.0 | ^104.0",
    "magento/module-checkout-agreements": "^100.0",
    "magento/module-checkout": "^100.0",
    "magento/module-config": "^101.0",
    "magento/module-customer": "^103.0",
    "magento/module-directory": "^100.0",
    "magento/module-eav": "^102.0",
    "magento/module-newsletter": "^100.0",
    "magento/module-payment": "^100.0",
    "magento/module-quote": "^101.0",
    "magento/module-sales": "^103.0",
    "magento/module-shipping": "^100.0",
    "magento/module-store": "^101.0",
    "magento/module-vault": "^101.0",
    "yireo/magento2-hyva-theme-auto-registration": "^1.0",
    "loki/magento2-components": "^2.0",
    "loki/magento2-field-components": "^2.0",
    "loki/magento2-map-components": "^0.1",
    "yireo/magento2-csp-utilities": "^1.0",
    "psr/log": "^3.0",
    "guzzlehttp/guzzle": "^7.0",
    "php": "^8.2",
    "ext-intl": "*",
    "ext-pcre": "*",
    "ext-json": "*",
    "ext-dom": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0 | ^10.0",
    "yireo/magento2-integration-test-helper": "~0.0"
  },
  "suggest": {
    "loki-checkout/magento2-luma": "Luma compatibility for Loki Checkout",
    "loki-checkout/magento2-hyva": "Hyvä compatibility for Loki Checkout"
  },
  "license": "OSL-3.0",
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "LokiCheckout\\Core\\": ""
    }
  }
}
