{
  "name": "yireo/magento2-loki-checkout",
  "version": "0.0.5",
  "description": "A developer-friendly AlpineJS-based checkout for Magento 2",
  "type": "magento2-module",
  "homepage": "https://loki-checkout.com/",
  "authors": [
    {
      "name": "Jisse Reitsma (Yireo)",
      "email": "jisse@yireo.com"
    }
  ],
  "require": {
    "magento/framework": "^103.0",
    "symfony/validator": "^7.1",
    "yireo/magento2-csp-utilities": "^1.0",
    "yireo/magento2-hyva-theme-auto-registration": "^1.0",
    "php": "^8.3",
    "ext-dom": "*"
  },
  "require-dev": {
    "yireo/magento2-integration-test-helper": "@dev"
  },
  "suggest": {
    "yireo/magento2-loki-checkout-luma": "Luma compatibility for Loki Checkout"
  },
  "license": [
    "OSL-3.0"
  ],
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Yireo\\LokiCheckout\\": ""
    }
  }
}
