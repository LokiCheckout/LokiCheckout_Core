<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="LokiCheckout\Core\Component\Checkout\Step\ShippingStep\ShippingStepContext">
        <arguments>
            <argument name="stepValidator" xsi:type="object">LokiCheckout\Core\Validator\VirtualShippingStepValidator</argument>
        </arguments>
    </type>

    <type name="LokiCheckout\Core\Logger\Debugger">
        <arguments>
            <argument name="logger" xsi:type="object">LokiCheckout\Core\Logger\VirtualLogger</argument>
        </arguments>
    </type>

    <virtualType type="Magento\Framework\Logger\Monolog" name="LokiCheckout\Core\Logger\VirtualLogger">
        <arguments>
            <argument name="handlers"  xsi:type="array">
                <item name="system" xsi:type="object">LokiCheckout\Core\Logger\VirtualLogHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType type="Magento\Framework\Logger\Handler\Base" name="LokiCheckout\Core\Logger\VirtualLogHandler">
        <arguments>
            <argument name="fileName" xsi:type="string">var/log/loki_checkout.log</argument>
        </arguments>
    </virtualType>

    <type name="LokiCheckout\Core\Config\LokiCheckoutModules">
        <arguments>
            <argument name="modules" xsi:type="array">
                <item name="Loki_Components" xsi:type="string">Loki_Components</item>
                <item name="Loki_FieldComponents" xsi:type="string">Loki_FieldComponents</item>
                <item name="Loki_Debugger" xsi:type="string">Loki_Debugger</item>
                <item name="LokiCheckout_Core" xsi:type="string">LokiCheckout_Core</item>
            </argument>
        </arguments>
    </type>

    <virtualType type="LokiCheckout\Core\Validator\StepValidator" name="LokiCheckout\Core\Validator\VirtualShippingStepValidator">
        <arguments>
            <argument name="validationRules" xsi:type="array">
                <item name="emailValidationRule" xsi:type="object">
                    LokiCheckout\Core\Validator\Quote\ValidationRule\Email
                </item>
                <item name="shippingAddressValidationRule" xsi:type="object">
                    Magento\Quote\Model\ValidationRules\ShippingAddressValidationRule
                </item>
                <item name="shippingMethodValidationRule" xsi:type="object">
                    Magento\Quote\Model\ValidationRules\ShippingMethodValidationRule
                </item>
            </argument>
        </arguments>
    </virtualType>

    <type name="LokiCheckout\Core\Component\Checkout\Step\BillingStep\BillingStepContext">
        <arguments>
            <argument name="stepValidator" xsi:type="object">LokiCheckout\Core\Validator\VirtualBillingStepValidator</argument>
        </arguments>
    </type>

    <virtualType type="LokiCheckout\Core\Validator\StepValidator" name="LokiCheckout\Core\Validator\VirtualBillingStepValidator">
        <arguments>
            <argument name="validationRules" xsi:type="array">
                <item name="billingAddressValidationRule" xsi:type="object">
                    Magento\Quote\Model\ValidationRules\BillingAddressValidationRule
                </item>
                <item name="paymentMethodValidationRule" xsi:type="object">
                    Magento\Quote\Model\ValidationRules\PaymentMethodValidationRule
                </item>
            </argument>
        </arguments>
    </virtualType>

    <type name="LokiCheckout\Core\Component\Checkout\Step\OneStep\OneStepContext">
        <arguments>
            <argument name="stepValidator" xsi:type="object">LokiCheckout\Core\Validator\VirtualOneStepValidator</argument>
        </arguments>
    </type>

    <virtualType type="LokiCheckout\Core\Validator\StepValidator" name="LokiCheckout\Core\Validator\VirtualOneStepValidator">
        <arguments>
            <argument name="validationRules" xsi:type="array">
                <item name="emailValidationRule" xsi:type="object">
                    LokiCheckout\Core\Validator\Quote\ValidationRule\Email
                </item>
                <item name="shippingAddressValidationRule" xsi:type="object">
                    Magento\Quote\Model\ValidationRules\ShippingAddressValidationRule
                </item>
                <item name="shippingMethodValidationRule" xsi:type="object">
                    Magento\Quote\Model\ValidationRules\ShippingMethodValidationRule
                </item>
            </argument>
        </arguments>
    </virtualType>

    <type name="Magento\Quote\Model\ValidationRules\QuoteValidationComposite">
        <arguments>
            <argument name="validationRules" xsi:type="array">
                <item name="emailValidationRule" xsi:type="object">LokiCheckout\Core\Validator\Quote\ValidationRule\Email</item>
            </argument>
        </arguments>
    </type>

    <type name="Loki\Components\Filter\FilterRegistry">
        <arguments>
            <argument name="filters" xsi:type="array">
                <item name="country_id" xsi:type="object">LokiCheckout\Core\Filter\CountryId</item>
                <item name="vat_id" xsi:type="object">LokiCheckout\Core\Filter\VatId</item>
            </argument>
        </arguments>
    </type>

    <type name="Loki\Components\Validator\ValidatorRegistry">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="customerAddress" xsi:type="object">LokiCheckout\Core\Validator\Component\CustomerAddressValidator</item>
                <item name="email_available" xsi:type="object">LokiCheckout\Core\Validator\Component\EmailAvailableValidator</item>
                <item name="postcode" xsi:type="object">LokiCheckout\Core\Validator\Component\PostcodeFormatValidator</item>
                <item name="gender" xsi:type="object">LokiCheckout\Core\Validator\Component\GenderValidator</item>
                <item name="dob" xsi:type="object">LokiCheckout\Core\Validator\Component\DobValidator</item>
                <item name="iban" xsi:type="object">LokiCheckout\Core\Validator\Component\IbanValidator</item>
                <item name="options" xsi:type="object">LokiCheckout\Core\Validator\Component\OptionsValidator</item>
            </argument>
        </arguments>
    </type>

    <virtualType name="LokiCheckout\Core\Config\XmlConfig\VirtualFileReader" type="Magento\Framework\Config\Reader\Filesystem">
        <arguments>
            <argument name="converter" xsi:type="object">LokiCheckout\Core\Config\XmlConfig\Converter</argument>
            <argument name="schemaLocator" xsi:type="object">LokiCheckout\Core\Config\XmlConfig\SchemaLocator</argument>
            <argument name="fileName" xsi:type="string">loki_checkout.xml</argument>
            <argument name="idAttributes" xsi:type="array">
                <item name="/config/skins/skin" xsi:type="array">
                    <item name="name" xsi:type="string">name</item>
                </item>
                <item name="/config/themes/theme" xsi:type="array">
                    <item name="name" xsi:type="string">name</item>
                </item>
                <item name="/config/skins/skin/steps/step" xsi:type="array">
                    <item name="name" xsi:type="string">name</item>
                </item>
                <item name="/config/themes/theme/steps/step" xsi:type="array">
                    <item name="name" xsi:type="string">name</item>
                </item>
                <item name="/config/grid_layouts/grid_layout" xsi:type="array">
                    <item name="name" xsi:type="string">name</item>
                </item>
                <item name="/config/grid_layouts/grid_layout/grid" xsi:type="array">
                    <item name="name" xsi:type="string">name</item>
                </item>
                <item name="/config/grid_layouts/grid_layout/grid/block" xsi:type="array">
                    <item name="alias" xsi:type="string">alias</item>
                </item>
            </argument>
        </arguments>
    </virtualType>

    <type name="LokiCheckout\Core\Config\XmlConfig">
        <arguments>
            <argument name="reader" xsi:type="object">LokiCheckout\Core\Config\XmlConfig\VirtualFileReader</argument>
            <argument name="cacheId" xsi:type="string">loki_checkout</argument>
        </arguments>
    </type>

    <type name="Loki\CssUtils\Util\CssStyle">
        <arguments>
            <argument name="cssStyleParsers" xsi:type="array">
                <item name="grid-style" xsi:type="object">LokiCheckout\Core\Util\Block\CssStyleParser\GridStyleParser</item>
            </argument>
        </arguments>
    </type>

    <type name="Loki\CssUtils\Util\CssClass">
        <arguments>
            <argument name="cssClassParsers" xsi:type="array">
                <item name="grid-class" xsi:type="object">LokiCheckout\Core\Util\Block\CssClassParser\GridClassParser</item>
            </argument>
        </arguments>
    </type>

    <type name="LokiCheckout\Core\Component\Base\Generic\CheckoutContext">
        <arguments>
            <argument name="dependencies" xsi:type="array">
                <item name="urlFactory" xsi:type="object">Magento\Framework\UrlFactory\Proxy</item>
                <item name="customerSession" xsi:type="object">Magento\Customer\Model\Session\Proxy</item>
                <item name="checkoutSession" xsi:type="object">Magento\Checkout\Model\Session\Proxy</item>
                <item name="addressStateProvider" xsi:type="object">LokiCheckout\Core\Util\Component\AddressStateProvider\Proxy</item>
                <item name="checkoutState" xsi:type="object">LokiCheckout\Core\ViewModel\CheckoutState\Proxy</item>
                <item name="shippingAddressState" xsi:type="object">LokiCheckout\Core\ViewModel\State\ShippingAddressState\Proxy</item>
                <item name="billingAddressState" xsi:type="object">LokiCheckout\Core\ViewModel\State\BillingAddressState\Proxy</item>
                <item name="messageManager" xsi:type="object">Magento\Framework\Message\ManagerInterface\Proxy</item>
                <item name="customerProvider" xsi:type="object">LokiCheckout\Core\Util\CustomerProvider\Proxy</item>
                <item name="attributeProvider" xsi:type="object">LokiCheckout\Core\Util\Component\AttributeProvider\Proxy</item>
                <item name="stepProvider" xsi:type="object">LokiCheckout\Core\Util\Component\StepProvider\Proxy</item>
                <item name="stepNavigator" xsi:type="object">LokiCheckout\Core\Step\StepNavigator\Proxy</item>
                <item name="moduleConfig" xsi:type="object">LokiCheckout\Core\Config\Config\Proxy</item>
                <item name="xmlConfig" xsi:type="object">LokiCheckout\Core\Config\XmlConfig\Proxy</item>
                <item name="scopeConfig" xsi:type="object">Magento\Framework\App\Config\ScopeConfigInterface\Proxy</item>
                <item name="localeResolver" xsi:type="object">Magento\Framework\Locale\ResolverInterface\Proxy</item>
                <item name="storeManager" xsi:type="object">Magento\Store\Model\StoreManagerInterface\Proxy</item>
                <item name="request" xsi:type="object">Magento\Framework\App\Request\Http\Proxy</item>
            </argument>
        </arguments>
    </type>

    <type name="LokiCheckout\Core\Component\Base\AddressField\AddressFieldContext">
        <arguments>
            <argument name="parentContexts" xsi:type="array">
                <item name="checkout" xsi:type="object">LokiCheckout\Core\Component\Base\Generic\CheckoutContext</item>
            </argument>
        </arguments>
    </type>

    <type name="LokiCheckout\Core\Component\Checkout\Sidebar\Items\ItemsContext">
        <arguments>
            <argument name="parentContexts" xsi:type="array">
                <item name="checkout" xsi:type="object">LokiCheckout\Core\Component\Base\Generic\CheckoutContext</item>
            </argument>
            <argument name="dependencies" xsi:type="array">
                <item name="itemConvertor" xsi:type="object">LokiCheckout\Core\Util\Cart\ItemConvertor\Proxy</item>
            </argument>
        </arguments>
    </type>

    <type name="LokiCheckout\Core\Component\Checkout\Other\Agreements\AgreementsContext">
        <arguments>
            <argument name="parentContexts" xsi:type="array">
                <item name="checkout" xsi:type="object">LokiCheckout\Core\Component\Base\Generic\CheckoutContext</item>
            </argument>
            <argument name="dependencies" xsi:type="array">
                <item name="searchCriteriaBuilder" xsi:type="object">Magento\Framework\Api\SearchCriteriaBuilder\Proxy</item>
                <item name="activeStoreAgreementsFilter" xsi:type="object">Magento\CheckoutAgreements\Model\Api\SearchCriteria\ActiveStoreAgreementsFilter\Proxy</item>
                <item name="checkoutAgreementsList" xsi:type="object">Magento\CheckoutAgreements\Api\CheckoutAgreementsListInterface\Proxy</item>
            </argument>
        </arguments>
    </type>

    <type name="LokiCheckout\Core\Component\Checkout\Address\AddressContext">
        <arguments>
            <argument name="parentContexts" xsi:type="array">
                <item name="checkout" xsi:type="object">LokiCheckout\Core\Component\Base\Generic\CheckoutContext</item>
            </argument>
            <argument name="dependencies" xsi:type="array">
                <item name="customerProvider" xsi:type="object">LokiCheckout\Core\Util\CustomerProvider\Proxy</item>
                <item name="sameAddressService" xsi:type="object">LokiCheckout\Core\Util\SameAddressService\Proxy</item>
                <item name="customerRepository" xsi:type="object">Magento\Customer\Api\CustomerRepositoryInterface\Proxy</item>
                <item name="customerAddressRepository" xsi:type="object">Magento\Customer\Api\AddressRepositoryInterface\Proxy</item>
                <item name="searchCriteriaBuilder" xsi:type="object">Magento\Framework\Api\SearchCriteriaBuilder\Proxy</item>
                <item name="addressConfig" xsi:type="object">Magento\Customer\Model\Address\Config\Proxy</item>
                <item name="addressRenderer" xsi:type="object">LokiCheckout\Core\Util\AddressRenderer\Proxy</item>
                <item name="addressMapper" xsi:type="object">Magento\Customer\Model\Address\Mapper\Proxy</item>
                <item name="customerAddressValidator" xsi:type="object">LokiCheckout\Core\Validator\CustomerAddressValidator\Proxy</item>
            </argument>
        </arguments>
    </type>

    <type name="LokiCheckout\Core\Component\Checkout\Address\AddressFormContext">
        <arguments>
            <argument name="parentContexts" xsi:type="array">
                <item name="address" xsi:type="object">LokiCheckout\Core\Component\Checkout\Address\AddressContext</item>
            </argument>
        </arguments>
    </type>

    <type name="LokiCheckout\Core\Step\FinalStep\TaskListing">
        <arguments>
            <argument name="tasks" xsi:type="array">
                <item name="saveInAddressBook" xsi:type="object">LokiCheckout\Core\Step\FinalStep\Task\SaveInAddressBookTask</item>
            </argument>
        </arguments>
    </type>

    <type name="LokiCheckout\Core\ViewModel\OptionModel\CountryOptionModel">
        <arguments>
            <argument name="skipCountries" xsi:type="array">
                <item name="AN" xsi:type="string">AN</item>
            </argument>
        </arguments>
    </type>
</config>
