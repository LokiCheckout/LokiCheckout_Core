<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Yireo\LokiCheckout\Component\Checkout\Step\ShippingStep\ViewModel">
        <arguments>
            <argument name="stepValidator" xsi:type="object">Yireo\LokiCheckout\Validator\VirtualShippingStepValidator</argument>
        </arguments>
    </type>

    <virtualType type="Yireo\LokiCheckout\Validator\StepValidator" name="Yireo\LokiCheckout\Validator\VirtualShippingStepValidator" >
        <arguments>
            <argument name="validationRules" xsi:type="array">
                <item name="emailValidationRule" xsi:type="object">Yireo\LokiCheckout\Validator\Quote\ValidationRule\Email</item>
                <item name="shippingAddressValidationRule" xsi:type="object">Magento\Quote\Model\ValidationRules\ShippingAddressValidationRule</item>
                <item name="shippingMethodValidationRule" xsi:type="object">Magento\Quote\Model\ValidationRules\ShippingMethodValidationRule</item>
            </argument>
        </arguments>
    </virtualType>

    <type name="Yireo\LokiCheckout\Component\Checkout\Step\BillingStep\ViewModel">
        <arguments>
            <argument name="stepValidator" xsi:type="object">Yireo\LokiCheckout\Validator\VirtualBillingStepValidator</argument>
        </arguments>
    </type>

    <virtualType type="Yireo\LokiCheckout\Validator\StepValidator" name="Yireo\LokiCheckout\Validator\VirtualBillingStepValidator" >
        <arguments>
            <argument name="validationRules" xsi:type="array">
                <item name="billingAddressValidationRule" xsi:type="object">Magento\Quote\Model\ValidationRules\BillingAddressValidationRule</item>
                <item name="paymentMethodValidationRule" xsi:type="object">Magento\Quote\Model\ValidationRules\PaymentMethodValidationRule</item>
            </argument>
        </arguments>
    </virtualType>

    <type name="Yireo\LokiCheckout\Component\Checkout\Step\OneStep\ViewModel">
        <arguments>
            <argument name="stepValidator" xsi:type="object">Yireo\LokiCheckout\Validator\VirtualOneStepValidator</argument>
        </arguments>
    </type>

    <virtualType type="Yireo\LokiCheckout\Validator\StepValidator" name="Yireo\LokiCheckout\Validator\VirtualOneStepValidator" >
        <arguments>
            <argument name="validationRules" xsi:type="array">
                <item name="emailValidationRule" xsi:type="object">Yireo\LokiCheckout\Validator\Quote\ValidationRule\Email</item>
                <item name="shippingAddressValidationRule" xsi:type="object">Magento\Quote\Model\ValidationRules\ShippingAddressValidationRule</item>
                <item name="shippingMethodValidationRule" xsi:type="object">Magento\Quote\Model\ValidationRules\ShippingMethodValidationRule</item>
            </argument>
        </arguments>
    </virtualType>

    <type name="Magento\Quote\Model\ValidationRules\QuoteValidationComposite">
        <arguments>
            <argument name="validationRules" xsi:type="array">
                <item name="loki" xsi:type="object">Yireo\LokiCheckout\Validator\Quote\ValidationRule\Custom</item>
            </argument>
        </arguments>
    </type>

    <type name="Yireo\LokiComponents\Component\Filter\FilterRegistry">
        <arguments>
            <argument name="filters" xsi:type="array">
                <item name="country_id" xsi:type="object">Yireo\LokiCheckout\Component\Filter\CountryId</item>
                <item name="vat_id" xsi:type="object">Yireo\LokiCheckout\Component\Filter\VatId</item>
            </argument>
        </arguments>
    </type>

    <type name="Yireo\LokiComponents\Component\Validator\ValidatorRegistry">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="postcode" xsi:type="object">Yireo\LokiCheckout\Validator\Component\PostcodeFormatValidator</item>
                <item name="prefix" xsi:type="object">Yireo\LokiCheckout\Validator\Component\PrefixValidator</item>
                <item name="gender" xsi:type="object">Yireo\LokiCheckout\Validator\Component\GenderValidator</item>
                <item name="dob" xsi:type="object">Yireo\LokiCheckout\Validator\Component\DobValidator</item>
            </argument>
        </arguments>
    </type>

    <type name="Yireo\LokiCheckout\Util\SetterInjection">
        <arguments>
            <argument name="injectables" xsi:type="array">
                <item name="lokiCheckoutConfig" xsi:type="object">Yireo\LokiCheckout\Config\Config</item>
                <item name="scopeConfig" xsi:type="object">Magento\Framework\App\Config\ScopeConfigInterface</item>
                <item name="checkoutSession" xsi:type="object">Magento\Checkout\Model\Session</item>
                <item name="customerSession" xsi:type="object">Magento\Customer\Model\Session</item>
                <item name="streetLinesFactory" xsi:type="object">Yireo\LokiCheckout\Util\StreetLinesFactory</item>
                <item name="fieldTemplateLocator" xsi:type="object">Yireo\LokiCheckout\Util\FieldTemplateLocator</item>
                <item name="componentRegistry" xsi:type="object">Yireo\LokiComponents\Component\ComponentRegistry</item>
            </argument>
        </arguments>
    </type>

    <type name="Yireo\HyvaThemeAutoRegistration\Observer\RegisterModuleForHyvaConfig">
        <arguments>
            <argument name="modulePrefixes" xsi:type="array">
                <item name="Yireo_LokiCheckout" xsi:type="string">Yireo_LokiCheckout</item>
            </argument>
        </arguments>
    </type>

    <virtualType name="Yireo\LokiCheckout\Config\XmlConfig\VirtualFileReader" type="Magento\Framework\Config\Reader\Filesystem">
        <arguments>
            <argument name="converter" xsi:type="object">\Yireo\LokiCheckout\Config\XmlConfig\Converter</argument>
            <argument name="schemaLocator" xsi:type="object">Yireo\LokiCheckout\Config\XmlConfig\SchemaLocator</argument>
            <argument name="fileName" xsi:type="string">loki_checkout.xml</argument>
            <argument name="idAttributes" xsi:type="array">
                <item name="/config/themes/theme" xsi:type="array">
                    <item name="name" xsi:type="string">name</item>
                </item>
                <item name="/config/themes/theme/steps/step" xsi:type="array">
                    <item name="name" xsi:type="string">name</item>
                </item>
                <item name="/config/grid_layouts/grid_layout" xsi:type="array">
                     <item name="name" xsi:type="string">name</item>
                </item>
                <item name="/config/grid_layouts/grid_layout/block" xsi:type="array">
                    <item name="alias" xsi:type="string">alias</item>
                </item>
            </argument>
        </arguments>
    </virtualType>

    <type name="Yireo\LokiCheckout\Config\XmlConfig">
        <arguments>
            <argument name="reader" xsi:type="object">Yireo\LokiCheckout\Config\XmlConfig\VirtualFileReader</argument>
            <argument name="cacheId" xsi:type="string">yireo_loki_checkout</argument>
        </arguments>
    </type>
</config>
