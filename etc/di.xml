    <type name="Yireo\LokiCheckout\Filter\FilterRegistry">
        <arguments>
            <argument name="filters" xsi:type="array">
                <item name="country_id" xsi:type="object">Yireo\LokiCheckout\Filter\CountryId</item>
                <item name="vat_id" xsi:type="object">Yireo\LokiCheckout\Filter\VatId</item>
                <item name="trim" xsi:type="object">Yireo\LokiCheckout\Filter\Trim</item>
                <item name="capitalize" xsi:type="object">Yireo\LokiCheckout\Filter\Capitalize</item>
                <item name="lowercase" xsi:type="object">Yireo\LokiCheckout\Filter\Lowercase</item>
                <item name="numeric" xsi:type="object">Yireo\LokiCheckout\Filter\Numeric</item>
                <item name="uppercase" xsi:type="object">Yireo\LokiCheckout\Filter\Uppercase</item>
            </argument>
        </arguments>
    </type>

    <type name="Yireo\LokiCheckout\Validator\Component\FieldValidatorRegistry">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="length" xsi:type="object">Yireo\LokiCheckout\Validator\Component\LengthValidator</item>
                <item name="postcode" xsi:type="object">Yireo\LokiCheckout\Validator\Component\PostcodeFormatValidator</item>
                <item name="email" xsi:type="object">Yireo\LokiCheckout\Validator\Component\EmailValidator</item>
                <item name="prefix" xsi:type="object">Yireo\LokiCheckout\Validator\Component\PrefixValidator</item>
                <item name="gender" xsi:type="object">Yireo\LokiCheckout\Validator\Component\GenderValidator</item>
                <item name="dob" xsi:type="object">Yireo\LokiCheckout\Validator\Component\DobValidator</item>
            </argument>
        </arguments>
    </type>

    <type name="Yireo\LokiCheckout\Plugin\SetterInjectionPlugin">
        <arguments>
            <argument name="injectables" xsi:type="array">
                <item name="config" xsi:type="object">Yireo\LokiCheckout\Config\Config</item>
                <item name="scopeConfig" xsi:type="object">Magento\Framework\App\Config\ScopeConfigInterface</item>
                <item name="checkoutSession" xsi:type="object">Magento\Checkout\Model\Session</item>
                <item name="customerSession" xsi:type="object">Magento\Customer\Model\Session</item>
                <item name="streetlinesFactory" xsi:type="object">Yireo\LokiCheckout\ValueObject\StreetlinesFactory</item>
                <item name="fieldTemplateLocator" xsi:type="object">Yireo\LokiCheckout\Util\FieldTemplateLocator</item>
            </argument>
        </arguments>
    </type>

    <type name="Yireo\HyvaThemeAutoRegistration\Observer\RegisterModuleForHyvaConfig">
        <arguments>
            <argument name="modulePrefixes" xsi:type="array">
                <item name="Yireo_LokiCheckout" xsi:type="string">Yireo_LokiCheckout</item>
            </argument>
        </arguments>
    </type>
</config>
