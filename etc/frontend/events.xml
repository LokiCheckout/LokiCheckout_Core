<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd"
>
    <event name="layout_load_before">
        <observer name="LokiCheckout_Core::enableCheckout" instance="LokiCheckout\Core\Observer\EnableCheckout"/>
    </event>

    <event name="view_block_abstract_to_html_before">
        <observer name="LokiCheckout_Core::assignAdditionalBlockVariables" instance="LokiCheckout\Core\Observer\AssignAdditionalBlockVariables"/>
    </event>

    <event name="view_block_abstract_to_html_after">
        <observer name="LokiCheckout_Core::addHtmlAttributes" instance="LokiCheckout\Core\Observer\AddHtmlAttributes"/>
        <observer name="LokiCheckout_Core::addDebuggingInfo" instance="LokiCheckout\Core\Observer\AddDebuggingInfo"/>
    </event>

    <event name="checkout_cart_save_after">
        <observer name="LokiCheckout_Core::resetStepAfterCartSave" instance="LokiCheckout\Core\Observer\ResetStepAfterCartSave"/>
    </event>

    <event name="loki_checkout_address_field_save_after">
        <observer name="LokiCheckout_Core::cleanAfterAddressChange" instance="LokiCheckout\Core\Observer\CleanAfterAddressChange"/>
    </event>
</config>
