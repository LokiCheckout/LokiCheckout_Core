<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd"
>
    <event name="layout_load_before">
        <observer name="Yireo_LokiCheckout::enableCheckout" instance="Yireo\LokiCheckout\Observer\EnableCheckout"/>
    </event>

    <event name="view_block_abstract_to_html_before">
        <observer name="Yireo_LokiCheckout::assignAdditionalBlockVariables" instance="Yireo\LokiCheckout\Observer\AssignAdditionalBlockVariables"/>
    </event>

    <event name="view_block_abstract_to_html_after">
        <observer name="Yireo_LokiCheckout::addDebuggingInfo" instance="Yireo\LokiCheckout\Observer\AddDebuggingInfo"/>
    </event>
</config>
