<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd"
>
    <event name="layout_load_before">
        <observer name="Yireo_FriggaCheckout::enableCheckout" instance="Yireo\FriggaCheckout\Observer\EnableCheckout"/>
    </event>

    <event name="hyva_config_generate_before">
        <observer name="Yireo_FriggaCheckout::registerModuleForHyvaConfig" instance="Yireo\FriggaCheckout\Observer\RegisterModuleForHyvaConfig"/>
    </event>

    <event name="view_block_abstract_to_html_before">
        <observer name="Yireo_FriggaCheckout::assignAdditionalBlockVariables" instance="Yireo\FriggaCheckout\Observer\AssignAdditionalBlockVariables"/>
    </event>
</config>
