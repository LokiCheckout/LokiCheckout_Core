<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Checkout\Model\Session">
        <plugin name="Yireo_LokiCheckout::clearHelperData"
                type="Yireo\LokiCheckout\Plugin\ClearHelperData"/>
    </type>

    <type name="Magento\Framework\View\Element\Template">
        <plugin name="Yireo_LokiCheckout::addCspInlineScripts" type="Yireo\LokiCheckout\Plugin\AddCspInlineScripts"/>
    </type>

    <type name="Yireo\LokiComponents\Component\ComponentHydrator">
        <plugin name="Yireo_LokiCheckout::additionalHydration"
                type="Yireo\LokiCheckout\Plugin\AdditionalHydration"/>
    </type>

    <type name="\Yireo\LokiCheckout\Observer\AddDebuggingInfo">
        <arguments>
            <argument name="blockPrefixes" xsi:type="array">
                <item name="loki-checkout" xsi:type="string">loki-checkout</item>
            </argument>
        </arguments>
    </type>
</config>
