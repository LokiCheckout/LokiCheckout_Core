<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magewirephp\Magewire\Model\ComponentResolver">
        <plugin name="Yireo_LokiCheckout::SetterInjectionPlugin"
                type="Yireo\LokiCheckout\Plugin\SetterInjectionPlugin"/>
    </type>

    <type name="Yireo\LokiCheckout\Magewire\Checkout\ShippingStep\ShippingAddress\Postcode">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="postcodeFormat" xsi:type="object">Yireo\LokiCheckout\Validator\Component\PostcodeFormatValidator</item>
            </argument>
        </arguments>
    </type>

    <type name="Yireo\LokiCheckout\Magewire\Checkout\BillingStep\BillingAddress\Postcode">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="postcodeFormat" xsi:type="object">Yireo\LokiCheckout\Validator\Component\PostcodeFormatValidator</item>
            </argument>
        </arguments>
    </type>

    <type name="Yireo\LokiCheckout\Magewire\Checkout\ShippingStep\ShippingAddress\VatId">
        <arguments>
            <argument name="filters" xsi:type="array">
                <item name="uppercase" xsi:type="object">Yireo\LokiCheckout\Filter\Uppercase</item>
            </argument>
        </arguments>
    </type>

    <type name="Yireo\LokiCheckout\Magewire\Checkout\ShippingStep\ShippingAddress\Telephone">
        <arguments>
            <argument name="filters" xsi:type="array">
                <item name="numeric" xsi:type="string">numeric</item>
            </argument>
        </arguments>
    </type>


</config>
