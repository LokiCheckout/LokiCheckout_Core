<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="LokiCheckout\Core\ViewModel\CheckoutState">
        <arguments>
            <argument xsi:type="object" name="checkoutSession">Magento\Checkout\Model\Session\Proxy</argument>
            <argument xsi:type="object" name="customerSession">Magento\Customer\Model\Session\Proxy</argument>
        </arguments>
    </type>

    <type name="Magento\Checkout\Model\Session">
        <plugin
            name="LokiCheckout_Core::clearHelperData"
            type="LokiCheckout\Core\Plugin\ClearHelperDataPlugin"/>
    </type>

    <type name="Magento\Framework\View\Element\Template">
        <plugin
            name="LokiCheckout_Core::addCspInlineScripts"
            type="LokiCheckout\Core\Plugin\AddCspInlineScriptsPlugin"/>
    </type>

    <type name="Loki\Components\Util\Controller\RepositoryDispatcher">
        <plugin
            name="LokiCheckout_Core::redirectEmptyQuoteAfterRepositoryDispatch"
            type="LokiCheckout\Core\Plugin\RedirectEmptyQuoteAfterRepositoryDispatchPlugin"/>
    </type>

    <type name="LokiCheckout\Core\Component\Checkout\Shipping\ShippingMethods\ShippingMethodsRepository">
        <plugin
            name="LokiCheckout_Core::fixFreeShippingSubtotal"
            type="LokiCheckout\Core\Plugin\FixFreeShippingSubtotalPlugin"/>
    </type>

    <type name="Loki\Components\Component\Component">
        <plugin
            name="LokiCheckout_Core::appendCheckoutTargets"
            type="LokiCheckout\Core\Plugin\AppendCheckoutTargetsPlugin"/>
    </type>

    <type name="LokiCheckout\Core\Observer\AddDebuggingInfo">
        <arguments>
            <argument name="blockPrefixes" xsi:type="array">
                <item name="loki-checkout" xsi:type="string">loki-checkout</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Customer\CustomerData\SectionPoolInterface">
        <arguments>
            <argument name="sectionSourceMap" xsi:type="array">
                <item name="loki-checkout" xsi:type="string">LokiCheckout\Core\CustomerData\Checkout</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Checkout\Model\CompositeConfigProvider">
        <plugin
            name="LokiCheckout_Core::cleanCompositeConfigProvider"
            type="LokiCheckout\Core\Plugin\CleanCompositeConfigProviderPlugin"/>
    </type>

    <type name="Magento\Framework\App\RouterList">
        <arguments>
            <argument name="routerList" xsi:type="array">
                <item name="loki-checkout" xsi:type="array">
                    <item name="class" xsi:type="string">LokiCheckout\Core\Router\LokiCheckoutRouter</item>
                    <item name="disable" xsi:type="boolean">false</item>
                    <item name="sortOrder" xsi:type="string">10</item>
                </item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Framework\View\Element\Message\MessageConfigurationsPool">
        <arguments>
            <argument name="configurationsMap" xsi:type="array">
                <item name="invalid_customer_address" xsi:type="array">
                    <item name="renderer" xsi:type="const">
                        \Magento\Framework\View\Element\Message\Renderer\BlockRenderer::CODE
                    </item>
                    <item name="data" xsi:type="array">
                        <item name="template" xsi:type="string">
                            LokiCheckout_Core::message/invalid-customer-address.phtml
                        </item>
                    </item>
                </item>
            </argument>
        </arguments>
    </type>

    <type name="Loki\Components\Layout\LayoutHandlerComposite">
        <arguments>
            <argument name="layoutHandlers" xsi:type="array">
                <item name="LokiCheckout_Core::layoutHandler" xsi:type="object">LokiCheckout\Core\Layout\LayoutHandler</item>
                <item name="LokiCheckout_Core::countrySpecificLayoutHandler" xsi:type="object">LokiCheckout\Core\Layout\CountrySpecificLayoutHandler</item>
            </argument>
        </arguments>
    </type>

    <type name="LokiCheckout\Core\Observer\SaveAfterRepositoryDispatch">
        <arguments>
            <argument name="postDispatchHandlers" xsi:type="array">
                <item name="same-address-copy" xsi:type="object">LokiCheckout\Core\Component\PostDispatchHandler\SameAddressCopy</item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Framework\Filter\Template">
        <plugin
            name="LokiCheckout_Core::modifyAddressTemplateVariables"
            type="LokiCheckout\Core\Plugin\ModifyAddressTemplateVariablesPlugin"/>
    </type>

    <type name="Magento\Quote\Model\Quote">
        <plugin
            name="LokiCheckout_Core::skipCustomerCopying"
            type="LokiCheckout\Core\Plugin\SkipCustomerCopyingPlugin"/>
    </type>
</config>
