<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Checkout\Model\Session">
        <plugin name="Yireo_LokiCheckout::clearHelperData"
                type="Yireo\LokiCheckout\Plugin\ClearHelperData"/>
    </type>

    <type name="Magento\Framework\View\Element\Template">
        <plugin name="Yireo_LokiCheckout::addCspInlineScripts" type="Yireo\LokiCheckout\Plugin\AddCspInlineScripts"/>
    </type>

    <type name="Yireo\LokiCheckout\Component\Checkout\Shipping\ShippingAddress\Postcode">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="postcodeFormat" xsi:type="object">Yireo\LokiCheckout\Validator\Component\PostcodeFormatValidator</item>
            </argument>
        </arguments>
    </type>

    <type name="Yireo\LokiCheckout\Component\Checkout\Billing\BillingAddress\Postcode">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="postcodeFormat" xsi:type="object">Yireo\LokiCheckout\Validator\Component\PostcodeFormatValidator</item>
            </argument>
        </arguments>
    </type>

    <type name="Yireo\LokiCheckout\Component\Checkout\Shipping\ShippingAddress\VatId">
        <arguments>
            <argument name="filters" xsi:type="array">
                <item name="uppercase" xsi:type="object">Yireo\LokiCheckout\Filter\Uppercase</item>
            </argument>
        </arguments>
    </type>

    <type name="Yireo\LokiCheckout\Component\Checkout\Shipping\ShippingAddress\Telephone">
        <arguments>
            <argument name="filters" xsi:type="array">
                <item name="numeric" xsi:type="string">numeric</item>
            </argument>
        </arguments>
    </type>

    <type name="\Yireo\LokiCheckout\Observer\AddDebuggingInfo">
        <arguments>
            <argument name="blockPrefixes" xsi:type="array">
                <item name="loki-checkout" xsi:type="string">loki-checkout</item>
            </argument>
        </arguments>
    </type>
</config>
