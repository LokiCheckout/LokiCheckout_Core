<?xml version="1.0" encoding="UTF-8" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:LokiCheckout_Core:etc/loki_checkout.xsd">
    <themes>
        <theme name="default" label="Multi Step Checkout (default)">
            <steps>
                <step name="shipping" blockName="loki-checkout.steps.shipping" sortOrder="10" />
                <step name="billing" blockName="loki-checkout.steps.billing" sortOrder="20" />
            </steps>
        </theme>

        <theme name="onestep" label="One Step Checkout">
            <steps>
                <step name="one" blockName="loki-checkout.steps.one"/>
            </steps>
        </theme>
    </themes>

    <grid_layouts>
        <grid_layout name="default_grid" label="Default grid" defaultColSpan="12" defaultMdColSpan="6">
            <grid name="default">
                <block alias="prefix" sortOrder="10" />
                <block alias="firstname" sortOrder="20" />
                <block alias="middlename" sortOrder="30" />
                <block alias="lastname" sortOrder="40" />
                <block alias="street0" sortOrder="50" />
                <block alias="street1" sortOrder="60" />
                <block alias="street2" sortOrder="70" />
                <block alias="street3" sortOrder="80" />
                <block alias="postcode" sortOrder="90" />
                <block alias="city" sortOrder="100" />
                <block alias="region" sortOrder="110" />
                <block alias="country_id" sortOrder="120" />
                <block alias="telephone" sortOrder="130" />
                <block alias="fax" sortOrder="140" />
                <block alias="company" sortOrder="150" />
                <block alias="vat_id" sortOrder="160" />
                <block alias="save_in_address_book" sortOrder="400" />
            </grid>
        </grid_layout>
    </grid_layouts>
</config>
