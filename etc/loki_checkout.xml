<?xml version="1.0" encoding="UTF-8" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Yireo_LokiCheckout:etc/loki_checkout.xsd">
    <themes>
        <theme name="default" label="Multi Step Checkout (default)">
            <steps>
                <step name="shipping" blockName="loki-checkout.steps.shipping"/>
                <step name="billing" blockName="loki-checkout.steps.billing"/>
            </steps>
        </theme>
        <theme name="onestep" label="One Step Checkout">
            <steps>
                <step name="one" blockName="loki-checkout.steps.one"/>
            </steps>
        </theme>
    </themes>

    <grid_layouts>
        <grid_layout name="default_grid" label="Default grid" defaultColSpan="12" defaultMdColSpan="6">
            <grid name="default">
                <block alias="prefix" sortOrder="1" />
                <block alias="firstname" sortOrder="2" />
                <block alias="middlename" sortOrder="3" />
                <block alias="lastname" sortOrder="4" />
                <block alias="street0" sortOrder="5" />
                <block alias="street1" sortOrder="6" />
                <block alias="street2" sortOrder="7" />
                <block alias="street3" sortOrder="8" />
                <block alias="postcode" sortOrder="9" />
                <block alias="city" sortOrder="10" />
                <block alias="region" sortOrder="11" />
                <block alias="country_id" sortOrder="12" />
                <block alias="telephone" sortOrder="13" />
                <block alias="fax" sortOrder="14" />
                <block alias="company" sortOrder="15" />
                <block alias="vat_id" sortOrder="16" />
            </grid>
            <grid name="NL" countryId="NL">
                <block alias="prefix" sortOrder="1"/>
                <block alias="firstname" sortOrder="2"/>
                <block alias="middlename" sortOrder="3"/>
                <block alias="lastname" sortOrder="4"/>
                <block alias="street0" sortOrder="5"/>
                <block alias="street1" sortOrder="6" mdColSpan="3"/>
                <block alias="street2" sortOrder="7" mdColSpan="3"/>
                <block alias="street3" sortOrder="8"/>
                <block alias="postcode" sortOrder="9"/>
                <block alias="city" sortOrder="10"/>
                <block alias="region" sortOrder="11"/>
                <block alias="country_id" sortOrder="12" mdColSpan="12"/>
                <block alias="telephone" sortOrder="13"/>
                <block alias="fax" sortOrder="14"/>
                <block alias="company" sortOrder="15"/>
                <block alias="vat_id" sortOrder="16"/>
            </grid>
            <grid name="BE" countryId="BE">
                <block alias="prefix" sortOrder="1"/>
                <block alias="firstname" sortOrder="2"/>
                <block alias="middlename" sortOrder="3"/>
                <block alias="lastname" sortOrder="4"/>
                <block alias="postcode" sortOrder="5" mdColSpan="3"/>
                <block alias="city" sortOrder="6" mdColSpan="9"/>
                <block alias="street0" sortOrder="7"/>
                <block alias="street1" sortOrder="8" mdColSpan="3"/>
                <block alias="street2" sortOrder="9" mdColSpan="3"/>
                <block alias="street3" sortOrder="10"/>
                <block alias="region" sortOrder="11"/>
                <block alias="country_id" sortOrder="12" mdColSpan="12"/>
                <block alias="telephone" sortOrder="13"/>
                <block alias="fax" sortOrder="14"/>
                <block alias="company" sortOrder="15"/>
                <block alias="vat_id" sortOrder="16"/>
            </grid>
        </grid_layout>
    </grid_layouts>
</config>
