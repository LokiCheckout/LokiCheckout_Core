<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="yireo" sortOrder="999" translate="label">
            <label>Yireo</label>
        </tab>
        <section id="yireo_loki_checkout" translate="label" sortOrder="342" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Yireo LokiCheckout</label>
            <tab>yireo</tab>
            <resource>Yireo_LokiCheckout::configuration</resource>
            <group id="general" translate="label" type="text" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enable"
                       translate="label"
                       type="select"
                       sortOrder="1"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="0">
                    <label>Enable</label>
                    <tooltip>Toggle this setting to enable or disable the LokiCheckout on the fly. Probably you will keep this on at all times.</tooltip>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="theme"
                       translate="label"
                       type="select"
                       sortOrder="1"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="0">
                    <label>Theme</label>
                    <tooltip>Change the complete layout of the checkout by using a specific theme.</tooltip>
                    <source_model>Yireo\LokiCheckout\Config\Source\ThemeOptions</source_model>
                    <depends>
                        <field id="*/*/enable">1</field>
                    </depends>
                </field>
                <field id="grid_layout"
                       translate="label"
                       type="select"
                       sortOrder="1"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="0">
                    <label>Grid Layout</label>
                    <tooltip><![CDATA[ All HTML elements in an address block (shipping address, billing address) are ordered according to a Grid
Layout (created via a file <code>etc/loki_checkout.xml</code>). This setting configures the default grid.]]></tooltip>
                    <source_model>Yireo\LokiCheckout\Config\Source\GridLayoutOptions</source_model>
                    <depends>
                        <field id="*/*/enable">1</field>
                    </depends>
                </field>
                <field id="license_key"
                       translate="label"
                       type="text"
                       sortOrder="2"
                       showInDefault="1"
                       showInWebsite="0"
                       showInStore="0">
                    <label>License Key</label>
                    <tooltip>Enter your LokiCheckout license key as found in our Yireo shop under "My Licenses". The license key is also used as composer key to download packages.</tooltip>
                    <depends>
                        <field id="*/*/enable">1</field>
                    </depends>
                </field>
            </group>
            <group id="debug" translate="label" type="text" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Debugging</label>
                <field id="enable"
                       translate="label"
                       type="select"
                       sortOrder="1"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Enable Debugging</label>
                    <tooltip>With debugging enabled, further details are added through the checkout, ideal for development.</tooltip>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="*/general/enable">1</field>
                    </depends>
                </field>
                <field id="html_hints"
                       translate="label"
                       type="select"
                       sortOrder="1"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Add Hints to HTML Output</label>
                    <tooltip>Adds an HTML comment in each LokiComponent for reviewing via your browser.</tooltip>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="*/*/enable">1</field>
                    </depends>
                </field>
                <field id="debug_block"
                       translate="label"
                       type="select"
                       sortOrder="1"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Add Debug Block</label>
                    <tooltip>Similar to the original Magento template hints behaviour, this adds a popup with meta-information for each LokiComponent. Either you like it or you find it hugely annoying.</tooltip>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="*/*/enable">1</field>
                    </depends>
                </field>
            </group>
            <group id="fields" translate="label" type="text" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Field settings</label>
                <field id="use_required_block"
                       translate="label"
                       type="select"
                       sortOrder="1"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="0">
                    <label>Use Required Block</label>
                    <tooltip><![CDATA[Each required field could be styled with an additional required block. In Luma, this is nice. In Hyvä, this is not needed because the styling is done via CSS. This settings adds the block <code>loki-field-components.utils.required</code> when a field is required]]></tooltip>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="*/general/enable">1</field>
                    </depends>
                </field>
                <field id="enable_same_as_billing"
                       translate="label"
                       type="select"
                       sortOrder="1"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="0">
                    <label>Enable Same As Billing Checkbox</label>
                    <tooltip>The checkbox that let's customers reuse their shipping address as billing address (or vice versa) could be toggled here.</tooltip>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="*/general/enable">1</field>
                    </depends>
                </field>
                <field id="hide_region_when_optional"
                       translate="label"
                       type="select"
                       sortOrder="1"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="0">
                    <label>Hide Region When Optional</label>
                    <tooltip>With some countries, the region is required. With some, it is optional. When this option is enabled, the region field disappears if it is optional for the choosen country.</tooltip>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="*/general/enable">1</field>
                    </depends>
                </field>
                <field id="enable_vat_id_only_for_company"
                       translate="label"
                       type="select"
                       sortOrder="1"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Enable Vat ID Only For Companies</label>
                    <tooltip>With this option enabled, the VAT ID field is hidden if there is no value for the company given.</tooltip>
                    <comment>Show the VAT ID field only if a company value is entered</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="*/general/enable">1</field>
                    </depends>
                </field>
            </group>
            <group id="shipping" translate="label" type="text" sortOrder="3" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Shipping settings</label>
                <field id="select_default_shipping_method"
                       translate="label"
                       type="select"
                       sortOrder="1"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Select Default Shipping Method</label>
                    <tooltip>With this option enabled, the first shipping method is automatically selected.</tooltip>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="*/general/enable">1</field>
                    </depends>
                </field>
            </group>
            <group id="billing" translate="label" type="text" sortOrder="3" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Billing settings</label>
                <field id="select_default_payment_method"
                       translate="label"
                       type="select"
                       sortOrder="1"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Select Default Payment Method</label>
                    <tooltip>With this option enabled, the first payment method is automatically selected.</tooltip>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <depends>
                        <field id="*/general/enable">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>
