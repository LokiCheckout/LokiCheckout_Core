<?xml version="1.0" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <loki_checkout>
            <general>
                <enable>1</enable>
                <theme>default</theme>
                <grid_layout>default_grid</grid_layout>
                <debug>0</debug>
                <default_grid_class>col-span-12 md:col-span-6</default_grid_class>
            </general>
            <fields>
                <enable_same_as_billing>1</enable_same_as_billing>
                <enable_vat_id_only_for_company>0</enable_vat_id_only_for_company>
                <hide_region_when_optional>1</hide_region_when_optional>
            </fields>
        </loki_checkout>
    </default>
</config>
