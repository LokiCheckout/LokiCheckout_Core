<?xml version="1.0" encoding="UTF-8" ?>
<components xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Yireo_LokiComponents:etc/loki_components.xsd">
    <componentGroup name="checkout" defaultContext="Yireo\LokiCheckout\Component\Base\Generic\GenericContext">
        <component
            name="loki-checkout.steps"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Steps\StepsViewModel"/>

        <component
            name="loki-checkout.progressbar"
            viewModel="Yireo\LokiCheckout\Component\Checkout\ProgressBar\ProgressBarViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\ProgressBar\ProgressBarRepository">
            <target name="loki-checkout.steps"/>
        </component>

        <component
            name="loki-checkout.shipping.address"
            context="Yireo\LokiCheckout\Component\Checkout\Shipping\ShippingAddress\ShippingAddressContext"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Shipping\ShippingAddress\ShippingAddressViewModel">
        </component>

        <component
            name="loki-checkout.shipping.address.toggle-select"
            context="Yireo\LokiCheckout\Component\Checkout\Shipping\ShippingAddress\ShippingAddressContext"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Shipping\ShippingAddressToggleSelect\ShippingAddressToggleSelectViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Shipping\ShippingAddressToggleSelect\ShippingAddressToggleSelectRepository">
        </component>

        <component
            name="loki-checkout.shipping.address.select"
            context="Yireo\LokiCheckout\Component\Checkout\Shipping\ShippingAddress\ShippingAddressContext"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Shipping\ShippingAddressSelect\ShippingAddressSelectViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Shipping\ShippingAddressSelect\ShippingAddressSelectRepository">
        </component>

        <component
            name="loki-checkout.shipping.methods"
            context="Yireo\LokiCheckout\Component\Checkout\Shipping\ShippingMethods\ShippingMethodsContext"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Shipping\ShippingMethods\ShippingMethodsViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Shipping\ShippingMethods\ShippingMethodsRepository">
            <target name="loki-checkout.sidebar.totals"/>
            <target name="loki-checkout.sidebar.preview.shipping_details"/>
        </component>

        <component
            name="loki-checkout.billing.address"
            context="Yireo\LokiCheckout\Component\Checkout\Billing\BillingAddress\BillingAddressContext"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Billing\BillingAddress\BillingAddressViewModel"/>

        <component
            name="loki-checkout.billing.address.shipping-as-billing"
            context="Yireo\LokiCheckout\Component\Checkout\Billing\BillingAddress\BillingAddressContext"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Billing\BillingAsShipping\BillingAsShippingViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Billing\BillingAsShipping\BillingAsShippingRepository">
            <target name="loki-checkout.billing.address"/>
        </component>

        <component
            name="loki-checkout.billing.address.view"
            context="Yireo\LokiCheckout\Component\Checkout\Billing\BillingAddress\BillingAddressContext"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Billing\BillingAddress\BillingAddressViewModel"/>

        <component
            name="loki-checkout.payment.methods"
            context="Yireo\LokiCheckout\Component\Checkout\Billing\PaymentMethods\PaymentMethodsContext"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Billing\PaymentMethods\PaymentMethodsViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Billing\PaymentMethods\PaymentMethodsRepository">
            <target name="loki-checkout.sidebar.preview.payment_details"/>
        </component>

        <component
            name="loki-checkout.sidebar.coupon_code"
            context="Yireo\LokiCheckout\Component\Base\Field\FieldContext"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Sidebar\CouponCode\CouponCodeViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Sidebar\CouponCode\CouponCodeRepository">
        </component>

        <component
            name="loki-checkout.sidebar.items"
            context="Yireo\LokiCheckout\Component\Checkout\Sidebar\Items\ItemsContext"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Sidebar\Items\ItemsViewModel">
        </component>

        <component
            name="loki-checkout.sidebar"/>

        <component
            name="loki-checkout.sidebar.totals"/>

        <component
            name="loki-checkout.sidebar.preview.quote_details"/>

        <component
            name="loki-checkout.sidebar.preview.shipping_details"/>

        <component
            name="loki-checkout.sidebar.preview.billing_address"/>

        <component
            name="loki-checkout.sidebar.preview.payment_details"/>

        <component
            name="loki-checkout.newsletter"
            context="Yireo\LokiCheckout\Component\Checkout\Other\Newsletter\NewsletterContext"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Other\Newsletter\NewsletterViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Other\Newsletter\NewsletterRepository">
        </component>

        <component
            name="loki-checkout.agreements"
            context="Yireo\LokiCheckout\Component\Checkout\Other\Agreements\AgreementsContext"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Other\Agreements\AgreementsViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Other\Agreements\AgreementsRepository">
            <target name="loki-checkout.agreements.form"/>
            <target name="loki-checkout.agreements.form.fields"/>
        </component>
    </componentGroup>

    <componentGroup name="steps">
        <component
            name="loki-checkout.steps.shipping"
            context="Yireo\LokiCheckout\Component\Checkout\Step\ShippingStep\ShippingStepContext"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Step\ShippingStep\ShippingStepViewModel">
        </component>

        <component
            name="loki-checkout.steps.billing"
            context="Yireo\LokiCheckout\Component\Checkout\Step\BillingStep\BillingStepContext"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Step\BillingStep\BillingStepViewModel">
        </component>

        <component
            name="loki-checkout.steps.single"
            context="Yireo\LokiCheckout\Component\Checkout\Step\OneStep\OneStepContext"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Step\OneStep\OneStepViewModel">
        </component>
    </componentGroup>

    <componentGroup
        name="quoteFields"
        defaultClass="Yireo\LokiCheckout\Component\Base\Field\FieldComponent"
        defaultContext="Yireo\LokiCheckout\Component\Base\Field\FieldContext"
        defaultRepository="Yireo\LokiCheckout\Component\Base\QuoteField\QuoteFieldRepository"
    >
        <defaultTarget name="loki-checkout.sidebar.preview.quote_details"/>

        <component
            name="loki-checkout.customer.customer_email"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Customer\Email\EmailViewModel">
        </component>

        <component
            name="loki-checkout.customer.customer_gender"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Customer\Gender\GenderViewModel">
        </component>

        <component
            name="loki-checkout.customer.customer_dob"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Customer\Dob\DobViewModel">
        </component>
    </componentGroup>

    <componentGroup
        name="shippingAddressFields"
        defaultClass="Yireo\LokiCheckout\Component\Base\Field\FieldComponent"
        defaultContext="Yireo\LokiCheckout\Component\Base\AddressField\AddressFieldContext"
        defaultViewModel="Yireo\LokiCheckout\Component\Base\AddressField\AddressFieldViewModel"
        defaultRepository="Yireo\LokiCheckout\Component\Base\AddressField\AddressFieldRepository"
    >
        <defaultTarget name="loki-checkout.sidebar.preview.shipping_details"/>
        <defaultTarget name="loki-checkout.sidebar.preview.billing_address"/>

        <component
            name="loki-checkout.shipping.address.prefix"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Address\Prefix\PrefixViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Address\Prefix\PrefixRepository">
            <validator name="prefix"/>
        </component>

        <component
            name="loki-checkout.shipping.address.firstname"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Address\Firstname\FirstnameViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Address\Firstname\FirstnameRepository"
        />

        <component
            name="loki-checkout.shipping.address.middlename"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Address\Middlename\MiddlenameViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Address\Middlename\MiddlenameRepository"
        />

        <component
            name="loki-checkout.shipping.address.lastname"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Address\Lastname\LastnameViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Address\Lastname\LastnameRepository"
        />

        <component
            name="loki-checkout.shipping.address.suffix"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Address\Suffix\SuffixViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Address\Suffix\SuffixRepository"
        />

        <component
            name="loki-checkout.shipping.address.postcode"
            context="Yireo\LokiCheckout\Component\Checkout\Address\Postcode\PostcodeContext"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Address\Postcode\PostcodeViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Address\Postcode\PostcodeRepository">
            <validator name="postcode"/>
            <filter name="uppercase"/>
        </component>

        <component
            name="loki-checkout.shipping.address.city"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Address\City\CityViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Address\City\CityRepository"
        />

        <component
            name="loki-checkout.shipping.address.region"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Address\Region\RegionViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Address\Region\RegionRepository">
            <target name="loki-checkout.shipping.address.postcode"/>
            <target name="loki-checkout.shipping.methods"/>
        </component>

        <component
            name="loki-checkout.shipping.address.country_id"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Address\CountryId\CountryIdViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Address\CountryId\CountryIdRepository">
            <target name="loki-checkout.shipping.address.postcode"/>
            <target name="loki-checkout.shipping.address.region"/>
            <target name="loki-checkout.shipping.methods"/>
            <filter name="country_id"/>
        </component>

        <component
            name="loki-checkout.shipping.address.company"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Address\Company\CompanyViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Address\Company\CompanyRepository">
            <target name="loki-checkout.shipping.address.vat_id"/>
        </component>

        <component
            name="loki-checkout.shipping.address.telephone"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Address\Telephone\TelephoneViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Address\Telephone\TelephoneRepository">
            <filter name="numeric"/>
        </component>

        <component
            name="loki-checkout.shipping.address.fax"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Address\Fax\FaxViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Address\Fax\FaxRepository">
            <filter name="numeric"/><!-- @todo Add a telephone filter instead -->
        </component>

        <component
            name="loki-checkout.shipping.address.vat_id"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Address\VatId\VatIdViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Address\VatId\VatIdRepository"
        />
    </componentGroup>

    <componentGroup
        name="billingAddressFields"
        defaultClass="Yireo\LokiCheckout\Component\Base\Field\FieldComponent"
        defaultContext="Yireo\LokiCheckout\Component\Base\AddressField\AddressFieldContext"
        defaultViewModel="Yireo\LokiCheckout\Component\Base\AddressField\AddressFieldViewModel"
        defaultRepository="Yireo\LokiCheckout\Component\Base\AddressField\AddressFieldRepository"
    >
        <defaultTarget name="loki-checkout.sidebar.preview.shipping_details"/>
        <defaultTarget name="loki-checkout.sidebar.preview.billing_address"/>

        <component
            name="loki-checkout.billing.address.prefix"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Address\Prefix\PrefixViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Address\Prefix\PrefixRepository"
        />

        <component
            name="loki-checkout.billing.address.firstname"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Address\Firstname\FirstnameViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Address\Firstname\FirstnameRepository"/>

        <component
            name="loki-checkout.billing.address.middlename"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Address\Middlename\MiddlenameViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Address\Middlename\MiddlenameRepository"
        />

        <component
            name="loki-checkout.billing.address.lastname"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Address\Lastname\LastnameViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Address\Lastname\LastnameRepository"
        />

        <component
            name="loki-checkout.billing.address.suffix"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Address\Suffix\SuffixViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Address\Suffix\SuffixRepository"
        />

        <component
            name="loki-checkout.billing.address.postcode"
            context="Yireo\LokiCheckout\Component\Checkout\Address\Postcode\PostcodeContext"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Address\Postcode\PostcodeViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Address\Postcode\PostcodeRepository">
            <validator name="postcode"/>
            <filter name="uppercase"/>
        </component>

        <component
            name="loki-checkout.billing.address.city"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Address\City\CityViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Address\City\CityRepository"
        />

        <component
            name="loki-checkout.billing.address.region"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Address\Region\RegionViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Address\Region\RegionRepository">
            <target name="loki-checkout.billing.address.postcode"/>
            <target name="loki-checkout.payment.methods"/>
        </component>

        <component
            name="loki-checkout.billing.address.country_id"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Address\CountryId\CountryIdViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Address\CountryId\CountryIdRepository">
            <filter name="country_id"/>
            <target name="loki-checkout.payment.methods"/>
        </component>

        <component
            name="loki-checkout.billing.address.company"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Address\Company\CompanyViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Address\Company\CompanyRepository"
        />

        <component
            name="loki-checkout.billing.address.telephone"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Address\Telephone\TelephoneViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Address\Telephone\TelephoneRepository">
            <filter name="numeric"/>
        </component>

        <component
            name="loki-checkout.billing.address.fax"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Address\Fax\FaxViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Address\Fax\FaxRepository">
            <filter name="numeric"/>
        </component>

        <component
            name="loki-checkout.billing.address.vat_id"
            viewModel="Yireo\LokiCheckout\Component\Checkout\Address\VatId\VatIdViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\Address\VatId\VatIdRepository"
        />
    </componentGroup>

    <componentGroup
        name="streetAddressFields"
        defaultClass="Yireo\LokiCheckout\Component\Base\Field\FieldComponent"
        defaultContext="Yireo\LokiCheckout\Component\Checkout\Address\StreetLine\StreetLineContext"
        defaultViewModel="Yireo\LokiCheckout\Component\Checkout\Address\StreetLine\StreetLineViewModel"
        defaultRepository="Yireo\LokiCheckout\Component\Checkout\Address\StreetLine\StreetLineRepository">
        <defaultTarget name="loki-checkout.sidebar.preview.shipping_details"/>
        <defaultTarget name="loki-checkout.sidebar.preview.billing_address"/>

        <component name="loki-checkout.shipping.address.street0"/>
        <component name="loki-checkout.shipping.address.street1"/>
        <component name="loki-checkout.shipping.address.street2"/>
        <component name="loki-checkout.shipping.address.street3"/>
        <component name="loki-checkout.billing.address.street0"/>
        <component name="loki-checkout.billing.address.street1"/>
        <component name="loki-checkout.billing.address.street2"/>
        <component name="loki-checkout.billing.address.street3"/>
    </componentGroup>

    <componentGroup
        name="step-buttons"
        defaultContext="Yireo\LokiCheckout\Component\Base\Generic\GenericContext">
        <defaultTarget name="loki-checkout.steps"/>
        <defaultTarget name="loki-checkout.progressbar"/>

        <component
            name="loki-checkout.steps.shipping.backward-button"
            viewModel="Yireo\LokiCheckout\Component\Checkout\StepButton\StepBackwardButton\StepBackwardButtonViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\StepButton\StepBackwardButton\StepBackwardButtonRepository">
            <target name="loki-checkout.steps"/>
        </component>

        <component
            name="loki-checkout.steps.shipping.forward-button"
            viewModel="Yireo\LokiCheckout\Component\Checkout\StepButton\StepForwardButton\StepForwardButtonViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\StepButton\StepForwardButton\StepForwardButtonRepository">
            <target name="loki-checkout.steps"/>
        </component>

        <component
            name="loki-checkout.steps.billing.backward-button"
            viewModel="Yireo\LokiCheckout\Component\Checkout\StepButton\StepBackwardButton\StepBackwardButtonViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\StepButton\StepBackwardButton\StepBackwardButtonRepository">
            <target name="loki-checkout.steps"/>
        </component>

        <component
            name="loki-checkout.steps.billing.forward-button"
            viewModel="Yireo\LokiCheckout\Component\Checkout\StepButton\StepForwardButton\StepForwardButtonViewModel"
            repository="Yireo\LokiCheckout\Component\Checkout\StepButton\StepForwardButton\StepForwardButtonRepository">
        </component>
    </componentGroup>
</components>
