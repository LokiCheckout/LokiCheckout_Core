/** @var ViewModelFactory $viewModelFactory */
/** @var SystemCheckCollection $systemCheckCollection */
$systemCheckCollection = $viewModelFactory->create(SystemCheckCollection::class);
?>

<div class="admin__data-grid-wrap">
    <table class="data-grid">
        <thead>
        <tr>
            <th class="data-grid-th">
                <span class="data-grid-cell-content">
                    System Check
                </span>
            </th>
            <th class="data-grid-th">
                <span class="data-grid-cell-content">
                    Value
                </span>
            </th>
            <th class="data-grid-th">
                <span class="data-grid-cell-content">
                    Recommendation
                </span>
            </th>
        </tr>
        </thead>
        <tbody>
        <?php foreach ($systemCheckCollection->getSystemChecks() as $systemCheck): ?>
            <tr>
                <td>
                    <div class="data-grid-cell-content">
                        <?= $systemCheck->getResult()->getLabel() ?>
                    </div>
                </td>
                <td>
                    <div class="data-grid-cell-content">

                    </div>

                    <div class="data-grid-cell-content">
                        <?php if ($systemCheck->getResult()->isValid()): ?>
                            <span class="system-check system-check-notice">
                                <?= $systemCheck->getResult()->getValue() ?>
                            </span>
                        <?php else: ?>
                            <span class="system-check system-check-error">
                                <?= $systemCheck->getResult()->getValue() ?>
                            </span>
                        <?php endif; ?>
                    </div>
                </td>
                <td>
                    <div class="data-grid-cell-content">
