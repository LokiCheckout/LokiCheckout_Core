<?php
declare(strict_types=1);

use Yireo\LokiCheckout\ViewModel\Adminhtml\SystemCheckCollection;
use Yireo\LokiComponents\Factory\ViewModelFactory;

/** @var ViewModelFactory $viewModelFactory */
/** @var SystemCheckCollection $systemCheckCollection */
$systemCheckCollection = $viewModelFactory->create(SystemCheckCollection::class);
?>

<div class="admin__data-grid-wrap">
    <table class="data-grid">
        <thead>
        <tr>
            <th class="data-grid-th">
                <span class="data-grid-cell-content">
                    System Check
                </span>
            </th>
            <th class="data-grid-th">
                <span class="data-grid-cell-content">
                    Value
                </span>
            </th>
            <th class="data-grid-th">
                <span class="data-grid-cell-content">
                    Recommendation
                </span>
            </th>
        </tr>
        </thead>
        <tbody>
        <?php foreach ($systemCheckCollection->getSystemChecks() as $systemCheck): ?>
            <?php foreach ($systemCheck->getCheckResultCollection()->get() as $checkResult): ?>
                <?php $valueClassSuffix = $checkResult->isValid() ? 'notice' : 'error'; ?>
                <tr>
                    <td>
                        <div class="data-grid-cell-content">
                            <?= $checkResult->getLabel() ?>
                        </div>
                    </td>
                    <td>
                        <div class="data-grid-cell-content system-check system-check-<?= $valueClassSuffix ?>">
                            <?= $checkResult->getValue() ?>
                        </div>
                    </td>
                    <td>
                        <div class="data-grid-cell-content">
                            <?= $checkResult->getRecommendation() ?>
                        </div>
                    </td>
                </tr>
            <?php endforeach; ?>
        <?php endforeach; ?>
        </tbody>
    </table>
</div>

<style>
    .system-check {
        padding: 1px 3px 1px 3px;
    }

    .system-check-error {
        border: 1px solid #e22626;
        background: #f9d4d4;
        color: #e22626;
    }

    .system-check-warning {
        border: 1px solid #ff8538;
        background: #ffe3cd;
        color: #ff833b;
    }

    .system-check-notice {
        border: 1px solid #5b8116;
        background: #d0e5a9;
        color: #185b00;
    }
</style>

