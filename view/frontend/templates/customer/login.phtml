<?php
declare(strict_types=1);

/** @version 2.1.10 */

use Loki\Components\Component\ComponentViewModelInterface;
use Loki\Components\Factory\ViewModelFactory;
use Loki\Components\Util\Block\BlockRenderer;
use Loki\CssUtils\Util\CssClass;
use Loki\Components\Util\Block\ImageRenderer;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var CssClass $css */
/** @var ComponentViewModelInterface $viewModel */
/** @var ViewModelFactory $viewModelFactory */
/** @var ImageRenderer $imageRenderer */
/** @var BlockRenderer $blockRenderer */


?>
<div class="<?= $escaper->escapeHtmlAttr($css('grid grid-2-cols gap-4 relative')) ?>">
    <?= /* @noEscape */ $blockRenderer->html( $block, 'loki-field-components.utils.loader-overlay') ?>

    <div class="<?= $escaper->escapeHtmlAttr($css('field email required', 'field-container')) ?>">
        <label class="<?= $escaper->escapeHtmlAttr($css('label', 'label')) ?>" for="<?= $escaper->escapeHtml($viewModel->getElementId()) ?>-email">
            <span><?= $escaper->escapeHtml(__('Email')) ?></span>
        </label>
        <div class="<?= $escaper->escapeHtmlAttr($css('control', 'field-control')) ?>">
            <input
                name="login[email]"
                class="<?= $escaper->escapeHtmlAttr($css('form-input w-full', 'field-input')) ?>"
                required
                :value="email"
                @change="setEmail"
                autocomplete="off"
                id="<?= $escaper->escapeHtml($viewModel->getElementId()) ?>-email"
                type="email"
                title="<?= $escaper->escapeHtml(__('Email')) ?>">
        </div>
    </div>

    <div class="<?= $escaper->escapeHtmlAttr($css('field password required', 'field-container')) ?>">
        <label class="<?= $escaper->escapeHtmlAttr($css('label', 'label')) ?>" for="<?= $escaper->escapeHtml($viewModel->getElementId()) ?>-password">
            <span><?= $escaper->escapeHtml(__('Password')) ?></span>
        </label>
        <div class="<?= $escaper->escapeHtmlAttr($css('control flex items-center', 'field-control')) ?>">
            <input
                name="login[password]"
                class="<?= $escaper->escapeHtmlAttr($css('form-input w-full', 'field-input')) ?>"
                required
                :value="password"
                @change="setPassword"
                autocomplete="off"
                id="<?= $escaper->escapeHtml($viewModel->getElementId()) ?>-password"
                :type="passwordFieldType"
                title="<?= $escaper->escapeHtml(__('Password')) ?>">

            <button
                type="button"
                @click="togglePasswordFieldType"
                :aria-label="buttonAriaLabel"
                class="<?= $escaper->escapeHtmlAttr($css('px-4 py-3', 'button')) ?>">
                <template x-if="passwordVisible">
                    <div class="<?= $escaper->escapeHtmlAttr($css('', 'password-icon')) ?>">
                    <?= /* @noEscape */ $imageRenderer->icon($block, 'eye') ?>
                    </div>
                </template>

                <template x-if="passwordNotVisible">
                    <div class="<?= $escaper->escapeHtmlAttr($css('', 'password-icon')) ?>">
                    <?= /* @noEscape */ $imageRenderer->icon($block, 'eye-slash') ?>
                    </div>
                </template>
            </button>
        </div>

        <?= /* @noEscape */ $block->getChildHtml('form_additional_info') ?>
    </div>

    <div class="<?= $escaper->escapeHtmlAttr($css('actions-toolbar flex gap-8', 'toolbar')) ?>">
        <button
            type="button"
            :disabled="isButtonDisabled"
            @click="submit"
            class="<?= $escaper->escapeHtmlAttr($css('btn btn-primary disabled:opacity-75', 'toolbar-button')) ?>">
            <span><?= $escaper->escapeHtml(__('Sign In')) ?></span>
        </button>

        <a
            href="<?= $escaper->escapeUrl($block->getUrl('customer/account/create')) ?>"
            class="<?= $escaper->escapeHtmlAttr($css('btn btn-secondary', 'toolbar-button')) ?>">
            <span><?= $escaper->escapeHtml(__('Create An Account')) ?></span>
        </a>

        <a
            class="<?= $escaper->escapeHtmlAttr($css('underline text-secondary', 'forgot-password-link')) ?>"
            href="<?= $escaper->escapeHtml(__($block->getUrl('customer/account/forgotpassword'))) ?>">
            <span><?= $escaper->escapeHtml(__('Forgot Your Password?')) ?></span>
        </a>
    </div>
</div>
