<?php
declare(strict_types=1);

use Loki\Components\Component\ComponentViewModelInterface;
use Loki\Components\Factory\ViewModelFactory;
use Loki\Components\Util\Block\BlockRenderer;
use Loki\CssUtils\Util\CssClass;
use Loki\Components\Util\ImageOutput;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var CssClass $css */
/** @var ComponentViewModelInterface $viewModel */
/** @var ViewModelFactory $viewModelFactory */
/** @var ImageOutput $imageOutput */
/** @var BlockRenderer $blockRenderer */

$imageOutput = $viewModelFactory->create(ImageOutput::class);
?>
<div class="<?= /* @noEscape */
$css('grid grid-2-cols gap-4 relative') ?>">
    <?= /* @noEscape */ $blockRenderer->html($block, 'loki-field-components.utils.loader-overlay') ?>

    <div class="<?= /* @noEscape */
    $css('field email required', 'field-container') ?>">
        <label class="<?= /* @noEscape */
        $css('label', 'label') ?>" for="<?= /* @noEscape */ $viewModel->getElementId() ?>-email">
            <span><?= /* @noEscape */
                __('Email') ?></span>
        </label>
        <div class="<?= /* @noEscape */
        $css('control', 'field-control') ?>">
            <input
                name="login[email]"
                class="<?= /* @noEscape */
                $css('form-input w-full', 'field-input') ?>"
                required
                :value="email"
                @change="setEmail"
                autocomplete="off"
                id="<?= /* @noEscape */ $viewModel->getElementId() ?>-email"
                type="email"
                title="<?= /* @noEscape */
                __('Email') ?>">
        </div>
    </div>

    <div class="<?= /* @noEscape */
    $css('field password required', 'field-container') ?>">
        <label class="<?= /* @noEscape */
        $css('label', 'label') ?>" for="<?= /* @noEscape */ $viewModel->getElementId() ?>-password">
            <span><?= /* @noEscape */
                __('Password') ?></span>
        </label>
        <div class="<?= /* @noEscape */
        $css('control flex items-center', 'field-control') ?>">
            <input
                name="login[password]"
                class="<?= /* @noEscape */
                $css('form-input w-full', 'field-input') ?>"
                required
                :value="password"
                @change="setPassword"
                autocomplete="off"
                id="<?= /* @noEscape */ $viewModel->getElementId() ?>-password"
                :type="passwordFieldType"
                title="<?= /* @noEscape */
                __('Password') ?>">

            <button
                type="button"
                @click="togglePasswordFieldType"
                :aria-label="buttonAriaLabel"
                class="<?= /* @noEscape */ $css('px-4 py-3', 'button') ?>">
                <template x-if="passwordVisible">
                    <div class="<?= /* @noEscape */ $css('w-4', 'password-icon') ?>">
                    <?= /* @noEscape */ $imageOutput->get('Loki_FieldComponents::images/eye.svg') ?>
                    </div>
                </template>

                <template x-if="passwordNotVisible">
                    <div class="<?= /* @noEscape */ $css('w-4', 'password-icon') ?>">
                    <?= /* @noEscape */ $imageOutput->get('Loki_FieldComponents::images/eye-slash.svg') ?>
                    </div>
                </template>
            </button>
        </div>

        <?= $block->getChildHtml('form_additional_info') ?>
    </div>

    <div class="<?= /* @noEscape */ $css('actions-toolbar flex gap-8', 'toolbar') ?>">
        <button
            type="button"
            :disabled="isButtonDisabled"
            @click="submit"
            class="<?= /* @noEscape */ $css('btn btn-primary disabled:opacity-75', 'toolbar-button') ?>">
            <span><?= __('Sign In') ?></span>
        </button>

        <a
            class="<?= /* @noEscape */ $css('underline text-secondary', 'forgot-password-link') ?>"
            href="<?= __($block->getUrl('customer/account/forgotpassword')) ?>">
            <span><?= __('Forgot Your Password?') ?></span>
        </a>
    </div>
</div>
