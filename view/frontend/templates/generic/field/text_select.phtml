<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\FriggaCheckout\Magewire\Generic\FormTextSelectFieldInterface;

/** @var Template $block */
/** @var FormTextSelectFieldInterface $magewire */
$magewire = $this->getComponent();
$optionModel = $block->getFieldBlock()->getOptionModel();
$magewire->setOptionModel($optionModel);

if (count($optionModel->getOptions($magewire)) > 0) {
    echo $block->getLayout()->createBlock(Template::class)
        ->addData($block->getData())
        ->addData(['component' => $magewire])
        ->setNameInLayout('frigga.checkout.generic.field.select.'.$magewire->getAttributeCode())
        ->setTemplate('Yireo_FriggaCheckout::generic/field/select.phtml')
        ->toHtml();

    return;
}

echo $block->getLayout()->createBlock(Template::class)
    ->addData($block->getData())
    ->addData(['component' => $magewire])
    ->setNameInLayout('frigga.checkout.generic.field.text.'.$magewire->getAttributeCode())
    ->setTemplate('Yireo_FriggaCheckout::generic/field/text.phtml')
    ->toHtml();
