<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Magewirephp\Magewire\Component;
use Yireo\FriggaCheckout\Factory\ViewModelFactory;
use Yireo\FriggaCheckout\Magewire\Generic\FormTextSelectFieldInterface;
use Yireo\FriggaCheckout\ViewModel\BlockRenderer;

/** @var Template $block */
/** @var Component|FormTextSelectFieldInterface $magewire */
/** @var ViewModelFactory $viewModelFactory */
/** @var BlockRenderer $blockRenderer */
$blockRenderer = $viewModelFactory->create(BlockRenderer::class);
$optionModel = $block->getAncestorBlock()->getOptionModel();
$magewire->setOptionModel($optionModel);

if (count($optionModel->getOptions($magewire)) > 0) {
    $block->setOptionModel($optionModel);
    echo $blockRenderer->render('generic/field/select.phtml', $block, $magewire);
    return;
}

echo $blockRenderer->render('generic/field/text.phtml', $block, $magewire);
