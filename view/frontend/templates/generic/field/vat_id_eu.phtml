<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Magewire\Generic\FormFieldInterface;

/** @var Template $block */
/** @var Template $parentBlock */
/** @var FormFieldInterface $magewire */
/** @var string $blockClass */
?>

<div class="<?= $blockClass ?> mb-4 ">
    <div class="flex">
        <input
            id="vat_id_country"
            wire:loading.attr="aria-busy"
            wire:loading.class="disabled"
            <?php if (false === $magewire->validate()): ?>
                aria-invalid="true"
            <?php endif ?>
            type="text"
            pattern="[a-zA-Z]*"
            min="2" max="4"
            value="<?= $magewire->getVatCountryId() ?>"
            class="block w-16 rounded-l-lg bg-zinc-100 invalid:bg-red-100 invalid:border-red-500 valid:bg-green-100 valid:border-green-500 border-r-1">

        <input
            id="vat_id_text"
            wire:loading.attr="aria-busy"
            wire:loading.class="disabled"
            <?php if (false === $magewire->validate()): ?>
                aria-invalid="true"
            <?php endif ?>
            <?= $magewire->isRequired() ? 'required' : '' ?>
            type="text"
            pattern="[a-zA-Z0-9]*"
            min="2" max="20"
            class="block w-full rounded-r-lg border-l-0 invalid:border-red-500 valid:border-green-500">
    </div>

    <input id="vat_id" type="hidden" wire:model="value">
    <small>Current VAT ID: <?= $magewire->value ?></small>
</div>
