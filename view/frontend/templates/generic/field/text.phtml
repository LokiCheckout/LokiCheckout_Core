<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\FriggaCheckout\Magewire\Generic\FormFieldInterface;

/** @var Template $block */
/** @var Template $parentBlock */
/** @var FormFieldInterface $magewire */
$parentBlock = $block->getParentBlock(); // @todo
$magewire = $this->getComponent();
?>
<input
    wire:loading.attr="aria-busy"
    wire:loading.class="disabled"
    wire:model.lazy="<?= $magewire->getFieldName() ?>"
    <?php if (false === $magewire->isValid()): ?>
        aria-invalid="true" aria-errormessage="<?= $magewire->getFieldName() ?>-error"
    <?php endif ?>
    <?= $magewire->isRequired() ? 'required' : '' ?>
    type="<?= $magewire->getTextType() ?>"
    class="form-input block w-full invalid:border-red-500 valid:border-green-500 mb-4" >
