<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\FriggaCheckout\Magewire\Generic\FormTextMultipleFieldInterface;

/** @var Template $block */
/** @var FormTextMultipleFieldInterface $magewire */
$magewire = $this->getComponent();
$textCount = $magewire->getTextCount();

$i = 0;
while ($i < $textCount) {
    $magewire->setCounter($i);
    echo $block->getLayout()->createBlock(Template::class)
        ->addData(['component' => $magewire])
        ->setNameInLayout('frigga.checkout.generic.field.text.'.$magewire->getAttributeCode().'.'.$i)
        ->setTemplate('Yireo_FriggaCheckout::generic/field/text.phtml')
        ->toHtml();

    $i++;
}

