<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\FriggaCheckout\Magewire\Generic\FormFieldInterface;

/** @var Template $block */
/** @var FormFieldInterface $magewire */
/** @var string $blockClass */

if (false === $magewire instanceof FormFieldInterface) {
    echo '<div style="display:none">skipped</div>';
    return;
}

if (false === $magewire->isVisible()) {
    echo '<div style="display:none">not visible</div>';
    return;
}
?>
<div class="<?= $blockClass ?> field w-full relative <?= $magewire->isRequired(
) && 'required' ?> <?= $magewire->getFieldName() ?>" x-data="<?= $magewire->getJsName() ?>" x-defer="interact">
    <label for="<?= $magewire->getFieldName() ?>">
        <?= $magewire->getFieldLabel() ?>
        <?= $magewire->isRequired() ? $block->getBlockHtml('frigga.checkout.utils.required') : '' ?>
    </label>
    <div class="relative">
        <?= $block->getLayout()->createBlock(Template::class)
            ->addData(['field_block' => $block])
            ->addData(['component' => $magewire])
            ->setParentBlock($this)
            ->setNameInLayout('frigga.checkout.generic.field.'.$magewire->getFieldName())
            ->setTemplate($magewire->getFieldTemplate())
            ->toHtml() ?>
        <div wire:loading class="field-loader absolute top-0 right-0 bottom-0 p-3">
            <?= $block->getBlockHtml('frigga.checkout.utils.loader') ?>
        </div>
    </div>

    <?php if ($magewire->hasErrors()): ?>
        <?= $block->getLayout()->getBlock('frigga.checkout.utils.errors')->setData(['errors' => $magewire->getErrors()])->toHtml() ?>
    <?php endif; ?>

    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.data('<?= $magewire->getJsName() ?>', () => ({
                validate() {
                    return true;
                }
            }))
        })
    </script>
</div>
