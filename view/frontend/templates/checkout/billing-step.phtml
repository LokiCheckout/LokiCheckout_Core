<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Magewire\Checkout\BillingStep;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var BillingStep $magewire */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */
$enableBillingAsShipping = $magewire->enableBillingAsShipping();
$billingAsShipping = $magewire->billingAsShipping;
?>
<div  class="<?= $css('') ?>">
    <?= $blockRenderer->html('loki.checkout.generic.title', $block, ['title' => 'Billing Address']) ?>

    <?php if ($enableBillingAsShipping): ?>
        <?= $blockRenderer->html('loki.checkout.billing-step.billing-as-shipping') ?>
    <?php endif; ?>

    <?php if ($billingAsShipping): ?>
        <?= $block->getChildHtml('address-view') ?>
    <?php else: ?>
        <?= $block->getChildHtml('address-form') ?>
    <?php endif; ?>

    <?= $block->getChildHtml('payment-methods') ?>

    <div class="<?= $css('mb-8 float-right flex', 'buttons') ?>">
        <?= $block->getChildHtml('backward-button') ?>
        <?= $block->getChildHtml('forward-button') ?>
    </div>
</div>
