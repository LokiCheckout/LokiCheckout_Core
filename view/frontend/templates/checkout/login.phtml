<?php
declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Magento\Framework\View\Element\Template;
use Yireo\FriggaCheckout\Magewire\Checkout\Login;
use Yireo\FriggaCheckout\ViewModel\CheckoutState;

/** @var Template $block */
/** @var Login $magewire */
/** @var ViewModelRegistry $viewModels */
/** @var CheckoutState $checkoutState */
$checkoutState = $viewModels->require(CheckoutState::class);
$customerSession = $checkoutState->getCustomerSession();
$isLoggedIn = $customerSession->isLoggedIn();
?>
<div>
    <?php if ($isLoggedIn): ?>
        You are logged in as: <?= $customerSession->getCustomer()->getName() ?>
    <?php else: ?>
        <a href="/customer/account">Login</a>
    <?php endif; ?>
</div>
