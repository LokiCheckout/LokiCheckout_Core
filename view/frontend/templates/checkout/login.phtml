<?php
declare(strict_types=1);

use Yireo\FriggaCheckout\Factory\ViewModelFactory;
use Magento\Framework\View\Element\Template;
use Yireo\FriggaCheckout\Magewire\Checkout\Login;
use Yireo\FriggaCheckout\ViewModel\CheckoutState;

/** @var Template $block */
/** @var Login $magewire */
/** @var ViewModelFactory $viewModelFactory */
/** @var CheckoutState $checkoutState */
/** @var string $blockClass */

$checkoutState = $viewModelFactory->create(CheckoutState::class);
$customerSession = $checkoutState->getCustomerSession();
$isLoggedIn = $customerSession->isLoggedIn();
?>
<div class="<?= $blockClass ?>">
    <?php if ($isLoggedIn): ?>
        You are logged in as: <?= $customerSession->getCustomer()->getName() ?>
    <?php else: ?>
        <a href="/customer/account">Login</a>
    <?php endif; ?>
</div>
