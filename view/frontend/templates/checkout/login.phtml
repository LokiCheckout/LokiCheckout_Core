$isLoggedIn = $customerSession->isLoggedIn();

$logoutUrl = $block->getUrl('customer/account/logout');
?>
<div class="<?= $escaper->escapeHtml($css('card')) ?>" x-data="LokiModal">
    <?php if ($isLoggedIn): ?>
        <?= /* @noEscape */ $block->getChildHtml('logged-in') ?>
    <?php else: ?>
        <?= /* @noEscape */ $block->getChildHtml('form') ?>
    <?php endif; ?>
</div>
