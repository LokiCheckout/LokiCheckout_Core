<?php
declare(strict_types=1);

use Loki\Base\ViewModel\Block\ChildRenderer;
use Loki\CssUtils\Util\CssClass;
use Loki\Components\Util\Block\TemplateRenderer;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Factory\ViewModelFactory;
use LokiCheckout\Core\ViewModel\CheckoutState;
use Loki\Components\Util\Block\ImageRenderer;

/** @version 2.6.0 */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var CheckoutState $checkoutState */
/** @var CssClass $css */
/** @var ImageRenderer $imageRenderer */
/** @var TemplateRenderer $templateRenderer */
/** @var ChildRenderer $childRenderer */

$checkoutState = $viewModelFactory->create(CheckoutState::class);
$customerSession = $checkoutState->getCustomerSession();
$isLoggedIn = $customerSession->isLoggedIn();

$logoutUrl = $block->getUrl('customer/account/logout');
?>
<div class="<?= $escaper->escapeHtml($css('card')) ?>" x-data="LokiModal">
    <?php if ($isLoggedIn): ?>
        <?= /* @noEscape */ $childRenderer->any($block, 'before-logged-in') ?>
        <?= /* @noEscape */ $childRenderer->html($block, 'logged-in') ?>
        <?= /* @noEscape */ $childRenderer->any($block, 'after-logged-in') ?>
    <?php else: ?>
        <?= /* @noEscape */ $childRenderer->any($block, 'before-form') ?>
        <?= /* @noEscape */ $childRenderer->html($block, 'form') ?>
        <?= /* @noEscape */ $childRenderer->any($block, 'after-form') ?>
    <?php endif; ?>
</div>
