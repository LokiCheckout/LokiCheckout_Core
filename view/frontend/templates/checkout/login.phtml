<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Magewire\Checkout\Login;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\ViewModel\CheckoutState;

/** @var Template $block */
/** @var Login $magewire */
/** @var ViewModelFactory $viewModelFactory */
/** @var CheckoutState $checkoutState */
/** @var CssClass $css */

$checkoutState = $viewModelFactory->create(CheckoutState::class);
$customerSession = $checkoutState->getCustomerSession();
$isLoggedIn = $customerSession->isLoggedIn();

$logoutUrl = $block->getUrl('customer/account/logout');
?>
<div class="<?= $css('card bg-gray-100 my-2') ?>"
     x-data="LokiCheckoutToggle"
     x-title="<?= $block->getComponentName() ?>">

    <?php if ($isLoggedIn): ?>
        You are logged in as: <?= $customerSession->getCustomer()->getName() ?>
        (<a href="<?= $logoutUrl ?>"><?= __('Sign Out') ?></a>)
    <?php else: ?>
        <button @click="toggle"><?= __('Sign In') ?></button>
    <?php endif; ?>

    <div x-cloak x-show="show">
        <?= $block->getChildHtml('form') ?>
    </div>
</div>
