<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Yireo\LokiComponents\Factory\ViewModelFactory;
use Yireo\LokiComponents\Util\Block\CssClass;
use Yireo\LokiCheckout\ViewModel\CheckoutState;
use Yireo\LokiFieldComponents\ViewModel\ImageOutput;

/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var CheckoutState $checkoutState */
/** @var CssClass $css */
/** @var ImageOutput */
$imageOutput = $viewModelFactory->create(ImageOutput::class);
$checkoutState = $viewModelFactory->create(CheckoutState::class);
$customerSession = $checkoutState->getCustomerSession();
$isLoggedIn = $customerSession->isLoggedIn();

$logoutUrl = $block->getUrl('customer/account/logout');
?>
<div class="<?= /* @noEscape */ $css('card my-2') ?>" x-data="LokiModal">
    <?php if ($isLoggedIn): ?>
        You are logged in as: <?= $escaper->escapeHtml($customerSession->getCustomer()->getName()) ?>
        (<a href="<?= $escaper->escapeHtml($logoutUrl) ?>"><?= $escaper->escapeHtml(__('Sign Out')) ?></a>)
    <?php else: ?>
        <button @click="toggleModal" :disabled="isModalOpen">
            <?= $escaper->escapeHtml(__('Sign In')) ?>
        </button>
    <?php endif; ?>

    <dialog x-ref="modal" class="border border-zinc-200 rounded-lg shadow-lg">
        <div>
            <button @click="toggleModal" class="float-right m-4 cursor-pointer w-4">
                <?= /** @noEscape */ $imageOutput->get('Yireo_LokiComponents::images/xmark.svg') ?>
            </button>
            <?= /* @noEscape */ $block->getChildHtml('form') ?>
        </div>
    </dialog>
</div>
