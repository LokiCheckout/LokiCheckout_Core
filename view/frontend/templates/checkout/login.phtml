<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Magewire\Checkout\Login;
use Yireo\LokiCheckout\Util\Block\BlockAttribute;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\ViewModel\CheckoutState;

/** @var Template $block */
/** @var Login $magewire */
/** @var ViewModelFactory $viewModelFactory */
/** @var CheckoutState $checkoutState */
/** @var CssClass $css */
/** @var BlockAttribute $blockAttribute */

$checkoutState = $viewModelFactory->create(CheckoutState::class);
$customerSession = $checkoutState->getCustomerSession();
$isLoggedIn = $customerSession->isLoggedIn();
?>
<div <?= $blockAttribute() ?> class="<?= $css('card bg-gray-100 my-2') ?>">
    <?php if ($isLoggedIn): ?>
        You are logged in as: <?= $customerSession->getCustomer()->getName() ?>
    <?php else: ?>
        <a href="/customer/account"><?= __('Sign In') ?></a>
    <?php endif; ?>
    <?= $block->getChildHtml() ?>
</div>
