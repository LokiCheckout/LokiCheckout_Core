<?php
declare(strict_types=1);

use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Magewire\Checkout\Login;
use Yireo\LokiCheckout\ViewModel\CheckoutState;

/** @var Template $block */
/** @var Login $magewire */
/** @var ViewModelFactory $viewModelFactory */
/** @var CheckoutState $checkoutState */
/** @var string $blockClass */

$checkoutState = $viewModelFactory->create(CheckoutState::class);
$customerSession = $checkoutState->getCustomerSession();
$isLoggedIn = $customerSession->isLoggedIn();
?>
<div class="<?= $blockClass ?> card bg-gray-100 my-2">
    <?php if ($isLoggedIn): ?>
        You are logged in as: <?= $customerSession->getCustomer()->getName() ?>
    <?php else: ?>
        <a href="/customer/account">Login</a>
    <?php endif; ?>
    <?= $block->getChildHtml() ?>
</div>
