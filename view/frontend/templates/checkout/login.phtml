<?php
declare(strict_types=1);

use Loki\Components\Util\Block\TemplateRenderer;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Factory\ViewModelFactory;
use Loki\Components\Util\Block\CssClass;
use LokiCheckout\Core\ViewModel\CheckoutState;
use Loki\Field\ViewModel\ImageOutput;

/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var CheckoutState $checkoutState */
/** @var CssClass $css */
/** @var ImageOutput $imageOutput */
/** @var TemplateRenderer $templateRenderer */

$imageOutput = $viewModelFactory->create(ImageOutput::class);
$checkoutState = $viewModelFactory->create(CheckoutState::class);
$customerSession = $checkoutState->getCustomerSession();
$isLoggedIn = $customerSession->isLoggedIn();

$logoutUrl = $block->getUrl('customer/account/logout');
?>
<div class="<?= /* @noEscape */ $css('card my-2') ?>" x-data="LokiModal">
    <?php if ($isLoggedIn): ?>
        <?= __('You are logged in as %1', $escaper->escapeHtml($customerSession->getCustomer()->getName())) ?>
        (<a href="<?= $escaper->escapeHtml($logoutUrl) ?>"><?= $escaper->escapeHtml(__('Sign Out')) ?></a>)
    <?php else: ?>
        <button @click="toggleModal" :disabled="isModalOpen">
            <?= $escaper->escapeHtml(__('Sign In')) ?>
        </button>
    <?php endif; ?>

    <dialog x-ref="modal" class="<?= /* @noEscape */ $css('border border-zinc-200 rounded-lg shadow-lg', 'dialog') ?>">
        <div>
            <?= $templateRenderer->html($block, 'Loki_Components::component/modal/close.phtml'); ?>
            <?= /* @noEscape */ $block->getChildHtml('form') ?>
        </div>
    </dialog>
</div>
