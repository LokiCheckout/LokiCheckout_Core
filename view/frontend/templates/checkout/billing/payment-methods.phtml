<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Util\Component\AlpineComponentData;
use Yireo\LokiComponents\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Component\Checkout\Billing\PaymentMethods;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var PaymentMethods $viewModel */
/** @var BlockRenderer $blockRenderer */
/** @var CssClass $css */
/** @var AlpineComponentData $alpineComponentData */
$alpineComponentData = $viewModelFactory->create(AlpineComponentData::class);
$paymentMethods = $viewModel->getPaymentMethods();
?>
<div class="<?= $css('relative') ?>"
     x-data="LokiCheckoutPaymentMethods"
     x-title="<?= $alpineComponentData->getName($block) ?>"
     x-init-data='<?= $alpineComponentData->getJson($viewModel) ?>'
>
    <?= $blockRenderer->html('loki-checkout.utils.loader-overlay') ?>
    <?= $blockRenderer->html('loki-checkout.generic.title', $block, ['title' => 'Payment Methods']) ?>

    <form
        data-type="field"
        x-ref="field"
        aria-invalid="<?= $viewModel->isValid() ? 'false' : 'true' ?>"
        class="<?= $css('border border-transparent', 'container') ?>">
        <?php if (!empty($paymentMethods)): ?>
            <ul>
                <?php foreach ($paymentMethods as $paymentMethod): ?>
                    <?= $blockRenderer->html(
                        'loki-checkout.billing.payment-methods.item',
                        $block,
                        [
                            'method' => $paymentMethod,
                            'is_current' => $paymentMethod->getCode() === $viewModel->getValue(),
                        ]
                    ) ?>
                <?php endforeach; ?>
            </ul>
        <?php else: ?>
            <?= __('No payment methods available') ?>
        <?php endif; ?>
    </form>

    <?= $blockRenderer->html(
        'loki-checkout.utils.errors',
        $block,
        ['errors' => $viewModel->getComponent()->getMessages()->getErrors()]
    ) ?>
</div>
