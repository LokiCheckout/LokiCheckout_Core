<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Magewire\Checkout\Billing\PaymentMethods;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var PaymentMethods $magewire */
/** @var BlockRenderer $blockRenderer */
/** @var CssClass $css */
$paymentMethods = $magewire->getPaymentMethods();
?>
<div class="<?= $css('relative') ?>" x-data="LokiCheckoutPaymentMethods"
     data-loki-component='<?= $magewire->getComponentDataAsJson() ?>'
>
    <?= $blockRenderer->html('loki-checkout.utils.loader-overlay') ?>
    <?= $blockRenderer->html('loki-checkout.generic.title', $block, ['title' => 'Payment Methods']) ?>

    <form
        data-type="field"
        x-ref="field"
        aria-invalid="<?= $magewire->isValid() ? 'false' : 'true' ?>"
        class="<?= $css('border border-transparent', 'container') ?>">
        <?php if (!empty($paymentMethods)): ?>
            <ul>
                <?php foreach ($paymentMethods as $paymentMethod): ?>
                    <?= $blockRenderer->html(
                        'loki-checkout.billing.payment-methods.item',
                        $block,
                        [
                            'method' => $paymentMethod,
                            'is_current' => $paymentMethod->getCode() === $magewire->value,
                        ]
                    ) ?>
                <?php endforeach; ?>
            </ul>
        <?php else: ?>
            <?= __('No payment methods available') ?>
        <?php endif; ?>
    </form>

    <?= $blockRenderer->html('loki-checkout.utils.errors', $block, ['errors' => $magewire->getErrors()]) ?>
</div>
