<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Magewire\Checkout\Billing\PaymentMethods;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var PaymentMethods $magewire */
/** @var BlockRenderer $blockRenderer */
/** @var CssClass $css */
$paymentMethods = $magewire->getPaymentMethods();
?>
<div class="<?= $css('relative') ?>" x-data="<?= $block->getComponentName() ?>">
    <?= $blockRenderer->getBlockHtml('loki-checkout.utils.loader-overlay') ?>
    <?= $blockRenderer->getBlockHtml('loki-checkout.generic.title', $block, ['title' => 'Payment Methods']) ?>

    <?php if (!empty($paymentMethods)): ?>
        <ul>
            <?php foreach ($paymentMethods as $paymentMethod): ?>
                <?= $blockRenderer->getBlockHtml(
                    'loki-checkout.billing.payment-methods.item',
                    $block,
                    [
                        'method' => $paymentMethod,
                        'is_current' => $paymentMethod->getCode() === $magewire->value,
                    ]
                ) ?>
            <?php endforeach; ?>
        </ul>
    <?php else: ?>
        <?= __('No payment methods available') ?>
    <?php endif; ?>

    <?= $blockRenderer->getChildHtml('script-component', $block, [
        'magewire_id' => $magewire->id,
        'method_code' => $magewire->value,
    ]) ?>
    <?= $blockRenderer->getChildHtml('script-toggler', $block, []) ?>
</div>
