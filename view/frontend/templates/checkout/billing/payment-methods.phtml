<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Magewire\Checkout\BillingStep\PaymentMethods;
use Yireo\LokiCheckout\Util\BlockAttribute;
use Yireo\LokiCheckout\Util\BlockCssClass;
use Yireo\LokiCheckout\ViewModel\BlockRenderer;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var PaymentMethods $magewire */
/** @var BlockRenderer $blockRenderer */
/** @var BlockCssClass $blockCss */
/** @var BlockAttribute $blockAttribute */

$blockRenderer = $viewModelFactory->create(BlockRenderer::class);
$paymentMethods = $magewire->getPaymentMethods();
?>
<div <?= $blockAttribute() ?> class="<?= $blockCss('') ?>">
    <?= $blockRenderer->html('loki.checkout.generic.title', ['title' => 'Payment Methods']) ?>
    <ul role="list">
        <?php foreach ($paymentMethods as $paymentMethod): ?>
            <?php $code = $paymentMethod->getCode(); ?>
            <label for="payment-<?= $code ?>">
                <li class="cursor-pointer relative my-4 py-2">
                    <input
                        type="radio"
                        value="<?= $code ?>"
                        wire:model="value"
                        id="payment-<?= $code ?>">
                    <span class="ml-4"><?= $paymentMethod->getTitle() ?></span>

                    <?= $blockRenderer->create(
                        'checkout/billing/payment-methods/icon.phtml',
                        $block,
                        $magewire
                    )->setCode($code)->toHtml() ?>

                    <?= $blockRenderer->html('loki.checkout.billing-step.payment-methods.'.$code.'.form') ?>
                    <?= $blockRenderer->html('loki.checkout.billing-step.payment-methods.'.$code.'.additional') ?>
                </li>
            </label>
        <?php endforeach; ?>
    </ul>
</div>
