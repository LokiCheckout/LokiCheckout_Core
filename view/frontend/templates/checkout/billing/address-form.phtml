<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Magewire\Checkout\BillingStep\BillingAddress;
use Yireo\LokiCheckout\Util\Block\BlockAttribute;
use Yireo\LokiCheckout\Util\Block\BlockCssClass;
use Yireo\LokiCheckout\Util\Block\SortedChildBlocks;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var BillingAddress $magewire */
/** @var BlockCssClass $blockCss */
/** @var BlockAttribute $blockAttribute */
/** @var SortedChildBlocks $sortedChildBlocks */
$sortedChildBlocks = $viewModelFactory->create(SortedChildBlocks::class);
?>
<div <?= $blockAttribute() ?> class="<?= $blockCss('grid grid-cols-12 gap-8') ?>">
    <?php foreach ($sortedChildBlocks->getChildren($block) as $childBlock): ?>
        <?= $childBlock->toHtml() ?>
    <?php endforeach; ?>
</div>
