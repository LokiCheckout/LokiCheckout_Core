<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Util\Block\BlockAttribute;
use Yireo\LokiCheckout\Util\Block\BlockCssClass;
use Yireo\LokiCheckout\ViewModel\PaymentMethod\CheckMoneyOrder;

/** @var Template $block */
/** @var BlockCssClass $blockCss */
/** @var ViewModelFactory $viewModelFactory */
/** @var BlockAttribute $blockAttribute */
/** @var CheckMoneyOrder $configuration */
$configuration = $viewModelFactory->create(CheckMoneyOrder::class);
?>
<div <?= $blockAttribute() ?> class="<?= $blockCss('') ?>">
    <?php if ($configuration->getPayableTo()): ?>
        <p><?= __('Make Check Payable to') ?>: <?= $configuration->getPayableTo() ?></p>
    <?php endif; ?>
    <?php if ($configuration->getMailingAddress()): ?>
        <?= __('Send Check to') ?>: <address><?= $configuration->getMailingAddress() ?></address>
    <?php endif; ?>
</div>
