use LokiCheckout\Core\ViewModel\CheckoutState;
use Loki\Components\Factory\ViewModelFactory;
use Loki\CssUtils\Util\CssClass;
use Loki\Components\Util\Block\TemplateRenderer;

/** @version 2.5.0 */
/** @var Template $block */
/** @var CssClass $css */
/** @var TemplateRenderer $templateRenderer */
/** @var ViewModelFactory $viewModelFactory */
/** @var CheckoutState $checkoutState */
/** @var BillingAddressTitle $billingAddressTitle */

$billingAddressTitle = $viewModelFactory->create(BillingAddressTitle::class);
$title = $billingAddressTitle->getTitle($block);

echo /* @noEscape */ $templateRenderer->html(
    $block,
    'LokiCheckout_Core::generic/title.phtml',
    ['title' => $title]
);

