<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\View\Element\Template;
use LokiCheckout\Core\Component\Checkout\Address\AddressFormViewModel;
use Loki\Components\Util\Block\BlockRenderer;

/** @version 2.1.11 */
/** @var Template $block */
/** @var AddressFormViewModel $viewModel */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */
?>
<div class="<?= $escaper->escapeHtmlAttr($css('flex flex-col gap-8 relative')) ?>">
    <?= /* @noEscape */ $blockRenderer->html( $block, 'loki-field-components.utils.loader-overlay') ?>

    <?= /* @noEscape */ $block->getChildHtml('shipping-as-billing') ?>

    <?php if ($viewModel->isSameAddress()): ?>
        <?= /* @noEscape */ $block->getChildHtml('view') ?>
    <?php else: ?>
        <?php if ($viewModel->showSelectAddress()): ?>
            <?= /* @noEscape */ $block->getChildHtml('select') ?>
            <?= /* @noEscape */ $block->getChildHtml('toggle-select') ?>
        <?php endif; ?>

        <?php if($viewModel->isNewAddress()): ?>
            <?= /* @noEscape */ $block->getChildHtml('form-title') ?>
            <?= /* @noEscape */ $block->getChildHtml('form') ?>
        <?php endif; ?>
    <?php endif; ?>
</div>
