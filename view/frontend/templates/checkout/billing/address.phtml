<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Component\Checkout\Billing\BillingAddress\BillingAddressViewModel;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;
use Yireo\LokiComponents\Util\Block\CssClass;

/** @var Template $block */
/** @var BillingAddressViewModel $viewModel */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */

$hideTitle = (bool)$block->getHideTitle();
?>
<div class="<?= $css('relative') ?>">
    <?= $blockRenderer->html($block, 'loki-checkout.utils.loader-overlay') ?>

    <?php if (false === $hideTitle): ?>
        <?= $blockRenderer->html($block, 'loki-checkout.generic.title', ['title' => 'Billing Address']) ?>
    <?php endif; ?>

    <?= $block->getChildHtml('shipping-as-billing') ?>
    <?php if ($viewModel->isSameAddress()): ?>
        <?= $block->getChildHtml('view') ?>
    <?php else: ?>
        <?= $block->getChildHtml('form') ?>
    <?php endif; ?>
</div>
