<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Component\Checkout\Billing\BillingAddress\BillingAddressViewModel;
use Yireo\LokiComponents\Util\Block\BlockRenderer;
use Yireo\LokiComponents\Util\Block\CssClass;

/** @var Template $block */
/** @var BillingAddressViewModel $viewModel */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */
?>
<div class="<?= $css('relative') ?>">
    <?= $blockRenderer->html($block, 'loki-field-components.utils.loader-overlay') ?>

    <?= $block->getChildHtml('shipping-as-billing') ?>

    <?php if ($viewModel->isSameAddress()): ?>
        <?= $block->getChildHtml('view') ?>
    <?php else: ?>
        <?php if ($viewModel->showSelectAddress()): ?>
            <?= $block->getChildHtml('select') ?>
            <?= $block->getChildHtml('toggle-select') ?>
        <?php endif; ?>

        <?php if($viewModel->isNewAddress()): ?>
            <?= $block->getChildHtml('form-title') ?>
            <?= $block->getChildHtml('form') ?>
        <?php endif; ?>
    <?php endif; ?>
</div>
