<?php
declare(strict_types=1);

use Loki\Components\Util\Block\ChildRenderer;
use Loki\Base\ViewModel\Block\ChildRenderer;
use Loki\Components\Component\ComponentViewModelInterface;
use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use LokiCheckout\Core\Component\Checkout\Address\AddressFormViewModel;
use Loki\Components\Util\Block\BlockRenderer;

/** @version 2.6.0 */
/** @var ComponentViewModelInterface $viewModel */
/** @var Template $block */
/** @var AddressFormViewModel $viewModel */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */
/** @var ChildRenderer $childRenderer */
/** @var Escaper $escaper */
?>
<div class="<?= $escaper->escapeHtml($css('flex flex-col gap-4 relative')) ?>">
    <?= /* @noEscape */ $blockRenderer->html( $block, 'loki-field-components.utils.loader-overlay') ?>

    <?= /* @noEscape */ $block->getChildHtml('shipping-as-billing') ?>

    <?php if ($viewModel->showView()): ?>
        <?= /* @noEscape */ $childRenderer->any($block, 'before-view') ?>
        <?= /* @noEscape */ $block->getChildHtml('view') ?>
        <?= /* @noEscape */ $childRenderer->any($block, 'after-view') ?>
    <?php else: ?>
        <?php if ($viewModel->showSelectAddress()): ?>
            <?= /* @noEscape */ $childRenderer->any($block, 'before-select') ?>
            <?= /* @noEscape */ $block->getChildHtml('select') ?>
            <?= /* @noEscape */ $block->getChildHtml('toggle-select') ?>
            <?= /* @noEscape */ $childRenderer->any($block, 'after-select') ?>
        <?php endif; ?>

        <?php if($viewModel->isNewAddress()): ?>
            <?= /* @noEscape */ $childRenderer->any($block, 'before-form') ?>
            <?= /* @noEscape */ $block->getChildHtml('form-title') ?>
            <?= /* @noEscape */ $block->getChildHtml('form') ?>
            <?= /* @noEscape */ $childRenderer->any($block, 'after-form') ?>
        <?php endif; ?>
    <?php endif; ?>
</div>
