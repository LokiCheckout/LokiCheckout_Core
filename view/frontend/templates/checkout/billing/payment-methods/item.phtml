<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Magento\Payment\Api\Data\PaymentMethodInterface;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var BlockRenderer $blockRenderer */
/** @var CssClass $css */
/** @var PaymentMethodInterface $paymentMethod */
$paymentMethod = $block->getMethod();
$code = $paymentMethod->getCode();
$isCurrent = $block->getIsCurrent();
$componentName = $block->getParentBlock()->getComponentName() . ucfirst($code);
?>
<li class="<?= $css('cursor-pointer relative my-4 py-2') ?>">
    <input
        type="radio"
        x-model="value"
        value="<?= $code ?>"
        <?php if ($isCurrent) : ?>checked<?php endif ?>
        id="payment-<?= $code ?>">

    <div class="<?= $css('inline-block ml-4', 'method') ?>">
        <?= $blockRenderer->getBlockTemplate('checkout/billing/payment-methods/icon.phtml', $block, ['code' => $code]) ?>
        <label for="payment-<?= $code ?>" class=""><?= $paymentMethod->getTitle() ?></label>
    </div>

    <div class="<?= $css('m-4 ml-10', 'other') ?> <?php if (!$isCurrent) : ?>hidden<?php endif ?>" data-payment-method-code="<?= $code ?>">
        <?= $blockRenderer->getBlockHtml(
            'loki-checkout.billing.payment-methods.'.$code.'.form',
            $block,
            ['method' => $code]
        ) ?>
        <?= $blockRenderer->getBlockHtml(
            'loki-checkout.billing.payment-methods.'.$code.'.additional',
            $block,
            ['method' => $code]
        )
        ?>
    </div>
</li>
