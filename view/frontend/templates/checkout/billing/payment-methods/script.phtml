<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Magewire\Checkout\BillingStep\PaymentMethods;

/** @var Template $block */
/** @var PaymentMethods $magewire */
$magewire = $block->getComponent();
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('<?= $block->getAncestorBlock()->getComponentName() ?>', () => ({
            value: '<?= $magewire->value ?>',
            <?php foreach($magewire->getPaymentMethods() as $paymentMethod): ?>
            show_<?= $paymentMethod->getCode() ?>: false,
            <?php endforeach; ?>
            init() {
                <?php if ($magewire->value) : ?>
                if (this.$refs['<?= $magewire->value ?>']) {
                    this.$refs['<?= $magewire->value ?>'].style.display = 'block';
                }
                <?php endif; ?>

                this.$watch('value', () => {
                    const $ref =this.$refs[this.value];
                    if ($ref) {
                        $ref.style.display = 'block';
                    }

                    this.$refs[this.value].style.display = 'block';
                    this.$component(this).call('setValue', this.value);
                    window.dispatchEvent(new CustomEvent('checkout:payment:method-activate', {
                        detail: { method: this.value}
                    }));
                });
            }
        }));
    });
</script>
