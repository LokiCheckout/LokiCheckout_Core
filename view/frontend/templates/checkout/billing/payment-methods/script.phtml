<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Magewire\Checkout\Billing\PaymentMethods;

/** @var Template $block */
/** @var PaymentMethods $component */
$paymentMethodCode = $block->getMethodCode();
$component = $block->getComponent();
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('<?= $block->getParentBlock()->getComponentName() ?>', () => ({
            name: '<?= $block->getParentBlock()->getComponentName() ?>',
            wireId: '<?= $component->id ?>',
            step: '<?= $component->getStep() ?>',
            value: '<?= $paymentMethodCode ?>',
            valid: <?= $component->valid ? 'true' : 'false' ?>,
            rules: ['required'],
            init() {
                Alpine.store('components').add(this);

                this.showPaymentMethodBlocks();

                if (this.value) {
                    this.rules = ['required', this.value];
                    window.dispatchEvent(new CustomEvent('checkout:payment:method-activate', {
                        detail: {method: this.value}
                    }));
                }

                this.$watch('value', () => {
                    this.rules = ['required', this.value];
                    window.dispatchEvent(new CustomEvent('checkout:payment:method-activate', {
                        detail: {method: this.value}
                    }));
                    this.$component(this).call('setValue', this.value);

                    if (this.value) {
                        this.valid = true;
                    }
                });
            },
            showPaymentMethodBlocks() {
                if (!this.value) {
                    return;
                }

                const selector = '[data-payment-method-code="' + this.value + '"]';
                const element = document.querySelector(selector);
                if (element) {
                    element.style.display = 'block';
                    return;
                }

                yireoLokiCheckoutLogger('WARNING: No element for selector', selector);
            }
        }));
    });
</script>
