<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Magewire\Checkout\BillingStep\PaymentMethods;
use Yireo\LokiCheckout\Magewire\Checkout\ShippingStep\ShippingMethods;
use Yireo\LokiCheckout\ViewModel\BlockRenderer;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var PaymentMethods $magewire */
/** @var BlockRenderer $blockRenderer */
$blockRenderer = $viewModelFactory->create(BlockRenderer::class);
$paymentMethods = $magewire->paymentMethods;
?>
<div>
    <?= $blockRenderer->html('loki.checkout.generic.title', ['title' => 'Payment Methods']) ?>

    <ul role="list">
        <?php foreach ($paymentMethods as $paymentMethodCode => $paymentMethodTitle): ?>
        <li class="my-4 py-2">
            <input type="radio" value="<?= $paymentMethodCode ?>" wire:model="value" id="payment-<?= $paymentMethodCode ?>">
            <label for="payment-<?= $paymentMethodCode ?>" class="ml-4">
                <?= $paymentMethodTitle ?>
            </label>
        </li>
        <?php endforeach; ?>
    </ul>
</div>
