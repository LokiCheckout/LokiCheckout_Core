<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Loki\Components\Util\Block\TemplateRenderer;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Factory\ViewModelFactory;
use LokiCheckout\Core\ViewModel\CheckoutState;
use Loki\Components\Util\Block\ImageRenderer;

/** @version 2.1.3 */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var CheckoutState $checkoutState */
/** @var CssClass $css */
/** @var ImageRenderer $imageRenderer */
/** @var TemplateRenderer $templateRenderer */


$checkoutState = $viewModelFactory->create(CheckoutState::class);
$customerSession = $checkoutState->getCustomerSession();
$isLoggedIn = $customerSession->isLoggedIn();

$logoutUrl = $block->getUrl('customer/account/logout');
$showCustomerEmail = (bool)$block->getShowCustomerEmail();
$showLogoutLink = (bool)$block->getShowLogoutLink();

$customerName = $escaper->escapeHtml($customerSession->getCustomer()->getName());
$customerEmail = $escaper->escapeHtml($customerSession->getCustomer()->getEmail());
?>
<div class="<?= $escaper->escapeHtmlAttr($css('')) ?>">
    <?= $escaper->escapeHtml(__('You are logged in as %1', $customerName)) ?>

    <?php if ($showCustomerEmail) : ?>
        <em class="<?= $escaper->escapeHtmlAttr($css('', 'email')) ?>">
            (<?= $escaper->escapeHtml($customerEmail) ?>)
        </em>
    <?php endif; ?>

    <?= /* @noEscape */ $block->getChildHtml('logout') ?>
</div>
