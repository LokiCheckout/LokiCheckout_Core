<?php
declare(strict_types=1);

use Loki\Components\Util\Block\ChildRenderer;
use Loki\Base\ViewModel\Block\ChildRenderer;
use Loki\CssUtils\Util\CssClass;
use Loki\Components\Util\Block\TemplateRenderer;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Factory\ViewModelFactory;
use LokiCheckout\Core\ViewModel\CheckoutState;
use Loki\Components\Util\Block\ImageRenderer;

/** @version 2.6.0 */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var CheckoutState $checkoutState */
/** @var CssClass $css */
/** @var ImageRenderer $imageRenderer */
/** @var TemplateRenderer $templateRenderer */
/** @var ChildRenderer $childRenderer */

$blockName = str_replace('.', '-', $block->getNameInLayout());
$tooltipElement = $block->getTooltipElement();
?>
<div class="<?= $escaper->escapeHtml($css()) ?>">
    <?= /* @noEscape */ $childRenderer->any($block, 'before') ?>

    <button
        @click.prevent="toggleModal"
        :disabled="isModalOpen"
        <?php if ($tooltipElement): ?>
        x-tooltip="<?= $escaper->escapeHtml($tooltipElement) ?>"
        <?php endif; ?>
        id="<?= $escaper->escapeHtml($blockName) ?>-button"
        class="<?= $escaper->escapeHtml($css('', 'button')) ?>"
    >
        <?= $escaper->escapeHtml(__($block->getButtonLabel())) ?>
    </button>

    <dialog
        x-ref="modal"
        id="<?= $escaper->escapeHtml($blockName) ?>-modal"
        class="<?= $escaper->escapeHtml($css('border border-zinc-200 rounded-lg shadow-lg p-4', 'dialog')) ?>"
    >
        <?= /* @noEscape */ $templateRenderer->html($block, 'Loki_Components::component/modal/close.phtml'); ?>

        <div class="<?= $escaper->escapeHtml($css('p-8', 'dialog-inner')) ?>">
            <?= /* @noEscape */ $childRenderer->any($block, 'form') ?>
        </div>
    </dialog>

    <?= /* @noEscape */ $childRenderer->any($block, 'after') ?>
</div>
