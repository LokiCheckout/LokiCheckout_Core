<?php
declare(strict_types=1);

use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Magewire\Checkout\BillingStep;
use Yireo\LokiCheckout\Magewire\Checkout\ShippingStep;
use Yireo\LokiCheckout\ViewModel\BlockRenderer;
use Yireo\LokiCheckout\ViewModel\CheckoutState;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var BillingStep $magewire */
/** @var string $blockClass */
/** @var BlockRenderer $blockRenderer */
$blockRenderer = $viewModelFactory->create(BlockRenderer::class);
$enableBillingAsShipping = $magewire->enableBillingAsShipping;
$billingAsShipping = $magewire->billingAsShipping;
?>
<div class="<?= $blockClass ?>">
    <?= $blockRenderer->html('loki.checkout.generic.title', ['title' => 'Billing Address']) ?>

    <?php if ($enableBillingAsShipping): ?>
    <div class="card mb-8">
        <label for="billing_as_shipping">
            <input type="checkbox"
                   wire:model="billingAsShipping"
                   wire:loading.attr="aria-busy"
                   wire:loading.class="disabled"
                   id="billing_as_shipping">
            <span class="pl-2">
            <?= __('My billing and shipping address are the same') ?>
                </span>
        </label>
    </div>
    <?php endif; ?>

    <div class="card mb-8">
        <button type="button" class="btn btn-secondary" wire:click="copyFromShippingAddress">Copy values from shipping address</button>
    </div>

    <?php if ($billingAsShipping): ?>
        <div class="mb-8">
            <?= $block->getChildHtml('billing-view') ?>
        </div>
    <?php else: ?>
        <div class="mb-8">
            <?= $block->getChildHtml('billing-address') ?>
        </div>
    <?php endif; ?>

    <div class="mb-8">
        <?= $block->getChildHtml('payment-methods') ?>
    </div>
    <div class="mb-8 float-right flex">
        <?= $block->getChildHtml('backward-button') ?>
        <?= $block->getChildHtml('forward-button') ?>
    </div>
</div>
