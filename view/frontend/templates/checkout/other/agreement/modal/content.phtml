<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\CheckoutAgreements\Api\Data\AgreementInterface;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @version 2.3.22 */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var CssClass $css */
/** @var AgreementInterface $agreement */

$agreement = $block->getAgreement();
?>
<span class="<?= $escaper->escapeHtml($css('italic', 'content')) ?>">
    <?php if (false === $agreement->getIsHtml()): ?>
        <?= $escaper->escapeHtml($agreement->getContent()) ?>
    <?php else: ?>
        <pre class="<?= $escaper->escapeHtml($css('text-wrap whitespace-pre-line', '')) ?>">
            <?= /* @noEscape */ $agreement->getContent() ?>
        </pre>
    <?php endif; ?>
</span>
