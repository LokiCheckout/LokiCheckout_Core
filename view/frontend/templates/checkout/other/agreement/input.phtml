<?php
declare(strict_types=1);

use Loki\Components\Component\ComponentViewModelInterface;
use Loki\CssUtils\Util\CssClass;
use Magento\CheckoutAgreements\Api\Data\AgreementInterface;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use LokiCheckout\Core\Component\Checkout\Other\Agreements\AgreementsViewModel;

/** @version 2.3.28 */
/** @var ComponentViewModelInterface $viewModel */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var CssClass $css */
/** @var AgreementsViewModel $viewModel */
/** @var AgreementInterface $agreement */

$viewModel = $block->getViewModel();
$agreement = $block->getAgreement();
?>
<input
    type="checkbox"
    data-type="field"
    x-ref="field"
    data-id="<?= $escaper->escapeHtml($agreement->getAgreementId()) ?>"
    :checked="isChecked"
    :aria-invalid="isAriaInvalid"
    :data-valid="isValid"
    value="<?= $escaper->escapeHtml($agreement->getAgreementId()) ?>"
    @change="toggle"
    <?php if ($agreement->getIsActive() === true): ?>checked<?php endif; ?>
    required
    aria-required="true"
    <?php if ($viewModel->isDisabled()): ?>disabled="disabled"<?php endif ?>
    class="<?= $escaper->escapeHtml($css('form-checkbox mt-2 float-left', 'input')) ?>"
/>
