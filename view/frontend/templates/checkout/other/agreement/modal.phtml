<?php
declare(strict_types=1);

use Loki\Components\Util\Block\ChildRenderer;
use Loki\Components\Util\Block\TemplateRenderer;
use Loki\CssUtils\Util\CssClass;
use Magento\CheckoutAgreements\Api\Data\AgreementInterface;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @version 2.3.4 */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var CssClass $css */
/** @var AgreementInterface $agreement */
/** @var ChildRenderer $childRenderer */
/** @var TemplateRenderer $templateRenderer */

$agreement = $block->getAgreement();
?>
<dialog
    x-ref="modal"
    class="<?= $escaper->escapeHtml($css('border border-zinc-200 rounded-lg shadow-lg w-1/2 max-h-[90vh] p-4')) ?>"
>
    <?= /* @noEscape */ $templateRenderer->html($block, 'Loki_Components::component/modal/close.phtml'); ?>

    <div class="<?= $escaper->escapeHtml($css('p-8', 'dialog-inner')) ?>">
        <?= /* @noEscape */ $childRenderer->html($block, 'content', [
            'agreement' => $agreement,
        ]) ?>
    </div>
</dialog>
