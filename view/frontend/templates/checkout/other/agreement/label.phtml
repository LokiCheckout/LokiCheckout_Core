<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use LokiCheckout\Core\Component\Checkout\Other\Agreements\AgreementsViewModel;

/** @version 2.7.5 */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var CssClass $css */
/** @var AgreementsViewModel $viewModel */

$viewModel = $block->getViewModel();
$agreement = $block->getAgreement();
$labelText = $escaper->escapeHtml(
    (string)__((string)$agreement->getCheckboxText()),
    ['a', 'b', 'strong', 'i', 'em', 'u', 'span', 'br']
);

$hasLink = str_contains($labelText, '<a>');
$linkClasses = $block->getLinkClasses() ?? 'underline cursor-pointer';

if ($hasLink) {
    $labelText = str_replace(
        '<a>',
        '<a @click="toggleModal" class="' . $escaper->escapeHtmlAttr($linkClasses) . '">',
        $labelText
    );
}
?>
<div class="<?= $escaper->escapeHtml($css('inline-block pl-4', 'label-block')) ?>">
    <div
        class="<?= $escaper->escapeHtml($css('', 'label')) ?>">

        <span class="<?= $escaper->escapeHtml($css('cursor-pointer', 'label-span')) ?>">
            <?= /* @noEscape */ $labelText ?>
        </span>

        <?php if (!$hasLink): ?>
            <a
                type="button"
                @click.prevent="toggleModal"
                :disabled="isModalOpen"
                class="<?= $escaper->escapeHtml($linkClasses) ?>"
            >
                <?= $escaper->escapeHtml(__('View terms')) ?>
            </a>
        <?php endif; ?>
    </div>
</div>
