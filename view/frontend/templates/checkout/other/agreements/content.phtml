<?php
declare(strict_types=1);

/** @version 2.0.15 */

use Loki\CssUtils\Util\CssClass;
use Magento\CheckoutAgreements\Api\Data\AgreementInterface;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\CssUtils\Util\CssClass;

/** @var Escaper $escaper */
/** @var Template $block */
/** @var CssClass $css */
/** @var AgreementInterface $agreement */

$agreement = $block->getAgreement();
?>
<span class="<?= /* @noEscape */ $css('italic', 'content') ?>">
    <?php if ($agreement->getIsHtml()): ?>
        <?= /* @noEscape */ $agreement->getContent() ?>
    <?php else: ?>
        <pre><?= /* @noEscape */ $agreement->getContent() ?></pre>
    <?php endif; ?>
</span>
