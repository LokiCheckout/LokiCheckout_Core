<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Component\Checkout\Other\Agreements\AgreementsViewModel;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\Util\Component\AlpineComponentData;
use Yireo\LokiComponents\Factory\ViewModelFactory;

/** @var Template $block */
/** @var CssClass $css */
/** @var AgreementsViewModel $viewModel */
/** @var ViewModelFactory $viewModelFactory */
/** @var AlpineComponentData $alpineComponentData */

$alpineComponentData = $viewModelFactory->create(AlpineComponentData::class);
?>
<div class="<?= $css('') ?>"
     x-data="LokiCheckoutFieldComponent"
     x-title="<?= $alpineComponentData->getName($block) ?>"
     x-init-data='<?= $alpineComponentData->getJson($viewModel) ?>'
>
    <?php foreach ($viewModel->getCheckoutAgreements() as $agreement): ?>
        <input type="checkbox" id="agreement<?= $agreement->getAgreementId() ?>" value="<?= $agreement->getAgreementId() ?>" x-model="value" @change="submit"/>
        <label for="agreement<?= $agreement->getAgreementId() ?>">
            <?= $agreement->getName() ?>
        </label>
        <div>
            <?= $agreement->getContent() ?>
        </div>
    <?php endforeach; ?>
</div>
