<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Component\Checkout\Other\Agreements\AgreementsViewModel;
use Yireo\LokiComponents\Util\Block\CssClass;
use Yireo\LokiComponents\Factory\ViewModelFactory;

/** @var Template $block */
/** @var CssClass $css */
/** @var AgreementsViewModel $viewModel */
/** @var ViewModelFactory $viewModelFactory */

?>
<div class="<?= $css('p-2') ?>">
    <?php foreach ($viewModel->getCheckoutAgreements() as $agreement): ?>
        <div class="<?= $css('pb-2', 'item') ?>">
            <input
                type="checkbox"
                id="<?= $viewModel->getElementId().$agreement->getAgreementId() ?>"
                :checked="isChecked"
                value="<?= $agreement->getAgreementId() ?>"
                @change="submitChecked"
                <?php if ($viewModel->getValue() === true): ?>
                    checked
                <?php endif; ?>
                <?php if ($viewModel->isDisabled()): ?>
                    disabled="disabled"
                <?php endif ?>
                class="<?= $css('form-checkbox mt-2 float-left disabled:bg-zinc-100', 'input') ?>"
            />

            <div class="<?= $css('inline-block pl-4', 'label-block') ?>">
                <label for="<?= $viewModel->getElementId().$agreement->getAgreementId() ?>"
                       class="<?= $css('', 'label') ?>">
                    <?= $agreement->getCheckboxText() ?>
                </label>
                <br/>

                <span class="<?= $css('italic', 'content') ?>">
                    <?= $agreement->getContent() ?>
                </span>
            </div>
        </div>
    <?php endforeach; ?>
</div>
