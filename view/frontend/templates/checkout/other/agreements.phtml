<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use LokiCheckout\Core\Component\Checkout\Other\Agreements\AgreementsViewModel;
use Loki\Components\Util\Block\CssClass;
use Loki\Components\Factory\ViewModelFactory;

/** @var Escaper $escaper */
/** @var Template $block */
/** @var CssClass $css */
/** @var AgreementsViewModel $viewModel */
/** @var ViewModelFactory $viewModelFactory */

?>
<div class="<?= /* @noEscape */ $css('field required p-2') ?>" aria-invalid="<?= $viewModel->isValid() ? 'false' : 'true' ?>">
    <?php foreach ($viewModel->getCheckoutAgreements() as $agreement): ?>
        <div class="<?= /* @noEscape */ $css('pb-2', 'item') ?>">
            <input
                type="checkbox"
                data-type="field"
                data-id="<?= $agreement->getAgreementId() ?>"
                id="<?= $viewModel->getElementId().'-'.$agreement->getAgreementId() ?>"
                :checked="isAgreementChecked"
                :aria-invalid="isAgreementNotChecked"
                value="<?= $escaper->escapeHtml($agreement->getAgreementId()) ?>"
                @change="toggleAgreement"
                <?php if ($agreement->getIsActive() === true): ?>
                    checked
                <?php endif; ?>
                required
                aria-required="true"
                <?php if ($viewModel->isDisabled()): ?>
                    disabled="disabled"
                <?php endif ?>
                class="<?= /* @noEscape */ $css('form-checkbox mt-2 float-left disabled:bg-zinc-100', 'input') ?>"
            />

            <div class="<?= /* @noEscape */ $css('inline-block pl-4', 'label-block') ?>">
                <label for="<?= $viewModel->getElementId().'-'.$agreement->getAgreementId() ?>"
                       class="<?= /* @noEscape */ $css('', 'label') ?>">
                    <?= /* @noEscape */ $agreement->getCheckboxText() ?>
                </label>
                <br/>

                <span class="<?= /* @noEscape */ $css('italic', 'content') ?>">
                    <?= /* @noEscape */ $agreement->getContent() ?>
                </span>
            </div>
        </div>
    <?php endforeach; ?>
</div>
