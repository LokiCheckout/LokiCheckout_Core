<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Loki\Components\Util\Block\BlockRenderer;
use Loki\Components\Util\Block\ChildRenderer;
use Loki\Components\Util\Block\TemplateRenderer;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use LokiCheckout\Core\Component\Checkout\Other\Agreements\AgreementsViewModel;

/** @version 2.0.19 */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var CssClass $css */
/** @var AgreementsViewModel $viewModel */
/** @var ChildRenderer $childRenderer */
/** @var TemplateRenderer $templateRenderer */
/** @var BlockRenderer $blockRenderer */
?>
<div class="<?= /* @noEscape */ $css('field required') ?>">
    <?= /* @noEscape */ $block->getChildHtml('before') ?>

    <?php foreach ($viewModel->getCheckoutAgreements() as $agreement): ?>
        <div
            x-data="LokiCheckoutAgreementComponent"
            x-title="LokiCheckoutAgreement<?= /* @noEscape */ $agreement->getAgreementId() ?>"
        >
            <div class="<?= /* @noEscape */ $css('pb-2', 'item') ?>">
                <?= /* @noEscape */ $childRenderer->html($block, 'input', [
                    'agreement' => $agreement,
                ]) ?>

                <div class="<?= /* @noEscape */ $css('inline-block pl-4', 'label-block') ?>">
                    <label for="<?= /* @noEscape */ $viewModel->getElementId() . '-' . $agreement->getAgreementId() ?>"
                           class="<?= /* @noEscape */ $css('', 'label') ?>">
                        <button
                            type="button"
                            @click="toggleModal"
                            :disabled="isModalOpen">
                            <?= /* @noEscape */ __($agreement->getCheckboxText()) ?>
                        </button>
                    </label>
                </div>
            </div>

            <dialog x-ref="modal" class="<?= /* @noEscape */ $css('border border-zinc-200 rounded-lg shadow-lg w-1/2 max-h-[90vh]', 'dialog') ?>">
                <div class="<?= /* @noEscape */ $css('p-5', 'dialog-inner') ?>">
                    <?= /* @noEscape */ $templateRenderer->html($block, 'Loki_Components::component/modal/close.phtml'); ?>
                    <?= /* @noEscape */ $childRenderer->html($block, 'content', [
                        'agreement' => $agreement,
                        'view_model' => $viewModel,
                    ]) ?>
                </div>
            </dialog>
        </div>
    <?php endforeach; ?>

    <?= /* @noEscape */ $blockRenderer->html($block, 'loki-components.utils.local-messages') ?>
    <?= /* @noEscape */ $block->getChildHtml('after') ?>
</div>
