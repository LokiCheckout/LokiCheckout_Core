<?php
declare(strict_types=1);

use Loki\Base\ViewModel\Block\ChildRenderer;
use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use LokiCheckout\Core\ViewModel\FastCheckout;

/** @version 2.7.8 */
/** @var Template $block */
/** @var CssClass $css */
/** @var Escaper $escaper */
/** @var ChildRenderer $childRenderer */

$fastCheckoutViewModel = $block->getFastCheckoutViewModel();
$children = $fastCheckoutViewModel instanceof FastCheckout
    ? $fastCheckoutViewModel->renderChildren($block)
    : ['html' => $childRenderer->all($block), 'visible' => true];
$html = trim($children['html']);
if (empty($html)) {
    return;
}

$title = $block->getTitle() ?: __('Pay faster with');
?>
<?php if (false === $children['visible']): ?>
<div hidden>
    <?= /* @noEscape */ $html ?>
</div>
<?php else: ?>
<div class="<?= $escaper->escapeHtml($css('card text-center')) ?>">
    <p class="<?= $escaper->escapeHtml($css('mb-4', 'title')) ?>">
        <strong><?= $escaper->escapeHtml($title) ?></strong>:
    </p>
    <div class="<?= $escaper->escapeHtml($css('inline-flex flex-wrap gap-4', 'inner')) ?>">
        <?= /* @noEscape */ $html ?>
    </div>
</div>
<?php endif; ?>
