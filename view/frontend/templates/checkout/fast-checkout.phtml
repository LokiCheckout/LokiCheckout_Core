<?php
declare(strict_types=1);

use Loki\Components\Util\Block\ChildRenderer;
use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Util\Block\BlockRenderer;

/** @version 2.1.25 */
/** @var Template $block */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */
/** @var Escaper $escaper */
/** @var ChildRenderer $childRenderer */

$html = $childRenderer->all($block);
if (empty($html)) {
    return;
}
?>
<div class="<?= $escaper->escapeHtml($css('card mb-8')) ?>">
    <div class="<?= $escaper->escapeHtml($css('flex justify-center p-4', 'inner')) ?>">
        <?= /* @noEscape */ $html ?>
    </div>
</div>
