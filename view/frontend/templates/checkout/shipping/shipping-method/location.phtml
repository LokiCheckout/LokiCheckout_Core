<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;

/** @var Template $block */
/** @var Escaper $escaper */
use Magento\Framework\View\Element\Template;
use Loki\Components\Location\Location;
use Loki\Components\Util\Block\ChildRenderer;

/** @version 2.0.22 */
/**
 * @var Template $block
 * @var ChildRenderer $childRenderer
 * @var CssClass $css
 * @var Location $location
 */
$location = $block->getLocation();
?>
<div class="<?= /* @noEscape */ $css('flex mb-8 p-4 hover:bg-black/5') ?>">
    <?= /* @noEscape */ $childRenderer->html($block, 'location.input', [
        'location' => $location,
    ]) ?>

    <label for="<?= $escaper->escapeHtml($location->getId()) ?>" class="<?= /* @noEscape */ $css('cursor-pointer flex-1', 'label') ?>">
        <?= /* @noEscape */ $childRenderer->html($block, 'location.name', [
            'location' => $location,
        ]) ?>

        <?= /* @noEscape */ $childRenderer->html($block, 'location.pickup-details', [
            'location' => $location,
        ]) ?>

        <?= /* @noEscape */ $childRenderer->html($block, 'location.address', [
            'location' => $location,
        ]) ?>

        <?= /* @noEscape */ $childRenderer->html($block, 'location.business-hours', [
            'location' => $location,
        ]) ?>

        <?= /* @noEscape */ $childRenderer->html($block, 'location.additional', [
            'location' => $location,
        ]) ?>
    </label>
</div>
