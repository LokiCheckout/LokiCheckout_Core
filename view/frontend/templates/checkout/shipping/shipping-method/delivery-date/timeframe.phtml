<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use LokiCheckout\Core\Shipment\DeliveryDate\Timeframe;
use Loki\Components\Util\Block\ChildRenderer;

/** @version 2.1.30 */
/** @var Template $block */
/** @var Escaper $escaper */
/** @var ChildRenderer $childRenderer */
/** @var CssClass $css */
/** @var Timeframe[] $timeframes */

$timeframe = $block->getTimeframe();
?>
<div class="<?= $escaper->escapeHtml($css('flex p-2 hover:bg-black/5')) ?>">
    <?= /* @noEscape */ $childRenderer->html($block, 'timeframe.input', [
        'timeframe' => $timeframe,
    ]) ?>

    <label for="<?= $escaper->escapeHtml($timeframe->getId()) ?>" class="<?= $escaper->escapeHtml($css('cursor-pointer flex-1', 'label')) ?>">
        <?= /* @noEscape */ $childRenderer->html($block, 'timeframe.name', [
            'timeframe' => $timeframe,
        ]) ?>
    </label>
</div>
