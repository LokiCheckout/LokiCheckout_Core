<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Shipment\DeliveryDate\Timeframe;
use Yireo\LokiComponents\Util\Block\ChildRenderer;
use Yireo\LokiComponents\Util\Block\CssClass;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ChildRenderer $childRenderer */
/** @var CssClass $css */
/** @var Timeframe[] $timeframes */

$timeframe = $block->getTimeframe();
?>
<div class="<?= /* @noEscape */ $css('flex p-2 hover:bg-black/5') ?>">
    <?= /* @noEscape */ $childRenderer->html($block, 'timeframe.input', [
        'timeframe' => $timeframe,
    ]) ?>

    <label for="<?= $escaper->escapeHtml($timeframe->getId()) ?>" class="<?= /* @noEscape */
    $css('cursor-pointer flex-1', 'label') ?>">
        <?= /* @noEscape */
    $childRenderer->html($block, 'timeframe.name', [
            'timeframe' => $timeframe,
        ]) ?>
    </label>
</div>
