<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\View\Element\Template;
use Magento\Framework\Escaper;
use LokiCheckout\Core\Shipment\DeliveryDate\Timeframe;
use LokiCheckout\Core\ViewModel\PriceFormatter;
use Loki\Components\Factory\ViewModelFactory;

/** @version 2.1.13 */
/** @var Template $block */
/** @var CssClass $css */
/** @var Escaper $escaper */
/** @var ViewModelFactory $viewModelFactory */
/** @var PriceFormatter $priceFormatter */
/** @var Timeframe $timeframe */

$priceFormatter = $viewModelFactory->create(PriceFormatter::class);
$timeframe = $block->getTimeframe();
?>
<div class="<?= $escaper->escapeHtmlAttr($css('')) ?>">
    <div class="float-right text-sm">
        <?= $escaper->escapeHtml($timeframe->getLabel()) ?>
        <?php if ($timeframe->getPrice() > 0) : ?>
            (+ <?= /* @noEscape */ $priceFormatter->format($timeframe->getPrice()) ?>)
        <?php endif; ?>
    </div>

    <div>
        <?= $escaper->escapeHtml($timeframe->getFromTime()) ?> - <?= $escaper->escapeHtml($timeframe->getToTime()) ?>
    </div>
</div>
