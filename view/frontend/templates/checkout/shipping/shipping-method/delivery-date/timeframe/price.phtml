<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @version 2.6.0 */
/** @var Template $block */
/** @var CssClass $css */
/** @var Escaper $escaper */

$marker = $block->getMarker();
if (empty($marker)) {
    $marker = '+';
}
?>
<template x-if="timeframe.price.amount">
    <div class="<?= $escaper->escapeHtml($css('float-right cursor-pointer text-sm pl-2', 'inner')) ?>">
        <?= /** @noEscape */ $marker ?> <span x-money="timeframe.price.amount"></span>
    </div>
</template>
