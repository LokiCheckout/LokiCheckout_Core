<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Magento\Framework\Escaper;
use Yireo\LokiComponents\Location\Location;
use Yireo\LokiComponents\Factory\ViewModelFactory;
use Yireo\LokiComponents\Util\Block\ChildRenderer;
use Yireo\LokiComponents\Util\Block\CssClass;
use Yireo\LokiFieldComponents\ViewModel\ImageOutput;

/** @var Template $block */
/** @var CssClass $css */
/** @var Escaper $escaper */
/** @var ChildRenderer $childRenderer */
/** @var ViewModelFactory $viewModelFactory */
/** @var Location[] $locations */
/** @var ImageOutput $imageOutput */

$imageOutput = $viewModelFactory->create(ImageOutput::class);
$locations = $block->getLocations();
?>
<div>
    <?php if (empty($locations)): ?>
        <div class="<?= /* @noEscape */ $css('p-2', 'empty') ?>"><?= $escaper->escapeHtml(__('No locations found')) ?></div>
    <?php else: ?>
        <?php $i = 1; ?>
        <?php foreach ($locations as $location): ?>
            <div data-location-index="<?= $escaper->escapeHtml($i) ?>" class="hidden">
                <?= /* @noEscape */ $childRenderer->html($block, 'location', [
                    'location' => $location,
                ]) ?>
            </div>
            <?php $i++; ?>
        <?php endforeach; ?>

        <div @click="expandLocations">
            <div class="inline-block w-4"><?= $escaper->escapeHtml($imageOutput->get('Yireo_LokiCheckout::images/angle-down.svg')) ?></div>
            <span class="text-sm"><?= $escaper->escapeHtml(__('Show more options')) ?></span>
        </div>
    <?php endif; ?>
</div>
