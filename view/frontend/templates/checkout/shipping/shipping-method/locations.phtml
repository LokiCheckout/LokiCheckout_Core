<?php
declare(strict_types=1);

use Loki\Components\Factory\ViewModelFactory;
use Loki\Components\Util\Block\BlockRenderer;
use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Util\Block\ChildRenderer;
use Loki\Components\Util\Block\ImageRenderer;

/** @version 2.6.0 */
/** @var Template $block */
/** @var CssClass $css */
/** @var Escaper $escaper */
/** @var ChildRenderer $childRenderer */
/** @var BlockRenderer $blockRenderer */
/** @var ViewModelFactory $viewModelFactory */
/** @var ImageRenderer $imageRenderer */

$tabId = $block->getTabId();
?>
<div data-tab-content="<?= $escaper->escapeHtml($tabId) ?>" class="<?= $escaper->escapeHtml($css('hidden relative', 'locations-container')) ?>">
    <div x-cloak x-show="showLoader" :aria-busy="showLoader"
         class="<?= $escaper->escapeHtml($css('absolute top-0 left-0 right-0 bottom-0', 'loader')) ?>">
        <?= /* @noEscape */ $blockRenderer->html( $block, 'loki-field-components.utils.loader-overlay') ?>
    </div>

    <div>
        <template x-if="isInvalidShippingAddress">
            <div class="<?= $escaper->escapeHtml($css('', 'invalid-address')) ?>">
                <?= $escaper->escapeHtml(__('Please enter your address details first')) ?>
            </div>
        </template>

        <template x-if="showLoadingLocations">
            <?= /* @noEscape */ $block->getChildBlock('loading-bricks')->setData('label', 'Loading locations')->toHtml() ?>
        </template>

        <template x-if="showNoLocations">
            <div class="<?= $escaper->escapeHtml($css('', 'empty')) ?>"><?= $escaper->escapeHtml(__('No locations found')) ?></div>
        </template>

        <template x-for="location in getVisibleLocations" :key="location.id">
            <?= /* @noEscape */ $blockRenderer->html( $block, 'loki-checkout.shipping.location') ?>
        </template>

        <?= /* @noEscape */ $block->getChildHtml('collapse-button') ?>
        <?= /* @noEscape */ $block->getChildHtml('expand-button') ?>
        <?= /* @noEscape */ $block->getChildHtml('expand-all-button') ?>
    </div>
</div>
