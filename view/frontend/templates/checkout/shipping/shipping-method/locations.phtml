<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\View\Element\Template;
use Magento\Framework\Escaper;
use Loki\Components\Location\Location;
use Loki\Components\Factory\ViewModelFactory;
use Loki\Components\Util\Block\ChildRenderer;
use Loki\Field\ViewModel\ImageOutput;

/** @version 2.0.17 */
/** @var Template $block */
/** @var CssClass $css */
/** @var Escaper $escaper */
/** @var ChildRenderer $childRenderer */
/** @var ViewModelFactory $viewModelFactory */
/** @var Location[] $locations */
/** @var ImageOutput $imageOutput */

$imageOutput = $viewModelFactory->create(ImageOutput::class);
$locations = $block->getLocations();
?>
<div>
    <?php if (empty($locations)): ?>
        <div class="<?= /* @noEscape */ $css('p-2', 'empty') ?>"><?= $escaper->escapeHtml(__('No locations found')) ?></div>
    <?php else: ?>
        <?php $i = 1; ?>
        <?php foreach ($locations as $location): ?>
            <div data-location-index="<?= $escaper->escapeHtml($i) ?>" class="hidden">
                <?= /* @noEscape */ $childRenderer->html($block, 'location', [
                    'location' => $location,
                ]) ?>
            </div>
            <?php $i++; ?>
        <?php endforeach; ?>

        <div @click="expandLocations">
            <div class="inline-block w-4"><?= /** @noEscape */ $imageOutput->get('LokiCheckout_Core::images/angle-down.svg') ?></div>
            <span class="text-sm"><?= $escaper->escapeHtml(__('Show more options')) ?></span>
        </div>
    <?php endif; ?>
</div>
