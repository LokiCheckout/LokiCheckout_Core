<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\View\Element\Template;
use Magento\Framework\Escaper;
use Loki\Components\Location\Location;
use Loki\Components\Factory\ViewModelFactory;
use Loki\Components\Util\Block\ChildRenderer;
use Loki\Components\Util\Block\ImageRenderer;

/** @version 2.3.2 */
/** @var Template $block */
/** @var CssClass $css */
/** @var Escaper $escaper */
/** @var ChildRenderer $childRenderer */
/** @var ViewModelFactory $viewModelFactory */
/** @var Location[] $locations */
/** @var ImageRenderer $imageRenderer */


$locations = $block->getLocations();
?>
<div>
    <?php if (empty($locations)): ?>
        <div class="<?= $escaper->escapeHtml($css('p-2', 'empty')) ?>"><?= $escaper->escapeHtml(__('No locations found')) ?></div>
    <?php else: ?>
        <?php $i = 1; ?>
        <?php foreach ($locations as $location): ?>
            <div data-location-index="<?= $escaper->escapeHtml($i) ?>" class="hidden">
                <?= /* @noEscape */ $childRenderer->html($block, 'location', [
                    'location' => $location,
                ]) ?>
            </div>
            <?php $i++; ?>
        <?php endforeach; ?>

        <div @click.prevent="expandLocations">
            <div class="inline-block">
                <?= /* @noEscape */ $imageRenderer->icon($block, 'angle-down') ?>
            </div>
            <span class="text-sm"><?= $escaper->escapeHtml(__('Show more options')) ?></span>
        </div>
    <?php endif; ?>
</div>
