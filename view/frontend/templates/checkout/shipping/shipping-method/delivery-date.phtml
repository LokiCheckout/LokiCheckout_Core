<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use LokiCheckout\Core\Shipment\DeliveryDate;
use Loki\Components\Util\Block\ChildRenderer;
use Loki\Components\Util\Block\CssClass;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ChildRenderer $childRenderer */
/** @var CssClass $css */
/** @var DeliveryDate $deliveryDate */

$deliveryDate = $block->getDeliveryDate();
?>
<details class="<?= /* @noEscape */ $css('my-4') ?>" open>
    <summary class="<?= /* @noEscape */ $css('font-bold cursor-pointer', 'summary') ?>">
        <?= $escaper->escapeHtml($deliveryDate->getDate()) ?>
    </summary>
    <div class="<?= /* @noEscape */ $css('mb-4', 'content') ?>">
        <?= /* @noEscape */ $childRenderer->html($block, 'timeframes', [
            'timeframes' => $deliveryDate->getTimeframes(),
        ]) ?>
    </div>
</details>
