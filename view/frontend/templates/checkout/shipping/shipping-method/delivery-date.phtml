<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use LokiCheckout\Core\Shipment\DeliveryDate;
use Loki\Components\Util\Block\ChildRenderer;

/** @version 2.1.1 */
/** @var Template $block */
/** @var Escaper $escaper */
/** @var ChildRenderer $childRenderer */
/** @var CssClass $css */
/** @var DeliveryDate $deliveryDate */

$deliveryDate = $block->getDeliveryDate();
?>
<details class="<?= $escaper->escapeHtmlAttr($css('my-4')) ?>" open>
    <summary class="<?= $escaper->escapeHtmlAttr($css('font-bold cursor-pointer', 'summary')) ?>">
        <?= $escaper->escapeHtml($deliveryDate->getDate()) ?>
    </summary>
    <div class="<?= $escaper->escapeHtmlAttr($css('mb-4', 'content')) ?>">
        <?= /* @noEscape */ $childRenderer->html($block, 'timeframes', [
            'timeframes' => $deliveryDate->getTimeframes(),
        ]) ?>
    </div>
</details>
