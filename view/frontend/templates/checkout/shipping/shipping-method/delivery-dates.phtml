<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;

/** @var Template $block */
/** @var CssClass $css */
/** @var Escaper $escaper */
use Magento\Framework\View\Element\Template;
use LokiCheckout\Core\Shipment\DeliveryDate;
use Loki\Components\Util\Block\ChildRenderer;

/** @version 2.1.33 */
/**
 * @var Template $block
 * @var ChildRenderer $childRenderer
 * @var CssClass $css
 * @var DeliveryDate[] $deliveryDates
 */
$deliveryDates = $block->getDeliveryDates();
?>
<div class="<?= $escaper->escapeHtml($css('py-4')) ?>">
    <?php if (empty($deliveryDates)): ?>
        <div class="<?= $escaper->escapeHtml($css('', 'empty')) ?>"><?= $escaper->escapeHtml(__('No delivery dates found')) ?></div>
    <?php else: ?>
        <?php foreach ($deliveryDates as $deliveryDate): ?>
            <?= /* @noEscape */ $childRenderer->html($block, 'delivery-date', [
                'delivery_date' => $deliveryDate,
            ]) ?>
        <?php endforeach; ?>
    <?php endif; ?>
</div>
