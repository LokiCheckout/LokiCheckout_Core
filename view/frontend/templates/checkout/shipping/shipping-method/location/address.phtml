<?php
declare(strict_types=1);

use Loki\Base\ViewModel\Block\ChildRenderer;
use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @version 2.7.4 */
/** @var Template $block */
/** @var CssClass $css */
/** @var Escaper $escaper */
/** @var ChildRenderer $childRenderer */

?>
<template x-if="location.addressLine">
    <div>
        <?= $escaper->escapeHtml($childRenderer->any($block, 'before')) ?>
        <span class="<?= $escaper->escapeHtml($css('font-bold', 'label')) ?>">
            <?= $escaper->escapeHtml(__('Address')) ?>:
        </span>
        <?= $escaper->escapeHtml($childRenderer->any($block, 'between')) ?>
        <address class="<?= $escaper->escapeHtml($css('inline-block mb-4')) ?>" x-text="location.addressLine"></address>
        <?= $escaper->escapeHtml($childRenderer->any($block, 'after')) ?>
    </div>
</template>
