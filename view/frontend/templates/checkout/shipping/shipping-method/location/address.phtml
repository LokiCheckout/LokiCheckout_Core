<?php
declare(strict_types=1);

use Magento\Framework\Escaper;

/** @var Template $block */
/** @var CssClass $css */
/** @var Escaper $escaper */
use Magento\Framework\View\Element\Template;
use Loki\Components\Location\Location;
use Loki\Components\Util\Block\CssClass;

/**
 * @var Template $block
 * @var CssClass $css
 * @var Location $location
 */
$location = $block->getLocation();
$address = $location->getAddress();
?>
<address class="<?= /* @noEscape */ $css('mb-4') ?>">
    <?= $escaper->escapeHtml($address->getStreet()) ?> <?= $escaper->escapeHtml($address->getHouseNumber()) ?>,
    <?= $escaper->escapeHtml($address->getPostcode()) ?> <?= $escaper->escapeHtml($address->getCity()) ?>,
    <?= $escaper->escapeHtml($address->getCountryId()) ?>
</address>
