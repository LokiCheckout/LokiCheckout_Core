<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @version 2.3.30 */
/** @var CssClass $css */
/** @var Template $block */
/** @var Escaper $escaper */

?>
<details x-show="location.businessHours" class="<?= $escaper->escapeHtml($css('')) ?>">
    <summary class="<?= $escaper->escapeHtml($css('text-sm', 'summary')) ?>">
        <?= $escaper->escapeHtml(__('Show opening hours')) ?>
    </summary>
    <div class="<?= $escaper->escapeHtml($css('py-8', 'inner')) ?>">
        <template x-for="day in location.businessHours.days" :key="day.id">
            <div class="<?= $escaper->escapeHtml($css('grid grid-cols-2 gap-2', 'day')) ?>">
                <div x-text="day.label" class="<?= $escaper->escapeHtml($css('day capitalize', 'label')) ?>'"></div>
                <template x-for="dayPart in day.dayParts" :key="dayPart.id">
                    <div class="<?= $escaper->escapeHtml($css('', 'hours')) ?>">
                        <span x-text="dayPart.openingHour"></span> - <span x-text="dayPart.closingHour"></span>
                    </div>
                </template>
                <template x-if="day.comment">
                    <div class="<?= $escaper->escapeHtml($css('','comment')) ?>" x-text="day.comment"></div>
                </template>
            </div>
        </template>
    </div>
</details>
