<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @version 2.3.15 */
/** @var CssClass $css */
/** @var Template $block */
/** @var Escaper $escaper */

?>
<details x-show="location.businessHours">
    <summary><?= $escaper->escapeHtml(__('Show opening hours')) ?></summary>
    <div class="py-8">
        <template x-for="day in location.businessHours.days" :key="day.id">
            <div class="grid grid-cols-2 gap-2">
                <div x-text="day.label" class="day capitalize"></div>
                <template x-for="dayPart in day.dayParts" :key="dayPart.id">
                    <div>
                        <span x-text="dayPart.openingHour"></span> - <span x-text="dayPart.closingHour"></span>
                    </div>
                </template>
                <template x-if="day.comment">
                    <div x-text="day.comment"></div>
                </template>
            </div>
        </template>
    </div>
</details>
