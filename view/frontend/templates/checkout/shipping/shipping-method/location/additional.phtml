<?php
declare(strict_types=1);

use Magento\Framework\Escaper;

/** @var CssClass $css */
/** @var Template $block */
/** @var Escaper $escaper */
use Magento\Framework\View\Element\Template;
use Yireo\LokiComponents\Location\Location;
use Yireo\LokiComponents\Util\Block\CssClass;

/**
 * @var Template $block
 * @var CssClass $css
 * @var Location $location
 */
$location = $block->getLocation();
$address = $location->getAddress();
$comment = $address->getComment();

$additionalContent = '';
if ($comment) {
    $additionalContent = '<p>'.$address->getComment().'</p>';
}

if (empty($additionalContent)) {
    return;
}
?>
<details class="<?= /* @noEscape */ $css('') ?>">
    <summary class="<?= /* @noEscape */ $css('', 'summary') ?>">
        <?= $escaper->escapeHtml(__('Additional information')) ?>
    </summary>
    <div class="<?= /* @noEscape */ $css('my-4 text-sm', 'content') ?>">
        <?= $escaper->escapeHtml($additionalContent) ?>
    </div>
</details>
