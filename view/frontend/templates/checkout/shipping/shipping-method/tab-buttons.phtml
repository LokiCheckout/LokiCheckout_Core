<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @version 2.7.3 */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var CssClass $css */

$buttons = (array)$block->getButtons();
$groupName = (string)preg_replace('/[^a-z0-9-]+/', '-', strtolower($block->getNameInLayout()));
$groupLabel = __($block->getGroupLabel()) ?: __('Shipping methods');
?>
<div
    role="radiogroup"
    aria-label="<?= $escaper->escapeHtmlAttr($groupLabel) ?>"
    class="<?= $escaper->escapeHtml($css('tab-buttons grid md:grid-cols-[repeat(var(--loki-grid-cols),minmax(0,1fr))] gap-2 md:gap-4 mt-6 mb-8')) ?>"
    style="--loki-grid-cols: <?= /** @noEscape */count($buttons) ?>"
>
    <?php foreach ($buttons as $buttonId => $buttonLabel): ?>
        <label
            data-tab-id="<?= $escaper->escapeHtmlAttr($buttonId) ?>"
            @click="toggleTabs"
            @change="toggleTabs"
            class="<?= $escaper->escapeHtml($css('tab-inactive btn p-4 cursor-pointer text-center', 'button')) ?>"
        >
            <input
                type="radio"
                name="<?= $escaper->escapeHtmlAttr($groupName) ?>"
                value="<?= $escaper->escapeHtmlAttr($buttonId) ?>"
                class="<?= $escaper->escapeHtml($css('sr-only', 'radio-input')) ?>"
            />
            <?= $escaper->escapeHtml(__($buttonLabel)); ?>
        </label>
    <?php endforeach; ?>
</div>
