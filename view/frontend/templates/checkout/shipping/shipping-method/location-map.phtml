<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Factory\ViewModelFactory;
use Loki\Components\Util\Block\BlockRenderer;
use Loki\Map\Component\Base\Map\MapViewModel;
use Loki\Map\Map\Marker;
use Loki\Map\Map\MarkerFactory;

/** @version 2.1.0 */
/** @var CssClass $css */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var MapViewModel $viewModel */
/** @var BlockRenderer $blockRenderer */
/** @var ViewModelFactory $viewModelFactory */
/** @var MarkerFactory $markerFactory */
/** @var Marker[] $markers */

$locations = $block->getLocations();
$markers = [];
$markerFactory = $viewModelFactory->create(MarkerFactory::class);
foreach ($locations as $location) {
    $markers[] = $markerFactory->createFromLocation($location);
}
?>
<div class="<?= /* @noEscape */ $css('') ?>">
    <div class="<?= /* @noEscape */ $css('flex max-h-96', 'inner') ?>">
        <?= /* @noEscape */ $blockRenderer->html($block,  'loki-map-components.map-container', []) ?>
        <div class="<?= /* @noEscape */ $css('w-1/4 px-4 grid gap-4 overflow-auto', 'grid') ?>">
            <?php foreach ($markers as $marker) : ?>
                <a href="#" class="<?= /* @noEscape */ $css('bg-white p-2 hover:bg-amber-100', 'anchor') ?>" @click.prevent="jumpToMarker" <?= /* @noEscape */ $marker->getHtmlAttributes() ?>>
                    <strong><?= $escaper->escapeHtml($marker->getTitle()) ?></strong><br/>
                    <?= $escaper->escapeHtml($marker->getAddress()->render()) ?><br/>
                    <button
                        class="<?= /* @noEscape */ $css('btn btn-primary btn-small', 'button') ?>"
                        @click.prevent="saveMarker"
                        data-value="<?= $escaper->escapeHtml($marker->getId()) ?>">
                        <?= $escaper->escapeHtml(__('Select')) ?>
                    </button>
                </a>
            <?php endforeach; ?>
        </div>
    </div>
</div>
