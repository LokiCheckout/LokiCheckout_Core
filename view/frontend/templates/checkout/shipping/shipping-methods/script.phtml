<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Magewire\Checkout\ShippingStep\ShippingMethods;

/** @var Template $block */
/** @var ShippingMethods $magewire */
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('<?= $magewire->getJsName() ?>', () => ({
            value: '<?= $magewire->value ?>',
            init() {
                this.$watch('value', () => {
                    window.dispatchEvent(new CustomEvent('checkout:shipping:method-activate', {
                        detail: { method: this.value}
                    }));

                    this.$component(this).call('setValue', this.value);
                });
            }
        }));
    });
</script>
