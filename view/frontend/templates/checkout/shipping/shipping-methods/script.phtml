<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Magewire\Checkout\Shipping\ShippingMethods;

/** @var Template $block */
/** @var ShippingMethods $component */
$component = $block->getComponent();
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('<?= $component->getJsName() ?>', () => ({
            name: '<?= $component->getJsName() ?>',
            wireId: '<?= $component->id ?>',
            step: '<?= $component->getStep() ?>',
            value: '<?= $component->value ?>',
            valid: <?= $component->valid ? 'true' : 'false' ?>,
            rules: ['required'],
            init() {
                if (this.value) {
                    this.rules = ['required', this.value];
                    window.dispatchEvent(new CustomEvent('checkout:shipping:method-activate', {
                        detail: {method: this.value}
                    }));
                }

                Alpine.store('components').add(this);

                this.$watch('value', () => {
                    this.rules = ['required', this.value];
                    this.$component(this).call('setValue', this.value);
                    if (this.value) {
                        this.valid = true;
                    }

                    window.dispatchEvent(new CustomEvent('checkout:shipping:method-activate', {
                        detail: {method: this.value}
                    }));
                });
            }
        }));
    });
</script>
