<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Magewire\Checkout\Shipping\ShippingMethods;

/** @var Template $block */
/** @var ShippingMethods $magewire */
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('<?= $magewire->getJsName() ?>', () => ({
            name: '<?= $magewire->getJsName() ?>',
            wireId: '<?= $magewire->id ?>',
            step: '<?= $magewire->getStep() ?>',
            value: '<?= $magewire->value ?>',
            valid: <?= $magewire->valid ? 'true' : 'false' ?>,
            rules: [
                'required'
            ],
            init() {
                this.code = '<?= $magewire->value ?>';
                Alpine.store('step').add(this);

                this.$watch('value', () => {
                    window.dispatchEvent(new CustomEvent('checkout:shipping:method-activate', {
                        detail: { method: this.value}
                    }));

                    this.$component(this).call('setValue', this.value);
                });
            }
        }));
    });
</script>
