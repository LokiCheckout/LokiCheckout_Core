<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Magento\Quote\Model\Cart\ShippingMethod;
use Yireo\LokiCheckout\Component\Checkout\Shipping\ShippingMethods\ShippingMethodsViewModel;
use Yireo\LokiComponents\Factory\ViewModelFactory;
use Yireo\LokiComponents\Util\Block\CssClass;
use Yireo\LokiCheckout\ViewModel\PriceFormatter;

/** @var Template $block */
/** @var CssClass $css */
/** @var ViewModelFactory $viewModelFactory */
/** @var PriceFormatter $priceFormatter */
/** @var ShippingMethodsViewModel $viewModel */
/** @var ShippingMethod $shippingMethod */

$viewModel = $block->getViewModel();
$priceFormatter = $viewModelFactory->create(PriceFormatter::class);
$code = $block->getCode();
$shippingMethod = $block->getMethod();
$isCurrent = $viewModel->getCurrentShippingCode() === $code;

$mainClasses = [];
$mainClasses[] = $isCurrent ? 'active' : 'inactive';
$mainClasses[] = $viewModel->isDisabled() ? 'disabled' : 'enabled';
?>
<li class="<?= $css('cursor-pointer relative flex') ?> <?= implode(' ', $mainClasses) ?>">
    <div class="<?= $css('p-4', 'input-container') ?>">
        <?php if ($shippingMethod->getAvailable()) : ?>
            <input type="radio"
                   x-model="value"
                   name="shipping_method"
                   value="<?= $code ?>"
                <?php if ($viewModel->isDisabled()): ?>
                    disabled="disabled"
                <?php endif; ?>
                   id="shipping-<?= $code ?>"
                <?= $isCurrent ? 'checked' : '' ?>>
        <?php else: ?>
            <input type="radio" disabled/>
        <?php endif; ?>
    </div>
    <div class="<?= $css('p-4 w-auto font-bold', 'amount-container') ?>">
        <label for="shipping-<?= $code ?>">
            <?= $priceFormatter->format($shippingMethod->getAmount()) ?>
        </label>
    </div>
    <div class="<?= $css('p-4 w-auto', 'method-container') ?>">
        <label for="shipping-<?= $code ?>">
            <?= $shippingMethod->getMethodTitle() ?>
        </label>
    </div>
    <div class="<?= $css('p-4', 'carrier-container') ?>">
        <label for="shipping-<?= $code ?>">
            <?= $shippingMethod->getCarrierTitle() ?>
        </label>
    </div>
</li>
