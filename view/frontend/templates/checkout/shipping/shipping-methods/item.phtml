<?php
declare(strict_types=1);

use Loki\Components\Component\ComponentViewModelInterface;
use Loki\CssUtils\Util\CssClass;
use LokiCheckout\Core\ViewModel\ApplicationMode;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Magento\Quote\Model\Cart\ShippingMethod;
use LokiCheckout\Core\Component\Checkout\Shipping\ShippingMethods\ShippingMethodsViewModel;
use Loki\Components\Factory\ViewModelFactory;
use Loki\Components\Util\Block\BlockRenderer;
use LokiCheckout\Core\ViewModel\PriceFormatter;
use Loki\Components\Util\Block\TemplateRenderer;

/** @version 2.3.22 */
/** @var ComponentViewModelInterface $viewModel */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */
/** @var TemplateRenderer $templateRenderer */
/** @var ViewModelFactory $viewModelFactory */
/** @var PriceFormatter $priceFormatter */
/** @var ShippingMethodsViewModel $viewModel */
/** @var ShippingMethod $shippingMethod */
/** @var ApplicationMode $applicationMode */

$priceFormatter = $viewModelFactory->create(PriceFormatter::class);
$viewModel = $block->getViewModel();

$code = $block->getCode();
$shippingMethod = $block->getMethod();
$isCurrent = $viewModel->getValue() === $code;
$showHidden = (bool)$block->getShowHidden(); // @doc

$blockClasses = [];
$blockClasses[] = $isCurrent ? 'active' : 'inactive';
$blockClasses[] = $viewModel->isDisabled() ? 'disabled' : 'enabled';

$htmlAttributes = '';
$applicationMode = $viewModelFactory->create(ApplicationMode::class);
if ($applicationMode->isDeveloperMode()) {
    $htmlAttributes = 'title="' . $escaper->escapeHtml($code) . '"';
}
?>
<li class="<?= $escaper->escapeHtml($css('cursor-pointer relative flex gap-4 my-2 p-3')) ?> <?= $escaper->escapeHtml(implode(' ', $blockClasses)) ?>" <?= /** @noEscape */ $htmlAttributes ?>>
    <div class="<?= $escaper->escapeHtml($css('', 'input-container')) ?>">
        <?php if ($shippingMethod->getAvailable()) : ?>
            <input
                type="radio"
                :value="value"
                :disabled="loading"
                @change="submitValue"
                name="shipping_method"
                value="<?= $escaper->escapeHtml($code) ?>"
                <?php if ($viewModel->getValue() === $code): ?>
                    checked
                <?php endif; ?>
                <?= $isCurrent ? 'checked' : '' ?>
                <?= $viewModel->isDisabled() ? 'disabled="disabled"' : '' ?>
                id="<?= $escaper->escapeHtml($viewModel->getFieldIdFromCode($code)) ?>"
                class="<?= $escaper->escapeHtml($css('mr-4', 'input')) ?>"
            >
        <?php else: ?>
            <input type="radio" id="shipping-<?= $escaper->escapeHtml($code) ?>" disabled/>
        <?php endif; ?>
    </div>
    <div class="<?= $escaper->escapeHtml($css('flex-1', 'details-container')) ?>">
        <div class="<?= $escaper->escapeHtml($css('md:flex', 'details')) ?>">
            <?= /* @noEscape */ $templateRenderer->html(
                $block,
                'LokiCheckout_Core::checkout/shipping/shipping-methods/icon.phtml',
                [
                    'alias' => $code,
                    'code' => $code,
                ]
            ) ?>

            <label for="<?= $escaper->escapeHtml($viewModel->getFieldIdFromCode($code)) ?>" class="<?= $escaper->escapeHtml($css('pr-2 font-bold cursor-pointer', 'amount-label')) ?>">
                <?= /* @noEscape */ $priceFormatter->format($shippingMethod->getAmount()) ?>
            </label>

            <label for="<?= $escaper->escapeHtml($viewModel->getFieldIdFromCode($code)) ?>"
                   class="<?= $escaper->escapeHtml($css('cursor-pointer pr-2 ', 'method-label')) ?>"><?= $escaper->escapeHtml($shippingMethod->getMethodTitle()) ?></label>

            <label for="<?= $escaper->escapeHtml($viewModel->getFieldIdFromCode($code)) ?>" class="<?= $escaper->escapeHtml($css('cursor-pointer pr-2 ', 'carrier-label')) ?>">
                <?= $escaper->escapeHtml($shippingMethod->getCarrierTitle()) ?>

                <?php if (false === $shippingMethod->getAvailable()) : ?>
                    <?php if ($shippingMethod->getErrorMessage()): ?>
                        (<?= $escaper->escapeHtml($shippingMethod->getErrorMessage()) ?>)
                    <?php else: ?>
                        (Not available)
                    <?php endif; ?>
                <?php endif; ?>
            </label>
        </div>

        <?php if ($isCurrent || $showHidden) : ?>
            <div class="<?= $escaper->escapeHtml($css('', 'other')) ?> <?php if (!$isCurrent) : ?>hidden<?php endif ?>">
                <?= /* @noEscape */ $blockRenderer->html(
                    $block,
                    'loki-checkout.shipping.methods.'.$code.'.form',
                    ['method' => $code]
                ) ?>

                <?= /* @noEscape */ $blockRenderer->html(
                    $block,
                    'loki-checkout.shipping.methods.'.$code.'.additional',
                    ['method' => $code]
                )
                ?>
            </div>
        <?php endif; ?>
    </div>
</li>
