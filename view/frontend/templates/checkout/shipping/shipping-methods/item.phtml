<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Magento\Quote\Model\Cart\ShippingMethod;
use Yireo\LokiCheckout\Component\Checkout\Shipping\ShippingMethods\ShippingMethodsViewModel;
use Yireo\LokiComponents\Factory\ViewModelFactory;
use Yireo\LokiComponents\Util\Block\BlockRenderer;
use Yireo\LokiComponents\Util\Block\CssClass;
use Yireo\LokiCheckout\ViewModel\PriceFormatter;
use Yireo\LokiComponents\Util\Block\TemplateRenderer;

/** @var Escaper $escaper */
/** @var Template $block */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */
/** @var ViewModelFactory $viewModelFactory */
/** @var PriceFormatter $priceFormatter */
/** @var ShippingMethodsViewModel $viewModel */
/** @var ShippingMethod $shippingMethod */

$templateRenderer = $viewModelFactory->create(TemplateRenderer::class);
$priceFormatter = $viewModelFactory->create(PriceFormatter::class);
$viewModel = $block->getViewModel();

$code = $block->getCode();
$shippingMethod = $block->getMethod();
$isCurrent = $viewModel->getValue() === $code;
$showHidden = (bool)$block->getShowHidden(); // @doc

$blockClasses = [];
$blockClasses[] = $isCurrent ? 'active' : 'inactive';
$blockClasses[] = $viewModel->isDisabled() ? 'disabled' : 'enabled';
?>
<li class="<?= /* @noEscape */ $css('cursor-pointer relative flex gap-4 my-2 p-3') ?> <?= /* @noEscape */ implode(' ', $blockClasses) ?>">
    <div class="<?= /* @noEscape */ $css('', 'input-container') ?>">
        <?php if ($shippingMethod->getAvailable()) : ?>
            <input
                type="radio"
                :value="value"
                @change="submitValue"
                name="shipping_method"
                value="<?= $escaper->escapeHtml($code) ?>"
                <?php if ($viewModel->getValue() === $code): ?>
                    checked
                <?php endif; ?>
                <?= $isCurrent ? 'checked' : '' ?>
                <?= $viewModel->isDisabled() ? 'disabled="disabled"' : '' ?>
                id="<?= $escaper->escapeHtml($viewModel->getFieldIdFromCode($code)) ?>"
                class="<?= /* @noEscape */ $css('mr-4', 'input') ?>"
            >
        <?php else: ?>
            <input type="radio" id="shipping-<?= $escaper->escapeHtml($code) ?>" disabled/>
        <?php endif; ?>
    </div>
    <div class="<?= /* @noEscape */ $css('flex-1', 'details-container') ?>">
        <div class="<?= /* @noEscape */ $css('md:flex', 'details') ?>">
            <?= /* @noEscape */ $templateRenderer->html(
                $block,
                'Yireo_LokiCheckout::checkout/shipping/shipping-methods/icon.phtml',
                [
                    'alias' => $code,
                    'code' => $code,
                ]
            ) ?>

            <label for="<?= $escaper->escapeHtml($viewModel->getFieldIdFromCode($code)) ?>" class="<?= /* @noEscape */ $css('pr-2 font-bold cursor-pointer', 'amount-label') ?>">
                <?= /* @noEscape */ $priceFormatter->format($shippingMethod->getAmount()) ?>
            </label>

            <label for="<?= $escaper->escapeHtml($viewModel->getFieldIdFromCode($code)) ?>"
                   class="<?= /* @noEscape */ $css('cursor-pointer pr-2 ', 'method-label') ?>"><?= $escaper->escapeHtml($shippingMethod->getMethodTitle()) ?></label>

            <label for="<?= $escaper->escapeHtml($viewModel->getFieldIdFromCode($code)) ?>" class="<?= /* @noEscape */ $css('cursor-pointer pr-2 ', 'carrier-label') ?>">
                <?= $escaper->escapeHtml($shippingMethod->getCarrierTitle()) ?>

                <?php if (false === $shippingMethod->getAvailable()) : ?>
                    <?php if ($shippingMethod->getErrorMessage()): ?>
                        (<?= $escaper->escapeHtml($shippingMethod->getErrorMessage()) ?>)
                    <?php else: ?>
                        (Not available)
                    <?php endif; ?>
                <?php endif; ?>
            </label>
        </div>

        <?php if ($isCurrent || $showHidden) : ?>
            <div class="<?= /* @noEscape */ $css('my-4', 'other') ?> <?php if (!$isCurrent) : ?>hidden<?php endif ?>">
                <?= /* @noEscape */ $blockRenderer->html(
                    $block,
                    'loki-checkout.shipping.shipping-methods.'.$code.'.form',
                    ['method' => $code]
                ) ?>

                <?= /* @noEscape */ $blockRenderer->html(
                    $block,
                    'loki-checkout.shipping.shipping-methods.'.$code.'.additional',
                    ['method' => $code]
                )
                ?>
            </div>
        <?php endif; ?>
    </div>
</li>
