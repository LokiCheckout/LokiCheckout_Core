<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Factory\ViewModelFactory;
use LokiCheckout\Core\ViewModel\ShipmentMethodIcon;

/** @version 2.2.3 */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var ShipmentMethodIcon $shipmentMethodIcon */
/** @var CssClass $css */
// @doc: Show how to change CSS here

$shipmentMethodCode = $block->getCode();
$shipmentMethodIcon = $viewModelFactory->create(ShipmentMethodIcon::class);
$icon = $shipmentMethodIcon->getIcon($shipmentMethodCode);
if (empty($icon)) {
    return;
}
?>
<div class="<?= $escaper->escapeHtml($css('inline-block mr-4 w-8 drop-shadow-2xl')) ?>">
    <?= /* @noEscape */ $shipmentMethodIcon->getIcon($shipmentMethodCode) ?>
</div>
