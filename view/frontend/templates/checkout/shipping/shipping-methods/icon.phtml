<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Factory\ViewModelFactory;
use LokiCheckout\Core\ViewModel\ShipmentMethodIcon;

/** @version 2.3.27 */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var ShipmentMethodIcon $shipmentMethodIcon */
/** @var CssClass $css */

$shipmentMethodCode = $block->getCode();
$shipmentMethodIcon = $viewModelFactory->create(ShipmentMethodIcon::class);

$size = $block->getSize() ?? 25;
$width = $block->getWidth() ?? $size;
$height = $block->getHeight() ?? $size;
$attributes = [
    'width'  => $width,
    'height' => $height,
    'class' => $block->getCssClass2()
];

$icon = $shipmentMethodIcon->getIcon($shipmentMethodCode, $attributes);
if (empty($icon)) {
    return;
}
?>
<?= /* @noEscape */ $icon ?>
