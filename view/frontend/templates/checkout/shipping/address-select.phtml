<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Magewire\Checkout\Shipping\ShippingAddress;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;
use Yireo\LokiCheckout\Util\Block\CssClass;

/** @var Template $block */
/** @var ShippingAddress $magewire */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */
$showEmptySelectOption = (bool)$block->getShowEmptySelectOption(); // @doc
$emptySelectOptionLabel = (string)$block->getEmptySelectOptionLabel(); // @doc
?>
<div class="<?= $css('') ?>">
    <select
        id="<?= $magewire->getElementId() ?>-field"
        data-type="field"
        aria-invalid="<?= $magewire->hasErrors() ? 'true' : 'false' ?>"
        wire:loading.attr="aria-busy"
        wire:loading.class="disabled"
        wire:model="currentShippingAddress"
        :class="newAddress ? 'disabled:opacity-75' : ''"
        :disabled="newAddress"
        class="<?= $css('form-input block w-full', 'select') ?>">
        <?php if ($showEmptySelectOption): ?>
        <option value="0"><?= $emptySelectOptionLabel ?></option>
        <?php endif; ?>
        <?php foreach ($magewire->shippingAddresses as $shippingAddressId => $shippingAddresLabel): ?>
            <option
                value="<?= $shippingAddressId ?>"
                <?= (int)$shippingAddressId === (int)$magewire->currentShippingAddress ? 'selected' : '' ?>
            >
                <?= $shippingAddresLabel ?>
            </option>
        <?php endforeach; ?>
    </select>

    <button
        class="<?= $css('btn btn-primary my-4', 'button') ?>"
        x-text="buttonLabel"
        type="button"
        @click="toggleNewAddress"
        wire:loading.attr="disabled">
        <?= $magewire->getButtonLabelNewAddress() ?>
    </button>
</div>
