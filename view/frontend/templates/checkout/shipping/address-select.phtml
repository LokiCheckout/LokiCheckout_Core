<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Component\Checkout\Shipping\ShippingAddressSelect;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\Util\Component\AlpineComponentData;
use Yireo\LokiComponents\Factory\ViewModelFactory;

/** @var Template $block */
/** @var ShippingAddressSelect $component */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */
/** @var ViewModelFactory $viewModelFactory */
/** @var AlpineComponentData $alpineComponentData */
$alpineComponentData = $viewModelFactory->create(AlpineComponentData::class);
$showEmptySelectOption = (bool)$block->getShowEmptySelectOption(); // @doc
$emptySelectOptionLabel = (string)$block->getEmptySelectOptionLabel(); // @doc
?>
<div class="<?= $css('') ?>"
     x-data="LokiCheckoutFieldComponent"
     x-title="<?= $alpineComponentData->getName($block) ?>"
     x-init-data='<?= $alpineComponentData->getJson($component) ?>'
>
    <?= $block->getChildHtml('title') ?>

    <select
        id="<?= $component->getDomId() ?>-field"
        data-type="field"
        aria-invalid="<?= $component->isValid() ? 'false' : 'true' ?>"
        x-model="value"
        :class="disabled ? 'disabled:opacity-75' : ''"
        :disabled="disabled"
        <?php if ($component->isDisabled()): ?>
            disabled="disabled"
        <?php endif ?>
        class="<?= $css('form-input block w-full', 'select') ?>"
    >
        <?php if ($showEmptySelectOption): ?>
            <option value="0"><?= $emptySelectOptionLabel ?></option>
        <?php endif; ?>
        <?php foreach ($component->shippingAddresses as $shippingAddressId => $shippingAddresLabel): ?>
            <option
                value="<?= $shippingAddressId ?>"
                <?= (int)$shippingAddressId === (int)$component->getValue() ? 'selected' : '' ?>
            >
                <?= $shippingAddresLabel ?>
            </option>
        <?php endforeach; ?>
    </select>
</div>
