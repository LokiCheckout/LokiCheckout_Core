<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Component\Checkout\Shipping\ShippingAddressSelect\ShippingAddressSelectViewModel;
use Yireo\LokiComponents\Util\Block\BlockRenderer;
use Yireo\LokiComponents\Util\Block\CssClass;
use Yireo\LokiComponents\Factory\ViewModelFactory;

/** @var Template $block */
/** @var ShippingAddressSelectViewModel $viewModel */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */
/** @var ViewModelFactory $viewModelFactory */

$showEmptySelectOption = (bool)$block->getShowEmptySelectOption(); // @doc
$emptySelectOptionLabel = (string)$block->getEmptySelectOptionLabel(); // @doc

?>
<div class="<?= $css('') ?>">
    <label for="<?= $viewModel->getElementId() ?>">
        <?= $block->getChildHtml('title') ?>
    </label>

    <select
        id="<?= $viewModel->getElementId() ?>-field"
        data-type="field"
        aria-invalid="<?= $viewModel->isValid() ? 'false' : 'true' ?>"
        x-model="value"
        @change="submit"
        :class="disabled ? 'disabled:opacity-75' : ''"
        <?php if ($viewModel->isDisabled()): ?>
            disabled="disabled"
        <?php endif ?>
        class="<?= $css('form-input block w-full', 'select') ?>"
    >
        <?php if ($showEmptySelectOption): ?>
            <option value="0"><?= $emptySelectOptionLabel ?></option>
        <?php endif; ?>
        <?php foreach ($viewModel->getAddressLines() as $addressId => $addresLabel): ?>
            <option
                value="<?= $addressId ?>"
                <?= (int)$addressId === (int)$viewModel->getValue() ? 'selected' : '' ?>
            >
                <?= $addresLabel ?>
            </option>
        <?php endforeach; ?>
    </select>
</div>
