<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Magewire\Checkout\ShippingStep\ShippingAddress;
use Yireo\LokiCheckout\ViewModel\BlockRenderer;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var ShippingAddress $magewire */
/** @var \Yireo\LokiCheckout\Util\BlockCssClass $blockCss */
/** @var BlockRenderer $blockRenderer */

$blockRenderer = $viewModelFactory->create(BlockRenderer::class);
?>
<div class="<?= $blockCss('') ?>">
    <?php if (count($magewire->shippingAddresses) > 0): ?>
        <div>
            <?= $blockRenderer->html('loki.checkout.generic.title', ['title' => 'Select your Shipping Address']) ?>

            <select
                wire:loading.attr="aria-busy"
                wire:loading.class="disabled"
                wire:model="currentShippingAddress"
                class="form-input block w-full invalid:border-red-500 valid:border-green-500">
                <?php foreach ($magewire->shippingAddresses as $shippingAddressId => $shippingAddresLabel): ?>
                    <option value="<?= $shippingAddressId ?>"><?= $shippingAddresLabel ?></option>
                <?php endforeach; ?>
            </select>

            <button class="btn m-2 btn-primary" type="button" wire:click="addAddress" wire:loading.attr="disabled">
                <?= __('New Address') ?>
            </button>
        </div>
    <?php endif; ?>

    <?php if ($magewire->newAddress): ?>
        <?= $blockRenderer->html('loki.checkout.generic.title', ['title' => 'New Shipping Address']) ?>

        <div class="grid grid-cols-12 gap-8">
            <?php foreach ($block->getChildNames() as $childName): ?>
                <?php $childBlock = $block->getLayout()->getBlock($childName) ?>
                <?php $colSpan = $childBlock->getData('grid-col-span') ?? 6 ?>
                <div class="col-span-<?= $colSpan ?>">
                    <?= $childBlock->toHtml() ?>
                </div>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>
</div>
