<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Magewire\Checkout\Shipping\ShippingMethods;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;
use Yireo\LokiCheckout\ViewModel\PriceFormatter;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var CssClass $css */
/** @var bool $debug */
/** @var ShippingMethods $magewire */
/** @var BlockRenderer $blockRenderer */
/** @var PriceFormatter $priceFormatter */

$priceFormatter = $viewModelFactory->create(PriceFormatter::class);
$shippingMethods = $magewire->getShippingMethods();
?>
<div class="<?= $css('relative w-full mb-8') ?>" x-data="<?= $magewire->getJsName() ?>">
    <?= $blockRenderer->html('loki-checkout.utils.loader-overlay', $block) ?>
    <?= $blockRenderer->html('loki-checkout.generic.title', $block, ['title' => 'Shipping Methods']) ?>

    <div
        data-type="field"
        x-ref="field"
        <?php if ($magewire->hasErrors()): ?>
            aria-invalid="true" data-invalid="true"
        <?php endif ?>
        class="border border-transparent data-[invalid=true]:border-red-500">
        <?php if (!empty($shippingMethods)): ?>
            <?php foreach ($shippingMethods as $shippingMethod): ?>
                <?php /** @todo: Move this to child-template */ ?>
                <?php $code = $shippingMethod->getCarrierCode().'_'.$shippingMethod->getMethodCode(); ?>
                <label for="shipping-<?= $code ?>">
                    <div class="flex cursor-pointer">
                        <div class="p-4">
                            <input type="radio"
                                   value="<?= $code ?>"
                                   x-model="value"
                                   id="shipping-<?= $code ?>"
                                <?= $magewire->value === $code ? 'checked' : '' ?>>
                        </div>
                        <div class="p-4 w-auto font-bold">
                            <?= $priceFormatter->format($shippingMethod->getAmount()) ?>
                        </div>
                        <div class="p-4 w-auto">
                            <?= $shippingMethod->getMethodTitle() ?>
                        </div>
                        <div class="p-4">
                            <?= $shippingMethod->getCarrierTitle() ?>
                        </div>
                    </div>
                </label>
            <?php endforeach; ?>
        <?php else: ?>
            <?= __('No shipping methods available') ?>
        <?php endif; ?>
    </div>

    <?= $blockRenderer->html('loki-checkout.utils.errors', $block, ['errors' => $magewire->getErrors()]) ?>

    <?= $block->getChildHtml('script') ?>
</div>
