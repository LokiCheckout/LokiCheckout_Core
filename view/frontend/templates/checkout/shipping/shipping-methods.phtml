<?php
declare(strict_types=1);

use Loki\Components\Util\Block\ChildRenderer;
use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use LokiCheckout\Core\Component\Checkout\Shipping\ShippingMethods\ShippingMethodsViewModel;
use Loki\Components\Factory\ViewModelFactory;
use Loki\Components\Util\Block\BlockRenderer;
use LokiCheckout\Core\ViewModel\PriceFormatter;

/** @version 2.1.2 */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var CssClass $css */
/** @var bool $debug */
/** @var ShippingMethodsViewModel $viewModel */
/** @var BlockRenderer $blockRenderer */
/** @var ChildRenderer $childRenderer */
/** @var PriceFormatter $priceFormatter */

$priceFormatter = $viewModelFactory->create(PriceFormatter::class);
$shippingMethods = $viewModel->getShippingMethods();
?>
<div class="<?= $escaper->escapeHtmlAttr($css('relative w-full mb-8')) ?>">
    <?php if ($viewModel->isDisabled()) : ?>
        <?= /* @noEscape */ $blockRenderer->html( $block, 'loki-checkout.utils.disabled-overlay') ?>
    <?php endif; ?>

    <?= /* @noEscape */ $blockRenderer->html( $block, 'loki-field-components.utils.loader-overlay') ?>
    <?= /* @noEscape */ $block->getChildHtml('title') ?>

    <div
        id="shipping-methods"
        data-type="field"
        x-ref="field"
        :aria-invalid="isAriaInvalid"
        :data-valid="isValid"
        class="<?= $escaper->escapeHtmlAttr($css('border border-transparent', 'container')) ?>">
        <?= /* @noEscape */ $block->getChildHtml('before-methods') ?>
        <?php if (!empty($shippingMethods)): ?>
            <ul>
                <?php foreach ($shippingMethods as $shippingMethod): ?>
                    <?php $code = $shippingMethod->getCarrierCode().'_'.$shippingMethod->getMethodCode(); ?>
                    <?= /* @noEscape */ $blockRenderer->html(
                        $block,
                        'loki-checkout.shipping.methods.item',
                        [
                            'method' => $shippingMethod,
                            'code' => $code,
                        ]
                    ) ?>
                <?php endforeach; ?>
            </ul>
        <?php else: ?>
            <div class="p-4">
                <?= $escaper->escapeHtml(__('No shipping methods available')) ?>
            </div>
        <?php endif; ?>
        <?= /* @noEscape */ $block->getChildHtml('after-methods') ?>
    </div>

    <?= /* @noEscape */ $blockRenderer->html( $block, 'loki-components.utils.local-messages') ?>
    <?= /* @noEscape */ $block->getChildHtml('script') ?>
</div>
