<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Magewire\Checkout\Shipping\ShippingMethods;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;
use Yireo\LokiCheckout\ViewModel\PriceFormatter;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var CssClass $css */
/** @var bool $debug */
/** @var ShippingMethods $magewire */
/** @var BlockRenderer $blockRenderer */
/** @var PriceFormatter $priceFormatter */

$priceFormatter = $viewModelFactory->create(PriceFormatter::class);
$shippingMethods = $magewire->getShippingMethods();
?>
<div class="<?= $css('relative w-full mb-8') ?>" x-data="<?= $magewire->getJsName() ?>">
    <?= $blockRenderer->getBlockHtml('loki-checkout.utils.loader-overlay', $block) ?>
    <?= $blockRenderer->getBlockHtml('loki-checkout.generic.title', $block, ['title' => 'Shipping Methods']) ?>
    <form
        data-type="field"
        x-ref="field"
        aria-invalid="<?= $magewire->valid ? 'false' : 'true' ?>"
        class="<?= $css('border border-transparent', 'container') ?>">
        <?php if (!empty($shippingMethods)): ?>
            <ul>
                <?php foreach ($shippingMethods as $shippingMethod): ?>
                    <?php $code = $shippingMethod->getCarrierCode().'_'.$shippingMethod->getMethodCode(); ?>
                    <?= $blockRenderer->getBlockHtml(
                        'loki-checkout.shipping.shipping-methods.item',
                        $block,
                        [
                            'method' => $shippingMethod,
                            'code' => $code,
                        ]
                    ) ?>
                <?php endforeach; ?>
            </ul>
        <?php else: ?>
            <?= __('No shipping methods available') ?>
        <?php endif; ?>
    </form>

    <?= $blockRenderer->getBlockHtml('loki-checkout.utils.errors', $block, ['errors' => $magewire->getErrors()]) ?>
    <?= $block->getChildHtml('script') ?>
</div>
