<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Magewire\Checkout\Shipping\ShippingAddress;

/** @var Template $block */
/** @var ShippingAddress $component */
$component = $block->getComponent();
$newAddress = (bool)$component->newAddress;
$magewireId = (string)$component->id;
$buttonLabelNewAddress = __('New Address');
$buttonLabelSelectAddress = __('Select Address');
?>
<script>
    LokiCheckoutAlpineCall(() => {
        Alpine.data('<?= $component->getJsName() ?>', () => ({
            newAddress: <?= $newAddress ? 'true' : 'false' ?>,
            buttonLabel: '<?= $newAddress ? $buttonLabelSelectAddress : $buttonLabelNewAddress ?>',
            init() {
                this.$watch('newAddress', (newAddress) => {
                    if (newAddress === true) {
                        Magewire.find('<?= $magewireId ?>').cleanCustomerAddress();
                        this.buttonLabel = '<?= $buttonLabelSelectAddress ?>';
                    } else {
                        this.buttonLabel = '<?= $buttonLabelNewAddress ?>';
                    }
                });
            },
            toggleNewAddress() {
                this.newAddress = !this.newAddress;
                Magewire.find('<?= $magewireId ?>').setNewAddress(this.newAddress);
            }
        }));
    });
</script>
