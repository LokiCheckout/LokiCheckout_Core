<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Magewire\Checkout\Shipping\ShippingAddress;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;
use Yireo\LokiCheckout\Util\Block\SortedChildBlocks;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var ShippingAddress $magewire */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */
/** @var SortedChildBlocks $sortedChildBlocks */
$sortedChildBlocks = $viewModelFactory->create(SortedChildBlocks::class);
$buttonLabelNewAddress = __('New Address');
$buttonLabelSelectAddress = __('Select Address');
?>
<div class="<?= $css('mb-8') ?>" x-data="<?= $block->getComponentName() ?>">
    <?php if (count($magewire->shippingAddresses) > 0): ?>
        <?= $block->getChildHtml('address-select') ?>
        <button
            class="<?= $css('btn btn-primary my-4', 'button') ?>"
            x-text="buttonLabel"
            type="button"
            @click="toggleNewAddress"
            wire:loading.attr="disabled">
            <?= $buttonLabelNewAddress ?>
        </button>
    <?php endif; ?>

    <?php if ($magewire->newAddress): ?>
    <div>
        <?= $blockRenderer->getBlockHtml('loki-checkout.generic.title', $block, ['title' => 'Enter a New Address']) ?>
        <?= $block->getChildHtml('address-form') ?>
    </div>
    <?php endif; ?>
</div>
