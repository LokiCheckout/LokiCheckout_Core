<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Magewire\Checkout\Shipping\ShippingAddress;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var ShippingAddress $magewire */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */
?>
<div class="<?= $css('mb-8') ?>" x-data="LokiCheckoutShippingAddress" data-loki-component='<?= $magewire->getComponentDataAsJson() ?>'>
    <?php if (count($magewire->shippingAddresses) > 0): ?>
        <?= $block->getChildHtml('address-select') ?>

        <button
            class="<?= $css('btn btn-primary my-4', 'button') ?>"
            x-text="buttonLabel"
            type="button"
            @click="toggleNewAddress"
            wire:loading.attr="disabled">
            <?= $magewire->getButtonLabelNewAddress() ?>
        </button>
    <?php endif; ?>

    <div x-cloak x-show="newAddress">
        <?= $blockRenderer->getBlockHtml('loki-checkout.generic.title', $block, [
            'title' => 'Enter a New Address'
        ]) ?>

        <?= $block->getChildHtml('address-form') ?>
    </div>
</div>
