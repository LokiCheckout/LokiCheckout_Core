<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Magewire\Checkout\ShippingStep\ShippingMethods;
use Yireo\LokiCheckout\ViewModel\BlockRenderer;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var string $blockClass */
/** @var bool $debug */
/** @var ShippingMethods $magewire */
/** @var BlockRenderer $blockRenderer */
$blockRenderer = $viewModelFactory->create(BlockRenderer::class);
$shippingMethods = $magewire->shippingMethods;
?>
<div class="<?= $blockClass ?>">
    <?= $blockRenderer->html('loki.checkout.generic.title', ['title' => 'Shipping Methods']) ?>

    <ul role="list">
        <?php foreach ($shippingMethods as $shippingCode => $shippingMethod): ?>
            <li class="my-4 py-2">
                <input type="radio" value="<?= $shippingCode ?>" wire:model="value" id="shipping-<?= $shippingCode ?>">
                <label for="shipping-<?= $shippingCode ?>" class="ml-4">
                    <?= $shippingMethod ?>
                </label>
            </li>
        <?php endforeach; ?>
    </ul>
</div>
