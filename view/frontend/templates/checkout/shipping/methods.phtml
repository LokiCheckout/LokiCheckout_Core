<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\MagewireCheckout\Magewire\Checkout\ShippingStep\ShippingMethods;

/** @var Template $block */
/** @var ShippingMethods $magewire */
$shippingMethods = $magewire->shippingMethods;
?>
<div>
    <h3 class="text-2xl border-b border-gray-400 mb-4"><?= __('Shipping Methods') ?></h3>

    <ul role="list">
        <?php foreach ($shippingMethods as $shippingCode => $shippingMethod): ?>
        <li class="my-4 py-2">
            <input type="radio" value="<?= $shippingCode ?>" wire:model="value" id="shipping-<?= $shippingCode ?>">
            <label for="shipping-<?= $shippingCode ?>" class="ml-4">
                <?= $shippingMethod ?>
            </label>
        </li>
        <?php endforeach; ?>
    </ul>
</div>
