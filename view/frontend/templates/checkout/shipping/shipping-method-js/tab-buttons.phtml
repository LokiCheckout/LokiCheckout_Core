<?php
declare(strict_types=1);

/** @version 2.1.24 */

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Escaper $escaper */
/** @var Template $block */
/** @var CssClass $css */

$buttons = (array)$block->getButtons();

/*
 * @todo this should be a Radio Group for better A11Y. Visually it still can be a styled as a button
 */
?>
<div
    role="tablist"
    class="<?= $escaper->escapeHtml($css('tab-buttons grid grid-cols-2 gap-4 mb-4')) ?>"
>
    <?php foreach ($buttons as $buttonId => $buttonLabel): ?>
        <button
            role="tab"
            @click="toggleTabs"
            data-tab-id="<?= $escaper->escapeHtml($buttonId) ?>"
            class="<?= $escaper->escapeHtml($css('tab-inactive btn p-4', 'button')) ?>"
        >
            <?= $escaper->escapeHtml(__($buttonLabel)); ?>
        </button>
    <?php endforeach; ?>
</div>

