<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Location\Location;
use Loki\Components\Location\Address\BusinessHours;

/** @version 2.0.20 */
/** @var CssClass $css */
/** @var Template $block */
/** @var Escaper $escaper */
/** @var Location $location */

$location = $block->getLocation();
$businessHours = $location->getBusinessHours();
if (false === $businessHours instanceof BusinessHours) {
    return;
}
?>
<details <?= /* @noEscape */ $css('') ?>>
    <summary class="<?= /* @noEscape */ $css('', 'summary') ?>">
        <?= $escaper->escapeHtml(__('Show opening hours')) ?>
    </summary>
    <div class="<?= /* @noEscape */ $css('grid grid-cols-2 gap-2 mb-4', 'content') ?>">
        <?php foreach ($businessHours->get() as $businessHourSegment): ?>
            <div><?= $escaper->escapeHtml(__($businessHourSegment->getDay())) ?></div>
            <div>
                <?php if ($businessHourSegment->getOpeningHour()): ?>
                <?= $escaper->escapeHtml($businessHourSegment->getOpeningHour()) ?> - <?= $escaper->escapeHtml($businessHourSegment->getClosingHour()) ?>
                <?php endif; ?>
                <?php if ($businessHourSegment->getComment()): ?>
                <?= $escaper->escapeHtml(__($businessHourSegment->getComment())) ?>
                <?php endif; ?>
            </div>
        <?php endforeach; ?>
    </div>
</details>
