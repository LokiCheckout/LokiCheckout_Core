<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @version 2.1.23 */
/** @var CssClass $css */
/** @var Template $block */
/** @var Escaper $escaper */

?>
<details x-show="location.openingHours">
    <summary><?= $escaper->escapeHtml(__('Show opening hours')) ?></summary>
    <div class="py-8">
        <template x-for="(hours, day) in location.openingHours" :key="day">
            <div class="grid grid-cols-2 gap-2">
                <div x-html="day" class="day capitalize"></div>
                <template x-for="hour in hours">
                    <div>
                        <span x-html="hour"></span>
                    </div>
                </template>
            </div>
        </template>
    </div>
</details>
