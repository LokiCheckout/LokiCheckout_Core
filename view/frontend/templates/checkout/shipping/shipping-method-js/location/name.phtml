<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Location\Location;

/** @version 2.1.24 */
/** @var CssClass $css */
/** @var Template $block */
/** @var Escaper $escaper */
/** @var Location $location */

$location = $block->getLocation();
?>
<div class="<?= $escaper->escapeHtml($css('mb-4')) ?>">
    <div class="float-right text-sm">
        <?= $escaper->escapeHtml($location->getDistance()) ?>m
    </div>
    <span class="uppercase font-bold"><?= $escaper->escapeHtml($location->getLabel()) ?></span>
</div>
