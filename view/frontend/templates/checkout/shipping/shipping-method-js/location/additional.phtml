<?php
declare(strict_types=1);

/** @version 2.0.0 */

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Location\Location;
use Loki\Components\Util\Block\CssClass;

/** @var CssClass $css */
/** @var Template $block */
/** @var Escaper $escaper */
/** @var Location $location */

$location = $block->getLocation();
$address = $location->getAddress();
$comment = $address->getComment();

$additionalContent = '';
if ($comment) {
    $additionalContent = '<p>'.$address->getComment().'</p>';
}

if (empty($additionalContent)) {
    return;
}
?>
<details>
    <summary class="<?= /* @noEscape */ $css('', 'summary') ?>">
        <?= $escaper->escapeHtml(__('Additional information')) ?>
    </summary>
    <div class="<?= /* @noEscape */ $css('my-4 text-sm', 'content') ?>">
        <?= $escaper->escapeHtml($additionalContent) ?>
    </div>
</details>
