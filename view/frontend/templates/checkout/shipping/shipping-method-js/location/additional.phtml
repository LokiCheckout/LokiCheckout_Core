<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Location\Location;

/** @version 2.3.5 */
/** @var CssClass $css */
/** @var Template $block */
/** @var Escaper $escaper */
/** @var Location $location */

$location = $block->getLocation();
$address = $location->getAddress();
$comment = $address->getComment();

$additionalContent = '';
if ($comment) {
    $additionalContent = '<p>'.$address->getComment().'</p>';
}

if (empty($additionalContent)) {
    return;
}
?>
<details>
    <summary class="<?= $escaper->escapeHtml($css('', 'summary')) ?>">
        <?= $escaper->escapeHtml(__('Additional information')) ?>
    </summary>
    <div class="<?= $escaper->escapeHtml($css('my-4 text-sm', 'content')) ?>">
        <?= $escaper->escapeHtml($additionalContent) ?>
    </div>
</details>
