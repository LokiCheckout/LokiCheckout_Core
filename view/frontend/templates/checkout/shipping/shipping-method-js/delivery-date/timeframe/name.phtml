<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Shipment\DeliveryDate\Timeframe;
use Yireo\LokiCheckout\ViewModel\PriceFormatter;
use Yireo\LokiComponents\Factory\ViewModelFactory;
use Yireo\LokiComponents\Util\Block\CssClass;

/** @var Escaper $escaper */
/** @var Template $block */
/** @var CssClass $css */
/** @var Timeframe $timeframe */
/** @var ViewModelFactory $viewModelFactory */
/** @var PriceFormatter $priceFormatter */

$priceFormatter = $viewModelFactory->create(PriceFormatter::class);
$timeframe = $block->getTimeframe();
?>
<div class="<?= /* @noEscape */ $css('') ?>">
    <div class="float-right text-sm">
        <?= $escaper->escapeHtml($timeframe->getLabel()) ?>
        <?php if ($timeframe->getPrice() > 0) : ?>
            (+ <?= $escaper->escapeHtml($priceFormatter->format($timeframe->getPrice())) ?>)
        <?php endif; ?>
    </div>

    <div>
        <?= $escaper->escapeHtml($timeframe->getFromTime()) ?> - <?= $escaper->escapeHtml($timeframe->getToTime()) ?>
    </div>
</div>
