<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Shipment\DeliveryDate;
use Yireo\LokiComponents\Util\Block\ChildRenderer;
use Yireo\LokiComponents\Util\Block\CssClass;

/**
 * @var Template $block
 * @var ChildRenderer $childRenderer
 * @var CssClass $css
 * @var DeliveryDate[] $deliveryDates
 */
$deliveryDates = $block->getDeliveryDates();
?>
<div class="<?= $css('py-4') ?>">
    <?php if (empty($deliveryDates)): ?>
        <div class="<?= $css('', 'empty') ?>"><?= __('No delivery dates found') ?></div>
    <?php else: ?>
        <?php foreach ($deliveryDates as $deliveryDate): ?>
            <?= $childRenderer->html($block, 'delivery-date', [
                'delivery_date' => $deliveryDate,
            ]) ?>
        <?php endforeach; ?>
    <?php endif; ?>
</div>
