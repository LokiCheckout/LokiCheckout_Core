<?php
declare(strict_types=1);

use Loki\Components\Factory\ViewModelFactory;
use Loki\Components\Util\Block\BlockRenderer;
use Loki\CssUtils\Util\CssClass;
use Loki\Components\Util\Block\ImageRenderer;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Util\Block\ChildRenderer;

/** @version 2.1.28 */
/** @var Template $block */
/** @var CssClass $css */
/** @var Escaper $escaper */
/** @var ChildRenderer $childRenderer */
/** @var BlockRenderer $blockRenderer */
/** @var ImageRenderer $imageRenderer */
/** @var ViewModelFactory $viewModelFactory */

$tabId = $block->getTabId();
?>
<div data-tab-content="<?= $escaper->escapeHtml($tabId) ?>" class="<?= $escaper->escapeHtml($css('hidden', 'timeframes-container')) ?>">
    <div x-cloak x-show="showLoader" :aria-busy="showLoader"
         class="<?= $escaper->escapeHtml($css('absolute top-0 left-0 right-0 bottom-0', 'loader')) ?>">
        <?= /* @noEscape */ $blockRenderer->html( $block, 'loki-field-components.utils.loader-overlay') ?>
    </div>

    <div>
        <template x-if="isInvalidShippingAddress">
            <div class="<?= $escaper->escapeHtml($css('', 'invalid-address')) ?>"><?= $escaper->escapeHtml(__('Please enter your address details first')) ?></div>
        </template>

        <div x-cloak x-show="showLoadingDeliveryDates" class="<?= $escaper->escapeHtml($css('', 'loading')) ?>">
            <?= $escaper->escapeHtml(__('Loading delivery options')) ?>
        </div>

        <div x-cloak x-show="showNoDeliveryDates" class="<?= $escaper->escapeHtml($css('', 'empty')) ?>">
            <?= $escaper->escapeHtml(__('No delivery options found')) ?>
        </div>

        <template x-for="deliveryDate in getVisibleDeliveryDates" :key="deliveryDate.date">
            <?= /* @noEscape */ $blockRenderer->html( $block, 'loki-checkout.shipping.js.delivery-date') ?>
        </template>

        <?= /* @noEscape */ $block->getChildHtml('expand-button') ?>
        <?= /* @noEscape */ $block->getChildHtml('expand-all-button') ?>
    </div>
</div>
