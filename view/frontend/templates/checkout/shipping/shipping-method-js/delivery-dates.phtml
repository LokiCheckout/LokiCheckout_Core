<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use LokiCheckout\Core\Shipment\DeliveryDate;
use Loki\Components\Util\Block\ChildRenderer;

/** @version 2.0.17 */
/** @var Template $block */
/** @var CssClass $css */
/** @var Escaper $escaper */
/** @var ChildRenderer $childRenderer */
/** @var DeliveryDate[] $deliveryDates */

$deliveryDates = $block->getDeliveryDates();
?>
<div class="<?= /* @noEscape */ $css('py-4') ?>">
    <?php if (empty($deliveryDates)): ?>
        <div class="<?= /* @noEscape */ $css('', 'empty') ?>"><?= $escaper->escapeHtml(__('No delivery dates found')) ?></div>
    <?php else: ?>
        <?php foreach ($deliveryDates as $deliveryDate): ?>
            <?= /* @noEscape */ $childRenderer->html($block, 'delivery-date', [
                'delivery_date' => $deliveryDate,
            ]) ?>
        <?php endforeach; ?>
    <?php endif; ?>
</div>
