<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Util\Block\ChildRenderer;
use Loki\Field\ViewModel\ImageOutput;

/** @version 2.0.21 */
/** @var Template $block */
/** @var CssClass $css */
/** @var Escaper $escaper */
/** @var ChildRenderer $childRenderer */
/** @var ImageOutput $imageOutput */
?>
<div>
    <template x-if="hasNoLocations">
        <div class="<?= /* @noEscape */ $css('p-2', 'empty') ?>"><?= $escaper->escapeHtml(__('No locations found')) ?></div>
    </template>

    <template x-for="location in locations">
        <div class="flex mb-8 p-4 hover:bg-black/5">
            <label x-bind:for="location.id" class="cursor-pointer flex-1">
            </label>
        </div>
    </template>

    <div @click="expandLocations">
        <div class="inline-block w-4"><?= /** @noEscape */ $imageOutput->get('LokiCheckout_Core::images/angle-down.svg') ?></div>
        <span class="text-sm"><?= $escaper->escapeHtml(__('Show more locations')) ?></span>
    </div>
