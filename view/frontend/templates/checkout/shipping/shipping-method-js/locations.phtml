<?php
declare(strict_types=1);

use Loki\Components\Factory\ViewModelFactory;
use Loki\Components\Util\Block\BlockRenderer;
use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Util\Block\ChildRenderer;
use Loki\Components\Util\Block\ImageRenderer;

/** @version 2.1.6 */
/** @var Template $block */
/** @var CssClass $css */
/** @var Escaper $escaper */
/** @var ChildRenderer $childRenderer */
/** @var BlockRenderer $blockRenderer */
/** @var ViewModelFactory $viewModelFactory */
/** @var ImageRenderer $imageRenderer */


$tabId = $block->getTabId();
?>
<div data-tab-content="<?= $escaper->escapeHtml($tabId) ?>" class="<?= $escaper->escapeHtmlAttr($css('hidden relative', 'locations-container')) ?>">
    <div x-cloak x-show="showLoader" :aria-busy="showLoader"
         class="<?= $escaper->escapeHtmlAttr($css('absolute top-0 left-0 right-0 bottom-0', 'loader')) ?>">
        <?= /* @noEscape */ $blockRenderer->html( $block, 'loki-field-components.utils.loader-overlay') ?>
    </div>

    <div>
        <template x-if="hasNoLocations">
            <div class="<?= $escaper->escapeHtmlAttr($css('p-2', 'empty')) ?>"><?= $escaper->escapeHtml(__('No locations found')) ?></div>
        </template>

        <template x-for="location in getVisibleLocations" :key="location.id">
            <?= /* @noEscape */ $blockRenderer->html( $block, 'loki-checkout.shipping.js.location') ?>
        </template>

        <button @click.prevent="expandLocations" x-cloak x-show="showExpandLocations" class="cursor-pointer">
            <div class="inline-block">
                <?= /* @noEscape */ $imageRenderer->icon($block, 'angle-down') ?>
            </div>
            <span class="text-sm"><?= $escaper->escapeHtml(__('Show more options')) ?></span>
        </button>

        <button @click.prevent="expandAllLocations" x-cloak x-show="showExpandLocations" class="cursor-pointer">
            <div class="inline-block">
                <?= /* @noEscape */ $imageRenderer->icon($block, 'angle-down') ?>
            </div>
            <span class="text-sm"><?= $escaper->escapeHtml(__('Show all options')) ?></span>
        </button>
    </div>
</div>
