<?php
declare(strict_types=1);

use Loki\Components\Factory\ViewModelFactory;
use Loki\Components\Util\Block\BlockRenderer;
use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Util\Block\ChildRenderer;
use Loki\Field\ViewModel\ImageOutput;

/** @version 2.0.24 */
/** @var Template $block */
/** @var CssClass $css */
/** @var Escaper $escaper */
/** @var ChildRenderer $childRenderer */
/** @var BlockRenderer $blockRenderer */
/** @var ViewModelFactory $viewModelFactory */
/** @var ImageOutput $imageOutput */

$imageOutput = $viewModelFactory->create(ImageOutput::class);
$tabId = $block->getTabId();
?>
<div data-tab-content="<?= /* @noEscape */ $tabId ?>" class="<?= /* @noEscape */ $css('hidden relative', 'locations-container') ?>">
    <div x-show="showLoader" :aria-busy="showLoader"
         class="<?= /* @noEscape */ $css('absolute top-0 left-0 right-0 bottom-0', 'loader') ?>">
        <?= /* @noEscape */ $blockRenderer->html($block, 'loki-field-components.utils.loader-overlay') ?>
    </div>

    <div>
        <template x-if="hasNoLocations">
            <div class="<?= /* @noEscape */ $css('p-2', 'empty') ?>"><?= $escaper->escapeHtml(__('No locations found')) ?></div>
        </template>

        <template x-for="location in getVisibleLocations" :key="location.id">
            <?= /* @noEscape */ $blockRenderer->html($block, 'loki-checkout.shipping.js.location') ?>
        </template>

        <div @click="expandLocations" x-cloak x-show="showExpandLocations">
            <div class="inline-block w-4">
                <?= /** @noEscape */ $imageOutput->get('LokiCheckout_Core::images/angle-down.svg') ?>
            </div>
            <span class="text-sm"><?= $escaper->escapeHtml(__('Show more options')) ?></span>
        </div>
    </div>
</div>
