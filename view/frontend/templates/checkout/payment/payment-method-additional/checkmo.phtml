<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Yireo\LokiComponents\Factory\ViewModelFactory;
use Yireo\LokiComponents\Util\Block\CssClass;
use Yireo\LokiCheckout\ViewModel\PaymentMethod\CheckMoneyOrder;

/** @var Escaper $escaper */
/** @var Template $block */
/** @var CssClass $css */
/** @var ViewModelFactory $viewModelFactory */
/** @var CheckMoneyOrder $configuration */
$configuration = $viewModelFactory->create(CheckMoneyOrder::class);
?>
<div class="<?= /* @noEscape */ $css('') ?>">
    <?php if ($configuration->getPayableTo()): ?>
        <p><?= $escaper->escapeHtml(__('Make Check Payable to')) ?>: <?= $escaper->escapeHtml($configuration->getPayableTo()) ?></p>
    <?php endif; ?>
    <?php if ($configuration->getMailingAddress()): ?>
        <?= $escaper->escapeHtml(__('Send Check to')) ?>:
        <address><?= $escaper->escapeHtml($configuration->getMailingAddress()) ?></address>
    <?php endif; ?>
</div>
