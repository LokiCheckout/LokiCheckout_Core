<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use LokiCheckout\Core\ViewModel\ApplicationMode;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Magento\Payment\Api\Data\PaymentMethodInterface;
use LokiCheckout\Core\Component\Checkout\Billing\PaymentMethods\PaymentMethodsViewModel;
use Loki\Components\Factory\ViewModelFactory;
use Loki\Components\Util\Block\BlockRenderer;
use Loki\Components\Util\Block\TemplateRenderer;

/** @version 2.3.9 */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var BlockRenderer $blockRenderer */
/** @var CssClass $css */
/** @var PaymentMethodInterface $paymentMethod */
/** @var TemplateRenderer $templateRenderer */
/** @var PaymentMethodsViewModel $viewModel */
/** @var ApplicationMode $applicationMode */

// @todo: Split up in smaller templates

$templateRenderer = $viewModelFactory->create(TemplateRenderer::class);
$applicationMode = $viewModelFactory->create(ApplicationMode::class);
$viewModel = $block->getViewModel();
$paymentMethod = $block->getMethod();
$code = $paymentMethod->getCode();
$isCurrent = $block->getIsCurrent();
$showHidden = (bool)$block->getShowHidden(); // @doc

$blockClasses = [];
$blockClasses[] = $isCurrent ? 'active' : 'inactive';
$blockClasses[] = $viewModel->isDisabled() ? 'disabled' : 'enabled';

$paymentIcon = $templateRenderer->html(
    $block,
    'LokiCheckout_Core::checkout/payment/payment-methods/icon.phtml',
    [
        'alias' => $code.'.icon',
        'code'  => $code,
    ]
);

$inputCss = $css('', 'input');
if ($paymentIcon) {
    $inputCss = $css('', 'input-with-icon'); // @doc: sr-only
}

$htmlAttributes = '';
if ($applicationMode->isDeveloperMode()) {
    $htmlAttributes = 'title="' . $escaper->escapeHtml($code) . '"';
}

?>
<li class="<?= $escaper->escapeHtml($css('cursor-pointer relative my-2 p-3')) ?> <?= $escaper->escapeHtml(implode(' ', $blockClasses)) ?>" <?= /** @noEscape */ $htmlAttributes ?>>
    <label
        data-code="<?= $escaper->escapeHtml($paymentMethod->getCode()) ?>"
        class="<?= $escaper->escapeHtml($css('flex gap-4 md:ga-6 items-center', 'input-container')) ?>"
    >
        <span class="<?= $escaper->escapeHtml($css('shrink-0 flex gap-4', 'input-container')) ?>">
            <input
                type="radio"
                :value="value"
                @change="submitValue"
                name="payment_method"
                value="<?= $escaper->escapeHtml($code) ?>"
            <?php if ($viewModel->getValue() === $code): ?>
                checked
            <?php endif; ?>
                <?= /* @noEscape */ $isCurrent && 'checked' ?>
                <?= /* @noEscape */ $viewModel->isDisabled() && 'disabled="disabled"' ?>
                id="<?= $escaper->escapeHtml($viewModel->getFieldIdFromCode($code)) ?>"
                class="<?= $escaper->escapeHtml($inputCss) ?>"
            >
            <?= /* @noEscape */ $paymentIcon ?>
        </span>

        <span
            class="<?= $escaper->escapeHtml($css('', 'label')) ?>">
            <?= $escaper->escapeHtml($paymentMethod->getTitle()) ?>
        </span>
    </label>

    <?php if ($isCurrent || $showHidden) : ?>
        <div class="<?= $escaper->escapeHtml($css('', 'other')) ?> <?php if (!$isCurrent) : ?>hidden<?php endif ?>">
            <?= /* @noEscape */ $blockRenderer->html(
                $block,
                'loki-checkout.payment.methods.' . $code . '.form',
                [
                    'uniq' => $code.'-form',
                    'method' => $code
                ]
            ) ?>

            <?= /* @noEscape */ $blockRenderer->html(
                $block,
                'loki-checkout.payment.methods.' . $code . '.additional',
                [
                    'uniq' => $code.'-additional',
                    'method' => $code
                ]
            ) ?>

            <?= $escaper->escapeHtml($viewModel->getPaymentInstructions($code)) ?>
        </div>
    <?php endif; ?>
</li>
