<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Magento\Payment\Api\Data\PaymentMethodInterface;
use Yireo\LokiCheckout\Component\Checkout\Billing\PaymentMethods\PaymentMethodsViewModel;
use Yireo\LokiComponents\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;
use Yireo\LokiCheckout\Util\Block\TemplateRenderer;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var BlockRenderer $blockRenderer */
/** @var CssClass $css */
/** @var PaymentMethodInterface $paymentMethod */
/** @var TemplateRenderer $templateRenderer */
/** @var PaymentMethodsViewModel $viewModel */

$templateRenderer = $viewModelFactory->create(TemplateRenderer::class);
$viewModel = $block->getViewModel();
$paymentMethod = $block->getMethod();
$code = $paymentMethod->getCode();
$isCurrent = $block->getIsCurrent();
?>
<li class="<?= $css('cursor-pointer relative my-4 p-4') ?> <?= $isCurrent ? 'active' : 'inactive' ?>">
    <div class="<?= $css('flex', 'method') ?>">
        <input
            type="radio"
            x-model="value"
            @change="submit"
            name="payment_method"
            value="<?= $code ?>"
            <?php if ($isCurrent) : ?>checked<?php endif ?>
            id="payment-<?= $code ?>"
            class="<?= $css('mr-4', 'input') ?>">

        <div>
            <div class="<?= $css('flex', 'method') ?>">
                <?= $templateRenderer->html('checkout/payment/payment-methods/icon.phtml', $block, [
                    'alias' => $code,
                    'code' => $code,
                ]) ?>

                <label for="payment-<?= $code ?>" class=""><?= $paymentMethod->getTitle() ?></label>
            </div>

            <div class="<?= $css('my-4', 'other') ?> <?php if (!$isCurrent) : ?>hidden<?php endif ?>">
                <?= $blockRenderer->html(
                    'loki-checkout.payment.payment-methods.'.$code.'.form',
                    $block,
                    ['method' => $code]
                ) ?>

                <?= $blockRenderer->html(
                    'loki-checkout.payment.payment-methods.'.$code.'.additional',
                    $block,
                    ['method' => $code]
                )
                ?>
            </div>
        </div>
    </div>
</li>
