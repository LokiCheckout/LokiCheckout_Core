<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Magento\Payment\Api\Data\PaymentMethodInterface;
use LokiCheckout\Core\Component\Checkout\Billing\PaymentMethods\PaymentMethodsViewModel;
use Loki\Components\Factory\ViewModelFactory;
use Loki\Components\Util\Block\BlockRenderer;
use Loki\Components\Util\Block\TemplateRenderer;

/** @version 2.1.2 */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var BlockRenderer $blockRenderer */
/** @var CssClass $css */
/** @var PaymentMethodInterface $paymentMethod */
/** @var TemplateRenderer $templateRenderer */
/** @var PaymentMethodsViewModel $viewModel */

// @todo: Split up in smaller templates

$templateRenderer = $viewModelFactory->create(TemplateRenderer::class);
$viewModel = $block->getViewModel();
$paymentMethod = $block->getMethod();
$code = $paymentMethod->getCode();
$isCurrent = $block->getIsCurrent();
$showHidden = (bool)$block->getShowHidden(); // @doc

$blockClasses = [];
$blockClasses[] = $isCurrent ? 'active' : 'inactive';
$blockClasses[] = $viewModel->isDisabled() ? 'disabled' : 'enabled';
?>
<li class="<?= $escaper->escapeHtmlAttr($css('cursor-pointer relative flex gap-4 my-2 p-3')) ?> <?= $escaper->escapeHtml(implode(' ', $blockClasses)) ?>">
    <div class="<?= $escaper->escapeHtmlAttr($css('', 'input-container')) ?>">
        <input
            type="radio"
            :value="value"
            @change="submitValue"
            name="payment_method"
            value="<?= $escaper->escapeHtml($code) ?>"
            <?php if ($viewModel->getValue() === $code): ?>
                checked
            <?php endif; ?>
            <?= /* @noEscape */ $isCurrent && 'checked' ?>
            <?= /* @noEscape */ $viewModel->isDisabled() && 'disabled="disabled"' ?>
            id="<?= $escaper->escapeHtml($viewModel->getFieldIdFromCode($code)) ?>"
            class="<?= $escaper->escapeHtmlAttr($css('mr-4', 'input')) ?>"
        >
    </div>
    <div class="<?= $escaper->escapeHtmlAttr($css('flex-1', 'details-container')) ?>">
        <div class="<?= $escaper->escapeHtmlAttr($css('flex', 'details')) ?>">
            <?= /* @noEscape */ $templateRenderer->html(
                $block,
                'LokiCheckout_Core::checkout/payment/payment-methods/icon.phtml',
                [
                    'alias' => $code,
                    'code' => $code,
                ]
            ) ?>

            <label
                for="<?= $escaper->escapeHtml($viewModel->getFieldIdFromCode($code)) ?>"
                title="<?= $escaper->escapeHtml($paymentMethod->getCode()) ?>"
                class="<?= $escaper->escapeHtmlAttr($css('', 'label')) ?>">
                <?= $escaper->escapeHtml($paymentMethod->getTitle()) ?>
            </label>
        </div>

        <?php if ($isCurrent || $showHidden) : ?>
            <div class="<?= $escaper->escapeHtmlAttr($css('', 'other')) ?> <?php if (!$isCurrent) : ?>hidden<?php endif ?>">
                <?= /* @noEscape */ $blockRenderer->html(
                    $block,
                    'loki-checkout.payment.methods.'.$code.'.form',
                    ['method' => $code]
                ) ?>

                <?= /* @noEscape */ $blockRenderer->html(
                    $block,
                    'loki-checkout.payment.methods.'.$code.'.additional',
                    ['method' => $code]
                ) ?>

                <?= $escaper->escapeHtml($viewModel->getPaymentInstructions($code)) ?>
            </div>
        <?php endif; ?>
    </div>
</li>
