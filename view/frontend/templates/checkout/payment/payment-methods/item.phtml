<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Magento\Payment\Api\Data\PaymentMethodInterface;
use Yireo\LokiCheckout\Component\Checkout\Billing\PaymentMethods\PaymentMethodsViewModel;
use Yireo\LokiComponents\Factory\ViewModelFactory;
use Yireo\LokiComponents\Util\Block\CssClass;
use Yireo\LokiComponents\Util\Block\BlockRenderer;
use Yireo\LokiComponents\Util\Block\TemplateRenderer;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var BlockRenderer $blockRenderer */
/** @var CssClass $css */
/** @var PaymentMethodInterface $paymentMethod */
/** @var TemplateRenderer $templateRenderer */
/** @var PaymentMethodsViewModel $viewModel */

// @todo: Split up in smaller templates

$templateRenderer = $viewModelFactory->create(TemplateRenderer::class);
$viewModel = $block->getViewModel();
$paymentMethod = $block->getMethod();
$code = $paymentMethod->getCode();
$isCurrent = $block->getIsCurrent();
$showHidden = (bool)$block->getShowHidden(); // @doc

$blockClasses = [];
$blockClasses[] = $isCurrent ? 'active' : 'inactive';
$blockClasses[] = $viewModel->isDisabled() ? 'disabled' : 'enabled';
?>
<li class="<?= /* @noEscape */ $css('cursor-pointer relative flex gap-4 my-2 p-3') ?> <?= $escaper->escapeHtml(implode(' ', $blockClasses)) ?>">
    <div class="<?= /* @noEscape */ $css('', 'input-container') ?>">
        <input
            type="radio"
            :value="value"
            @change="submitValue"
            name="payment_method"
            value="<?= $escaper->escapeHtml($code) ?>"
            <?php if ($viewModel->getValue() === $code): ?>
                checked
            <?php endif; ?>
            <?= $isCurrent && 'checked' ?>
            <?= $viewModel->isDisabled() && 'disabled="disabled"' ?>
            id="<?= $escaper->escapeHtml($viewModel->getFieldIdFromCode($code)) ?>"
            class="<?= /* @noEscape */ $css('mr-4', 'input') ?>"
        >
    </div>
    <div class="<?= /* @noEscape */ $css('flex-1', 'details-container') ?>">
        <div class="<?= /* @noEscape */ $css('flex', 'details') ?>">
            <?= /* @noEscape */ $templateRenderer->html(
                $block,
                'Yireo_LokiCheckout::checkout/payment/payment-methods/icon.phtml',
                [
                    'alias' => $code,
                    'code' => $code,
                ]
            ) ?>

            <label
                for="<?= $escaper->escapeHtml($viewModel->getFieldIdFromCode($code)) ?>"
                title="<?= $escaper->escapeHtml($paymentMethod->getCode()) ?>"
                class="<?= /* @noEscape */
            $css('', 'label') ?>">
                <?= $escaper->escapeHtml($paymentMethod->getTitle()) ?>
            </label>
        </div>

        <?php if ($isCurrent || $showHidden) : ?>
            <div class="<?= /* @noEscape */
            $css('', 'other') ?> <?php if (!$isCurrent) : ?>hidden<?php endif ?>">
                <?= /* @noEscape */
            $blockRenderer->html(
                    $block,
                    'loki-checkout.payment.payment-methods.'.$code.'.form',
                    ['method' => $code]
                ) ?>

                <?= /* @noEscape */
                $blockRenderer->html(
                    $block,
                    'loki-checkout.payment.payment-methods.'.$code.'.additional',
                    ['method' => $code]
                ) ?>

                <?= $escaper->escapeHtml($viewModel->getPaymentInstructions($code)) ?>
            </div>
        <?php endif; ?>
    </div>
</li>
