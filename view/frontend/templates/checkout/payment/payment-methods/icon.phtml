<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Factory\ViewModelFactory;
use LokiCheckout\Core\ViewModel\PaymentMethodIcon;

/** @version 2.3.12 */
/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var PaymentMethodIcon $paymentMethodIcon */
/** @var CssClass $css */
/** @var Escaper $escaper */
// @doc: Show how to change CSS here

$paymentMethodCode = $block->getCode();
$paymentMethodIcon = $viewModelFactory->create(PaymentMethodIcon::class);

$size = $block->getSize() ?? 25;
$width = $block->getWidth() ?? $size;
$height = $block->getHeight() ?? $size;
$attributes = [
    'width'  => $width,
    'height' => $height,
];

$icon = $paymentMethodIcon->getIcon($paymentMethodCode, $attributes);
if (empty($icon)) {
    return;
}
?>
<?= /* @noEscape */ $icon ?>
