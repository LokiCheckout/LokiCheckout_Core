<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use LokiCheckout\Core\Component\Checkout\Billing\PaymentMethods\PaymentMethodsViewModel;
use Loki\Components\Factory\ViewModelFactory;
use Loki\Components\Util\Block\BlockRenderer;

/** @version 2.1.5 */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var PaymentMethodsViewModel $viewModel */
/** @var BlockRenderer $blockRenderer */
/** @var CssClass $css */

$paymentMethods = $viewModel->getPaymentMethods();
?>
<div class="<?= $escaper->escapeHtmlAttr($css('relative')) ?>">
    <?= /* @noEscape */ $blockRenderer->html( $block, 'loki-field-components.utils.loader-overlay') ?>
    <?= /* @noEscape */ $block->getChildHtml('title') ?>

    <form
        data-type="field"
        x-ref="field"
        :aria-invalid="isAriaInvalid"
        :data-valid="isValid"
        class="<?= $escaper->escapeHtmlAttr($css('border border-transparent', 'container')) ?>">
        <?php if (!empty($paymentMethods)): ?>
	    <ul class="<?= $escaper->escapeHtmlAttr($css('', 'list')) ?>">
                <?php foreach ($paymentMethods as $paymentMethod): ?>
                    <?= /* @noEscape */ $blockRenderer->html(
                        $block,
                        'loki-checkout.payment.methods.item',
                        [
                            'method' => $paymentMethod,
                            'is_current' => $paymentMethod->getCode() === $viewModel->getValue(),
                        ]
                    ) ?>
                <?php endforeach; ?>
            </ul>
        <?php else: ?>
            <div class="<?= $escaper->escapeHtmlAttr($css('p-4', 'no-items')) ?>">
                <?= $escaper->escapeHtml(__('No payment methods available')) ?>
            </div>
        <?php endif; ?>
    </form>

    <?= /* @noEscape */ $blockRenderer->html($block,  'loki-components.utils.local-messages') ?>
</div>
