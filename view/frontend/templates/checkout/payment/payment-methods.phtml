<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Component\Checkout\Billing\PaymentMethods\PaymentMethodsViewModel;
use Yireo\LokiComponents\Factory\ViewModelFactory;
use Yireo\LokiComponents\Util\Block\CssClass;
use Yireo\LokiComponents\Util\Block\BlockRenderer;

/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var PaymentMethodsViewModel $viewModel */
/** @var BlockRenderer $blockRenderer */
/** @var CssClass $css */

$paymentMethods = $viewModel->getPaymentMethods();
?>
<div class="<?= /* @noEscape */ $css('relative') ?>">
    <?= /* @noEscape */ $blockRenderer->html($block, 'loki-field-components.utils.loader-overlay') ?>
    <?= /* @noEscape */ $block->getChildHtml('title') ?>

    <form
        data-type="field"
        x-ref="field"
        aria-invalid="<?= $viewModel->isValid() ? 'false' : 'true' ?>"
        class="<?= /* @noEscape */ $css('border border-transparent', 'container') ?>">
        <?php if (!empty($paymentMethods)): ?>
	    <ul class="<?= /* @noEscape */ $css('', 'list') ?>">
                <?php foreach ($paymentMethods as $paymentMethod): ?>
                    <?= /* @noEscape */ $blockRenderer->html(
                        $block,
                        'loki-checkout.payment.payment-methods.item',
                        [
                            'method' => $paymentMethod,
                            'is_current' => $paymentMethod->getCode() === $viewModel->getValue(),
                        ]
                    ) ?>
                <?php endforeach; ?>
            </ul>
        <?php else: ?>
            <div class="<?= /* @noEscape */
                    $css('p-4', 'no-items') ?>">
                <?= $escaper->escapeHtml(__('No payment methods available')) ?>
            </div>
        <?php endif; ?>
    </form>

    <?= /* @noEscape */ $blockRenderer->html($block, 'loki-components.utils.local-messages') ?>
</div>
