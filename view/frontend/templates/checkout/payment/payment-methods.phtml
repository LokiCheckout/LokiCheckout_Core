<?php
declare(strict_types=1);

use Loki\Components\Component\ComponentViewModelInterface;
use Loki\Base\ViewModel\Block\ChildRenderer;
use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use LokiCheckout\Core\Component\Checkout\Billing\PaymentMethods\PaymentMethodsViewModel;
use Loki\Components\Factory\ViewModelFactory;
use Loki\Components\Util\Block\BlockRenderer;

/** @version 2.7.1 */
/** @var ComponentViewModelInterface $viewModel */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var PaymentMethodsViewModel $viewModel */
/** @var BlockRenderer $blockRenderer */
/** @var CssClass $css */
/** @var ChildRenderer $childRenderer */

$paymentMethods = $viewModel->getPaymentMethods();
?>
<div class="<?= $escaper->escapeHtml($css('relative')) ?>" role="group">
    <?= /* @noEscape */ $blockRenderer->html( $block, 'loki-field-components.utils.loader-overlay') ?>

    <?= /* @noEscape */ $childRenderer->any($block, 'before-title') ?>
    <?= /* @noEscape */ $childRenderer->html($block, 'title') ?>
    <?= /* @noEscape */ $childRenderer->any($block, 'after-title') ?>

    <form
        data-type="field"
        x-ref="field"
        :aria-invalid="isAriaInvalid"
        :data-valid="isValid"
        class="<?= $escaper->escapeHtml($css('border border-transparent', 'container')) ?>">

        <?= /* @noEscape */ $childRenderer->any($block, 'before-methods') ?>

        <?php if (!empty($paymentMethods)): ?>
	        <ul class="<?= $escaper->escapeHtml($css('', 'list')) ?>">
                <?php foreach ($paymentMethods as $paymentMethod): ?>
                    <?= /* @noEscape */ $blockRenderer->html(
                        $block,
                        'loki-checkout.payment.methods.item',
                        [
                            'method' => $paymentMethod,
                            'is_current' => $paymentMethod->getCode() === $viewModel->getValue(),
                        ]
                    ) ?>
                <?php endforeach; ?>
            </ul>
        <?php else: ?>
            <?= /* @noEscape */ $childRenderer->any($block, 'empty') ?>
            <div class="<?= $escaper->escapeHtml($css('p-4', 'no-items')) ?>">
                <?= $escaper->escapeHtml(__('No payment methods available')) ?>
            </div>
        <?php endif; ?>

        <?= /* @noEscape */ $childRenderer->any($block, 'after-methods') ?>
    </form>

    <?= /* @noEscape */ $blockRenderer->html($block,  'loki-components.utils.local-messages') ?>
</div>
