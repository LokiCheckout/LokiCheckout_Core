<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Component\Checkout\Sidebar\Preview\ShippingDetails\ShippingDetailsViewModel;
use Yireo\LokiComponents\Util\Block\CssClass;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;
use Yireo\LokiComponents\Factory\ViewModelFactory;

/** @var Template $block */
/** @var ShippingDetailsViewModel $viewModel */
/** @var ViewModelFactory $viewModelFactory */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */

$viewModel = $viewModelFactory->create(ShippingDetailsViewModel::class);
$addressHtml = $viewModel->getAddressHtml();
$methodHtml = $viewModel->getMethodHtml();

if (empty($addressHtml)) {
    echo '<div></div>';

    return;
}

?>
<div class="<?= $css('relative') ?>">
    <?= $blockRenderer->html($block,'loki-checkout.utils.loader-overlay') ?>

    <div class="<?= $css('mb-4', 'address') ?>">
        <span class="<?= $css('text-xl font-bold', 'title') ?>"><?= __('Shipping Address') ?></span><br>
        <address><?= $addressHtml ?></address>
    </div>

    <?php if (!empty($methodHtml)): ?>
        <div class="<?= $css('mb-4', 'method') ?>">
            <span class="<?= $css('text-xl font-bold', 'title') ?>"><?= __('Shipping Method') ?></span><br>
            <?= $methodHtml ?>
        </div>
    <?php endif; ?>
</div>
