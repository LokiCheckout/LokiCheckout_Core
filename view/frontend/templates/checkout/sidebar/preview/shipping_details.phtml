<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use LokiCheckout\Core\Component\Checkout\Sidebar\Preview\ShippingDetails\ShippingDetailsViewModel;
use Loki\Components\Util\Block\BlockRenderer;
use Loki\Components\Factory\ViewModelFactory;

/** @version 2.1.37 */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var ShippingDetailsViewModel $viewModel */
/** @var ViewModelFactory $viewModelFactory */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */

$addressHtml = $viewModel->getAddressHtml();
$methodHtml = $viewModel->getMethodHtml();

if (empty($addressHtml)) {
    echo '<div></div>';

    return;
}

?>
<div class="<?= $escaper->escapeHtml($css('relative')) ?>">
    <?= /* @noEscape */ $blockRenderer->html($block, 'loki-field-components.utils.loader-overlay') ?>

    <div class="<?= $escaper->escapeHtml($css('mb-4', 'address')) ?>">
        <span class="<?= $escaper->escapeHtml($css('text-xl font-bold', 'title')) ?>">
            <?= $escaper->escapeHtml(__($viewModel->getAddressLabel())) ?>
        </span><br>
        <address>
            <?= /* @noEscape */ $addressHtml ?>
            <?= /* @noEscape */ $block->getChildHtml('additional_address_info') ?>
        </address>
    </div>

    <?php if (!empty($methodHtml)): ?>
        <div
            class="<?= $escaper->escapeHtml($css('mb-4', 'method')) ?>"
            title="<?= $escaper->escapeHtml($viewModel->getMethod()) ?>"
        >
            <span class="<?= $escaper->escapeHtml($css('text-xl font-bold', 'title')) ?>"><?= $escaper->escapeHtml(__('Shipping Method')) ?></span><br>
            <?= /* @noEscape */ $methodHtml ?>
            <?= /* @noEscape */ $block->getChildHtml('additional_method_info') ?>
        </div>
    <?php endif; ?>
</div>
