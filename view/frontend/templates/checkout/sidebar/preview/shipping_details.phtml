<?php
declare(strict_types=1);

use Yireo\LokiCheckout\Component\Checkout\Sidebar\Preview\ShippingDetails;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;

/** @var ShippingDetails $component */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */
$addressHtml = $component->getAddressHtml();
$methodHtml = $component->getMethodHtml();

if (empty($addressHtml)) {
    echo '<div></div>';

    return;
}

?>
<div class="<?= $css('relative') ?>">
    <?= $blockRenderer->html('loki-checkout.utils.loader-overlay') ?>

    <div class="<?= $css('mb-4', 'address') ?>">
        <span class="<?= $css('text-xl font-bold', 'title') ?>"><?= __('Shipping Address') ?></span><br>
        <?= $addressHtml ?>
    </div>

    <?php if (!empty($methodHtml)): ?>
        <div class="<?= $css('mb-4', 'method') ?>">
            <span class="<?= $css('text-xl font-bold', 'title') ?>"><?= __('Shipping Method') ?></span><br>
            <?= $methodHtml ?>
        </div>
    <?php endif; ?>
</div>
