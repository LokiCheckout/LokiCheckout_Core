<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Component\Checkout\Sidebar\Preview\ShippingDetails\ShippingDetailsViewModel;
use Yireo\LokiComponents\Util\Block\CssClass;
use Yireo\LokiComponents\Util\Block\BlockRenderer;
use Yireo\LokiComponents\Factory\ViewModelFactory;

/** @var Template $block */
/** @var ShippingDetailsViewModel $viewModel */
/** @var ViewModelFactory $viewModelFactory */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */

$addressHtml = $viewModel->getAddressHtml();
$methodHtml = $viewModel->getMethodHtml();

if (empty($addressHtml)) {
    echo '<div></div>';

    return;
}

?>
<div class="<?= /* @noEscape */ $css('relative') ?>">
    <?= /* @noEscape */ $blockRenderer->html($block,'loki-field-components.utils.loader-overlay') ?>

    <div class="<?= /* @noEscape */ $css('mb-4', 'address') ?>">
        <span class="<?= /* @noEscape */ $css('text-xl font-bold', 'title') ?>"><?= $escaper->escapeHtml(__('Shipping Address')) ?></span><br>
        <address><?= /* @noEscape */ $addressHtml ?></address>
    </div>

    <?php if (!empty($methodHtml)): ?>
        <div class="<?= /* @noEscape */ $css('mb-4', 'method') ?>">
            <span class="<?= /* @noEscape */ $css('text-xl font-bold', 'title') ?>"><?= $escaper->escapeHtml(__('Shipping Method')) ?></span><br>
            <?= $escaper->escapeHtml($methodHtml) ?>
        </div>
    <?php endif; ?>
</div>
