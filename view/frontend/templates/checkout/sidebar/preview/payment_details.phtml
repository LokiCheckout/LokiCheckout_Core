<?php
declare(strict_types=1);

use Loki\Components\Component\ComponentViewModelInterface;
use Loki\Components\Util\Block\ChildRenderer;
use Loki\CssUtils\Util\CssClass;
use LokiCheckout\Core\ViewModel\ApplicationMode;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use LokiCheckout\Core\Component\Checkout\Sidebar\Preview\PaymentDetails\PaymentDetailsViewModel;
use Loki\Components\Util\Block\BlockRenderer;
use Loki\Components\Factory\ViewModelFactory;

/** @version 2.4.3 */
/** @var ComponentViewModelInterface $viewModel */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var PaymentDetailsViewModel $viewModel */
/** @var ApplicationMode $applicationMode */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */
/** @var ChildRenderer $childRenderer */

$applicationMode = $viewModelFactory->create(ApplicationMode::class);
$viewModel = $viewModelFactory->create(PaymentDetailsViewModel::class);
$html = $viewModel->getHtml();
if (empty($html)) {
    echo '<div></div>';
    return;
}
?>
<div class="<?= $escaper->escapeHtml($css('mb-4 relative')) ?>">
    <?= /* @noEscape */ $blockRenderer->html($block, 'loki-field-components.utils.loader-overlay') ?>

    <span class="<?= $escaper->escapeHtml($css('text-xl font-bold', 'title')) ?>"><?= $escaper->escapeHtml(__('Payment Method')) ?></span><br>
    <?= /* @noEscape */ $html ?>
    <?= /* @noEscape */ $childRenderer->all($block) ?>

    <?php if ($applicationMode->isDeveloperMode()): ?>
    <!-- <?= $escaper->escapeHtml($viewModel->getPaymentCode()) ?> -->
    <?php endif; ?>
</div>
