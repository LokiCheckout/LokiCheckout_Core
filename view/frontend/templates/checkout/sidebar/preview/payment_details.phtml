<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Component\Checkout\Sidebar\Preview\PaymentDetails\PaymentDetailsViewModel;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;
use Yireo\LokiComponents\Factory\ViewModelFactory;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var PaymentDetailsViewModel $viewModel */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */

$viewModel = $viewModelFactory->create(PaymentDetailsViewModel::class);
$html = $viewModel->getHtml();
if (empty($html)) {
    echo '<div></div>';
    return;
}
?>
<div class="<?= $css('mb-4 relative') ?>">
    <?= $blockRenderer->html('loki-checkout.utils.loader-overlay') ?>

    <span class="<?= $css('text-xl font-bold', 'title') ?>"><?= __('Payment Method') ?></span><br>
    <?= $html ?>
    <?= $block->getChildHtml() ?>
</div>
