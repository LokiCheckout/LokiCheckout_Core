<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\ViewModel\PaymentDetails\Purchaseorder;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var Purchaseorder $purchaseOrder */
$purchaseOrder = $viewModelFactory->create(Purchaseorder::class);
$poNumber = $purchaseOrder->getPoNumber();
if (empty($poNumber)) {
    return '';
}
?>
<div>
    <span><?= __('PO Number') ?></span>:
    <?= $poNumber ?>
</div>

