<?php
declare(strict_types=1);

use Yireo\LokiCheckout\Magewire\Checkout\Sidebar\Preview\ShippingAddress;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;

/** @var ShippingAddress $magewire */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */
$html = $magewire->getHtml();
if (empty($html)) {
    echo '<div></div>';
    return;
}

?>
<div  class="<?= $css('mb-4 relative') ?>">
    <?= $blockRenderer->getBlockHtml('loki-checkout.utils.loader-overlay') ?>

    <span class="<?= $css('text-xl font-bold', 'title') ?>"><?= __('Shipping Address') ?></span><br>
    <address><?= $html ?></address>
</div>
