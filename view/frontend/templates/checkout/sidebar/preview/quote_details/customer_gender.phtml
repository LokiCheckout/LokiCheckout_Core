<?php
declare(strict_types=1);

use LokiCheckout\Core\ViewModel\GenderViewModel;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Factory\ViewModelFactory;
use LokiCheckout\Core\ViewModel\QuoteDetails;

/** @version 2.4.2 */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var QuoteDetails $quoteDetails */
/** @var GenderViewModel $genderViewModel */

$quoteDetails = $viewModelFactory->create(QuoteDetails::class);
$gender = $quoteDetails->getGender();
if (empty($gender)) {
    return '';
}

$genderViewModel = $viewModelFactory->create(GenderViewModel::class);
$genderLabel = $genderViewModel->getLabelById((int)$gender);
?>
<div>
    <span><?= $escaper->escapeHtml(__('Gender')) ?></span>:
    <?= $escaper->escapeHtml($genderLabel) ?>
</div>

