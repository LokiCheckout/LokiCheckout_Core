<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Yireo\LokiComponents\Factory\ViewModelFactory;
use Yireo\LokiCheckout\ViewModel\QuoteDetails;

/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var QuoteDetails $quoteDetails */
$quoteDetails = $viewModelFactory->create(QuoteDetails::class);
$email = $quoteDetails->getEmail();
if (empty($email)) {
    return '';
}

?>
<div>
    <span><?= $escaper->escapeHtml(__('Email')) ?></span>:
    <?= $escaper->escapeHtml($email) ?>
</div>

