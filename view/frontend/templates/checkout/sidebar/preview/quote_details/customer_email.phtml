<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\ViewModel\QuoteDetails;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var QuoteDetails $quoteDetails */
$quoteDetails = $viewModelFactory->create(QuoteDetails::class);
$email = $quoteDetails->getEmail();
if (empty($email)) {
    return '';
}

?>
<div>
    <span><?= __('Email') ?></span>:
    <?= $email ?>
</div>

