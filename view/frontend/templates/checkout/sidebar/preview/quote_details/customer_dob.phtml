<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Factory\ViewModelFactory;
use LokiCheckout\Core\ViewModel\QuoteDetails;

/** @version 2.3.1 */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var QuoteDetails $quoteDetails */
$quoteDetails = $viewModelFactory->create(QuoteDetails::class);
$dob = $quoteDetails->getDob();
if (empty($dob)) {
    return '';
}
?>
<div>
    <span><?= $escaper->escapeHtml(__('Date of Birth')) ?></span>:
    <?= $escaper->escapeHtml($dob) ?>
</div>

