<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiComponents\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Component\Checkout\Sidebar\Preview\BillingAddress\BillingAddressViewModel;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;

/** @var Template $block */
/** @var BillingAddressViewModel $viewModel */
/** @var ViewModelFactory $viewModelFactory */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */

$viewModel = $viewModelFactory->create(BillingAddressViewModel::class);
$html = $viewModel->getHtml();
if (empty($html)) {
    echo '<div></div>';
    return;
}
?>
<div  class="<?= $css('mb-4 relative') ?>">
    <?= $blockRenderer->html('loki-checkout.utils.loader-overlay') ?>
    <span class="<?= $css('text-xl font-bold', 'title') ?>"><?= __('Billing Address') ?></span><br>
    <address><?= $html ?></address>
    <?php if ($viewModel->isSameAsShipping()): ?>
    <small class="<?= $css('', 'notice') ?>"><?= __('Same as shipping address') ?></small>
    <?php endif; ?>
</div>
