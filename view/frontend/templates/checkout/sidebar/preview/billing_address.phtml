<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Factory\ViewModelFactory;
use LokiCheckout\Core\Component\Checkout\Sidebar\Preview\BillingAddress\BillingAddressViewModel;
use Loki\Components\Util\Block\BlockRenderer;

/** @version 2.1.34 */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var BillingAddressViewModel $viewModel */
/** @var ViewModelFactory $viewModelFactory */
/** @var BillingAddressViewModel $viewModel */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */

$viewModel = $viewModelFactory->create(BillingAddressViewModel::class);
$html = $viewModel->getHtml();
if (empty($html)) {
    echo '<div></div>';
    return;
}
?>
<div class="<?= $escaper->escapeHtml($css('mb-4 relative')) ?>">
    <?= /* @noEscape */ $blockRenderer->html($block, 'loki-field-components.utils.loader-overlay') ?>
    <span class="<?= $escaper->escapeHtml($css('text-xl font-bold', 'title')) ?>"><?= $escaper->escapeHtml(__('Billing Address')) ?></span><br>
    <address>
        <?= /* @noEscape */ $html ?>
        <?= /* @noEscape */ $block->getChildHtml('additional_address_info') ?>
    </address>
</div>
