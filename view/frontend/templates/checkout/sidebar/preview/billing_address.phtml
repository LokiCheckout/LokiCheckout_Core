<?php
declare(strict_types=1);

use Yireo\LokiCheckout\Component\Checkout\Sidebar\Preview\BillingAddress;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;

/** @var BillingAddress $component */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */
$html = $component->getHtml();
if (empty($html)) {
    echo '<div></div>';
    return;
}
?>
<div  class="<?= $css('mb-4 relative') ?>">
    <?= $blockRenderer->html('loki-checkout.utils.loader-overlay') ?>
    <span class="<?= $css('text-xl font-bold', 'title') ?>"><?= __('Billing Address') ?></span><br>
    <address><?= $html ?></address>
    <?php if ($component->isSameAsShipping()): ?>
    <small class="<?= $css('', 'notice') ?>"><?= __('Same as shipping address') ?></small>
    <?php endif; ?>
</div>
