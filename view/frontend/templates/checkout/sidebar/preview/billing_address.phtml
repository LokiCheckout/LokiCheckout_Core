<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Factory\ViewModelFactory;
use LokiCheckout\Core\Component\Checkout\Sidebar\Preview\BillingAddress\BillingAddressViewModel;
use Loki\Components\Util\Block\CssClass;
use Loki\Components\Util\Block\BlockRenderer;

/** @var Escaper $escaper */
/** @var Template $block */
/** @var BillingAddressViewModel $viewModel */
/** @var ViewModelFactory $viewModelFactory */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */

$viewModel = $viewModelFactory->create(BillingAddressViewModel::class);
$html = $viewModel->getHtml();
if (empty($html)) {
    echo '<div></div>';
    return;
}
?>
<div class="<?= /* @noEscape */ $css('mb-4 relative') ?>">
    <?= /* @noEscape */ $blockRenderer->html($block,'loki-field-components.utils.loader-overlay') ?>
    <span class="<?= /* @noEscape */ $css('text-xl font-bold', 'title') ?>"><?= $escaper->escapeHtml(__('Billing Address')) ?></span><br>
    <address><?= /* @noEscape */ $html ?></address>
    <?php if ($viewModel->isSameAsShipping()): ?>
        <small class="<?= /* @noEscape */ $css('', 'notice') ?>"><?= $escaper->escapeHtml(__('Same as shipping address')) ?></small>
    <?php endif; ?>
</div>
