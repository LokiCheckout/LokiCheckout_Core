<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Util\Block\CssClass;
use Loki\Components\Util\Block\BlockRenderer;

/** @var Escaper $escaper */
/** @var Template $block */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */

$html = $block->getChildHtml();
if (empty($html)) {
    echo '<div></div>';

    return;
}
?>
<div class="<?= /* @noEscape */ $css('mb-4 relative') ?>">
    <?= /* @noEscape */ $blockRenderer->html($block, 'loki-field-components.utils.loader-overlay') ?>
    <span class="<?= /* @noEscape */ $css('text-xl font-bold', 'title') ?>"><?= $escaper->escapeHtml(__('Details')) ?></span><br>
    <output>
        <?= /* @noEscape */
        $html ?>
    </output>
</div>
