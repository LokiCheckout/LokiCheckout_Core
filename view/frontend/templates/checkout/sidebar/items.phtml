<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Magewire\Checkout\Sidebar\Items;

/** @var Template $block */
/** @var Items $magewire */
/** @var \Yireo\LokiCheckout\Util\BlockCssClass $blockCss */

if (empty($magewire->items)) {
    return '<div>No items</div>';
}
?>
<div class="<?= $blockCss('border-b border-gray-400 my-8') ?>">
    <ul role="list">
        <?php foreach ($magewire->items as $item) : ?>
            <?= $block->getChildBlock('item')->addData(['item' => $item])->toHtml() ?>
        <?php endforeach; ?>
    </ul>
</div>
