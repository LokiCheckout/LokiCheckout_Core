<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Magewire\Checkout\Sidebar\Items;
use Yireo\LokiCheckout\Util\BlockCssClass;

/** @var Template $block */
/** @var Items $magewire */
/** @var BlockCssClass $blockCss */

if (empty($magewire->items)) {
    return '<div>No items</div>';
}
?>
<div class="<?= $blockCss('') ?>">
    <ul role="list">
        <?php foreach ($magewire->items as $item) : ?>
            <?= $block->getChildBlock('item')
                ->addData(['item' => $item, 'component' => $magewire
                ])->toHtml() ?>
        <?php endforeach; ?>
    </ul>
</div>
