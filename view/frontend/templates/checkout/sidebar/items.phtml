<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Magewire\Checkout\Sidebar\Items;
use Yireo\LokiCheckout\Util\BlockAttribute;
use Yireo\LokiCheckout\Util\BlockCssClass;

/** @var Template $block */
/** @var Items $magewire */
/** @var BlockCssClass $blockCss */
/** @var BlockAttribute $blockAttribute */

if (empty($magewire->items)) {
    return '<div>No items</div>';
}
?>
<div <?= $blockAttribute() ?> class="<?= $blockCss('relative') ?>">
    <div
        wire:loading
        aria-live="polite"
        class="z-30 absolute top-0 left-0 right-0 bottom-0 inset-0 bg-white/60 flex justify-center items-start">
        <img
            src="<?= $block->getViewFileUrl('Yireo_LokiCheckout::images/loader.svg'); ?>"
            style="margin-top:20%"
            width="100"
            height="100"
            alt="Loading..."
        >
    </div>

    <ul role="list">
        <?php foreach ($magewire->getItems() as $item) : ?>
            <li>
                <?= $block->getChildBlock('item')->addData([
                    'item' => $item,
                    'component' => $magewire,
                ])->toHtml() ?>
            </li>
        <?php endforeach; ?>
    </ul>
</div>
