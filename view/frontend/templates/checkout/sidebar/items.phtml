<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Magewire\Checkout\Sidebar\Items;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;

/** @var Template $block */
/** @var Items $magewire */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */

if (empty($magewire->items)) {
    echo '<div>No items</div>';
    return;
}

?>
<div class="<?= $css('relative') ?>">
    <?= $blockRenderer->getBlockHtml('loki-checkout.utils.loader-overlay') ?>
    <?= $block->getChildHtml('before') ?>

    <ul role="list">
        <?php foreach ($magewire->getItems() as $item) : ?>
            <li>
                <?= $blockRenderer->getChildHtml('item', $block, [
                    'item' => $item,
                ]) ?>
            </li>
        <?php endforeach; ?>
    </ul>

    <?= $block->getChildHtml('after') ?>
</div>
