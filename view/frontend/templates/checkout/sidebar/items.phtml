<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Component\Checkout\Sidebar\Items\ItemsViewModel;
use Yireo\LokiComponents\Factory\ViewModelFactory;
use Yireo\LokiComponents\Util\Block\ChildRenderer;
use Yireo\LokiComponents\Util\Block\CssClass;
use Yireo\LokiComponents\Util\Block\BlockRenderer;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var ItemsViewModel $viewModel */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */
/** @var ChildRenderer $childRenderer */

$blockRenderer = $viewModelFactory->create(BlockRenderer::class);
$childRenderer = $viewModelFactory->create(ChildRenderer::class);
?>
<div class="<?= /* @noEscape */ $css('relative') ?>">
    <?= /* @noEscape */ $blockRenderer->html($block,'loki-field-components.utils.loader-overlay') ?>
    <?= /* @noEscape */ $block->getChildHtml('before') ?>

    <ul role="list">
        <?php foreach ($viewModel->getItems() as $item) : ?>
            <li>
                <?= /* @noEscape */ $childRenderer->html($block,'item', [
                    'alias' => 'item',
                    'item' => $item,
                ]) ?>
            </li>
        <?php endforeach; ?>
    </ul>

    <?= /* @noEscape */ $block->getChildHtml('after') ?>
</div>
