<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Loki\Components\Util\Block\ImageRenderer;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use LokiCheckout\Core\Component\Checkout\Sidebar\Items\ItemsViewModel;
use Loki\Components\Factory\ViewModelFactory;
use Loki\Components\Util\Block\ChildRenderer;
use Loki\Components\Util\Block\BlockRenderer;

/** @version 2.1.23 */
/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var ItemsViewModel $viewModel */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */
/** @var ChildRenderer $childRenderer */
/** @var Escaper $escaper */
/** @var ImageRenderer $imageRenderer */

$allItems = $viewModel->getItems();
$visibleItems = array_slice($allItems, 0, $viewModel->getVisibleCount());
$hiddenItems = array_slice($allItems, $viewModel->getVisibleCount());
?>
<div class="<?= $escaper->escapeHtml($css('relative')) ?>">
    <?= /* @noEscape */ $blockRenderer->html( $block, 'loki-field-components.utils.loader-overlay') ?>
    <?= /* @noEscape */ $block->getChildHtml('before') ?>

    <div x-data="LokiToggle" class="<?= $escaper->escapeHtml($css('', 'inner')) ?>">
        <ul role="list">
            <?php foreach ($visibleItems as $item) : ?>
                <li>
                    <?= /* @noEscape */ $childRenderer->html($block, 'item', [
                        'alias' => 'item',
                        'uniq' => 'item-' . $item->getItemId(),
                        'item' => $item,
                    ]) ?>
                </li>
            <?php endforeach; ?>
        </ul>

        <?php if (count($hiddenItems) > 0): ?>
            <button @click.prevent="toggle" x-show="hidden" class="<?= $escaper->escapeHtml($css('flex', 'button-down')) ?>">
                <span class="<?= $escaper->escapeHtml($css('', 'button-down-span')) ?>">
                    <?= /* @noEscape */ $imageRenderer->icon($block, 'chevron-down') ?>
                </span>
                <?= $escaper->escapeHtml(__('Show all items')) ?>
            </button>

            <ul role="list" x-show="shown">
                <?php foreach ($hiddenItems as $item) : ?>
                    <li>
                        <?= /* @noEscape */ $childRenderer->html($block, 'item', [
                            'alias' => 'item',
                            'item' => $item,
                        ]) ?>
                    </li>
                <?php endforeach; ?>
            </ul>

            <button @click.prevent="toggle" x-cloak x-show="shown" class="<?= $escaper->escapeHtml($css('flex', 'button-up')) ?>">
                <span class="<?= $escaper->escapeHtml($css('w-6 h-2', 'button-up-span')) ?>">
                    <?= /* @noEscape */ $imageRenderer->icon($block, 'chevron-up') ?>
                </span>
                <?= $escaper->escapeHtml(__('Do not show all items')) ?>
            </button>
        <?php endif; ?>
    </div>

    <?= /* @noEscape */ $block->getChildHtml('after') ?>
</div>
