<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Magewire\Checkout\Sidebar\Items;

/** @var Template $block */
/** @var Items $magewire */
/** @var string $blockClass */

if (empty($magewire->items)) {
    return '';
}
?>
<div class="<?= $blockClass ?> border-b border-gray-400 my-8">
    <ul role="list">
        <?php foreach ($magewire->items as $item) : ?>
            <?= $block->getChildBlock('item')->addData(['item' => $item])->toHtml() ?>
        <?php endforeach; ?>
    </ul>
</div>
