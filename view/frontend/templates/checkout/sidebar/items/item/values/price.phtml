<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use LokiCheckout\Core\ViewModel\PriceFormatter;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Magento\Quote\Api\Data\CartItemInterface;
use Loki\Components\Factory\ViewModelFactory;
use Magento\Quote\Model\Quote\Item as CartItem;

/** @version 2.7.3 */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var CartItem $item */
/** @var ViewModelFactory $viewModelFactory */
/** @var CssClass $css */
/** @var PriceFormatter $priceFormatterViewModel */

$item = $block->getItem();
$priceFormatterViewModel = $viewModelFactory->create(PriceFormatter::class);
?>
<dt class="<?= $escaper->escapeHtml($css('font-medium', 'price-label')) ?>">
    <?= $escaper->escapeHtml(__('Price')) ?>:
</dt>
<dd class="<?= $escaper->escapeHtml($css('', 'price-value')) ?>">
    <?php if ($priceFormatterViewModel->displayCartPricesExclTax()): ?>
    <?= /* @noEscape */ $priceFormatterViewModel->format($item->getPrice()) ?>
    <?php endif; ?>
    <?php if ($priceFormatterViewModel->displayCartPricesInclTax()): ?>
        <?= /* @noEscape */ $priceFormatterViewModel->format($item->getPriceInclTax()) ?>
    <?php endif; ?>

    <?php if ($priceFormatterViewModel->displayCartPricesBoth()): ?>
        <?= /* @noEscape */ $priceFormatterViewModel->format($item->getPrice()) ?> /
        <?= /* @noEscape */ $priceFormatterViewModel->format($item->getPriceInclTax()) ?>
    <?php endif; ?>
</dd>
