<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Magento\Quote\Api\Data\CartItemInterface;
use Loki\Components\Factory\ViewModelFactory;
use LokiCheckout\Core\ViewModel\ProductRenderer;

/** @version 2.4.1 */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var CartItemInterface $item */
/** @var ViewModelFactory $viewModelFactory */
/** @var CssClass $css */
/** @var ProductRenderer $productRendererViewModel */

$item = $block->getItem();
$productRendererViewModel = $viewModelFactory->create(ProductRenderer::class);
?>
<?php foreach ($productRendererViewModel->getProductOptions($item) as $option): ?>
    <dt class="<?= $escaper->escapeHtml($css('font-medium', 'option-label')) ?>">
        <?= $escaper->escapeHtml(__($option['label'])) ?>:
    </dt>
    <dd class="<?= $escaper->escapeHtml($css('', 'option-value')) ?>">
        <?php $formattedOptionValue = $option['formatted'] ?>
        <?php if (isset($formattedOptionValue['full_view'])): ?>
            <?= $escaper->escapeHtml($formattedOptionValue['full_view']) ?>
        <?php else: ?>
            <?= $escaper->escapeHtml($formattedOptionValue['value'], ['span', 'a']) ?>
        <?php endif; ?>
    </dd>
<?php endforeach; ?>
