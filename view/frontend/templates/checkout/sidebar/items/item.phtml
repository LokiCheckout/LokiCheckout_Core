<?php
declare(strict_types=1);

use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Magento\Framework\View\Element\Template;
use Magento\Quote\Api\Data\CartItemInterface;
use Yireo\LokiCheckout\ViewModel\PriceFormatter;
use Yireo\LokiCheckout\ViewModel\ProductImage;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
$priceFormatterViewModel = $viewModelFactory->create(PriceFormatter::class);
$productImageViewModel = $viewModelFactory->create(ProductImage::class);

/** @var CartItemInterface $item */
/** @var \Yireo\LokiCheckout\Util\BlockCssClass $blockCss */

$item = $block->getItem();
$width = 75;
$productImageUrl = $productImageViewModel->getImageUrlBySku($item->getSku(), $width);
?>
<li class="<?= $blockCss('flex') ?>">
    <img src="<?= $productImageUrl ?>" width="<?= $width ?>" height="<?= $width ?>" class="image pr-4">
    <div class="pb-4">
        <?= $item->getName() ?><br>
        <span class="text-sm"><?= __('Price') ?>: <?= $priceFormatterViewModel->format($item->getPrice()) ?></span><br>
        <span class="text-sm"><?= __('Quantity') ?>: <?= $item->getQty() ?></span>
    </div>
</li>
