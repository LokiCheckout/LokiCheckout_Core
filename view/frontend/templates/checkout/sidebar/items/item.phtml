<?php
declare(strict_types=1);

use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Magento\Framework\View\Element\Template;
use Magento\Quote\Api\Data\CartItemInterface;
use Yireo\LokiCheckout\Magewire\Checkout\Sidebar\Items;
use Yireo\LokiCheckout\Util\BlockAttribute;
use Yireo\LokiCheckout\Util\BlockCssClass;
use Yireo\LokiCheckout\ViewModel\BlockRenderer;
use Yireo\LokiCheckout\ViewModel\PriceFormatter;
use Yireo\LokiCheckout\ViewModel\ProductImage;

/** @var Template $block */
/** @var Items $component */
/** @var ViewModelFactory $viewModelFactory */
/** @var BlockRenderer $blockRenderer */
/** @var array $item */
/** @var BlockCssClass $blockCss */
/** @var BlockAttribute $blockAttribute */

$component = $block->getComponent();
$priceFormatterViewModel = $viewModelFactory->create(PriceFormatter::class);
$productImageViewModel = $viewModelFactory->create(ProductImage::class);
$blockRenderer = $viewModelFactory->create(BlockRenderer::class);
$item = $block->getItem();
$width = 75;
$productImageUrl = $productImageViewModel->getImageUrlBySku($item['sku'], $width);
?>
<div <?= $blockAttribute() ?> class="<?= $blockCss('flex gap-4 my-8') ?>"
                              x-data="LokiCheckoutSidebarItems<?= $item['id'] ?>">
    <img
        src="<?= $productImageUrl ?>"
        width="<?= $width ?>"
        height="<?= $width ?>"
        alt=""
        class="shrink-0"
    >
    <div>
        <div class="grow">
            <p><strong><?= $item['name'] ?><br></strong></p>
            <dl class="text-sm grid grid-cols-2 sm:grid-cols-[auto_minmax(0px,1fr)] gap-x-2">
                <dt class="font-medium"><?= __('Price') ?>:</dt>
                <dd><?= $priceFormatterViewModel->format($item['price']) ?></dd>
                <dt class="font-medium"><?= __('Quantity') ?>:</dt>
                <dd><?= $item['qty'] ?></dd>
            </dl>
        </div>

        <div class="actions">
            <div>
                <input type="number" x-model="qty" min="0" max="1000000"/>
                <button class="m-2" title="Update item quantity" @click="updateItemQty">
                    <?= $blockRenderer->render('Yireo_LokiCheckout::utils/save.phtml') ?>
                </button>
                <button class="m-2" title="Remove item" @click="removeItem">
                    <?= $blockRenderer->render('Yireo_LokiCheckout::utils/trash.phtml') ?>
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiCheckoutSidebarItems<?= $item['id'] ?>', () => ({
            itemId: <?= $item['id'] ?>,
            qty: <?= $item['qty'] ?>,
            updateItemQty() {
                Magewire.find('<?= $component->getId() ?>').updateItemQty(this.itemId, this.qty);
            },
            removeItem() {
                Magewire.find('<?= $component->getId() ?>').removeItem(this.itemId);
            }
        }))
    });
</script>
