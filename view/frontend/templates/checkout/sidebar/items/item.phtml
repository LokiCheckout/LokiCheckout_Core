<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Magento\Quote\Api\Data\CartItemInterface;
use Loki\Components\Factory\ViewModelFactory;
use Loki\Components\Util\Block\ChildRenderer;
use LokiCheckout\Core\ViewModel\ProductRenderer;

/** @version 2.1.33 */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var ChildRenderer $childRenderer */
/** @var CartItemInterface $item */
/** @var CssClass $css */
/** @var ProductRenderer $productRendererViewModel */

$item = $block->getItem();
if (empty($item)) {
    return;
}

$size = $block->getSize() ?? 125;
$width = $block->getWidth() ?? $size;
$height = $block->getHeight() ?? $size;
$useOriginalRenderer = (bool)$block->getUseOriginalRenderer() ?? false;

$productRendererViewModel = $viewModelFactory->create(ProductRenderer::class);
if ($useOriginalRenderer) {
    echo $productRendererViewModel->getRenderer($item)->toHtml();
    return;
}

$childRenderer = $viewModelFactory->create(ChildRenderer::class);
$productImageHtml = $productRendererViewModel->getImage($item, $width, $height);
?>

<div class="<?= $escaper->escapeHtml($css('flex gap-4 my-8 justify-between')) ?>" data-item-id="<?= (int)$item->getItemId() ?>" data-item-qty="<?= (float)$item->getQty() ?>">
    <?= /* @noEscape */ $productImageHtml ?>

    <div class="<?= $escaper->escapeHtml($css('', 'outer grow')) ?>">
        <div class="<?= $escaper->escapeHtml($css('grow', 'inner mb-2')) ?>">
            <?= $childRenderer->html($block, 'title', ['item' => $item]) ?>

            <dl class="<?= $escaper->escapeHtml($css('text-sm grid grid-cols-2 sm:grid-cols-[auto_minmax(0px,1fr)] gap-x-2', 'list')) ?>">
                <?= $childRenderer->html($block, 'values', ['item' => $item]) ?>
                <?= $childRenderer->html($block, 'product-options', ['item' => $item]) ?>
            </dl>
        </div>

        <?= /* @noEscape */ $childRenderer->html($block, 'actions', [
            'alias' => 'actions',
            'item' => $item
        ]) ?>
    </div>
</div>
