<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Magento\Quote\Api\Data\CartItemInterface;
use Loki\Components\Factory\ViewModelFactory;
use Loki\Components\Util\Block\ChildRenderer;
use LokiCheckout\Core\ViewModel\PriceFormatter;
use LokiCheckout\Core\ViewModel\ProductRenderer;

/** @version 2.1.28 */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var ChildRenderer $childRenderer */
/** @var CartItemInterface $item */
/** @var CssClass $css */
/** @var PriceFormatter $priceFormatterViewModel */
/** @var ProductRenderer $productRendererViewModel */

$item = $block->getItem();
if (empty($item)) {
    return;
}

$size = $block->getSize() ?? 125;
$width = $block->getWidth() ?? $size;
$height = $block->getHeight() ?? $size;
$useOriginalRenderer = (bool)$block->getUseOriginalRenderer() ?? false;

$productRendererViewModel = $viewModelFactory->create(ProductRenderer::class);
if ($useOriginalRenderer) {
    echo $productRendererViewModel->getRenderer($item)->toHtml();
    return;
}

$childRenderer = $viewModelFactory->create(ChildRenderer::class);
$priceFormatterViewModel = $viewModelFactory->create(PriceFormatter::class);
$productImageHtml = $productRendererViewModel->getImage($item, $width, $height);
?>

<div class="<?= $escaper->escapeHtml($css('flex gap-4 my-8 justify-between')) ?>" data-item-id="<?= (int)$item->getItemId() ?>" data-item-qty="<?= (float)$item->getQty() ?>">
    <?= /* @noEscape */ $productImageHtml ?>

    <div class="<?= $escaper->escapeHtml($css('', 'outer grow')) ?>">
        <div class="<?= $escaper->escapeHtml($css('grow', 'inner mb-2')) ?>">
            <p><strong><?= $escaper->escapeHtml($item->getName()) ?><br></strong></p>

            <dl class="<?= $escaper->escapeHtml($css('text-sm grid grid-cols-2 sm:grid-cols-[auto_minmax(0px,1fr)] gap-x-2', 'list')) ?>">
                <dt class="<?= $escaper->escapeHtml($css('font-medium', 'price-label')) ?>">
                    <?= $escaper->escapeHtml(__('Price')) ?>:
                </dt>
                <dd class="<?= $escaper->escapeHtml($css('', 'price-value')) ?>">
                    <?= /* @noEscape */ $priceFormatterViewModel->format($item->getPriceInclTax()) ?>
                </dd>

                <dt class="<?= $escaper->escapeHtml($css('font-medium', 'qty-label')) ?>">
                    <?= $escaper->escapeHtml(__('Quantity')) ?>:
                </dt>
                <dd class="<?= $escaper->escapeHtml($css('', 'qty-value')) ?>">
                    <?= (float) $item->getQty() ?>
                </dd>

                <?php foreach ($productRendererViewModel->getProductOptions($item) as $option): ?>
                    <dt class="<?= $escaper->escapeHtml($css('font-medium', 'option-label')) ?>">
                        <?= $escaper->escapeHtml(__($option['label'])) ?>:
                    </dt>
                    <dd class="<?= $escaper->escapeHtml($css('', 'option-value')) ?>">
                        <?php $formattedOptionValue = $option['formatted'] ?>
                        <?php if (isset($formattedOptionValue['full_view'])): ?>
                            <?= $escaper->escapeHtml($formattedOptionValue['full_view']) ?>
                        <?php else: ?>
                            <?= $escaper->escapeHtml($formattedOptionValue['value'], ['span', 'a']) ?>
                        <?php endif; ?>
                    </dd>
                <?php endforeach; ?>
            </dl>

            <?php if ($options = $block->getProductOptions()): ?>
                <dl class="mt-4 item-options table text-sm">
                    <?php foreach ($options as $option): ?>
                        <?php $formatedOptionValue = $block->getFormatedOptionValue($option) ?>
                        <div class="table-row">
                            <dt class="table-cell font-normal min-w-16 pe-2 pb-1 text-fg-secondary">
                                <?= $escaper->escapeHtml($option['label']) ?>
                            </dt>
                            <dd class="table-cell font-bold pb-1">
                                <?php if (isset($formatedOptionValue['full_view'])): ?>
                                    <?= $escaper->escapeHtml($formatedOptionValue['full_view']) ?>
                                <?php else: ?>
                                    <?= $escaper->escapeHtml($formatedOptionValue['value'], ['span', 'a']) ?>
                                <?php endif; ?>
                            </dd>
                        </div>
                    <?php endforeach; ?>
                </dl>
            <?php endif;?>
        </div>

        <?= /* @noEscape */ $childRenderer->html($block, 'actions', [
            'alias' => 'actions',
            'item' => $item
        ]) ?>
    </div>
</div>
