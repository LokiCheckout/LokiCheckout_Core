<?php
declare(strict_types=1);

use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Magento\Framework\View\Element\Template;
use Magento\Quote\Api\Data\CartItemInterface;
use Yireo\LokiCheckout\ViewModel\PriceFormatter;
use Yireo\LokiCheckout\ViewModel\ProductImage;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
$priceFormatterViewModel = $viewModelFactory->create(PriceFormatter::class);
$productImageViewModel = $viewModelFactory->create(ProductImage::class);

/** @var CartItemInterface $item */
/** @var \Yireo\LokiCheckout\Util\BlockCssClass $blockCss */

$item = $block->getItem();
$width = 75;
$productImageUrl = $productImageViewModel->getImageUrlBySku($item->getSku(), $width);
?>
<li class="<?= $blockCss('flex gap-4') ?>">
    <img
        src="<?= $productImageUrl ?>"
        width="<?= $width ?>"
        height="<?= $width ?>"
        alt=""
        class="shrink-0"
    >
    <div class="grow">
        <p><strong><?= $item->getName() ?><br></strong></p>
        <dl class="text-sm grid grid-cols-2 sm:grid-cols-[auto_minmax(0px,1fr)] gap-x-2">
            <dt class="font-medium"><?= __('Price') ?>:</dt>
            <dd><?= $priceFormatterViewModel->format($item->getPrice()) ?></dd>
            <dt class="font-medium"><?= __('Quantity') ?>:</dt>
            <dd><?= $item->getQty() ?></dd>
        </dl>
    </div>
</li>
