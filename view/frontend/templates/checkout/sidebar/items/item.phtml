<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Magento\Quote\Api\Data\CartItemInterface;
use Loki\Components\Factory\ViewModelFactory;
use Loki\Components\Util\Block\ChildRenderer;
use LokiCheckout\Core\ViewModel\PriceFormatter;
use LokiCheckout\Core\ViewModel\ProductImage;

/** @version 2.1.6 */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var ChildRenderer $childRenderer */
/** @var CartItemInterface $item */
/** @var CssClass $css */

$item = $block->getItem();
$width = (int)$block->getWidth();
if (empty($width)) {
    $width = 75;
}

$childRenderer = $viewModelFactory->create(ChildRenderer::class);
$priceFormatterViewModel = $viewModelFactory->create(PriceFormatter::class);
$productImageViewModel = $viewModelFactory->create(ProductImage::class);
$productImageHtml = $productImageViewModel->getImage($item, $width);
?>
<div class="<?= $escaper->escapeHtmlAttr($css('flex gap-4 my-8 justify-between')) ?>" data-item-id="<?= (int)$item->getItemId() ?>" data-item-qty="<?= (float)$item->getQty() ?>">
    <?= /* @noEscape */ $productImageHtml ?>

    <div class="<?= $escaper->escapeHtmlAttr($css('', 'outer grow')) ?>">
        <div class="<?= $escaper->escapeHtmlAttr($css('grow', 'inner')) ?>">
            <p><strong><?= $escaper->escapeHtml($item->getName()) ?><br></strong></p>
            <dl class="<?= $escaper->escapeHtmlAttr($css('text-sm grid grid-cols-2 sm:grid-cols-[auto_minmax(0px,1fr)] gap-x-2', 'list')) ?>">
                <dt class="<?= $escaper->escapeHtmlAttr($css('font-medium', 'price-label')) ?>">
                    <?= $escaper->escapeHtml(__('Price')) ?>:
                </dt>
                <dd class="<?= $escaper->escapeHtmlAttr($css('', 'price-value')) ?>">
                    <?= /* @noEscape */ $priceFormatterViewModel->format($item->getPriceInclTax()) ?>
                </dd>
                <dt class="<?= $escaper->escapeHtmlAttr($css('font-medium', 'qty-label')) ?>">
                    <?= $escaper->escapeHtml(__('Quantity')) ?>:
                </dt>
                <dd class="<?= $escaper->escapeHtmlAttr($css('', 'qty-value')) ?>">
                    <?= (float) $item->getQty() ?>
                </dd>
            </dl>
        </div>

        <?= /* @noEscape */ $childRenderer->html($block, 'actions', [
            'alias' => 'actions',
            'item' => $item
        ]) ?>
    </div>
</div>
