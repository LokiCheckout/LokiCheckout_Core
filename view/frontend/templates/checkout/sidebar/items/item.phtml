<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Magewire\Checkout\Sidebar\Items;
use Yireo\LokiCheckout\Util\Block\BlockAttribute;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;
use Yireo\LokiCheckout\ViewModel\PriceFormatter;
use Yireo\LokiCheckout\ViewModel\ProductImage;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var BlockRenderer $blockRenderer */
/** @var array $item */
/** @var CssClass $css */
/** @var BlockAttribute $blockAttribute */

$priceFormatterViewModel = $viewModelFactory->create(PriceFormatter::class);
$productImageViewModel = $viewModelFactory->create(ProductImage::class);

$item = $block->getItem();
$width = 75;
$productImageUrl = $productImageViewModel->getImageUrlBySku($item['sku'], $width);
?>
<div <?= $blockAttribute() ?> class="<?= $css('flex gap-4 my-8') ?>">
    <img
        src="<?= $productImageUrl ?>"
        width="<?= $width ?>"
        height="<?= $width ?>"
        alt=""
        class="shrink-0"
    >
    <div>
        <div class="grow">
            <p><strong><?= $item['name'] ?><br></strong></p>
            <dl class="text-sm grid grid-cols-2 sm:grid-cols-[auto_minmax(0px,1fr)] gap-x-2">
                <dt class="font-medium"><?= __('Price') ?>:</dt>
                <dd><?= $priceFormatterViewModel->format($item['price']) ?></dd>
                <dt class="font-medium"><?= __('Quantity') ?>:</dt>
                <dd><?= $item['qty'] ?></dd>
            </dl>
        </div>

        <?= $block->getChildHtml('actions') ?>
    </div>

    <?= $block->getChildHtml('additional') ?>
</div>
