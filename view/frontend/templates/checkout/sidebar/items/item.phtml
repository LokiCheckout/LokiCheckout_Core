<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;
use Yireo\LokiCheckout\ViewModel\PriceFormatter;
use Yireo\LokiCheckout\ViewModel\ProductImage;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var BlockRenderer $blockRenderer */
/** @var array $item */
/** @var CssClass $css */
$priceFormatterViewModel = $viewModelFactory->create(PriceFormatter::class);
$productImageViewModel = $viewModelFactory->create(ProductImage::class);

$item = $block->getItem();
$width = 75;
$productImageUrl = $productImageViewModel->getImageUrlBySku($item['sku'], $width);
?>
<div class="<?= $css('flex gap-4 my-8') ?>">
    <img
        src="<?= $productImageUrl ?>"
        width="<?= $width ?>"
        height="<?= $width ?>"
        alt=""
        class="<?= $css('shrink-0', 'image') ?>"
    >
    <div class="<?= $css('', 'outer') ?>">
        <div class="<?= $css('grow', 'inner') ?>">
            <p><strong><?= $item['name'] ?><br></strong></p>
            <dl class="<?= $css('text-sm grid grid-cols-2 sm:grid-cols-[auto_minmax(0px,1fr)] gap-x-2', 'list') ?>">
                <dt class="<?= $css('font-medium', 'price-label') ?>">
                    <?= __('Price') ?>:
                </dt>
                <dd class="<?= $css('', 'price-value') ?>">
                    <?= $priceFormatterViewModel->format($item['price']) ?>
                </dd>
                <dt class="<?= $css('font-medium', 'qty-label') ?>">
                    <?= __('Quantity') ?>:
                </dt>
                <dd class="<?= $css('', 'qty-value') ?>">
                    <?= $item['qty'] ?>
                </dd>
            </dl>
        </div>

        <?= $blockRenderer->getChildHtml('actions', $block, ['item' => $item]) ?>
    </div>
</div>
