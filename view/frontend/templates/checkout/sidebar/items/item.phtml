<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Magento\Quote\Api\Data\CartItemInterface;
use Loki\Components\Factory\ViewModelFactory;
use Loki\Components\Util\Block\ChildRenderer;
use LokiCheckout\Core\ViewModel\PriceFormatter;
use LokiCheckout\Core\ViewModel\ProductImage;

/** @version 2.0.21 */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var ChildRenderer $childRenderer */
/** @var CartItemInterface $item */
/** @var CssClass $css */

$item = $block->getItem();
$width = (int)$block->getWidth();
if (empty($width)) {
    $width = 75;
}

$childRenderer = $viewModelFactory->create(ChildRenderer::class);
$priceFormatterViewModel = $viewModelFactory->create(PriceFormatter::class);
$productImageViewModel = $viewModelFactory->create(ProductImage::class);
$productImageUrl = $productImageViewModel->getImageUrlBySku($item->getSku(), $width);
?>
<div class="<?= /* @noEscape */ $css('flex gap-4 my-8') ?>" data-item-id="<?= (int)$item->getItemId() ?>" data-item-qty="<?= (float)$item->getQty() ?>">
    <img
        src="<?= $escaper->escapeHtml($productImageUrl) ?>"
        width="<?= $escaper->escapeHtml($width) ?>"
        alt="<?= $escaper->escapeHtml($item->getName()) ?>"
        loading="lazy"
        class="<?= /* @noEscape */ $css('hidden md:block h-full', 'image') ?>"
    >
    <div class="<?= /* @noEscape */ $css('', 'outer grow') ?>">
        <div class="<?= /* @noEscape */ $css('grow', 'inner') ?>">
            <p><strong><?= $escaper->escapeHtml($item->getName()) ?><br></strong></p>
            <dl class="<?= /* @noEscape */ $css('text-sm grid grid-cols-2 sm:grid-cols-[auto_minmax(0px,1fr)] gap-x-2', 'list') ?>">
                <dt class="<?= /* @noEscape */ $css('font-medium', 'price-label') ?>">
                    <?= $escaper->escapeHtml(__('Price')) ?>:
                </dt>
                <dd class="<?= /* @noEscape */ $css('', 'price-value') ?>">
                    <?= /* @noEscape */ $priceFormatterViewModel->format($item->getPriceInclTax()) ?>
                </dd>
                <dt class="<?= /* @noEscape */ $css('font-medium', 'qty-label') ?>">
                    <?= $escaper->escapeHtml(__('Quantity')) ?>:
                </dt>
                <dd class="<?= /* @noEscape */ $css('', 'qty-value') ?>">
                    <?= (float) $item->getQty() ?>
                </dd>
            </dl>
        </div>

        <?= /* @noEscape */ $childRenderer->html($block,'actions', [
            'alias' => 'actions',
            'item' => $item
        ]) ?>
    </div>
</div>
