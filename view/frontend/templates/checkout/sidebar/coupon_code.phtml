<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Loki\Components\Factory\ViewModelFactory;
use Loki\Components\Util\Block\ChildRenderer;
use Loki\Components\Util\Block\ImageRenderer;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use LokiCheckout\Core\Component\Checkout\Sidebar\CouponCode\CouponCodeViewModel;
use Loki\Components\Util\Block\BlockRenderer;

/** @version 2.1.10 */
/** @var Template $block */
/** @var CouponCodeViewModel $viewModel */
/** @var CssClass $css */
/** @var Escaper $escaper */
/** @var BlockRenderer $blockRenderer */
/** @var ChildRenderer $childRenderer */
/** @var ViewModelFactory $viewModelFactory */
/** @var ImageRenderer $imageRenderer */


$couponCode = $viewModel->getValue();
?>
<div class="<?= $escaper->escapeHtmlAttr($css('border-b border-gray-200 relative')) ?>">
    <?= /* @noEscape */ $blockRenderer->html($block, 'loki-field-components.utils.loader-overlay') ?>
    <?php if (!empty($couponCode)): ?>
        <?= /* @noEscape */ $childRenderer->html($block, 'value', [
            'coupon_code' => $viewModel->getValue()
        ]) ?>

    <?php else: ?>
        <details x-ref="details" :open="hasCouponCode" class="<?= $escaper->escapeHtmlAttr($css('group', 'details' )) ?>">
            <?= /* @noEscape */ $childRenderer->html($block, 'summary') ?>
            <?= /* @noEscape */ $childRenderer->html($block, 'form', [
                'field_id' => $viewModel->getFieldId(),
            ]) ?>
        </details>
    <?php endif; ?>

    <?= /* @noEscape */ $block->getChildHtml('script') ?>
</div>
