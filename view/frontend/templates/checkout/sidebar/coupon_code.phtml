<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Magewire\Checkout\Sidebar\CouponCode;
use Yireo\LokiCheckout\Util\Block\BlockAttribute;
use Yireo\LokiCheckout\Util\Block\BlockCssClass;
use Yireo\LokiCheckout\ViewModel\CheckoutState;

/** @var Template $block */
/** @var CouponCode $magewire */
/** @var ViewModelFactory $viewModelFactory */
/** @var CheckoutState $checkoutState */
/** @var BlockCssClass $blockCss */
/** @var BlockAttribute $blockAttribute */

$checkoutState = $viewModelFactory->create(CheckoutState::class);
$quote = $checkoutState->getQuote();
$couponCode = $quote->getCouponCode();
?>
<div <?= $blockAttribute() ?> class="<?= $blockCss('border-b border-gray-200') ?>">
    <?php if (!empty($couponCode)): ?>
        <p class="mb-4">
            <span><?= $escaper->escapeHtml(__('Coupon code')) ?>: </span>
            <strong><?= $couponCode ?></strong>
        </p>
        <button
            type="button"
            class="btn btn-secondary"
            wire:click="removeCouponCode"
            wire:loading.attr="disabled"
        ><?= __('Remove coupon code') ?></button>
    <?php else: ?>
        <details class="group">
            <summary class="flex gap-2 justify-between items-center w-full py-3 font-medium [&::-webkit-details-marker]:hidden cursor-pointer">
                <span><?= __('Discount Code') ?></span>
                <img
                    alt="<?= __('Expand') ?>"
                    src="<?= $block->getViewFileUrl('Yireo_LokiCheckout::images/chevron-down.svg'); ?>"
                    class="<?= $blockCss('') ?> inline-block group-open:rotate-180 transition-transform"
                    width="20"
                    height="20"
                >
            </summary>

            <div>
                <label class="block mb-3">
                    <span class="sr-only"><?php __('Discount Code') ?></span>
                    <input type="text" wire:model.lazy="couponCode" class="form-input w-full">
                </label>
                <button
                    type="button"
                    class="btn btn-secondary w-full justify-center text-center"
                    wire:click="applyCouponCode"
                    wire:loading.attr="disabled"
                ><?= __('Apply') ?></button>
            </div>
        </details>
    <?php endif; ?>

    <?= $block->getChildHtml('script') ?>
</div>
