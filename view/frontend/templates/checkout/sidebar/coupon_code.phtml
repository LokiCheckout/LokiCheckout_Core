<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Magewire\Checkout\Sidebar\CouponCode;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\ViewModel\CheckoutState;

/** @var Template $block */
/** @var CouponCode $magewire */
/** @var ViewModelFactory $viewModelFactory */
/** @var CheckoutState $checkoutState */
/** @var CssClass $css */

$checkoutState = $viewModelFactory->create(CheckoutState::class);
$quote = $checkoutState->getQuote();
$couponCode = $quote->getCouponCode();
?>
<div  class="<?= $css('border-b border-gray-200') ?>">
    <?php if (!empty($couponCode)): ?>
        <p class="<?= $css('mb-4', 'current') ?>">
            <span><?= $escaper->escapeHtml(__('Coupon code')) ?>: </span>
            <strong><?= $couponCode ?></strong>
        </p>
        <button
            type="button"
            class="<?= $css('btn btn-secondary', 'button-remove') ?>"
            wire:click="removeCouponCode"
            wire:loading.attr="disabled"
        ><?= __('Remove coupon code') ?></button>
    <?php else: ?>
        <details class="<?= $css('group', 'details' ) ?>">
            <summary class="<?= $css('flex gap-2 justify-between items-center w-full py-3 font-medium [&::-webkit-details-marker]:hidden cursor-pointer', 'summary') ?>'">
                <span><?= __('Apply Discount Code') ?></span>
                <img
                    alt="<?= __('Expand') ?>"
                    src="<?= $block->getViewFileUrl('Yireo_LokiCheckout::images/chevron-down.svg'); ?>"
                    class="<?= $css('inline-block group-open:rotate-180 transition-transform') ?>"
                    width="20"
                    height="20"
                >
            </summary>

            <div>
                <label class="<?= $css('block mb-3', 'label') ?>">
                    <span class="<?= $css('sr-only', 'label-inner') ?>"><?php __('Discount Code') ?></span>
                    <input type="text" wire:model.lazy="couponCode" class="<?= $css('form-input w-full', 'input') ?>">
                </label>
                <button
                    type="button"
                    class="<?= $css('btn btn-secondary w-full justify-center text-center', 'button-apply') ?>"
                    wire:click="applyCouponCode"
                    wire:loading.attr="disabled"
                ><?= __('Apply') ?></button>
            </div>
        </details>
    <?php endif; ?>

    <?= $block->getChildHtml('script') ?>
</div>
