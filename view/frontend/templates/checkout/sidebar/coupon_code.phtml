<?php
declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HeroiconsOutline;
use Magento\Framework\View\Element\Template;
use Yireo\FriggaCheckout\Magewire\Checkout\Sidebar\CouponCode;
use Yireo\FriggaCheckout\ViewModel\CheckoutState;

/** @var Template $block */
/** @var ViewModelRegistry $viewModels */
/** @var CouponCode $magewire */
/** @var ViewModelRegistry $viewModels */
/** @var CheckoutState $checkoutState */
$checkoutState = $viewModels->require(CheckoutState::class);
$quote = $checkoutState->getQuote();
$couponCode = $quote->getCouponCode();
$heroicons = $viewModels->require(HeroiconsOutline::class);
?>
<div class="border-b border-gray-400 my-4">
    <div x-data="FriggaCheckoutSidebarCouponCode">
        <?php if (!empty($couponCode)): ?>
            Coupon code: <span><?= $couponCode ?></span>
            <button class="btn btn-secondary mt-4"
                    type="button"
                    wire:click="removeCouponCode"
                    wire:loading.attr="disabled">
                <?= __('Remove coupon code') ?>

            </button>
        <?php else: ?>
            <button type="button" @click="toggle" class="text-sm">
                <?= __('Discount Code') ?>
                <?= $heroicons->chevronDownHtml('inline w-4 h-4', 32, 32) ?>
            </button>

            <div x-show="show">
                <label>
                    <span class="sr-only"><?php __('Discount Code') ?></span>
                    <input type="text" wire:model.lazy="couponCode" class="form-input w-full"/>
                </label>
                <button class="btn btn-secondary text-sm mt-4"
                        type="button"
                        wire:click="applyCouponCode"
                        wire:loading.attr="disabled">
                    <?= __('Apply') ?>
                </button>
            </div>
        <?php endif; ?>
    </div>

    <?= $block->getChildHtml('script') ?>
</div>
