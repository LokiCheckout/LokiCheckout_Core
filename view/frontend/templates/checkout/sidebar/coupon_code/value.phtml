<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @version 2.1.8 */
/** @var Template $block */
/** @var CssClass $css */
/** @var Escaper $escaper */

$couponCode = $block->getCouponCode();
?>
<div class="<?= $escaper->escapeHtmlAttr($css('mb-4')) ?>">
    <p class="<?= $escaper->escapeHtmlAttr($css('mb-4', 'value')) ?>">
        <span>
            <?= $escaper->escapeHtml(__('Coupon code')) ?>:
        </span>
        <strong><?= $escaper->escapeHtml($couponCode) ?></strong>
    </p>
    <button
        type="button"
        class="<?= $escaper->escapeHtmlAttr($css('btn btn-secondary', 'button-remove')) ?>"
        @click.prevent="removeCouponCode">
        <?= $escaper->escapeHtml(__('Remove coupon code')) ?>
    </button>
</div>
