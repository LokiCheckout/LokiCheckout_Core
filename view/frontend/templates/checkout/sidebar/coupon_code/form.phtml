<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @version 2.0.17 */
/** @var Template $block */
/** @var CssClass $css */
/** @var Escaper $escaper */

$fieldId = $block->getFieldId();
?>
<div>
    <label
        for="<?= $escaper->escapeHtml($fieldId) ?>"
        class="<?= /* @noEscape */ $css('block mb-3', 'label') ?>">
        <span class="<?= /* @noEscape */ $css('sr-only', 'label-inner') ?>">
            <?= $escaper->escapeHtml(__('Discount Code')) ?>
        </span>
    </label>

    <input
        autocomplete="off"
        name="coupon_code"
        type="text"
        x-ref="input"
        :value="value"
        @change="setValue"
        id="<?= $escaper->escapeHtml($fieldId) ?>"
        aria-label="<?= $escaper->escapeHtml(__('Discount Code')) ?>"
        class="<?= /* @noEscape */ $css('form-input w-full mb-3', 'input') ?>">

    <button
        type="button"
        class="<?= /* @noEscape */ $css('btn btn-secondary w-full justify-center text-center', 'button-apply') ?>"
        @click="applyCouponCode">
        <?= $escaper->escapeHtml(__('Apply')) ?>
    </button>
</div>
