<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\DataObject;
use Magento\Framework\View\Element\Template;
use Loki\Components\Factory\ViewModelFactory;
use Loki\Components\Util\Block\CssClass;
use LokiCheckout\Core\ViewModel\PriceFormatter;

/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var DataObject $total */
/** @var CssClass $css */
// @doc: Document this overriding mechanism

$total = $block->getTotal();
$priceFormatter = $viewModelFactory->create(PriceFormatter::class);
?>
<dt class="total label <?= /* @noEscape */ $css('font-bold', $total->getCode() . '-label') ?>">
    <?= $escaper->escapeHtml(__(trim($total->getTitle()))) ?>
</dt>
<dd class="total value <?= /* @noEscape */ $css('text-right', $total->getCode() . '-value') ?>">
    <?= /* @noEscape */ $priceFormatter->format($total->getValue()) ?>
</dd>
