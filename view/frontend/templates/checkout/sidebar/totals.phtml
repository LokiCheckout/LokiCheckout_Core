<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Util\Block\BlockAttribute;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\ViewModel\CheckoutState;
use Yireo\LokiCheckout\ViewModel\PriceFormatter;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var PriceFormatter $priceFormatter */
/** @var CheckoutState $checkoutState */
/** @var CssClass $css */
/** @var BlockAttribute $blockAttribute */

$checkoutState = $viewModelFactory->create(CheckoutState::class);
$quote = $checkoutState->getQuote()->collectTotals();
$priceFormatter = $viewModelFactory->create(PriceFormatter::class);
?>
<div <?= $blockAttribute() ?> class="<?= $css('') ?>">
    <dl class="grid grid-cols-2 gap-y-1 ">
        <dt class="font-medium"><?= __('Subtotal') ?></dt>
        <dd class="text-right"><?= $priceFormatter->format($quote->getSubtotal()) ?></dd>
        <dt class="font-medium"><?= __('Shipping & Handling') ?></dt>
        <dd class="text-right"><?= $priceFormatter->format($quote->getShippingAmount()) ?></dd>
        <dt class="font-medium"><?= __('Tax') ?></dt>
        <dd class="text-right"><?= $priceFormatter->format($quote->getTaxAmount()) ?></dd>
        <div class="font-bold text-lg grid grid-cols-2 gap-x-2 col-span-full">
            <dt><?= __('Grand Total') ?></dt>
            <dd class="text-right"><?= $priceFormatter->format($quote->getGrandTotal()) ?></dd>
        </div>
    </dl>
</div>
