<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;
use Yireo\LokiCheckout\Util\Cart\CartTotals;
use Yireo\LokiComponents\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\ViewModel\PriceFormatter;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var PriceFormatter $priceFormatter */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */
/** @var CartTotals $cartTotals */

$priceFormatter = $viewModelFactory->create(PriceFormatter::class);
$cartTotals = $viewModelFactory->create(CartTotals::class);
$totals = $cartTotals->getTotals();
?>
<div class="<?= $css('relative') ?>">
    <?= $blockRenderer->html($block,'loki-checkout.utils.loader-overlay') ?>

    <dl class="<?= $css('grid grid-cols-2 gap-y-1', 'grid') ?>">
        <?= $block->getChildHtml('before') ?>

        <?php foreach ($totals as $total) : ?>
            <?php $childBlock = $block->getChildBlock($total->getCode()); ?>
            <?php if ($childBlock) : ?>
                <?= $childBlock->setData(['total' => $total])->toHtml() ?>
            <?php else: ?>
                <dt class="<?= $css('font-medium', $total->getCode() . '-label') ?>">
                    <?= __($total->getTitle()) ?>
                </dt>
                <dd class="<?= $css('text-right', $total->getCode() . '-value') ?>">
                    <?= $priceFormatter->format($total->getValue()) ?>
                </dd>
            <?php endif; ?>
        <?php endforeach; ?>
        <?= $block->getChildHtml('after') ?>
    </dl>
</div>
