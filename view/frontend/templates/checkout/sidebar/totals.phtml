<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use LokiCheckout\Core\ViewModel\CheckoutState;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Util\Block\BlockRenderer;
use Loki\Components\Factory\ViewModelFactory;
use LokiCheckout\Core\ViewModel\PriceFormatter;

/** @version 2.5.2 */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var PriceFormatter $priceFormatter */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */
/** @var CheckoutState $checkoutState */

$priceFormatter = $viewModelFactory->create(PriceFormatter::class);
$checkoutState = $viewModelFactory->create(CheckoutState::class);
$totals = $checkoutState->calculateTotals();
$totalSegments = $totals->getTotalSegments();
?>
<div class="<?= $escaper->escapeHtml($css('relative')) ?>">
    <?= /* @noEscape */ $blockRenderer->html($block, 'loki-field-components.utils.loader-overlay') ?>

    <dl class="<?= $escaper->escapeHtml($css('grid grid-cols-2 gap-y-1', 'grid')) ?>">
        <?= /* @noEscape */ $block->getChildHtml('before') ?>

        <?php foreach ($totalSegments as $total) : ?>
            <?php $childBlock = $block->getChildBlock($total->getCode()); ?>
            <?php if ($childBlock) : ?>
                <?= /* @noEscape */ $childBlock->setData(['total' => $total, 'totals' => $totals])->toHtml() ?>
            <?php else: ?>
                <dt
                    class="<?= $escaper->escapeHtml($css('font-medium', $total->getCode() . '-label')) ?>"
                >
                    <?= $escaper->escapeHtml(__(trim((string)$total->getTitle()))) ?>
                </dt>
                <dd
                    class="<?= $escaper->escapeHtml($css('text-right', $total->getCode() . '-value')) ?>"
                    data-code="<?= $escaper->escapeHtml($total->getCode()) ?>"
                >
                    <?= /* @noEscape */ $priceFormatter->format($total->getValue()) ?>
                </dd>
            <?php endif; ?>
        <?php endforeach; ?>
        <?= /* @noEscape */ $block->getChildHtml('after') ?>
    </dl>
</div>
