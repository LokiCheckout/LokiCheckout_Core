<?php
declare(strict_types=1);

use Yireo\FriggaCheckout\Factory\ViewModelFactory;
use Magento\Framework\View\Element\Template;
use Yireo\FriggaCheckout\Magewire\Checkout\Sidebar\Totals;
use Yireo\FriggaCheckout\ViewModel\CheckoutState;
use Yireo\FriggaCheckout\ViewModel\PriceFormatter;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var PriceFormatter $priceFormatter */
/** @var CheckoutState $checkoutState */
/** @var string $blockClass */

$checkoutState = $viewModelFactory->create(CheckoutState::class);
$quote = $checkoutState->getQuote();
$priceFormatter = $viewModelFactory->create(PriceFormatter::class);
?>
<div class="<?= $blockClass ?> border-b border-gray-400 my-8">
    <div class="grid grid-cols-2">
        <div class="label"><?= __('Subtotal') ?></div>
        <div class="value text-right"><?= $priceFormatter->format($quote->getSubtotal()) ?></div>
        <div class="label"><?= __('Shipping & Handling') ?></div>
        <div class="value text-right"><?= $priceFormatter->format($quote->getShippingAmount()) ?></div>
        <div class="label"><?= __('Tax') ?></div>
        <div class="value text-right"><?= $priceFormatter->format($quote->getTaxAmount()) ?></div>
    </div>
    <div class="grid grid-cols-2">
        <div class="label font-bold"><?= __('Grand Total') ?></div>
        <div class="text-right font-bold"><?= $priceFormatter->format($quote->getGrandTotal()) ?></div>
    </div>
</div>
