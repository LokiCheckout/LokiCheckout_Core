<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\ViewModel\CheckoutState;
use Yireo\LokiCheckout\ViewModel\PriceFormatter;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var PriceFormatter $priceFormatter */
/** @var CheckoutState $checkoutState */
/** @var CssClass $css */

$checkoutState = $viewModelFactory->create(CheckoutState::class);
$quote = $checkoutState->getQuote()->collectTotals();
$priceFormatter = $viewModelFactory->create(PriceFormatter::class);
?>
<div class="<?= $css('') ?>">
    <dl class="<?= $css('grid grid-cols-2 gap-y-1', 'grid') ?>">
        <?= $block->getChildHtml('after') ?>

        <dt class="<?= $css('font-medium', 'subtotal-label') ?>">
            <?= __('Subtotal') ?>
        </dt>
        <dd class="<?= $css('text-right', 'subtotal-value') ?>">
            <?= $priceFormatter->format($quote->getSubtotal()) ?>
        </dd>

        <dt class="<?= $css('font-medium', 'shipping-label') ?>">
            <?= __('Shipping & Handling') ?>
        </dt>
        <dd class="<?= $css('text-right', 'shipping-value') ?>">
            <?= $priceFormatter->format($quote->getShippingAmount()) ?>
        </dd>

        <dt class="<?= $css('font-medium', 'tax-label') ?>">
            <?= __('Tax') ?>
        </dt>
        <dd class="<?= $css('text-right', 'tax-value') ?>">
            <?= $priceFormatter->format($quote->getTaxAmount()) ?>
        </dd>

        <?= $block->getChildHtml('inner') ?>

        <dt class="<?= $css('font-bold text-lg', 'total-label') ?>">
            <?= __('Grand Total') ?>
        </dt>
        <dd class="<?= $css('font-bold text-lg text-right', 'total-value') ?>">
            <?= $priceFormatter->format($quote->getGrandTotal()) ?>
        </dd>

        <?= $block->getChildHtml('after') ?>
    </dl>
</div>
