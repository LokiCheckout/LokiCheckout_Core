<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Loki\Components\Util\Block\ChildRenderer;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use LokiCheckout\Core\Component\Checkout\ProgressBar\ProgressBarViewModel;
use LokiCheckout\Core\Component\Checkout\Step\StepViewModelInterface;
use Loki\Components\Factory\ViewModelFactory;
use LokiCheckout\Core\Step\StepNavigator;
use Loki\Components\Util\Block\BlockRenderer;

/** @version 2.1.1 */
/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelFactory $viewModelFactory */
/** @var ProgressBarViewModel $viewModel */
/** @var StepNavigator $stepNavigator */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */
/** @var ChildRenderer $childRenderer */
/** @var StepViewModelInterface $step */

$stepNavigator = $viewModelFactory->create(StepNavigator::class);
$step = $block->getStep();
$isActive = $step->getCode() === $stepNavigator->getCurrentStep()?->getCode();

$innerHtml = $childRenderer->html($block, 'inner', ['step' => $step, 'is_active' => $isActive]);
?>
<li
    class="<?= $escaper->escapeHtmlAttr($css('step flex items-center aria-[current=step]:font-bold')) ?>"
    <?php if ($isActive): ?>aria-current="step"<?php endif; ?>
>
    <?php if (false === $step->isEnabled()): ?>
        <span class="<?= $escaper->escapeHtmlAttr($css('opacity-60 cursor-not-allowed', 'disabled')) ?>">
            <?= $escaper->escapeHtml($innerHtml) ?>
        </span>
    <?php elseif (false === $step->isAccessable()): ?>
        <span class="<?= $escaper->escapeHtmlAttr($css('', 'enabled')) ?>">
             <?= $escaper->escapeHtml($innerHtml) ?>
        </span>
    <?php else: ?>
        <button
            @click.prevent="submit"
            data-step="<?= $escaper->escapeHtml($step->getCode()) ?>"
            class="<?= $escaper->escapeHtmlAttr($css('w-full h-auto', 'button')) ?>">
            <?= $escaper->escapeHtml($innerHtml) ?>
        </button>
    <?php endif; ?>
</li>
