<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Component\Checkout\ProgressBar\ProgressBarViewModel;
use Yireo\LokiCheckout\Component\Checkout\Step\StepViewModelInterface;
use Yireo\LokiComponents\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Step\StepNavigator;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;
use Yireo\LokiCheckout\Util\Block\CssClass;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelFactory $viewModelFactory */
/** @var ProgressBarViewModel $viewModel */
/** @var StepNavigator $stepNavigator */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */
/** @var StepViewModelInterface $step */

$blockRenderer = $viewModelFactory->create(BlockRenderer::class);
$stepNavigator = $viewModelFactory->create(StepNavigator::class);
$step = $block->getStep();
$isActive = $step->getCode() === $stepNavigator->getCurrentStep()?->getCode();
$skipSeparator = (bool)$block->getSkipSeparator(); // @doc skip_separator = true
?>
<li
    class="<?= $css('step flex items-center aria-[current=step]:font-bold') ?>"
    <?php if ($isActive): ?>
        aria-current="step"
    <?php endif; ?>
>
    <?php if (false === $step->isEnabled()): ?>
        <span class="<?= $css('opacity-60 cursor-not-allowed', 'disabled') ?>">
             <?= $step->getLabel() ?>
        </span>
    <?php elseif (false === $step->isAccessable()): ?>
        <span class="<?= $css('', 'enabled') ?>">
             <?= $step->getLabel() ?>
        </span>
    <?php else: ?>
        <button @click="submit" data-step="<?= $step->getCode() ?>">
            <?= __($step->getLabel()) ?>
        </button>
    <?php endif; ?>

    <?php if (false === $skipSeparator && false === $stepNavigator->isLastStep($step)): ?>
        <span class="<?= $css('inline-flex justify-center items-center px-2', 'separator') ?>" aria-hidden="true">
             <?= $blockRenderer->html('loki-checkout.utils.separator') ?>
        </span>
    <?php endif; ?>
</li>
