<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use LokiCheckout\Core\Component\Checkout\ProgressBar\ProgressBarViewModel;
use LokiCheckout\Core\Component\Checkout\Step\StepViewModelInterface;
use Loki\Components\Factory\ViewModelFactory;
use LokiCheckout\Core\Step\StepNavigator;
use Loki\Components\Util\Block\BlockRenderer;
use Loki\Components\Util\Block\CssClass;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelFactory $viewModelFactory */
/** @var ProgressBarViewModel $viewModel */
/** @var StepNavigator $stepNavigator */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */
/** @var StepViewModelInterface $step */

$blockRenderer = $viewModelFactory->create(BlockRenderer::class);
$stepNavigator = $viewModelFactory->create(StepNavigator::class);
$step = $block->getStep();
$isActive = $step->getCode() === $stepNavigator->getCurrentStep()?->getCode();
$skipSeparator = (bool)$block->getSkipSeparator(); // @doc skip_separator = true
?>
<li
    class="<?= /* @noEscape */ $css('step flex items-center aria-[current=step]:font-bold') ?>"
    <?php if ($isActive): ?>
        aria-current="step"
    <?php endif; ?>
>
    <?php if (false === $step->isEnabled()): ?>
        <span class="<?= /* @noEscape */ $css('opacity-60 cursor-not-allowed', 'disabled') ?>">
             <?= $escaper->escapeHtml($step->getLabel()) ?>
        </span>
    <?php elseif (false === $step->isAccessable()): ?>
        <span class="<?= /* @noEscape */ $css('', 'enabled') ?>">
             <?= $escaper->escapeHtml($step->getLabel()) ?>
        </span>
    <?php else: ?>
        <button @click="submit" data-step="<?= $escaper->escapeHtml($step->getCode()) ?>">
            <?= $escaper->escapeHtml(__($step->getLabel())) ?>
        </button>
    <?php endif; ?>

    <?php if (false === $skipSeparator && false === $stepNavigator->isLastStep($step)): ?>
        <span class="<?= /* @noEscape */ $css('inline-flex justify-center items-center px-2', 'separator') ?>" aria-hidden="true">
             <?= /* @noEscape */ $blockRenderer->html($block,'loki-checkout.utils.separator') ?>
        </span>
    <?php endif; ?>
</li>
