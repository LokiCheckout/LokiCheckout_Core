<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Loki\Components\Factory\ViewModelFactory;
use Loki\Field\ViewModel\ImageOutput;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use LokiCheckout\Core\Component\Checkout\Step\StepViewModelInterface;

/** @version 2.0.23 */
/** @var Template $block */
/** @var Escaper $escaper */
/** @var StepViewModelInterface $step */
/** @var CssClass $css */
/** @var ViewModelFactory $viewModelFactory */
/** @var ImageOutput $imageOutput */

$imageOutput = $viewModelFactory->create(ImageOutput::class);

$step = $block->getStep();
$isActive = (bool)$block->getIsActive();
$inactiveClass = $block->getInactiveClass();
$activeClass = $block->getActiveClass();

$iconHtml = $imageOutput->get('LokiCheckout_Core::images/'.$step->getCode().'.svg');
?>
<div
    class="<?= /* @noEscape */ $css('w-6') ?> <?= $isActive ? $escaper->escapeHtml($activeClass) : $escaper->escapeHtml($inactiveClass) ?>"
    aria-label="<?= $escaper->escapeHtml(__($escaper->escapeHtml($step->getLabel()))) ?>">
    <?= /** @noEscape */
$iconHtml ?>
</div>
