<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Loki\Components\Factory\ViewModelFactory;
use Loki\Components\Util\Block\ImageRenderer;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use LokiCheckout\Core\Component\Checkout\Step\StepViewModelInterface;

/** @version 2.3.10 */
/** @var Template $block */
/** @var Escaper $escaper */
/** @var StepViewModelInterface $step */
/** @var CssClass $css */
/** @var ViewModelFactory $viewModelFactory */
/** @var ImageRenderer $imageRenderer */



$step = $block->getStep();
$isActive = (bool)$block->getIsActive();
$inactiveClass = $block->getInactiveClass();
$activeClass = $block->getActiveClass();

$iconHtml = $imageRenderer->get('LokiCheckout_Core::images/'.$step->getCode().'.svg');
?>
<div
    class="<?= $escaper->escapeHtml($css('w-6')) ?> <?= $isActive ? $escaper->escapeHtml($activeClass) : $escaper->escapeHtml($inactiveClass) ?>"
    aria-label="<?= $escaper->escapeHtml(__($escaper->escapeHtml($step->getLabel()))) ?>">
    <?= /* @noEscape */ $iconHtml ?>
</div>
