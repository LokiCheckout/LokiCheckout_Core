<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Step\StepNavigator;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */
/** @var StepNavigator $stepNavigator */
$stepNavigator = $viewModelFactory->create(StepNavigator::class);
$currentStep = $stepNavigator->getCurrentStep();
?>
<div  class="<?= $css('') ?>" x-data="<?= $block->getComponentName() ?>">
    <?php foreach ($block->getChildNames() as $childName) : ?>
        <?php $stepBlock = $block->getLayout()->getBlock($childName); ?>
        <?php $step = $stepBlock->getMagewire(); ?>
        <div x-show="<?= $step->getCode() ?>" x-transition>
            <?= $block->getLayout()->getBlock($childName)->toHtml() ?>
        </div>
    <?php endforeach; ?>

    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.data('<?= $block->getComponentName() ?>', () => ({
                currentStep: '<?= $currentStep->getCode() ?>',
                <?php foreach ($stepNavigator->getSteps() as $step): ?>
                <?= $step->getCode() ?>: <?= $stepNavigator->isCurrentStep($step) ? 'true' : 'false' ?>,
                <?php endforeach; ?>
                init() {
                    this.currentStep = Alpine.store('step').currentStep;
                    Livewire.on('stepChange', (stepCode) => {
                        this.currentStep = stepCode;
                        <?php foreach ($stepNavigator->getSteps() as $step): ?>
                        this.<?= $step->getCode() ?> = '<?= $step->getCode() ?>' === stepCode;
                        <?php endforeach; ?>
                    });
                }
            }));
        });
    </script>
</div>
