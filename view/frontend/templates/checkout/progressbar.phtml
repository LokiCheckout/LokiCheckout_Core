<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Magento\Framework\Escaper;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Magewire\Checkout\Progressbar;
use Yireo\LokiCheckout\Step\StepNavigator;
use Yireo\LokiCheckout\ViewModel\CheckoutState;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelFactory $viewModelFactory */
/** @var Progressbar $magewire */
/** @var CheckoutState $checkoutState */
/** @var StepNavigator $stepNavigator */
/** @var \Yireo\LokiCheckout\Util\BlockCssClass $blockCss */

$checkoutState = $viewModelFactory->create(CheckoutState::class);
$stepNavigator = $viewModelFactory->create(StepNavigator::class);
?>
<nav
    class="<?= $blockCss('hidden md:block card rounded-lg') ?>"
    aria-label="<?= $escaper->escapeHtmlAttr(__('Pagination')) ?>"
>
    <ul class="flex items-center">
        <?php foreach ($stepNavigator->getSteps() as $step): ?>
            <?php $isActive = $step->getCode() === $stepNavigator->getCurrentStep()?->getCode(); ?>
            <li
                class="step flex items-center aria-[current=step]:font-bold"
                <?php if ($isActive): ?>
                    aria-current="step"
                <?php endif; ?>
            >
                <?php if (false === $step->isEnabled()): ?>
                    <span class="opacity-60 cursor-not-allowed">
                        <?= $step->getLabel() ?>
                    </span>
                <?php elseif (false === $step->isAccessable()): ?>
                    <span>
                        <?= $step->getLabel() ?>
                    </span>
                <?php else: ?>
                    <button wire:click="goToStep('<?= $step->getCode() ?>')">
                        <?= __($step->getLabel()) ?>
                    </button>
                <?php endif; ?>
                <?php if (false === $stepNavigator->isLastStep($step)): ?>
                    <span class="inline-flex justify-center items-center px-2" aria-hidden="true">
                        <?= $block->getBlockHtml('loki.checkout.utils.separator') ?>
                    </span>
                <?php endif; ?>
            </li>
        <?php endforeach; ?>
    </ul>

    <script>
        document.addEventListener('magewire:load', () => {
            Livewire.on('stepChange', (stepCode) => {
                window.location.hash = stepCode;
                document.body.scrollTop = 0;
                document.documentElement.scrollTop = 0;
            });
        });
    </script>
</nav>
