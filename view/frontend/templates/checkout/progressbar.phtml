<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use LokiCheckout\Core\Component\Checkout\ProgressBar\ProgressBarViewModel;
use Loki\Components\Util\Block\BlockRenderer;
use Loki\Components\Util\Block\ChildRenderer;
use Loki\Components\Factory\ViewModelFactory;
use LokiCheckout\Core\Step\StepNavigator;
use LokiCheckout\Core\ViewModel\CheckoutState;

/** @version 2.4.1 */
/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelFactory $viewModelFactory */
/** @var ProgressBarViewModel $viewModel */
/** @var CheckoutState $checkoutState */
/** @var StepNavigator $stepNavigator */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */
/** @var ChildRenderer $childRenderer */

$checkoutState = $viewModelFactory->create(CheckoutState::class);
$stepNavigator = $viewModelFactory->create(StepNavigator::class);
$skipSeparator = (bool)$block->getSkipSeparator(); // @doc skip_separator = true
?>
<nav
    class="<?= $escaper->escapeHtml($css('hidden md:block card rounded-lg relative')) ?>"
    aria-label="<?= $escaper->escapeHtml(__('Pagination')) ?>"
>
    <?= /* @noEscape */ $blockRenderer->html($block, 'loki-field-components.utils.overlay') ?>
    <ul class="<?= $escaper->escapeHtml($css('flex items-center', 'list')) ?>">
        <?= /* @noEscape */ $block->getChildHtml('before') ?>
        <?php foreach ($stepNavigator->getSteps() as $step): ?>
            <?= /* @noEscape */ $childRenderer->html($block, 'step', ['step' => $step]) ?>
            <?php if (false === $skipSeparator && false === $stepNavigator->isLastStep($step)): ?>
                <?= /* @noEscape */ $blockRenderer->html($block, 'loki-checkout.progressbar.separator') ?>
            <?php endif; ?>
        <?php endforeach; ?>
        <?= /* @noEscape */ $block->getChildHtml('after') ?>
    </ul>
</nav>
