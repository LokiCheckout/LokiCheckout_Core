<?php
declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HeroiconsOutline;
use Magento\Framework\View\Element\Template;
use Yireo\FriggaCheckout\Magewire\Checkout\Progressbar;
use Yireo\FriggaCheckout\Step\StepNavigator;
use Yireo\FriggaCheckout\ViewModel\CheckoutState;

/** @var Template $block */
/** @var ViewModelRegistry $viewModels */
/** @var Progressbar $magewire */
/** @var CheckoutState $checkoutState */
/** @var StepNavigator $stepNavigator */
/** @var string $blockClass */

$heroicons = $viewModels->require(HeroiconsOutline::class);
$checkoutState = $viewModels->require(CheckoutState::class);
$stepNavigator = $viewModels->require(StepNavigator::class);
?>
<div class="<?= $blockClass ?>">
    <ul class="opc-progress-bar flex" role="list">
        <?php foreach ($stepNavigator->getSteps() as $step): ?>
            <?php $isActive = $step->getCode() === $stepNavigator->getCurrentStep()?->getCode(); ?>
            <li class="opc-progress-bar-item pr-4 <?= $isActive ? 'active _active font-bold' : 'inactive' ?>">
                <?php if (false === $step->isEnabled()): ?>
                    <span class="text-gray-200">
                        <?= $step->getLabel() ?>
                    </span>
                <?php elseif (false === $step->isAccessable()): ?>
                    <span>
                        <?= $step->getLabel() ?>
                    </span>
                <?php else: ?>
                    <span>
                    <button wire:click="goToStep('<?= $step->getCode() ?>')">
                        <?= __($step->getLabel()) ?>
                    </button>
                    </span>
                <?php endif; ?>
                <?php if (false === $stepNavigator->isLastStep($step)): ?>
                    <span class="separator">
                        <?= $heroicons->chevronRightHtml('inline w-4 h-4 ml-2', 4, 4) ?>
                    </span>
                <?php endif; ?>
            </li>
        <?php endforeach; ?>
    </ul>

    <script>
        document.addEventListener('magewire:load', () => {
            Livewire.on('stepChange', (stepCode) => {
                window.location.hash = stepCode;
                document.body.scrollTop = 0;
                document.documentElement.scrollTop = 0;
            });
        });
    </script>
</div>
