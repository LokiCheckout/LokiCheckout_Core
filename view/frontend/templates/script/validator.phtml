<script>
    LokiCheckoutValidator = {
        validators: {
            required: (component) => {
                isValid = true;
                if (component.value === '' || component.value === undefined) {
                    component.messages.push({type:'error', text: '<?= __('Value is required') ?>'});
                    isValid = false;
                }

                return isValid;
            }
        },
        validate: function (component) {
            isValid = true;
            component.messages = [];

            if (!component.validators) {
                return true;
            }

            component.validators.every(validator => {
                if (this.validators[validator] === undefined) {
                    //yireoLokiCheckoutLogger('WARNING: Validator "' + validator + '" not found', component);
                    return true;
                }

                const result = this.validators[validator](component);
                if (Boolean(result && typeof result.then === 'function')) {
                    result.then(value => {
                        isValid = value;
                    })
                } else {
                    isValid = result;
                }

                return isValid;
            })

            if (false === isValid) {
                this.setInvalid(component);
            } else {
                this.setValid(component);
            }

            return isValid;
        },
        setInvalid: function (component) {
            component.valid = false;
            const elements = component.$root.querySelectorAll('[data-type="field"]');
            elements.forEach(element => {
                if (element.tagName === 'input') {
                    if (typeof element.setCustomValidity === 'function') {
                        element.setCustomValidity('Value is invalid');
                    }
                }
                element.setAttribute('aria-invalid', true);
            });

            document.dispatchEvent(new CustomEvent('loki:dom-update', {target: {element}}));
            document.dispatchEvent(new CustomEvent('yireo-loki-checkout.component-change', {detail: {component}}));
        },
        setValid: function (component) {
            component.valid = true;
            Array.from(component.$root.getElementsByTagName('input')).forEach(element => {
                if (typeof element.setCustomValidity === 'function') {
                    element.setCustomValidity('');
                }
                element.setAttribute('aria-invalid', false);
            });

            document.dispatchEvent(new CustomEvent('loki:dom-update', {target: {element}}));
            document.dispatchEvent(new CustomEvent('yireo-loki-checkout.component-change', {detail: {component}}));
        }
    }
</script>
