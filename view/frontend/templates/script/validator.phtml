<script>
    window.LokiCheckoutValidator = {
        rules: {
            required: (component) => {
                isValid = true;
                if (component.value === '' || component.value === undefined) {
                    window.LokiCheckoutMessenger.error('<?= __('Value is required') ?>', component);
                    isValid = false;
                }

                return isValid;
            }
        },
        validate: function (component) {
            isValid = true;
            window.LokiCheckoutMessenger.clear(component);

            component.rules.forEach(rule => {
                if (false === this.rules[rule](component)) {
                    isValid = false;
                }
            })

            if (false === isValid) {
                this.setInvalid(component);
            } else {
                this.setValid(component);
            }

            return isValid;
        },
        setInvalid: function (component) {
            Array.from(component.$root.getElementsByTagName('input')).forEach(element => {
                element.setCustomValidity('Value is invalid');
                element.setAttribute('data-invalid', true);
                element.setAttribute('aria-invalid', true);
            });

            component.valid = false;
            window.dispatchEvent(new CustomEvent('yireo-loki-checkout.step-change', {detail: {component}}));
        },
        setValid: function (component) {
            Array.from(component.$root.getElementsByTagName('input')).forEach(element => {
                element.setCustomValidity('');
                element.removeAttribute('data-invalid');
                element.removeAttribute('aria-invalid');
            });

            component.valid = true;
            window.dispatchEvent(new CustomEvent('yireo-loki-checkout.step-change', {detail: {component}}));
        }
    }

    window.LokiCheckoutValidator.rules.email = function (component) {
        if (/\S+@\S+\.\S+/.test(component.value) === false) {
            window.LokiCheckoutMessenger.error('<?= __('Not a valid email') ?>', component);
        }

        return isValid;
    }
</script>
