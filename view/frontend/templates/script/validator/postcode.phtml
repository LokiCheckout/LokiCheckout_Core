<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Factory\ViewModelFactory;
use LokiCheckout\Core\ViewModel\PostcodePatterns;

/** @version 2.1.29 */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var PostcodePatterns $postcodePatterns */
$postcodePatterns = $viewModelFactory->create(PostcodePatterns::class);
?>
<script>
    const postcodePatterns = {};
    <?php foreach($postcodePatterns->getConfiguration() as $countryCode => $patterns) : ?>
    postcodePatterns['<?= $escaper->escapeHtml($countryCode) ?>'] = [];
    <?php foreach($patterns as $patternName => $pattern): ?>
    postcodePatterns['<?= $escaper->escapeHtml($countryCode) ?>'].push({
        example: '<?= $escaper->escapeHtml($pattern['example']) ?>',
        pattern: /<?= $escaper->escapeHtml($pattern['pattern']) ?>/
    });
    <?php endforeach; ?>
    <?php endforeach; ?>

    LokiComponentValidator.validators.postcode = function (component) {
        const countryComponent = Alpine.store('LokiCheckout').getComponentByFieldNameAndStep('country_id', component.step);
        if (!countryComponent || !countryComponent.id) {
            return true;
        }

        const countryId = countryComponent.value;
        if (!countryId) {
            return true;
        }

        if (!Object.keys(postcodePatterns).includes(countryId)) {
            return true;
        }

        let found = false;
        for (const [key, value] of Object.entries(postcodePatterns[countryId])) {
            if (value['pattern'].test(component.value)) {
                found = true;
            }
        }

        if (!found) {
            component.messages.push({type:'error', text: '<?= $escaper->escapeHtml(__('Not a valid postcode')) ?>'});
            return false;
        }

        return true;
    }
</script>
