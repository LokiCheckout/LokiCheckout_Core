<?php
declare(strict_types=1);
?>
<script>
    LokiComponentValidator.validators.email = function (component) {
        if (/\S+@\S+\.\S+/.test(component.value) === false) {
            component.messages.push({type:'error', text: '<?= $escaper->escapeHtml(__('Invalid email')) ?>'});
            return false;
        }

        return true;
    }
</script>
