<script>
    document.addEventListener('alpine:init', () => {
        Alpine.store('lock', {
            lockedComponents: [],
            lock(component) {
                this.lockedComponents.push(component);
                //console.log('Locking component', component, this.lockedComponents);
                window.dispatchEvent(new CustomEvent('yireo-loki-checkout.lock', {detail: {lockedComponent: component}}));
            },
            unlock(component) {
                //console.log('Unlocking component', component, this.lockedComponents);
                this.lockedComponents = this.lockedComponents.filter(lockedComponent => lockedComponent != component);
                window.dispatchEvent(new CustomEvent('yireo-loki-checkout.unlock', {detail: {unlockedComponent: component}}));
            },
            isLocked(component) {
                let isLocked = false;
                this.lockedComponents.forEach(lockedComponent => {
                    if (lockedComponent.endsWith(component)) {
                        isLocked = true;
                    }
                });
                return isLocked;
            },
            hasLocks() {
                return this.lockedComponents.length > 0;
            }
        })
    })
</script>
