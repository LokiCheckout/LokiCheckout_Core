<?php
declare(strict_types=1);

/** @version 2.1.24 */

use Magento\Framework\View\Element\Template;

/** @var Template $block */
?>
<script>
    document.addEventListener('toggle-cart', function(event) {
        if (event.detail.isOpen) {
            window.location.href = '<?= $block->getUrl('checkout/cart') ?>';
        }
    });
</script>
