<?php declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use LokiCheckout\Core\Config\Config;
use Loki\Components\Factory\ViewModelFactory;

/** @version 2.7.1 */
/** @var Template $block */

$translations = json_encode((array)$block->getTranslations(), JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT);
?>
<script>
    const LokiCheckoutTranslations = <?= /* @noEscape */ $translations ?>;
    const LokiTranslate = {
        __(text) {
            if (LokiCheckoutTranslations.hasOwnProperty(text)) {
                return LokiCheckoutTranslations[text];
            }

            return text;
        }
    };
</script>
