<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;

/** @var Template $block */
?>
<script>
    function createAlpineComponent(componentName, componentData) {
        Alpine.data(componentName, () => ({
            ...componentData
        }));
    }

    function createAlpineFieldComponent(componentName, componentData) {
        Alpine.data(componentName, () => {
            return LokiCheckoutFieldComponentExtender.extend({
                ...componentData,
                initActions: {
                    addToAlpineStore: function () {
                        Alpine.store('components').add(this);
                    },
                    livewireElementUpdated: function () {
                        Livewire.hook('element.updated', (element, component) => {
                            if (this.elementId === component.el.id && this.elementId + '-field' === element.id) {
                                this.valid = this.$component(this).valid;
                                this.updated();
                                window.dispatchEvent(new CustomEvent('yireo-loki-checkout.step-change'));
                            }
                        });
                    }
                },
                init() {
                    Object.entries(this.initActions).forEach(([key, callback]) => {
                        callback.apply(this);
                    });
                },
                submit() {
                    this.beforeSubmit();

                    if (false === window.LokiCheckoutValidator.validate(this)) {
                        return false;
                    }

                    this.$component(this).call('setValue', this.value);
                    this.afterSubmit();
                },
            });
        });
    }
</script>
