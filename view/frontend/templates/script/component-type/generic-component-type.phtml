<script>
    const LokiCheckoutGenericComponentType = {
        ...LokiComponentType,
        blockId: '',
        target: '',
        elementId: '',
        step: '',
        name: '',
        visible: false,
        initActions: {
            loadInitialData: function() {
                const jsonData = JSON.parse(this.$el.getAttribute('x-init-data'));
                for ([key, value] of Object.entries(jsonData)) {
                    this[key] = value;
                }
            },
            register() {
                Alpine.store('components').add(this);
            }
        },
        beforeInit() {
        },
        init() {
            this.beforeInit();

            for ([key, callback] of Object.entries(this.initActions)) {
                callback.apply(this);
            }

            if (this.lazyLoad) {
                this.post({});
                return;
            }

            this.afterInit();
        },
        afterInit() {
        }
    };
</script>
