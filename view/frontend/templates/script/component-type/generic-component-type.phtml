<script>
    const LokiGenericComponentType = {
        wireId: '',
        elementId: '',
        step: '',
        name: '',
        visible: false,
        initActions: {
            loadInitialData: function() {
                const jsonData = JSON.parse(this.$el.getAttribute('x-init-data'));
                for ([key, value] of Object.entries(jsonData)) {
                    this[key] = value;
                }
            },
            register() {
                Alpine.store('components').add(this);
            },
            listenToComponentChange() {
                Livewire.hook('element.updated', (element, component) => {
                    // @todo: Is this actually needed?
                    if (this.elementId === component.el.id && this.elementId + '-field' === element.id) {
                        this.valid = Magewire.find(this.wireId).valid;
                        this.value = Magewire.find(this.wireId).value;
                        document.dispatchEvent(new CustomEvent('yireo-loki-checkout.component-change', {detail: {component}}));
                    }
                });

                /*
                Livewire.on(this.afterSaveEventName, (value) => {
                    console.log('afterSaveEvent event', value);
                    this.value = value;
                });
                 */
            },
        },
        beforeInit() {
        },
        init() {
            this.beforeInit();

            for ([key, callback] of Object.entries(this.initActions)) {
                callback.apply(this);
            }

            if (this.lazyLoad && this.wireId) {
                Magewire.find(this.wireId).$refresh();
                return;
            }

            this.afterInit();
        },
        afterInit() {
        }
    };
</script>
