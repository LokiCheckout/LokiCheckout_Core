<script>
    const LokiGenericComponentType = {
        wireId: '',
        elementId: '',
        step: '',
        name: '',
        loadInitialData() {
            const jsonData = JSON.parse(this.$el.getAttribute('data-loki-component'));
            Object.entries(jsonData).forEach(([key, value]) => {
                this[key] = value;
            });
        },
        register(component) {
            Alpine.store('components').add(component);
        },
        triggerComponentChange(currentComponent) {
            Livewire.hook('element.updated', (element, component) => {
                // @todo: Is this actually needed?
                if (currentComponent.elementId === component.el.id && currentComponent.elementId + '-field' === element.id) {
                    currentComponent.valid = Magewire.find(currentComponent.wireId).valid;
                    document.dispatchEvent(new CustomEvent('yireo-loki-checkout.component-change', {detail: {component}}));
                }
            });
        }
    };
</script>
