<script>
    const LokiCheckoutFieldComponentType = {
        ...LokiCheckoutBaseComponentType,
        value: '',
        valid: true,
        disabled: false,
        validators: [],
        beforeValidate() {
        },
        beforeSubmit() {
        },
        submit() {
            this.beforeValidate();
            if (false === LokiCheckoutValidator.validate(this)) {
                return false;
            }

            this.beforeSubmit();
            this.post(this.value);
            this.afterSubmit();
        },
        afterSubmit() {
            document.dispatchEvent(new CustomEvent('yireo-loki-checkout.component-change', {detail: {component:this}}));
        },
    };
</script>
