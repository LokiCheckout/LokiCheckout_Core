<script>
    const LokiCheckoutFieldComponentType = {
        ...LokiCheckoutGenericComponentType,
        value: '',
        valid: true,
        disabled: false,
        loading: false,
        validators: [],
        beforeValidate() {
        },
        beforeSubmit() {
        },
        submit() {
            this.beforeValidate();
            if (false === LokiCheckoutValidator.validate(this)) {
                return false;
            }

            this.beforeSubmit();
            this.loading = true;
            this.post({value: this.value});
            this.loading = false;
            this.afterSubmit();
        },
        afterSubmit() {
        },
    };
</script>
