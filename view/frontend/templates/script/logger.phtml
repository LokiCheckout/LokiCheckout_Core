<?php declare(strict_types=1);

use Yireo\LokiCheckout\Config\Config;
use Yireo\LokiComponents\Factory\ViewModelFactory;

/**
 * @var ViewModelFactory $viewModelFactory
 * @var Config $config
 */
$config = $viewModelFactory->create(Config::class);
?>
<script>
    function yireoLokiCheckoutLogger(...args) {
        const debug = <?= $config->isDebug() ? 'true' : 'false' ?>;
        if (false === debug) {
            return;
        }

        var color = 'gray';
        if (args[0].toLowerCase().startsWith('success')) {
            color = 'green';
        }

        if (args[0].toLowerCase().startsWith('warning')) {
            color = 'orange';
        }

        if (args[0].toLowerCase().startsWith('error')) {
            color = 'red';
        }

        var css = 'color:white; background-color:' + color + '; padding:1px;'
        console.log('%cYireo_LokiCheckout', css, ...args);
    }
</script>
