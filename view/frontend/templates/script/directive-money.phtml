<?php
declare(strict_types=1);

/** @version 2.1.2 */

use Magento\Framework\View\Element\Template;

/** @var Template $block */
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.directive('money', (el, { value, expression }, { evaluate }) => {
            if (expression) {
                const amount = evaluate(expression) / 100;
                el.textContent = new Intl.NumberFormat().format(amount);
            }
        });
    });
</script>
