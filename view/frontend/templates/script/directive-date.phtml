<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;

/** @version 2.0.21 */
/** @var Template $block */
$options = (array)$block->getOptions();
if (!isset($options['weekday'])) {
    $options['weekday'] = 'long';
}

if (!isset($options['month'])) {
    $options['month'] = 'long';
}

if (!isset($options['day'])) {
    $options['day'] = 'numeric';
}
?>
<script>
    const LokiCheckoutDateOptions = JSON.parse('<?= /* @noEscape */ json_encode($options) ?>');

    document.addEventListener('alpine:init', () => {
        Alpine.directive('date', (el, { value, expression }, { evaluate }) => {
            if (expression) {
                const date = new Date(evaluate(expression));
                el.textContent = date.toLocaleString(undefined, LokiCheckoutDateOptions);
            }
        });

        Alpine.directive('datetime', (el, { value, expression }, { evaluate }) => {
            if (expression) {
                const date = new Date(evaluate(expression));
                el.textContent = date.toLocaleString(undefined, LokiCheckoutDateOptions) + ', ' + date.toLocaleTimeString();
            }
        });

        Alpine.directive('time', (el, { value, expression }, { evaluate }) => {
            if (expression) {
                const time = evaluate(expression);
                const regex = /([0-9]{2}):([0-9]{2}):([0-9]{2})/;
                const match = time.toString().match(regex);
                if (match) {
                    el.textContent = match[1] + ':' + match[2];
                    return;
                }

                const date = new Date(time);
                el.textContent = date.getHours() + ':' + date.getMinutes().toString().padStart(2, '0');
            }
        });
    });
</script>
