<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Step\StepNavigator;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var StepNavigator $stepNavigator */
$stepNavigator = $viewModelFactory->create(StepNavigator::class);
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.store('step', {
            currentStep: '<?= $stepNavigator->getCurrentStep()->getCode() ?>',
            components: [],
            getComponents() {
                return Object.values(this.components);
            },
            getComponentsByStep(step) {
                return this.getComponents().filter(component => component.step === step);
            },
            add(component) {
                this.components[component.name] = component;
            },
            get(componentName) {
                return this.components[componentName];
            },
            getInvalidComponents(step) {
                return this.getComponentsByStep(step).filter(component => component.valid === false);
            },
            hasInvalidComponents(step) {
                return this.getInvalidComponents(step).length > 0;
            },
            hasOnlyValidComponents(step) {
                return !this.hasInvalidComponents(step);
            },
            lock(component) {
                this.components[component.name].locked = true;
                window.dispatchEvent(new CustomEvent('yireo-loki-checkout.step-change', {detail: {component}}));
            },
            unlock(component) {
                this.components[component.name].locked = false;
                window.dispatchEvent(new CustomEvent('yireo-loki-checkout.step-change', {detail: {component}}));
            },
            isLocked(component) {
                return this.components[component.name].locked;
            },
            hasLockedComponents(step) {
                let hasLocked = false;
                Object.keys(this.components).forEach(componentName => {
                    component = this.components[componentName];
                    if (component.locked === true && component.step === step) {
                        hasLocked = true;
                    }
                });

                return hasLocked;
            }
        })
    });
</script>
