<script>
    const LokiCheckoutMessenger = {
        error: function (message, component) {
            const errorContainer = component.$refs.errors;
            if (!errorContainer) {
                yireoLokiCheckoutLogger('ERROR: Message sent to empty HTML element ($refs.error)', component);
                return false;
            }

            const errorElement = document.createElement("li");
            errorElement.textContent = message;
            errorContainer.appendChild(errorElement);
            return false;
        },
        clear: function (component) {
            const errorContainer = component.$refs.errors;
            if (!errorContainer) {
                yireoLokiCheckoutLogger('ERROR: Clear attempt on empty HTML element', component.name);
                return;
            }

            errorContainer.innerHTML = '';
        }
    }
</script>
