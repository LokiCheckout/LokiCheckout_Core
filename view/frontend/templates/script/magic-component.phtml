<script>
    document.addEventListener('alpine:init', () => {
        Alpine.magic('component', (element) => component => {
            if (component.wireId) {
                return Magewire.find(component.wireId);
            }

            let wireId = element.getAttribute('wire:id');
            // @todo: Find a way to do this recursively
            if (!wireId) {
               wireId = element.parentElement.getAttribute('wire:id');
            }

            if (!wireId) {
                yireoLokiCheckoutLogger('ERROR: Could not locate wire ID of element', element, component);
                return;
            }

            return Magewire.find(wireId);
        })
    });
</script>

