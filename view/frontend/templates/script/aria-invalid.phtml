<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;

/** @version 2.6.0 */
/** @var Template $block */
?>
<script>
    (function () {
        document.querySelectorAll('[aria-invalid]').forEach(function (element) {
            if (typeof element.setCustomValidity === 'function') {
                element.reportValidity();
                element.setCustomValidity('Field is invalid');
            }
        });

        document.addEventListener("loki-components:dom-update", function (event) {
            event.target.querySelectorAll('[aria-invalid]').forEach(function (element) {
                if (typeof element.setCustomValidity === 'function') {
                    element.reportValidity();
                    element.setCustomValidity('Field is invalid');
                }
            });
        });
    })();
</script>
