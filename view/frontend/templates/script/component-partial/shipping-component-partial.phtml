<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;

/** @version 2.6.0 */
/** @var Template $block */
?>
<script>
    const LokiCheckoutShippingComponentPartial = {
        ...LokiTabComponentPartial,
        ...LokiModalComponentPartial,
        valid: false,
        required: true,
        activeTabId: 'delivery-dates',
        defaultDeliveryCount: 3,
        visibleDeliveryCount: 3,
        expandDeliveryCount: 3,
        defaultLocationCount: 3,
        visibleLocationCount: 3,
        expandLocationCount: 3,
        isShippingAddressValid: true,
        isShippingAddressChanged: false,
        shippingAddressHash: null,
        showLoader: false,
        locations: [],
        deliveryEnabled: false,
        deliveryDates: [],
        initCheckShippingAddressChanged() {

        },
        initActiveTab() {
            if (this.deliveryEnabled && this.activeTabId !== 'locations') {
                this.activeTabId = 'delivery-dates';
            }

            if (!this.deliveryEnabled) {
                this.activeTabId = 'locations';
            }

            this.showActiveTab();
        },
        initLocations() {
            this.showLocations();
        },
        showLocations() {
        },
        isDeliveryEnabled() {
            return this.deliveryEnabled;
        },
        isInvalidShippingAddress() {
            return !this.isShippingAddressValid;
        },
        getVisibleDeliveryDates() {
            if (!this.hasDeliveryDates()) {
                return [];
            }

            return this.deliveryDates.slice(0, this.visibleDeliveryCount);
        },
        hasDeliveryDates() {
            return this.deliveryDates.length > 0;
        },
        showNoDeliveryDates() {
            return !this.hasDeliveryDates() && !this.showLoader && this.isShippingAddressValid;
        },
        showLoadingDeliveryDates() {
            return !this.hasDeliveryDates() && this.showLoader;
        },
        expandAllDeliveryDates() {
            this.visibleDeliveryCount = this.deliveryDates.length;
        },
        expandDeliveryDates() {
            this.visibleDeliveryCount += this.expandDeliveryCount;
        },
        collapseDeliveryDates() {
            this.visibleDeliveryCount = this.defaultDeliveryCount;
        },
        isCurrentValue(value) {
            return JSON.stringify(value) === JSON.stringify(this.value);
        },
        getVisibleLocations() {
            return this.getSortedLocations().slice(0, this.visibleLocationCount);
        },
        hasLocations() {
            return this.locations.length > 0;
        },
        hasNoLocations() {
            return !this.hasLocations();
        },
        showNoLocations() {
            return !this.hasLocations() && !this.showLoader && this.isShippingAddressValid;
        },
        showLoadingLocations() {
            return !this.hasLocations() && this.showLoader;
        },
        expandAllLocations() {
            this.visibleLocationCount = this.locations.length;
        },
        expandLocations() {
            this.visibleLocationCount += this.expandLocationCount;
            this.showLocations();
        },
        collapseLocations() {
            this.visibleLocationCount = this.defaultLocationCount;
            this.showLocations();
        },
        getSortedLocations() {
            return this.locations.sort((a, b) => {
                if (this.isCurrentLocationValue(a.value)) {
                    return -1; // @todo: Make this optional
                }

                if (parseInt(a.distance) < parseInt(b.distance)) {
                    return -1;
                }

                if (parseInt(a.distance) > parseInt(b.distance)) {
                    return 1;
                }

                return 0;
            });
        },
        saveLocation(event) {
            const data = JSON.parse(event.target.getAttribute('data-json'));
            this.value = data;
            this.post(data);
        },
        saveTimeframe(event) {
            const data = JSON.parse(event.target.getAttribute('data-json'));
            this.value = data;
            this.post(data);
        },
        /*isCurrentLocation() {
            const id = this.$el.getAttribute('value');

            return this.isCurrentLocationValue(id);
        },*/
        isCurrentLocationValue(locationId) {
            if (!locationId || !this.value || this.value.deliveryType !== 'pickup') {
                return false;
            }

            return locationId === this.value.pickupLocation.location_code;
        },
        showExpandDeliveryDates() {
            return this.deliveryDates.length > this.visibleDeliveryCount;
        },
        showCollapseDeliveryDates() {
            return this.visibleDeliveryCount > this.defaultDeliveryCount;
        },
        showExpandLocations() {
            return this.locations.length > this.visibleLocationCount;
        },
        showCollapseLocations() {
            return this.visibleLocationCount > this.defaultLocationCount;
        },
        toggleMaps() {
            this.activeTabId = 'locations';
            this.toggleTab('locations');
            this.toggleModal();
        },
    }
</script>
