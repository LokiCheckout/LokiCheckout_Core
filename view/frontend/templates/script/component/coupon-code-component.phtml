<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiCheckoutCouponCodeComponent', () => ({
            ...LokiCheckoutFieldComponentType,
            afterInit() {
                this.$watch('isOpen', (value) => {
                    console.log('dialog open', value);
                })
            },
            isOpen() {
                return this.value.length > 0;
            },
            removeCouponCode() {
                this.value = '';
                this.post({
                    code: '',
                    task: 'remove'
                });
            },
            applyCouponCode() {
                this.post({
                    code: this.value,
                    task: 'apply'
                });
            }
        }));
    });
</script>
