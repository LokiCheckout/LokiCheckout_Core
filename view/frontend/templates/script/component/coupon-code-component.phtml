<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiCheckoutCouponCodeComponent', () => ({
            ...LokiCheckoutFieldComponentType,
            afterInit() {
                this.$refs.details.addEventListener('toggle', event => {
                    if (this.$refs.details.open) {
                        this.$refs.input.focus();
                    }
                })
            },
            isOpen() {
                return this.value.length > 0;
            },
            removeCouponCode() {
                this.value = '';
                this.post({
                    code: '',
                    task: 'remove'
                });
            },
            applyCouponCode() {
                this.post({
                    code: this.value,
                    task: 'apply'
                });
            }
        }));
    });
</script>
