<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiCheckoutCouponCodeComponent', () => ({
            ...LokiCheckoutFieldComponentType,
            isOpen() {
                return this.value.length > 0;
            },
            removeCouponCode() {
                this.value = '';
                this.post({
                    code: '',
                    task: 'remove'
                });
            },
            applyCouponCode() {
                this.post({
                    code: this.value,
                    task: 'apply'
                });
            }
        }));
    });
</script>
