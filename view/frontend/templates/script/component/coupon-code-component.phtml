<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;

/** @version 2.7.7 */
/** @var Template $block */
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiCheckoutCouponCodeComponent', () => ({
            ...LokiCheckoutComponentType,
            ...LokiCheckoutRecaptchaGuardComponentPartial,
            recaptchaFormId: 'coupon_code',
            detailOpen: false,
            couponCodePattern: '^[a-zA-Z0-9_-]+$',
            couponCodeInvalidMessage: '',
            initCouponCode() {
                if (this.$refs.details) {
                    this.$refs.details.addEventListener('toggle', () => {
                        this.detailOpen = this.$refs.details.open;
                        if (this.$refs.details.open && this.$refs.input) {
                            this.$refs.input.focus();
                        }
                    })
                }
            },
            hasCouponCode() {
                return !!this.value;
            },
            isDetailOpen() {
                return this.detailOpen;
            },
            isDetailClosed() {
                return !this.detailOpen;
            },
            removeCouponCode() {
                this.value = '';
                this.post({
                    code: '',
                    task: 'remove'
                });
            },
            clearCouponCodeErrors() {
                this.messages = this.messages.filter(message => message.type !== 'error');
            },
            isValidCouponCode(code) {
                if (code === '') {
                    return false;
                }

                try {
                    return new RegExp(this.couponCodePattern).test(code);
                } catch (error) {
                    return false;
                }
            },
            async applyCouponCode() {
                const input = this.$refs.input;
                const code = String(input ? input.value : (this.value ?? '')).trim();
                this.value = code;
                this.clearCouponCodeErrors();

                if (false === this.isValidCouponCode(code)) {
                    this.addLocalError(this.couponCodeInvalidMessage);
                    input && input.focus();
                    return;
                }

                if (false === await this.awaitRecaptcha()) {
                    return;
                }

                this.post({
                    code: code,
                    task: 'apply'
                });
            }
        }));
    });
</script>
