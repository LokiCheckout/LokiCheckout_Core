<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiCheckoutAgreementComponent', () => ({
            ...LokiModalComponentPartial,
            name: 'LokiCheckoutAgreementComponent',
            id: '',
            submitted: false,
            valid: false,
            init() {
                this.id = this.name + this.$refs.field.getAttribute('data-id');
                Alpine.store('components').add(this);
                this.valid = this.agreements[this.id];
            },
            toggle(event) {
                const agreementId = event.target.getAttribute('data-id');
                this.valid =  event.target.checked;
                this.agreements[agreementId] = this.valid;
                this.post(this.agreements);
            },
            isChecked() {
                return this.agreements[this.$el.getAttribute('data-id')];
            },
            isNotChecked() {
                return !this.isAgreementChecked();
            },
            invalid() {
                return !this.$refs.field.checked && this.submitted;
            },
            beforePostNextStep() {
            }
        }));
    });
</script>
