<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;

/** @version 2.3.26 */
/** @var Template $block */
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiCheckoutAgreementComponent', () => ({
            ...LokiLoadInitMethodsComponentPartial,
            ...LokiModalComponentPartial,
            name: 'LokiCheckoutAgreementComponent',
            id: '',
            submitted: false,
            visible: true,
            valid: false,
            init() {
                this.id = this.name + this.$refs.field.getAttribute('data-id');
                this.valid = this.agreements[this.id];
                Alpine.store('LokiCheckout').add(this);
                this.loadInitMethods();
            },
            toggle(event) {
                const agreementId = this.name + event.target.getAttribute('data-id');
                this.valid =  event.target.checked;
                this.agreements[agreementId] = event.target.checked;
                this.post(this.agreements);
            },
            isChecked() {
                return this.agreements[this.id] === true;
            },
            isNotChecked() {
                return !this.isChecked();
            },
            isAriaInvalid() {
                return !this.$refs.field.checked && this.submitted;
            },
            isValid() {
                return this.valid;
            },
            beforePostNextStep() {
                this.valid = this.agreements[this.id];
            }
        }));
    });
</script>
