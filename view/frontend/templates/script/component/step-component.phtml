<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiCheckoutStep', () => ({
            ...LokiCheckoutComponentType,
            step: null,
            initScrollTo() {
                if (!this.step) {
                    this.step = Alpine.store('checkout').currentStep;
                    window.scrollTo(0, 0);
                }
            }
        }));
    });
</script>
