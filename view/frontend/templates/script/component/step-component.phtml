<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiCheckoutStep', () => ({
            step: 'unknown',
            name: '',
            visible: false,
            init() {
                LokiCheckoutComponentExtender.merge(this);

                Magewire.on('afterChangeStep', (stepCode) => {
                    this.visible = this.step === stepCode;
                });
            }
        }));
    });
</script>
