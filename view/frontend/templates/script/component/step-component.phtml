<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiCheckoutStep', () => ({
            ...LokiGenericComponentType,
            initActions: {
                ...LokiGenericComponentType.initActions,
                changeVisibilityOnStepChange() {
                    Magewire.on('afterChangeStep', (stepCode) => {
                        this.visible = this.step === stepCode;
                    });
                },
            }
        }));
    });
</script>
