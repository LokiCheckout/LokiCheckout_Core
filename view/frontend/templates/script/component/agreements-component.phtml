<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiCheckoutAgreementsComponent', () => ({
            ...LokiCheckoutComponentType,
            agreements: [],
            errorText: '',
            toggleAgreement(event) {
                const agreementId = event.target.getAttribute('data-id');
                this.agreements[agreementId] = event.target.checked;
                this.post(this.agreements);
            },
            isAgreementChecked() {
                return this.agreements[this.$el.getAttribute('data-id')];
            },
            isAgreementNotChecked() {
                return !this.isAgreementChecked();
            },
            beforePostNextStep() {
                if (Object.values(this.agreements).includes(false)) {
                    this.valid = false;
                }

                if (false === this.valid) {
                    this.addGlobalError(this.errorText);
                }
            }
        }));
    });
</script>
