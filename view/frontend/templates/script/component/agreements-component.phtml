<?php
declare(strict_types=1);
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiCheckoutAgreementsComponent', () => ({
            ...LokiCheckoutComponentType,
            agreements: [],
            errorText: '',
            beforePostNextStep() {
                if (Object.values(this.agreements).includes(false)) {
                    this.valid = false;
                }

                if (false === this.valid) {
                    this.addError(this.errorText);
                }
            }
        }));
    });
</script>
