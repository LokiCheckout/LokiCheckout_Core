<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;

/** @version 2.3.25 */
/** @var Template $block */
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiCheckoutAgreementsComponent', () => ({
            ...LokiCheckoutComponentType,
            visible: false,
            agreements: [],
            errorText: '',
            initWatchAgreements() {
                this.$watch('agreements', () => {
                    this.valid = !Object.values(this.agreements).includes(false);
                });

                this.valid = !Object.values(this.agreements).includes(false);
            },
            beforePostNextStep() {
                this.valid = !Object.values(this.agreements).includes(false);
                if (false === this.valid) {
                    this.addError(this.errorText);
                }
            }
        }));
    });
</script>
