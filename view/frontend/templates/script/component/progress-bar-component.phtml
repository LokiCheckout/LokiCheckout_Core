<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;

/** @version 2.3.31 */
/** @var Template $block */
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiCheckoutProgressBar', () => ({
            ...LokiCheckoutComponentType,
            currentStep: 'none',
            steps: [],
            initCurrentStep() {
                if (this.currentStep !== 'none') {
                    window.location.hash = this.currentStep;
                    Alpine.store('LokiCheckout').currentStep = this.currentStep;
                    window.scrollTo(0, 0);
                }
            },
            initHashChangeListener() {
                window.onhashchange = (event) => {
                    let newStep = (new URL(event.newURL)).hash.replace('#', '');
                    if (!this.steps.includes(newStep)) {
                        newStep = this.steps[0];
                    }

                    if (this.currentStep === newStep) {
                        window.location.hash = this.currentStep;
                        return;
                    }

                    this.post(newStep);
                };
            },
            submit(event) {
                const step = event.target.getAttribute('data-step');
                if (step === this.value) {
                    return;
                }

                this.value = step;
                this.post();
            }
        }));
    });
</script>
