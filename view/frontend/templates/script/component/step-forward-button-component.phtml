<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;

/** @version 2.5.1 */
/** @var Template $block */
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiCheckoutStepForwardButton', () => ({
            ...LokiCheckoutComponentType,
            redirectUrl: '',
            currentStep: '',
            valid: true,
            disabled: false,
            cssClassActive: 'btn-primary',
            cssClassInactive: 'btn-secondary',
            cssClass() {
                return this.valid ? this.cssClassActive : this.cssClassInactive;
            },
            initRedirectIfNeeded() {
                if (this.redirectUrl) {
                    document.dispatchEvent(new CustomEvent('loki-checkout.before-redirect', {
                        component: this,
                        redirectUrl: this.redirectUrl
                    }));

                    window.location.replace(this.redirectUrl);
                }
            },
            initUpdateValid() {
                this.updateValid();

                document.addEventListener('loki-components.ajax.loading', (event) => {
                    this.disabled = !!event.detail;
                });

                document.addEventListener('loki-components.component.update', () => {
                    this.updateValid();
                });

                this.$nextTick(() => {
                    this.updateValid();
                });
            },
            initDisableAllWhenLoading() {
                const container = document.getElementById('loki-checkout');
                container.removeAttribute('aria-busy');

                this.$watch('loading', () => {
                    if (this.loading) {
                        this.disabled = true;
                        container.setAttribute('aria-busy', true);
                    } else {
                        this.disabled = false;
                        container.removeAttribute('aria-busy');
                    }
                });
            },
            updateValid() {
                this.valid = Alpine.store('LokiCheckout').hasOnlyValidComponents([this.currentStep, 'any']);

                if (!this.valid) {
                    const components = Alpine.store('LokiCheckout').getInvalidComponentIds([this.currentStep, 'any']);
                    LokiCheckoutLogger.debug('Invalid components for step "' + this.currentStep + '"', components);
                }

                if (this.$refs.button) {
                    if (this.valid) {
                        this.$refs.button.removeAttribute('aria-disabled');
                    } else {
                        this.$refs.button.setAttribute('aria-disabled', 'true');
                    }
                }

                return this.valid;
            },
            submit() {
                this.loading = true;
                document.dispatchEvent(new CustomEvent('clear-messages'));

                Alpine.store('LokiCheckout').getComponentArrayByStep([this.currentStep, 'any']).forEach(component => {
                    component.submitted = true;
                });

                Alpine.store('LokiCheckout').getComponentArrayByStep([this.currentStep, 'any']).forEach(async component => {
                    await LokiComponentValidator.validate(component);
                });

                const beforePostNextStepPromises = [];
                Alpine.store('LokiCheckout').getComponentArrayByStep([this.currentStep, 'any']).forEach(async component => {
                    if (component.beforePostNextStep) {
                        const beforePostNextStep = component.beforePostNextStep();
                        if (this.isPromise(beforePostNextStep)) {
                            beforePostNextStepPromises.push(beforePostNextStep);
                        }
                    }
                });

                if (beforePostNextStepPromises.length > 0) {
                    Promise.all(beforePostNextStepPromises)
                        .then(() => {
                            this.moveToNextStep();
                        })
                        .catch(error => {
                            console.log('Failed to resolve beforePostNextStepPromises', error); // @todo
                            LokiCheckoutLogger.debug('Failed to resolve beforePostNextStepPromises', error);
                            this.loading = false;
                            this.valid = false;
                        });
                } else {
                    this.$nextTick(() => {
                        this.moveToNextStep();
                    });
                }
            },
            moveToNextStep() {
                this.valid = this.updateValid();
                this.loading = false;

                if (true === this.valid) {
                    document.dispatchEvent(new CustomEvent('loki-checkout.step-forward.before-post', {
                        component: this
                    }));

                    Alpine.store('LocalStorage').reset(['cart', 'loki-checkout']);

                    this.post();
                    return;
                }

                const firstInvalidElement = LokiComponentValidator.findFirstInvalidElement();
                if (firstInvalidElement) {
                    firstInvalidElement.focus();
                }
            },
            isPromise(value) {
                return (
                    value !== null &&
                    typeof value === "object" &&
                    typeof value.then === "function"
                );
            }
        }));
    });
</script>
