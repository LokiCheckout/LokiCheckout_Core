<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiCheckoutStepForwardButton', () => ({
            ...LokiCheckoutBaseComponentType,
            redirectUrl: '',
            currentStep: '',
            valid: true,
            initActions: {
                ...LokiCheckoutBaseComponentType.initActions,
                redirectIfNeeded() {
                    if (this.redirectUrl) {
                        document.dispatchEvent(new CustomEvent('loki-checkout-before-redirect', {
                            component: this,
                            redirectUrl: this.redirectUrl
                        }));

                        window.location.replace(this.redirectUrl);
                    }
                },
                updateValid() {
                    document.addEventListener('loki-components.component.update', () => {
                        this.updateValid();
                    });

                    this.updateValid();
                }
            },
            disabled() {
                return !this.valid;
            },
            updateValid() {
                this.valid = Alpine.store('checkout').hasOnlyValidComponents(this.currentStep);
                if (!this.valid) {
                    const components = [];
                    Alpine.store('checkout').getInvalidComponents(this.currentStep).forEach((component) => {
                        components.push(component.id);
                    })

                    LokiCheckoutLogger.debug('Invalid components for step "' + this.currentStep + '"', components);
                }

                return this.valid;
            },
            submit() {
                document.dispatchEvent(new CustomEvent('clear-messages')); // @todo: Use Loki specific event

                Alpine.store('checkout').getComponentsByStep(this.currentStep).forEach((component) => {
                    LokiCheckoutValidator.validate(component);
                });

                if (true === this.updateValid()) {
                    document.dispatchEvent(new CustomEvent('loki-checkout.step-forward.before-post', {
                        component: this
                    }));

                    this.post();
                    return true;
                }

                const firstInvalidElement = LokiCheckoutValidator.findFirstInvalidElement();
                if (firstInvalidElement) {
                    firstInvalidElement.focus();
                }

                return false;
            }
        }));
    });
</script>
