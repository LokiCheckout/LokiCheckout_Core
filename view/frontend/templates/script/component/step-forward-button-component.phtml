<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiCheckoutStepForwardButton', () => ({
            ...LokiCheckoutBaseComponentType,
            redirectUrl: '',
            currentStep: '',
            valid: true,
            initActions: {
                ...LokiCheckoutBaseComponentType.initActions,
                redirectIfNeeded() {
                    if (this.redirectUrl) {
                        window.dispatchEvent(new CustomEvent('loki-checkout-before-redirect', {
                            component: this,
                            redirectUrl: this.redirectUrl
                        }));

                        window.location.replace(this.redirectUrl);
                    }
                },
                updateValid() {
                    this.updateValid();
                    document.addEventListener('yireo-loki-checkout.component-change', () => {
                        this.updateValid();
                    });
                }
            },
            disabled() {
                return !this.valid;
            },
            updateValid() {
                this.valid = Alpine.store('checkout').hasOnlyValidComponents(this.currentStep);
                if (!this.valid) {
                    const components = [];
                    Alpine.store('checkout').getInvalidComponents(this.currentStep).forEach((component) => {
                        components.push(component.id);
                    })

                    yireoLokiCheckoutLogger('DEBUG: Invalid components for step "' + this.currentStep + '"', components);
                }

                return this.valid;
            },
            submit() {
                window.dispatchEvent(new CustomEvent('clear-messages')); // @todo: Use Loki specific event
                Alpine.store('checkout').getComponentsByStep(this.currentStep).forEach((component) => {
                    LokiCheckoutValidator.validate(component);
                });

                if (true === this.updateValid()) {
                    window.dispatchEvent(new CustomEvent('loki-checkout-before-step-forward', {
                        component: this
                    }));

                    this.post();
                    return;
                }

                const firstInvalidElement = LokiCheckoutValidator.findFirstInvalidElement();
                if (firstInvalidElement) {
                    firstInvalidElement.focus();
                }

                // Fail-safe enabling of the button
                setTimeout(() => {
                    if (this.valid) {
                        this.valid = true;
                    }
                }, 4000);
            }
        }));
    });
</script>
