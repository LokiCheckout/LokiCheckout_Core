<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('StepForwardButton', () => ({
            wireId: '',
            step: '',
            valid: false,
            init() {
                const componentData = JSON.parse(this.$el.dataset.lokiComponent);
                for (const [key, value] of Object.entries(componentData)) {
                    this[key] = value;
                }

                this.updateValid();
                document.addEventListener('yireo-loki-checkout.component-change', () => {
                    this.updateValid();
                });
            },
            isDisabled() {
                return this.valid !== true;
            },
            updateValid() {
                this.valid = Alpine.store('components').hasOnlyValidComponents(this.step);
                if (!this.valid) {
                    const components = [];
                    Alpine.store('components').getInvalidComponents(this.step).forEach((component) => {
                        components.push(component.name);
                    })

                    yireoLokiCheckoutLogger('INFO: Invalid components', components);
                }

                return this.valid;
            },
            submit() {
                window.dispatchEvent(new CustomEvent('clear-messages'));
                Alpine.store('components').getComponentsByStep(this.step).forEach((component) => {
                    LokiCheckoutValidator.validate(component);
                });

                if (true === this.updateValid()) {
                    this.$component(this).call('submit');
                }

                // @todo: Is this a good UI benefit?
                setTimeout(() => {
                    this.valid = true;
                    console.log('Resetting valid');
                }, 4000);
            }
        }));
    });
</script>
