<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiCheckoutFieldComponent', () => {
            return LokiCheckoutComponentExtender.extend({
                ...LokiFieldComponent.create(this),
                init() {
                    this.register(this);
                    this.triggerComponentChange(this);
                }
            });
        });
    });
</script>
