<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiCheckoutFieldComponent', () => {
            return LokiCheckoutComponentExtender.extend({
                name: '',
                wireId: '',
                elementId: '',
                step: '',
                value: '',
                valid: true,
                rules: [],
                initActions: {
                    addToAlpineStore: function () {
                        Alpine.store('components').add(this);
                    },
                    livewireElementUpdated: function () {
                        Livewire.hook('element.updated', (element, component) => {
                            if (this.elementId === component.el.id && this.elementId + '-field' === element.id) {
                                this.valid = this.$component(this).valid;
                                this.updated();
                                document.dispatchEvent(new CustomEvent('yireo-loki-checkout.component-change', {detail: {component}}));
                            }
                        });
                    }
                },
                init() {
                    LokiCheckoutComponentExtender.merge(this);
                    console.log('FieldComponent', this.name);

                    Object.entries(this.initActions).forEach(([key, callback]) => {
                        callback.apply(this);
                    });

                    // @todo: Find a nicer way to do this
                    if (this.newAddress !== undefined && this.newAddress === false) {
                        this.rules = [];
                        this.valid = true;
                    }
                },
                updated() {},
                submit() {
                    if (false === LokiCheckoutValidator.validate(this)) {
                        return false;
                    }

                    this.$component(this).call('setValue', this.value);
                },
            });
        });
    });
</script>
