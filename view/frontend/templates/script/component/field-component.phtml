<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiCheckoutFieldComponent', () => {
            return {
                ...LokiFieldComponentType,
                init() {
                    this.loadInitialData(this);
                    this.register(this);
                    this.triggerComponentChange(this);
                }
            }
        });
    });
</script>
