<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @version 2.7.2 */
/** @var Template $block */
/** @var Escaper $escaper */
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiCheckoutNewsletterComponent', () => ({
            ...LokiCheckoutComponentType,
            ...LokiCheckoutRecaptchaGuardComponentPartial,
            recaptchaFormId: 'newsletter',
            async post(value) {
                if (false === await this.awaitRecaptcha()) {
                    return;
                }

                return LokiCheckoutComponentType.post.call(this, value);
            },
            initListenToDisabledClicks() {
                this.$el.addEventListener('click', (e) => {
                    if (this.disabled) {
                        this.messages = [{
                            type: 'warning',
                            text: '<?= $escaper->escapeHtml(__('Please enter a valid email first')) ?>',
                        }];
                    }
                })
            }
        }));
    });
</script>
