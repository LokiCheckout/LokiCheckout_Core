<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @version 2.3.33 */
/** @var Template $block */
/** @var Escaper $escaper */
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiCheckoutNewsletterComponent', () => ({
            ...LokiCheckoutComponentType,
            initListenToDisabledClicks() {
                this.$el.addEventListener('click', (e) => {
                    if (this.disabled) {
                        this.messages = [{
                            type: 'warning',
                            text: '<?= $escaper->escapeHtml(__('Please enter a valid email first')) ?>',
                        }];
                    }
                })
            }
        }));
    });
</script>
