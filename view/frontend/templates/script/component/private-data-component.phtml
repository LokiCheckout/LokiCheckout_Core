<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;

/** @version 2.3.25 */
/** @var Template $block */
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiCheckoutPrivateData', () => ({
            ...LokiLoadDataComponentPartial,
            privateData: {},
            init() {
                this.loadData();
                Alpine.store('LocalStorage').set('loki-checkout', this.privateData);
            }
        }));
    });
</script>
