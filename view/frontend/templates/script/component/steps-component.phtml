<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiCheckoutSteps', () => ({
            ...LokiCheckoutComponentType,
            currentStep: 'none',
            initCurrentStep() {
                if (this.currentStep !== 'none') {
                    window.location.hash = this.currentStep;
                    Alpine.store('checkout').currentStep = this.currentStep;
                }
            },
            submit(event) {
                const step = event.target.getAttribute('data-step');
                if (step === this.value) {
                    return;
                }

                this.value = step;
                this.post();
            }
        }));
    });
</script>
