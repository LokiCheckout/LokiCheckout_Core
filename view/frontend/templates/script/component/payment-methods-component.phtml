<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiCheckoutPaymentMethods', () => ({
            ...LokiCheckoutComponentType,
            afterInit() {
                this.dispatchPaymentMethodEvent();
            },
            dispatchPaymentMethodEvent() {
                // @todo: Is this also fired when the value is empty?
                document.dispatchEvent(new CustomEvent('loki-checkout.payment.method-activate', {
                    detail: {method: this.value}
                }));

                // @todo: Trigger an event "checkout:payment:method-deactivate"
            },
            beforeSubmit() {
                this.validators = ['required', this.value]; // @todo: Doesn't this stick when switching value?
            },
            afterSubmit() {
                this.dispatchPaymentMethodEvent();
            }
        }));
    });
</script>
