<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;

/** @version 2.4.4 */
/** @var Template $block */
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiCheckoutAddress', () => ({
            ...LokiCheckoutComponentType,
            buttonLabel: '',
            buttonDisabled: false,
            initButtonLabel() {
                this.buttonLabel = this.getButtonLabel();
            },
            getButtonLabel() {
                if (this.value) {
                    return this.buttonLabelSelectAddress;
                }

                return this.buttonLabelNewAddress;
            },
            toggle() {
                this.value = !this.value;
                this.buttonLabel = this.getButtonLabel();
                this.submit();
            },
            beforeSubmit() {
                this.buttonDisabled = true;
            }
        }));
    });
</script>
