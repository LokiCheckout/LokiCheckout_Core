<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;

/** @version 2.5.1 */
/** @var Template $block */
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiCheckoutPaymentMethod', () => ({
            ...LokiCheckoutPaymentMethodComponentType,
            initDispatchPaymentMethodEvent() {
                this.dispatchPaymentMethodEvent();
            },
            dispatchPaymentMethodEvent() {
                document.dispatchEvent(new CustomEvent('loki-checkout.payment.method-activate', {
                    detail: {method: this.value}
                }));
            }
        }));
    });
</script>
