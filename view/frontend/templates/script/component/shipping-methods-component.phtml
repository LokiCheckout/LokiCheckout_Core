<?php
declare(strict_types=1);

/** @version 2.1.6 */

use Magento\Framework\View\Element\Template;

/** @var Template $block */
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiCheckoutShippingMethods', () => ({
            ...LokiCheckoutComponentType,
            initShippingMethodEvent() {
                this.dispatchShippingMethodEvent();
            },
            initWatchShippingMethod() {
                this.$watch('value', () => {
                    this.submit();
                });
            },
            dispatchShippingMethodEvent() {
                document.dispatchEvent(new CustomEvent('loki-checkout.shipping.method-activate', {
                    detail: {method: this.value}
                }));
            },
            beforeSubmit() {
                this.validators = ['required', this.value]; // @todo: Doesn't this stick when switching value?
            },
            afterSubmit() {
                this.dispatchShippingMethodEvent();
            }
        }));
    });
</script>
