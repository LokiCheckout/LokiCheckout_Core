<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiCheckoutShippingMethods', () => ({
            ...LokiFieldComponentType,
            initActions: {
                ...LokiFieldComponentType.initActions,
                initShippingMethod() {
                    this.dispatchShippingMethodEvent();
                    this.$watch('value', () => {
                        if (this.value) {
                            this.submit();
                        }
                    });
                },
            },
            dispatchShippingMethodEvent() {
                window.dispatchEvent(new CustomEvent('checkout:shipping:method-activate', {
                    detail: {method: this.value}
                }));
            },
            beforeSubmit() {
                this.rules = ['required', this.value]; // @todo: Doesn't this stick when switching value?
            },
            afterSubmit() {
                this.dispatchShippingMethodEvent();
            }
        }));
    });
</script>
