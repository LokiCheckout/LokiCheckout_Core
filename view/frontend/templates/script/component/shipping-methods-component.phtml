<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiCheckoutShippingMethods', () => ({
            name: '',
            wireId: '',
            elementId: '',
            step: '',
            value: '',
            valid: false,
            rules: ['required'],
            init() {
                const componentData = JSON.parse(this.$el.dataset.component);
                for (const [key, value] of Object.entries(componentData)) {
                    this[key] = value;
                }

                if (this.value) {
                    this.rules = ['required', this.value];
                    window.dispatchEvent(new CustomEvent('checkout:shipping:method-activate', {
                        detail: {method: this.value}
                    }));
                }

                Alpine.store('components').add(this);

                this.$watch('value', () => {
                    this.rules = ['required', this.value];
                    this.$component(this).call('setValue', this.value);
                    if (this.value) {
                        this.valid = true;
                    }

                    window.dispatchEvent(new CustomEvent('checkout:shipping:method-activate', {
                        detail: {method: this.value}
                    }));
                });
            }
        }));
    });
</script>
