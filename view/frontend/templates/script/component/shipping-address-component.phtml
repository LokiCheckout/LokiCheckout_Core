<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('LokiCheckoutShippingAddress', () => ({
            ...LokiCheckoutBaseComponentType,
            buttonLabel: '',
            afterInit() {
                this.buttonLabel = this.getButtonLabel();
                this.$watch('newAddress', () => {
                    this.post({newAddress: this.newAddress});
                });
            },
            getButtonLabel() {
                if (this.newAddress === true) {
                    return this.buttonLabelSelectAddress;
                }

                return this.buttonLabelNewAddress;
            },
            toggleNewAddress() {
                this.newAddress = !this.newAddress;
                this.buttonLabel = this.getButtonLabel();
            }
        }));
    });
</script>
