<script>
    const LokiCheckoutComponentExtender = {
        // @todo WIP
        create() {
            return {
                name: '',
                elementId: '',
                wireId: '',
                step: '',
            }
        },
        // @todo WIP
        createField() {
            return {
                ...this.create(),
                value: '',
                valid: false,
                rules: [],
            }
        },
        getComponentData(component) {
            return JSON.parse(component.$el.dataset.lokiComponent);
        },
        merge(component) {
            const componentData = this.getComponentData(component);
            for (const [key, value] of Object.entries(componentData)) {
                component[key] = value;
            }
        },
        extenders: [],
        addExtender(extender) {
            this.extenders.push(extender);
        },
        extend(component) {
            this.extenders.forEach((extender) => {
                component = extender(component);
            })
            return component;
        }
    };
</script>

