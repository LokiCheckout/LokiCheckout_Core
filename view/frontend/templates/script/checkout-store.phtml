<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiComponents\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Step\StepNavigator;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var StepNavigator $stepNavigator */

$stepNavigator = $viewModelFactory->create(StepNavigator::class);
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.store('checkout', {
            currentStep: '<?= $stepNavigator->getCurrentStep()->getCode() ?>',
            getComponentIds() {
                return Alpine.store('components').getComponentIds();
            },
            getComponents() {
                return Alpine.store('components').getComponents();
            },
            getComponentsByStep(step) {
                return this.getComponents().filter(component => component.step === step);
            },
            removeInvisibleComponents() {
                const invisibleComponents = [];
                for (const [componentId, component] of Object.entries(this.components)) {
                    if (!document.getElementById(component.elementId)) {
                        delete this.components[componentId];
                        invisibleComponents.push(componentId);
                    }
                }

                if (invisibleComponents.length > 0) {
                    yireoLokiCheckoutLogger('NOTICE: Removing invisible components from store', invisibleComponents);
                }
            },
            add(component) {
                return Alpine.store('components').add(component);
            },
            get(componentId) {
                return Alpine.store('components').get(componentId);
            },
            getInvalidComponents(step) {
                return this.getComponentsByStep(step).filter(component => component.valid === false);
            },
            hasInvalidComponents(step) {
                return this.getInvalidComponents(step).length > 0;
            },
            hasOnlyValidComponents(step) {
                return !this.hasInvalidComponents(step);
            },
            lock(component) {
                this.components[component.id].locked = true;
                document.dispatchEvent(new CustomEvent('yireo-loki-checkout.component-change', {detail: {component}}));
            },
            unlock(component) {
                this.components[component.id].locked = false;
                document.dispatchEvent(new CustomEvent('yireo-loki-checkout.component-change', {detail: {component}}));
            },
            isLocked(component) {
                return this.components[component.id].locked;
            },
            hasLockedComponents(step) {
                let hasLocked = false;
                Object.keys(this.components).forEach(componentId => {
                    component = this.components[componentId];
                    if (component.locked === true && component.step === step) {
                        hasLocked = true;
                    }
                });

                return hasLocked;
            }
        })

        document.addEventListener('@todo', () => {
            Alpine.store('checkout').removeInvisibleComponents();
        });
    });
</script>
