<?php
declare(strict_types=1);

use LokiCheckout\Core\Config\Config;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Factory\ViewModelFactory;
use LokiCheckout\Core\Step\StepNavigator;

/** @version 2.4.4 */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var StepNavigator $stepNavigator */
/** @var Config $config */

$config = $viewModelFactory->create(Config::class);
$stepNavigator = $viewModelFactory->create(StepNavigator::class);
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.store('LokiCheckout', {
            locations: [],
            deliveryDates: [],
            currentTheme: '<?= $escaper->escapeHtml($config->getTheme()) ?>',
            currentStep: '<?= $escaper->escapeHtml($stepNavigator->getCurrentStep()->getCode()) ?>',
            init() {
            },
            getComponentIds() {
                return Alpine.store('LokiComponents').getComponentIds();
            },
            getComponentIdsByStep(step) {
                return Object.keys(this.getComponentsByStep(step));
            },
            getComponentByName(componentName) {
                return this.getComponentArray().find(component => component.name === componentName);
            },
            getComponents() {
                return Alpine.store('LokiComponents').getComponents();
            },
            getComponentArray() {
                return Alpine.store('LokiComponents').getComponentArray();
            },
            getComponentsByStep(step) {
                if (!step) {
                    LokiCheckoutLogger.error('getInvalidComponents() called without step argument');
                    return {};
                }

                const components = {};
                this.getComponentArray().forEach(component => {
                    const matchStep = step === 'all' || component.step === step || (step.includes(component.step));
                    if (this.exists(component) && matchStep) {
                        components[component.id] = component;
                    }
                });

                return components;
            },
            getComponentArrayByStep(step) {
                return Object.values(this.getComponentsByStep(step));
            },
            getComponentsByFieldNameAndStep(fieldName, step) {
                const components = {};
                this.getComponentArray().forEach(component => {
                    if (component.fieldName === fieldName && component.step === step) {
                        components[component.id] = component;
                    }
                });

                return components;
            },
            getComponentArrayByFieldNameAndStep(fieldName, step) {
                return Object.values(this.getComponentsByFieldNameAndStep(fieldName, step));
            },
            getComponentByFieldNameAndStep(fieldName, step) {
                return this.getComponentArrayByFieldNameAndStep(fieldName, step).find(() => true);
            },
            removeInvisibleComponents() {
                return Alpine.store('LokiComponents').removeInvisibleComponents();
            },
            exists(component) {
                if (!Alpine.store('LokiComponents').exists(component)) {
                    return false;
                }

                const element = document.getElementById(component.elementId);
                if (!element) {
                    return false;
                }

                if (element.children.length === 0) {
                    return false;
                }

                return true;
            },
            add(component) {
                return Alpine.store('LokiComponents').add(component);
            },
            get(componentId) {
                return Alpine.store('LokiComponents').get(componentId);
            },
            getInvalidComponents(step) {
                const components = {};
                this.getComponentArrayByStep(step).forEach(component => {
                    if (!this.exists(component)) {
                        return;
                    }

                    if (component.valid) {
                        return;
                    }

                    if (component.skipValidation) {
                        return;
                    }

                    if (!component.visible) {
                        return;
                    }

                    components[component.id] = component;
                });

                return components;
            },
            getInvalidComponentArray(step) {
                return Object.values(this.getInvalidComponents(step));
            },
            getInvalidComponentIds(step) {
                return Object.keys(this.getInvalidComponents(step));
            },
            hasInvalidComponents(step) {
                return Object.values(this.getInvalidComponents(step)).length > 0;
            },
            hasOnlyValidComponents(step) {
                return !this.hasInvalidComponents(step);
            },
            lock(component) {
                this.components[component.id].locked = true;
                document.dispatchEvent(new CustomEvent('loki-components.component.update', {detail: {component}}));
            },
            componentIds(components) {
                const ids = [];
                Object.values(components).forEach(component => {
                    ids.push(component.id);
                });

                return ids;
            },
            unlock(component) {
                this.components[component.id].locked = false;
                document.dispatchEvent(new CustomEvent('loki-components.component.update', {detail: {component}}));
            },
            isLocked(component) {
                return this.components[component.id].locked;
            },
            hasLockedComponents(step) {
                let hasLocked = false;
                this.getComponentArrayByStep(step).forEach(component => {
                    if (component.locked === true && component.step === step) {
                        hasLocked = true;
                    }
                });

                return hasLocked;
            }
        });

        // @doc
        document.addEventListener('loki-checkout.checkout-store.remove-invisible', () => {
            Alpine.store('LokiCheckout').removeInvisibleComponents();
        });
    });
</script>
