<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Factory\ViewModelFactory;
use LokiCheckout\Core\Step\StepNavigator;

/** @version 2.0.15 */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var StepNavigator $stepNavigator */

$stepNavigator = $viewModelFactory->create(StepNavigator::class);
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.store('checkout', {
            currentStep: '<?= $escaper->escapeHtml($stepNavigator->getCurrentStep()->getCode()) ?>',
            getComponentIds() {
                return Alpine.store('components').getComponentIds();
            },
            getComponentIdsByStep(step) {
                return Object.keys(Alpine.store('checkout').getComponentsByStep(step));
            },
            getComponents() {
                return Alpine.store('components').getComponents();
            },
            getComponentArray() {
                return Alpine.store('components').getComponentArray();
            },
            getComponentsByStep(step) {
                if (!step) {
                    LokiCheckoutLogger.error('getInvalidComponents() called without step argument');
                    return {};
                }

                const components = {};
                this.getComponentArray().forEach(component => {
                    const matchStep = component.step === step || (step.includes(component.step));
                    if (this.exists(component) && matchStep) {
                        components[component.id] = component;
                    }
                });
                return components;
            },
            getComponentArrayByStep(step) {
                return Object.values(this.getComponentsByStep(step));
            },
            getComponentsByFieldNameAndStep(fieldName, step) {
                const components = {};
                this.getComponentArray().forEach(component => {
                    if (component.fieldName === fieldName && component.step === step) {
                        components[component.id] = component;
                    }
                });
                return components;
            },
            getComponentArrayByFieldNameAndStep(fieldName, step) {
                return Object.values(this.getComponentsByFieldNameAndStep(fieldName, step));
            },
            getComponentByFieldNameAndStep(fieldName, step) {
                return this.getComponentArrayByFieldNameAndStep(fieldName, step).find(() => true);
            },
            removeInvisibleComponents() {
                return Alpine.store('components').removeInvisibleComponents();
            },
            exists(component) {
                return Alpine.store('components').exists(component);
            },
            add(component) {
                return Alpine.store('components').add(component);
            },
            get(componentId) {
                return Alpine.store('components').get(componentId);
            },
            getInvalidComponents(step) {
                const components = {};
                this.getComponentArrayByStep(step).forEach(component => {
                    if (false === component.valid) {
                        components[component.id] = component;
                    }
                });
                return components;
            },
            getInvalidComponentArray(step) {
                return Object.values(this.getInvalidComponents(step));
            },
            getInvalidComponentIds(step) {
                return Object.keys(this.getInvalidComponents(step));
            },
            hasInvalidComponents(step) {
                return Object.values(this.getInvalidComponents(step)).length > 0;
            },
            hasOnlyValidComponents(step) {
                return !this.hasInvalidComponents(step);
            },
            lock(component) {
                this.components[component.id].locked = true;
                document.dispatchEvent(new CustomEvent('loki-components.component.update', {detail: {component}}));
            },
            unlock(component) {
                this.components[component.id].locked = false;
                document.dispatchEvent(new CustomEvent('loki-components.component.update', {detail: {component}}));
            },
            isLocked(component) {
                return this.components[component.id].locked;
            },
            hasLockedComponents(step) {
                let hasLocked = false;
                this.getComponentArrayByStep(step).forEach(component => {
                    if (component.locked === true && component.step === step) {
                        hasLocked = true;
                    }
                });

                return hasLocked;
            }
        });

        // @doc
        document.addEventListener('loki-checkout.checkout-store.remove-invisible', () => {
            Alpine.store('checkout').removeInvisibleComponents();
        });
    });
</script>
