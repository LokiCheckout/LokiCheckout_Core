<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @version 2.4.0 */
/** @var Template $block */
/** @var Escaper $escaper */

$options = (array)$block->getOptions();
if (!isset($options['weekday'])) {
    $options['weekday'] = 'long';
}

if (!isset($options['month'])) {
    $options['month'] = 'long';
}

if (!isset($options['day'])) {
    $options['day'] = 'numeric';
}

$options['locale'] = 'nl-NL'; // @todo: Make this dynamic
$options['timeZone'] = 'Europe/Amsterdam'; // @todo: Make this dynamic
?>
<script>
    const LokiCheckoutDateOptions = JSON.parse('<?= /* @noEscape */ json_encode($options) ?>');
    const getLokiCheckoutDateFromValue = (value, modifiers = []) => {
        if (modifiers.includes('timestamp') || typeof value === Number) {
            value = Number(value);

            if (Number.isNaN(value)) {
                return null;
            }

            if (value < 1e12) {
                value *= 1000;
            }
        }

        return new Date(value);
    }

    document.addEventListener('alpine:init', () => {
        Alpine.directive('date', (el, { value, modifiers, expression }, { evaluate }) => {
            if (expression) {
                const value = evaluate(expression);
                const date = new Date(getLokiCheckoutDateFromValue(value, modifiers));
                el.textContent = date.toLocaleString(LOKI_LOCALE, LokiCheckoutDateOptions);
            }
        });

        Alpine.directive('datetime', (el, { value, modifiers, expression }, { evaluate }) => {
            if (expression) {
                const value = evaluate(expression);
                const date = new Date(getLokiCheckoutDateFromValue(value, modifiers));
                el.textContent = date.toLocaleString(LOKI_LOCALE, LokiCheckoutDateOptions) + ', ' + date.toLocaleTimeString();
            }
        });

        Alpine.directive('time', (el, { value, modifiers, expression }, { evaluate }) => {
            if (expression) {
                const value = evaluate(expression);
                if (!value) {
                    return;
                }

                const match = value.toString().match(/^([0-9]{2}):([0-9]{2})(?::([0-9]{2}))?$/);
                if (match) {
                    el.textContent = match[1] + ':' + match[2];
                    return;
                }

                const date = new Date(getLokiCheckoutDateFromValue(value, modifiers));
                el.textContent = new Intl.DateTimeFormat('<?= $escaper->escapeHtml($options['locale']) ?>', {
                    hour: '2-digit',
                    minute: '2-digit',
                    hour12: false,
                    timeZone: '<?= $escaper->escapeHtml($options['timeZone']) ?>'
                }).format(date);
            }
        });
    });
</script>
