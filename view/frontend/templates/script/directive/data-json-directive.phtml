<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;

/** @version 2.3.27 */
/** @var Template $block */

?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.directive('data-json', (el, { expression, modifiers }, { evaluate }) => {
            const value = evaluate(expression)
            const spacing = modifiers.includes('pretty') ? 2 : 0

            el.setAttribute(
                'data-json',
                JSON.stringify(value, null, spacing)
            )
        })
    })
</script>
