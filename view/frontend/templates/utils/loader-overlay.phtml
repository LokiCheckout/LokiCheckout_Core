<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;
use Yireo\LokiComponents\Component\ComponentViewModelInterface;

/** @var Template $block */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */
$size = (int)$block->getSize();
if (empty($size)) {
    $size = 50;
}

$viewModel = $block->getViewModel();
$hasViewModel = $viewModel instanceof ComponentViewModelInterface;
?>
<div
    <?php if ($hasViewModel) : ?>
    x-cloak x-show="loading"
    <?php endif; ?>
    aria-live="polite"
    class="<?= $css('z-30 absolute top-0 left-0 right-0 bottom-0 inset-0 bg-white/60 flex justify-center items-center') ?> <?php if (false === $hasViewModel) : ?>hidden loading<?php endif; ?>">
    <?= $blockRenderer->html('loki-checkout.utils.loader', $block, ['size' => $size]) ?>
</div>
