<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Util\Block\BlockCssClass;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;

/** @var Template $block */
/** @var BlockCssClass $blockCss */
/** @var BlockRenderer $blockRenderer */
$size = (int)$block->getSize();
if (empty($size)) {
    $size = 50;
}
?>
<div
    wire:loading.flex
    aria-live="polite"
    class="z-30 absolute top-0 left-0 right-0 bottom-0 inset-0 bg-white/60 flex justify-center items-center">
    <?= $blockRenderer->html('loki.checkout.utils.loader', ['size' => $size]) ?>
</div>
