<?php
declare(strict_types=1);

use Loki\Components\Component\ComponentViewModelInterface;
use Loki\CssUtils\Util\CssClass;
use Loki\Components\Factory\ViewModelFactory;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use LokiCheckout\Core\Component\Base\AddressField\AddressFieldViewModel;
use Loki\Components\Component\ComponentInterface;
use Loki\Components\Util\Block\ImageRenderer;

/** @version 2.3.25 */
/** @var ComponentViewModelInterface $viewModel */
/** @var ViewModelFactory $viewModelFactory */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var CssClass $css */
/** @var ComponentInterface|null $viewModel */
/** @var Template $ancestorBlock */
/** @var ImageRenderer $imageRenderer */

$viewModel = $block->getViewModel();

$ancestorBlock = $block->getAncestorBlock();
?>
<div x-data="{open:false}" class="<?= $escaper->escapeHtml($css('absolute top-0 left-0')) ?>">
    <button @click.prevent="open = ! open">
        <?= /* @noEscape */ $imageRenderer->icon($block, 'debug'); ?>
    </button>
    <div x-cloak x-show="open" class="<?= $escaper->escapeHtml($css('absolute z-50 w-auto text-sm bg-orange-100 border-2 border-orange-400 p-2', 'modal')) ?>">
        Component: <?= ($viewModel instanceof ComponentInterface) ? $escaper->escapeHtml(get_class($viewModel)) : 'none' ?><br>
        Block: <?= $escaper->escapeHtml(get_class($ancestorBlock)) ?><br>
        Name in layout: <?= $escaper->escapeHtml($ancestorBlock->getNameInLayout()) ?><br>
        Template file: <?= $escaper->escapeHtml($ancestorBlock->getTemplateFile()) ?><br>
        <?php if ($viewModel instanceof AddressFieldViewModel): ?>
            Validators: <?= $escaper->escapeHtml(implode(', ', $viewModel->getValidators())) ?><br>
            Filters: <?= $escaper->escapeHtml(implode(', ', $viewModel->getFilters())) ?><br>
        <?php endif; ?>
    </div>
</div>
