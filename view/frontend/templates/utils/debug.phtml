<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Magewirephp\Magewire\Component;

/** @var Template $block */
/** @var \Yireo\LokiCheckout\Util\BlockCssClass $blockCss */
/** @var Component|null $component */
/** @var Template $ancestorBlock */
$component = $block->getComponent();
$ancestorBlock = $block->getAncestorBlock();
?>
<div class="<?= $blockCss('text-xs bg-orange-100 m-1 p-1') ?>">
    Component: <?= ($component instanceof Component) ? get_class($component) : 'no' ?><br/>
    Block: <?= get_class($ancestorBlock) ?> / <?= $ancestorBlock->getNameInLayout() ?><br/>
</div>
