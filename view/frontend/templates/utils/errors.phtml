<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;

/**
 * Note that if you change this template, it needs to remain compatible with LokiCheckoutMessenger
 */

/** @var Template $block */
/** @var string $blockClass */
/** @var string[] $errors */
$errors = $block->getErrors();
?>
<ul class="<?= $blockClass ?> error text-red-800" x-ref="errors">
    <?php foreach ($errors as $error): ?>
        <li><?= $error ?></li>
    <?php endforeach; ?>
</ul>
