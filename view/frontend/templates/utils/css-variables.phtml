<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Factory\ViewModelFactory;
use LokiCheckout\Core\ViewModel\CssVariables;

/** @version 2.4.5 */
/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var CssVariables $cssVariables */

$cssVariables = $viewModelFactory->create(CssVariables::class);
?>
<style>
    :root {
    <?php foreach ($cssVariables->get() as $cssVariable) : ?> -- <?= $escaper->escapeHtml($cssVariable->getName()) ?>: <?= $escaper->escapeHtml($cssVariable->getValue()) ?>;
    <?php endforeach; ?>
    }
</style>
