<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiComponents\Util\Block\CssClass;

/** @var Template $block */
/** @var CssClass $css */
$size = (int)$block->getSize();
if (!$size) {
    $size = 20;
}

$text = $block->getAncestorBlock()->getHelpText();
?>
<div class="<?= $css('relative') ?>" x-data="LokiCheckoutToggle" x-cloak>
    <button type="button" @click="toggle">
        <img alt="<?= __('Show help') ?>"
             src="<?= $block->getViewFileUrl('Yireo_LokiCheckout::images/help.svg'); ?>"
             class="<?= $css('help m-2', 'image') ?>"
             width="<?= $size ?>"
             height="<?= $size ?>">
    </button>

    <div x-cloak x-show="show" class="<?= $css('absolute z-50 right-0 w-100 p-3 bg-zinc-400 text-white', 'popup') ?>">
        <?= $text ?>
    </div>
</div>
