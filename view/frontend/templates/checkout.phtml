<?php
declare(strict_types=1);

use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Magewire\Checkout;
use Yireo\LokiCheckout\Util\BlockCssClass;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var Checkout $magewire */
/** @var BlockCssClass $blockCss */

$currentStep = $magewire->currentStep;
?>
<div class="<?= $blockCss('space-y-6') ?>">
    <?= $block->getChildBlock('progressbar')->toHtml(); ?>

    <div
        class="grid grid-cols-1 lg:grid-cols-[var(--checkout-layout)] gap-8"
        style="--checkout-layout: minmax(0px,2fr) minmax(0px,1fr);"
    >
        <div class="opc relative">
            <div
                wire:loading
                x-cloak
                aria-live="polite"
                class="loader-container"
            >
                <div class="z-30 absolute inset-0 bg-white/60 flex justify-center items-center">
                    <img
                        src="<?= $block->getViewFileUrl('Yireo_LokiCheckout::images/loader.svg'); ?>"
                        width="100"
                        height="100"
                        alt="Loading..."
                    >
                </div>
            </div>

            <?php
                $stepBlock = $block->getChildBlock($currentStep.'-step');

                if ($stepBlock) {
                    echo $stepBlock->toHtml();
                } else {
                    echo 'No step block for "'.$currentStep.'"';
                }
            ?>
        </div>

        <?= $block->getChildBlock('sidebar')->toHtml(); ?>
    </div>
</div>
