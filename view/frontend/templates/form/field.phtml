<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Component\Base\Field\FieldViewModel;
use Yireo\LokiCheckout\Util\Component\AlpineComponentData;
use Yireo\LokiComponents\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\Util\Block\TemplateRenderer;

/** @var Template $block */
/** @var CssClass $css */
/** @var ViewModelFactory $viewModelFactory */
/** @var TemplateRenderer $templateRenderer */
/** @var BlockRenderer $blockRenderer */
/** @var FieldViewModel $viewModel */
/** @var AlpineComponentData $alpineComponentData */
$alpineComponentData = $viewModelFactory->create(AlpineComponentData::class);
$templateRenderer = $viewModelFactory->create(TemplateRenderer::class);
$blockRenderer = $viewModelFactory->create(BlockRenderer::class);
?>
<div class="<?= $css('field w-auto relative') ?> <?= $viewModel->isRequired() ? 'required' : 'optional' ?> <?= $viewModel->getFieldName() ?>"
     x-data="LokiCheckoutFieldComponent"
     x-title="<?= $alpineComponentData->getName($block) ?>"
     x-init-data='<?= $alpineComponentData->getJson($viewModel) ?>'
     x-target
>
    <?= $block->getChildHtml('before') ?>

    <?= $templateRenderer->html('form/field/label.phtml', $block, ['alias' => 'label']) ?>

    <div class="<?= $css('relative space-y-2 flex', 'field') ?>">
        <?= $templateRenderer->html($viewModel->getFieldTemplate(), $block, $viewModel->getFieldData()) ?>

        <div x-cloak x-show="loading" class="<?= $css('field-loader absolute inset-y-0 right-0 pt-1 pr-2', 'loader') ?>">
            <?= $blockRenderer->html('loki-checkout.utils.loader-small') ?>
        </div>

        <?php if ($block->getHelpText()): ?>
            <?= $templateRenderer->html('utils/help.phtml', $block, ['alias' => 'help']) ?>
        <?php endif; ?>
    </div>

    <?= $blockRenderer->html('loki-checkout.utils.messages', $block, ['messages' => $viewModel->getMessageManager()->getLocalMessages()]) ?>
    <?= $block->getChildHtml('after') ?>
</div>
