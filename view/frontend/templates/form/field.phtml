<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Magewirephp\Magewire\Component;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Magewire\Form\Field\FormFieldInterface;
use Yireo\LokiCheckout\Util\Block\BlockAttribute;
use Yireo\LokiCheckout\Util\Block\BlockCssClass;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;

/** @var Template $block */
/** @var Component|FormFieldInterface $magewire */
/** @var BlockCssClass $blockCss */
/** @var ViewModelFactory $viewModelFactory */
/** @var BlockRenderer $blockRenderer */
/** @var BlockAttribute $blockAttribute */

if (false === $magewire instanceof FormFieldInterface || false === $magewire instanceof Component) {
    echo '<div style="display:none">skipped</div>';

    return;
}

if (false === $magewire->isVisible()) {
    echo '<div style="display:none">not visible</div>';

    return;
}
?>
<div id="<?= $magewire->getElementId() ?>" <?= $blockAttribute() ?> class="<?= $blockCss('field w-auto relative') ?> <?= $magewire->isRequired() && 'required' ?> <?= $magewire->getFieldName() ?>" x-data="<?= $magewire->getJsName() ?>">
    <label for="<?= $magewire->getFieldName() ?>" class="inline-block mb-1.5">
        <?= $magewire->getFieldLabel() ?>
        <?= $magewire->isRequired() ? $block->getBlockHtml('loki.checkout.utils.required') : '' ?>
    </label>
    <div class="relative space-y-2">
        <?= $blockRenderer->render($magewire->getFieldTemplate(), $block) ?>

        <div wire:loading x-cloak class="field-loader absolute inset-y-0 right-0 pt-1 pr-2">
            <?= $blockRenderer->html('loki.checkout.utils.loader-small') ?>
        </div>
    </div>

    <?= $blockRenderer->get('loki.checkout.utils.errors')->setErrors($magewire->getErrors())->toHtml() ?>
    <?= $blockRenderer->render('form/field/text/script.phtml', $block) ?>
    <?= $blockRenderer->html($magewire->getNameInLayout().'.additional_script', ['component' => $magewire]) ?>
</div>
