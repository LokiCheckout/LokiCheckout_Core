<?php
declare(strict_types=1);

use Magento\Framework\View\Element\AbstractBlock;
use Magento\Framework\View\Element\Template;
use Magewirephp\Magewire\Component;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Magewire\Form\Field\FormFieldInterface;
use Yireo\LokiCheckout\ViewModel\BlockRenderer;

/** @var Template $block */
/** @var Component|FormFieldInterface $magewire */
/** @var \Yireo\LokiCheckout\Util\BlockCssClass $blockCss */
/** @var ViewModelFactory $viewModelFactory */
/** @var BlockRenderer $blockRenderer */
$blockRenderer = $viewModelFactory->create(BlockRenderer::class);

if (false === $magewire instanceof FormFieldInterface || false === $magewire instanceof Component) {
    echo '<div style="display:none">skipped</div>';

    return;
}

if (false === $magewire->isVisible()) {
    echo '<div style="display:none">not visible</div>';

    return;
}
?>
<div id="<?= $magewire->getElementId() ?>" class="<?= $blockCss('') ?> field w-full relative <?= $magewire->isRequired(
) && 'required' ?> <?= $magewire->getFieldName() ?>" <?php if ($magewire->hasClientSideValidation()): ?>x-data="<?= $magewire->getJsName() ?>"<?php endif; ?>>
    <label for="<?= $magewire->getFieldName() ?>" class="inline-block mb-1.5">
        <?= $magewire->getFieldLabel() ?>
        <?= $magewire->isRequired() ? $block->getBlockHtml('loki.checkout.utils.required') : '' ?>
    </label>
    <div class="relative space-y-2">
        <?= $blockRenderer->render($magewire->getFieldTemplate(), $block, $magewire) ?>
        <div wire:loading x-cloak class="field-loader absolute inset-y-0 right-0 p-2">
            <?= $block->getBlockHtml('loki.checkout.utils.loader') ?>
        </div>
        <div x-show="locked" class="field-locked absolute inset-y-0 right-0 p-2">
            <?= $block->getBlockHtml('loki.checkout.utils.loader') ?>
        </div>
    </div>

    <?= $blockRenderer->get('loki.checkout.utils.errors')->setErrors($magewire->getErrors())->toHtml() ?>

    <?php $script = $block->getChildBlock('script'); ?>
    <?php if ($script instanceof AbstractBlock): ?>
        <?= $script->addData(['component' => $magewire])->toHtml() ?>
    <?php else: ?>
        <?= $blockRenderer->render('form/field/text_js/script.phtml', $block, $magewire) ?>
    <?php endif; ?>
</div>
