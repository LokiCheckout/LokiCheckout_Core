<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Magewirephp\Magewire\Component;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Magewire\Form\Field\FormFieldInterface;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;

/** @var Template $block */
/** @var Component|FormFieldInterface $magewire */
/** @var CssClass $css */
/** @var ViewModelFactory $viewModelFactory */
/** @var BlockRenderer $blockRenderer */

if (false === $magewire instanceof FormFieldInterface || false === $magewire instanceof Component) {
    echo '<div style="display:none">skipped</div>';

    return;
}

if (false === $magewire->isVisible()) {
    echo '<div style="display:none">not visible</div>';

    return;
}
?>
<div id="<?= $magewire->getElementId() ?>"
     class="<?= $css('field w-auto relative') ?> <?= $magewire->isRequired(
     ) && 'required' ?> <?= $magewire->getFieldName() ?>" x-data="<?= $magewire->getJsName() ?>">
    <label for="<?= $magewire->getElementId() ?>-field" class="<?= $css('inline-block mb-1.5', 'label') ?>">
        <?= __($magewire->getFieldLabel()) ?>
        <?= $magewire->isRequired() ? $block->getBlockHtml('loki.checkout.utils.required') : '' ?>
    </label>
    <div class="<?= $css('relative space-y-2 flex', 'field') ?>">
        <?= $blockRenderer->html($magewire->getFieldTemplate(), $block) ?>

        <div wire:loading x-cloak class="<?= $css('field-loader absolute inset-y-0 right-0 pt-1 pr-2', 'loader') ?>">
            <?= $blockRenderer->html('loki.checkout.utils.loader-small') ?>
        </div>

        <?php if ($block->getHelpText()): ?>
            <?= $blockRenderer->html('utils/help.phtml', $block) ?>
        <?php endif; ?>
    </div>

    <?= $blockRenderer->html('loki.checkout.utils.errors', $block, ['errors' => $magewire->getErrors()]) ?>
    <?= $blockRenderer->html('form/field/text/script.phtml', $block) ?>
    <?= $blockRenderer->html($magewire->getNameInLayout().'.additional_script', $block, ['component' => $magewire]) ?>
</div>
