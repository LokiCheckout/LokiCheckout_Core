<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Magewire\Form\Field\FieldComponent;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\Util\Block\TemplateRenderer;

/** @var Template $block */
/** @var FieldComponent $magewire */
/** @var CssClass $css */
/** @var ViewModelFactory $viewModelFactory */
/** @var TemplateRenderer $templateRenderer */
/** @var BlockRenderer $blockRenderer */

$templateRenderer = $viewModelFactory->create(TemplateRenderer::class);
$blockRenderer = $viewModelFactory->create(BlockRenderer::class);

// @todo: Determine LokiCheckoutFieldComponent from component method getAlpineComponentName()
?>
<div class="<?= $css('field w-auto relative') ?> <?= $magewire->isRequired() ? 'required' : 'optional' ?> <?= $magewire->getFieldName() ?>"
     x-data="LokiCheckoutFieldComponent"
     x-title="<?= $magewire->getAlpineComponentName() ?>"
     data-loki-component='<?= $magewire->getAlpineDataAsJson() ?>'
>
    <?= $block->getChildHtml('before') ?>

    <?= $templateRenderer->html('form/field/label.phtml', $block, ['alias' => 'label']) ?>

    <div class="<?= $css('relative space-y-2 flex', 'field') ?>">
        <?= $templateRenderer->html($magewire->getFieldTemplate(), $block, $magewire->getFieldData()) ?>

        <div wire:loading x-cloak class="<?= $css('field-loader absolute inset-y-0 right-0 pt-1 pr-2', 'loader') ?>">
            <?= $blockRenderer->html('loki-checkout.utils.loader-small') ?>
        </div>

        <?php if ($block->getHelpText()): ?>
            <?= $templateRenderer->html('utils/help.phtml', $block, ['alias' => 'help']) ?>
        <?php endif; ?>
    </div>

    <?= $blockRenderer->html('loki-checkout.utils.errors', $block, ['errors' => $magewire->getErrors()]) ?>
    <?= $block->getChildHtml('after') ?>
</div>
