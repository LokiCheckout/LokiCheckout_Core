<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Component\Form\Field\Field;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;
use Yireo\LokiCheckout\Util\Block\CssClass;

/** @var Template $block */
/** @var Field $viewModel */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */

$viewModel = $block->getViewModel();
?>
<label
    for="<?= $viewModel->getDomId() ?>-field"
    class="<?= $css('inline-block mb-1.5') ?>">
    <?= __($viewModel->getFieldLabel()) ?>

    <?php if ($viewModel->isRequired() && $viewModel->getLokiCheckoutConfig()->useRequiredBlock()): ?>
        <?= $blockRenderer->html('loki-checkout.utils.required'); ?>
    <?php endif; ?>
</label>
