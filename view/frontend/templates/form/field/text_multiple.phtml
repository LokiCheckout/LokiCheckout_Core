<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Magewirephp\Magewire\Component;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Magewire\Generic\FormTextMultipleFieldInterface;
use Yireo\LokiCheckout\ViewModel\BlockRenderer;

/** @var Template $block */
/** @var Component|FormTextMultipleFieldInterface $magewire */
/** @var ViewModelFactory $viewModelFactory */
$blockRenderer = $viewModelFactory->create(BlockRenderer::class);
$magewire = $this->getComponent();
$textCount = $magewire->getTextCount();

$i = 0;
while ($i < $textCount) {
    $magewire->setCounter($i);
    echo $blockRenderer->render('form/field/text.phtml', $block, $magewire);
    $i++;
}
