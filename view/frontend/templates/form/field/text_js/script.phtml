<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Magewire\Generic\AddressFieldComponent;

/** @var Template $block */
/** @var Template $fieldBlock */
/** @var AddressFieldComponent $magewire */
$fieldBlock = $block->getFieldBlock();
$component = $this->getComponent();
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('<?= $component->getJsName() ?>', () => ({
            value: '<?= $component->value ?>',
            locked: false,
            init() {
                window.addEventListener('yireo-loki-checkout.lock', (event) => {
                    if ('<?= $magewire->getElementId() ?>'.endsWith('-postcode') &&
                        event.detail.lockedComponent.endsWith('-country-id')
                    ) {
                        //this.locked = true; // @todo: Find a way to do unlock this again
                    }
                });
            },
            rules: {
                <?php if($component->isRequired()): ?>
                required: {value: '<?= __('Value') ?>'}
                <?php endif; ?>
            },
            submit() {
                if (false === window.LokiCheckoutValidator.validate(this)) {
                    return false;
                }

                window.dispatchEvent(new CustomEvent('yireo-loki-checkout.lock', {
                    detail: {
                        lockedComponent: '<?= $magewire->getElementId() ?>'
                    }
                }));

                Magewire.find(this.$root.getAttribute('wire:id')).call('setValue', this.value);
            }
        }));
    });
</script>
