<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Component\Base\Field\FieldViewModel;
use Yireo\LokiCheckout\Util\Block\CssClass;

/** @var Template $block */
/** @var Template $fieldBlock */
/** @var FieldViewModel $viewModel */
/** @var CssClass $css */

$fieldBlock = $block->getFieldBlock();
$viewModel = $block->getViewModel();
?>
<input
    aria-invalid="<?= $viewModel->isValid() ? 'false' : 'true' ?>"
    data-type="field"
    x-ref="field"
    x-model.lazy="value"
    @change="submit"
    <?php if ($viewModel->isDisabled()): ?>
        disabled="disabled"
    <?php endif ?>
    <?php if ($viewModel->hasAutocomplete()): ?>
        autocomplete="<?= $viewModel->getAutocomplete() ?>"
    <?php endif ?>
    <?php if ($viewModel->hasMinLength()): ?>
        minlength="<?= $viewModel->getMinLength() ?>"
    <?php endif ?>
    <?php if ($viewModel->hasMaxLength()): ?>
        maxlength="<?= $viewModel->getMaxLength() ?>"
    <?php endif ?>
    <?php if ($viewModel->hasMin()): ?>
        min="<?= $viewModel->getMin() ?>"
    <?php endif ?>
    <?php if ($viewModel->hasMax()): ?>
        max="<?= $viewModel->getMax() ?>"
    <?php endif ?>
    <?php if ($viewModel->getPlaceholder()): ?>
        placeholder="<?= $viewModel->getPlaceholder() ?>"
    <?php endif ?>
    <?= $viewModel->isRequired() ? 'required' : '' ?>
    type="<?= $viewModel->getInputType() ?>"
    class="<?= $css('form-input w-full disabled:bg-zinc-100', 'input') ?>"
>
