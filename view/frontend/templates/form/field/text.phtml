<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Component\Form\Field\Field;
use Yireo\LokiCheckout\Util\Block\CssClass;

/** @var Template $block */
/** @var Template $fieldBlock */
/** @var Field $component */
/** @var CssClass $css */
$fieldBlock = $block->getFieldBlock();
$component = $block->getComponent();
?>
<input
    aria-invalid="<?= $component->isValid() ? 'false' : 'true' ?>"
    data-type="field"
    x-ref="field"
    x-model.lazy="value"
    @change="submit"
    <?php if ($component->isDisabled()): ?>
        disabled="disabled"
    <?php endif ?>
    <?php if ($component->hasMinLength()): ?>
        minlength="<?= $component->getMinLength() ?>"
    <?php endif ?>
    <?php if ($component->hasMaxLength()): ?>
        maxlength="<?= $component->getMaxLength() ?>"
    <?php endif ?>
    <?php if ($component->hasMin()): ?>
        min="<?= $component->getMin() ?>"
    <?php endif ?>
    <?php if ($component->hasMax()): ?>
        max="<?= $component->getMax() ?>"
    <?php endif ?>
    <?php if ($component->getPlaceholder()): ?>
        placeholder="<?= $component->getPlaceholder() ?>"
    <?php endif ?>
    <?= $component->isRequired() ? 'required' : '' ?>
    type="<?= $component->getInputType() ?>"
    class="<?= $css('form-input w-full disabled:bg-zinc-100', 'input') ?>"
>
