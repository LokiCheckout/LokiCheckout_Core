<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Magewire\Form\Field\AddressFieldComponent;
use Yireo\LokiCheckout\Util\Block\CssClass;

/** @var Template $block */
/** @var Template $fieldBlock */
/** @var AddressFieldComponent $magewire */
/** @var CssClass $css */
$fieldBlock = $block->getFieldBlock();
$magewire = $this->getComponent();
?>
<input
    wire:loading.attr="aria-busy"
    wire:loading.class="disabled"
    data-type="field"
    x-ref="field"
    x-model.lazy="value"
    x-on:change="submit"
    <?php if ($magewire->isDisabled()): ?>
        disabled="disabled"
    <?php endif ?>
    <?php if ($magewire->hasMinLength()): ?>
        minlength="<?= $magewire->getMinLength() ?>"
    <?php endif ?>
    <?php if ($magewire->hasMaxLength()): ?>
        maxlength="<?= $magewire->getMaxLength() ?>"
    <?php endif ?>
    <?php if ($magewire->hasMin()): ?>
        min="<?= $magewire->getMin() ?>"
    <?php endif ?>
    <?php if ($magewire->hasMax()): ?>
        max="<?= $magewire->getMax() ?>"
    <?php endif ?>
    aria-invalid="<?= $magewire->isValid() ? 'false' : 'true' ?>"
    <?php if ($magewire->getPlaceholder()): ?>
        placeholder="<?= $magewire->getPlaceholder() ?>"
    <?php endif ?>
    <?= $magewire->isRequired() ? 'required' : '' ?>
    type="<?= $magewire->getInputType() ?>"
    class="<?= $css('form-input w-full disabled:bg-zinc-100', 'input') ?>"
>
