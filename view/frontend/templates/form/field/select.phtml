<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Component\Base\Field\FieldBehaviour\OptionsBehaviour;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\Component\Base\Field\Field;

/** @var Template $block */
/** @var Field|OptionsBehaviour $viewModel */
/** @var CssClass $css */
$viewModel = $block->getViewModel();
$optionModel = $block->getAncestorBlock()->getOptionModel();
$viewModel->setOptionModel($optionModel);

// @todo: Check disabled state
// @todo: Check aria-busy
?>
<select
    data-type="field"
    x-ref="field"
    x-model="value"
    @change="submit"
    aria-invalid="<?= $viewModel->isValid() ? 'false' : 'true' ?>"
    <?php if ($viewModel->isDisabled()): ?>
        disabled="disabled"
    <?php endif ?>
    <?= $viewModel->isRequired() ? 'required' : '' ?>
    class="<?= $css('form-select w-full') ?>"
>
    <?php foreach ($optionModel->getOptions($viewModel) as $optionValue => $optionLabel): ?>
        <option value="<?= $optionValue ?>"><?= $optionLabel ?></option>
    <?php endforeach; ?>
</select>
