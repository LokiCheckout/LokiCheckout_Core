<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Magewire\Generic\FormSelectFieldInterface;

/** @var Template $block */
/** @var FormSelectFieldInterface $magewire */
$optionModel = $block->getAncestorBlock()->getOptionModel();
$magewire->setOptionModel($optionModel);
?>
<select
    wire:loading.attr="aria-busy"
    wire:loading.class="disabled"
    wire:model="<?= $magewire->getModelName() ?>"
    <?php if ($magewire->hasErrors()): ?>
        aria-invalid="true" data-invalid="true"
    <?php endif ?>
    <?= $magewire->isRequired() ? 'required' : '' ?>
    class="form-input block w-full data-[invalid=true]:border-red-500">
    <?php foreach ($optionModel->getOptions($magewire) as $optionValue => $optionLabel): ?>
    <option value="<?= $optionValue ?>"><?= $optionLabel ?></option>
    <?php endforeach; ?>
</select>
