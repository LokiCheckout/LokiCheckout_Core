<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Magewire\Form\Field\AddressFieldComponent;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;

/** @var Template $block */
/** @var Template $fieldBlock */
/** @var AddressFieldComponent $component */
/** @var ViewModelFactory $viewModelFactory */
/** @var BlockRenderer $blockRenderer */

$fieldBlock = $block->getFieldBlock();
$component = $this->getComponent();
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('<?= $component->getJsName() ?>', () => {
            let component = {
                elementId: '<?= $component->getElementId() ?>',
                value: '<?= $component->getJsValue() ?>',
                locked: <?= $component->locked ? 'true' : 'false' ?>,
                rules: [
                    <?php foreach($component->getJsValidators() as $jsValidator): ?>
                    '<?= $jsValidator ?>',
                    <?php endforeach; ?>
                ],
                beforeInit() {
                },
                init() {
                    window.addEventListener('yireo-loki-checkout.lock', (event) => {
                        // @todo: Make this not hard-coded
                        if (this.elementId.endsWith('-postcode') && event.detail.lockedComponent.endsWith('-country-id')) {
                            this.locked = true;
                        }
                    });

                    document.addEventListener('livewire:init', () => {
                        Livewire.hook('element.updated', (element, component) => {
                            if (this.elementId === component.el.id) {
                                Alpine.store('lock').unlock(this.elementId);
                                this.locked = false;
                                this.updated();
                            }
                        });
                    });

                    this.afterInit();
                },
                afterInit() {
                },
                updated() {
                },
                beforeSubmit() {
                },
                submit() {
                    this.beforeSubmit();
                    if (false === window.LokiCheckoutValidator.validate(this)) {
                        return false;
                    }

                    Alpine.store('lock').lock(this.elementId);
                    Magewire.find(this.$root.getAttribute('wire:id')).call('setValue', this.value);
                    this.afterSubmit();
                },
                afterSubmit() {
                },
            }

            <?= $blockRenderer->js($component->getNameInLayout().'.additional_script', ['component' => $component]) ?>

            return component;
        });
    });
</script>
