            pattern="[a-zA-Z0-9]*"
            min="2" max="20"
            class="block w-full rounded-r-lg border-l-0 data-[invalid=true]:border-red-500 data-[valid=true]:border-green-500">
    </div>

    <input id="vat_id" type="hidden" wire:model="<?= $magewire->getModelName() ?>">
