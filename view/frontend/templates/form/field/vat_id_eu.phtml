<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Magewire\Generic\FormFieldInterface;
use Yireo\LokiCheckout\Util\BlockCssClass;

/** @var Template $block */
/** @var Template $parentBlock */
/** @var FormFieldInterface $magewire */
/** @var BlockCssClass $blockCss */
?>

<div class="<?= $blockCss('mb-4') ?>">
    <div class="flex">
        <input
            id="vat_id_country"
            x-model="vatIdCountry"
            x-ref="vatIdCountry"
            @change="submit"
            wire:loading.attr="aria-busy"
            wire:loading.class="disabled"
            <?php if ($magewire->hasErrors()): ?>
                aria-invalid="true" data-invalid="true"
            <?php endif ?>
            type="text"
            pattern="[a-zA-Z]*"
            min="2" max="4"
            value="<?= $magewire->getVatCountryId() ?>"
            class="form-input block w-16 rounded-l-lg !rounded-r-none bg-zinc-100 data-[invalid=true]:border-red-500 data-[valid=true]:border-green-500 border-r-1">

        <input
            id="vat_id_text"
            x-model="vatIdNumber"
            x-ref="vatIdNumber"
            @change="submit"
            wire:loading.attr="aria-busy"
            wire:loading.class="disabled"
            <?php if ($magewire->hasErrors()): ?>
                aria-invalid="true"
            <?php endif ?>
            <?php if ($magewire->getPlaceholder()): ?>
                placeholder="<?= $magewire->getPlaceholder() ?>"
            <?php endif ?>
            <?= $magewire->isRequired() ? 'required' : '' ?>
            type="text"
            pattern="[a-zA-Z0-9]*"
            min="2" max="20"
            class="form-input block w-full !rounded-l-none rounded-r-lg border-l-0 data-[invalid=true]:border-red-500 data-[valid=true]:border-green-500">
    </div>

    <input id="vat_id" type="text" wire:model="<?= $magewire->getModelName() ?>">
    <small>Current VAT ID: <?= $magewire->getValue() ?></small>
</div>
