            pattern="[a-zA-Z]*"
            min="2" max="4"
            value="<?= $magewire->getVatCountryId() ?>"
            class="block w-16 rounded-l-lg bg-zinc-100 invalid:bg-red-100 data-[invalid=true]:border-red-500 data-[valid=true]:border-green-500 border-r-1">

        <input
            id="vat_id_text"
            wire:loading.attr="aria-busy"
