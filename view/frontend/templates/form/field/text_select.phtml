<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Magewirephp\Magewire\Component;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Magewire\Form\Field\FormTextSelectFieldInterface;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;

/** @var Template $block */
/** @var Component|FormTextSelectFieldInterface $magewire */
/** @var ViewModelFactory $viewModelFactory */
/** @var BlockRenderer $blockRenderer */

$optionModel = $block->getAncestorBlock()->getOptionModel();
$magewire->setOptionModel($optionModel);

if (count($optionModel->getOptions($magewire)) > 0) {
    $block->setOptionModel($optionModel);
    echo $blockRenderer->getBlockTemplate('form/field/select.phtml', $block);
    return;
}

echo $blockRenderer->getBlockTemplate('form/field/text.phtml', $block);
