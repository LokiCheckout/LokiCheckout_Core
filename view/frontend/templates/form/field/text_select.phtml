<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Magewire\Form\Field\FieldComponent;
use Yireo\LokiCheckout\Magewire\Form\Field\FieldComponentBehaviour\OptionsBehaviour;
use Yireo\LokiCheckout\Util\Block\TemplateRenderer;

/** @var Template $block */
/** @var FieldComponent|OptionsBehaviour $magewire */
/** @var ViewModelFactory $viewModelFactory */

$templateRenderer = $viewModelFactory->create(TemplateRenderer::class);
$optionModel = $block->getAncestorBlock()->getOptionModel();
$magewire->setOptionModel($optionModel);

if (count($optionModel->getOptions($magewire)) > 0) {
    $block->setOptionModel($optionModel);
    echo $templateRenderer->html('form/field/select.phtml', $block, ['alias' => 'select']);
    return;
}

echo $templateRenderer->html('form/field/text.phtml', $block, ['alias' => 'text']);
