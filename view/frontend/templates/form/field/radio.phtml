<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiComponents\Util\Block\CssClass;
use Yireo\LokiCheckout\ViewModel\OptionModel\OptionModelInterface;
use Yireo\LokiComponents\Component\ComponentViewModelInterface;

/** @var Template $block */
/** @var ComponentViewModelInterface $viewModel */
/** @var CssClass $css */

$viewModel = $block->getViewModel();
$optionModel = $block->getAncestorBlock()->getOptionModel();
if (false === $optionModel instanceof OptionModelInterface) {
    echo 'No options found';
    return;
}

?>
<div class="<?= $css('w-full grid grid-cols-1 md:grid-cols-2 p-2') ?>"
     aria-invalid="<?= $viewModel->isValid() ? 'false' : 'true' ?>"
     data-type="field">
    <?php $i = 0; ?>
    <?php foreach ($optionModel->getOptions($viewModel) as $optionValue => $optionLabel): ?>
        <div class="<?= $css('pb-4', 'option') ?>">
            <input
                type="radio"
                id="<?= $viewModel->getElementId() ?>-field-<?= $i ?>"
                x-model="value"
                @change="submit"
                value="<?= $optionValue ?>"
                <?php if ($viewModel->getValue() === $optionValue): ?>
                    checked
                <?php endif; ?>
                <?php if ($viewModel->isDisabled()): ?>
                    disabled="disabled"
                <?php endif ?>
            />
            <label
                class="<?= $css('pl-2', 'label') ?>"
                for="<?= $viewModel->getElementId() ?>-field-<?= $i ?>">
                <?= __($optionLabel) ?>
            </label>
        </div>
        <?php $i++; ?>
    <?php endforeach; ?>
</div>
