<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Component\Form\Field\FieldBehaviour\OptionsBehaviour;
use Yireo\LokiCheckout\Component\Form\Field\FieldInterface;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\Component\Form\Field\Field;

/** @var Template $block */
/** @var FieldInterface|OptionsBehaviour $viewModel */
/** @var CssClass $css */

$optionModel = $block->getAncestorBlock()->getOptionModel();
$viewModel->setOptionModel($optionModel);
?>
<div class="<?= $css('w-full grid grid-cols-2 p-2') ?>"
     aria-invalid="<?= $viewModel->isValid() ? 'false' : 'true' ?>"
     data-type="field">
    <?php $i = 0; ?>
    <?php foreach ($viewModel->getOptions() as $optionValue => $optionLabel): ?>
        <div class="<?= $css('', 'option') ?>">
            <input type="radio"
                   id="<?= $viewModel->getDomId() ?>-field-<?= $i ?>"
                   x-model="value"

                   value="<?= $optionValue ?>"
                <?php if ($viewModel->getValue() === $optionValue): ?>
                    checked
                <?php endif; ?>
                <?php if ($viewModel->isDisabled()): ?>
                    disabled="disabled"
                <?php endif ?>
            />
            <label
                class="<?= $css('pl-2', 'label') ?>"
                for="<?= $viewModel->getDomId() ?>-field-<?= $i ?>">
                <?= __($optionLabel) ?>
            </label>
        </div>
        <?php $i++; ?>
    <?php endforeach; ?>
</div>
