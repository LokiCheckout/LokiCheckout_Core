<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Magewire\Form\Button\ButtonInterface;

/** @var Template $block */
/** @var ButtonInterface $magewire */
$magewire = $block->getComponent();
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('<?= $magewire->getJsName() ?>', () => ({
            wireId: '<?= $magewire->id ?>',
            visible: <?= $magewire->isVisible() ? 'true' : 'false' ?>,
            valid: <?= $magewire->allow() ? 'true' : 'false' ?>,
            init() {
                this.updateValid();

                window.addEventListener('yireo-loki-checkout.step-change', () => {
                    this.updateValid();
                });
            },
            updateValid() {
                this.valid = !Alpine.store('step').hasInvalidComponents('<?= $magewire->getStep() ?>');
            },
            submit() {
                window.dispatchEvent(new CustomEvent('clear-messages'));

                Alpine.store('step').components.forEach((component) => {
                    window.LokiCheckoutValidator.validate(component);
                });

                this.update();

                if (this.valid) {
                    this.$component(this).call('submit');
                }
            }
        }));
    });
</script>
