<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Magewire\Form\Button\ButtonInterface;

/** @var Template $block */
/** @var ButtonInterface $magewire */
$magewire = $block->getComponent();
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('<?= $magewire->getJsName() ?>', () => ({
            wireId: '<?= $magewire->id ?>',
            valid: true,
            init() {
                this.updateValid();
                window.addEventListener('yireo-loki-checkout.component-change', () => {
                    this.updateValid();
                });
            },
            updateValid() {
                this.valid = Alpine.store('components').hasOnlyValidComponents('<?= $magewire->getStep() ?>');
                return this.valid;
            },
            submit() {
                window.dispatchEvent(new CustomEvent('clear-messages'));
                Alpine.store('components').getComponentsByStep('<?= $magewire->getStep() ?>').forEach((component) => {
                    window.LokiCheckoutValidator.validate(component);
                });

                if (this.updateValid()) {
                    this.$component(this).call('submit');
                }
            }
        }));
    });
</script>
