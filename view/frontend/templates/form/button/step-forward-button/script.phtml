<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Magewire\Form\Button\ButtonInterface;

/** @var Template $block */
/** @var ButtonInterface $magewire */
$magewire = $block->getComponent();
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('<?= $magewire->getJsName() ?>', () => ({
            wireId: '<?= $magewire->id ?>',
            step: '<?= $magewire->getStep() ?>',
            valid: true,
            init() {
                this.updateValid();
                document.addEventListener('yireo-loki-checkout.component-change', () => {
                    this.updateValid();
                });
            },
            isDisabled() {
                return this.valid !== true;
            },
            updateValid() {
                this.valid = Alpine.store('components').hasOnlyValidComponents('<?= $magewire->getStep() ?>');
                if (!this.valid) {
                    const components = [];
                    Alpine.store('components').getInvalidComponents('<?= $magewire->getStep() ?>').forEach((component) => {
                        components.push(component.name);
                    })

                    yireoLokiCheckoutLogger('INFO: Invalid components', components);
                }

                return this.valid;
            },
            submit() {
                window.dispatchEvent(new CustomEvent('clear-messages'));
                Alpine.store('components').getComponentsByStep('<?= $magewire->getStep() ?>').forEach((component) => {
                    LokiCheckoutValidator.validate(component);
                });

                if (true === this.updateValid()) {
                    this.$component(this).call('submit');
                }

                // @todo: Is this a good UI benefit?
                setTimeout(() => {
                    this.valid = true;
                    console.log('Resetting valid');
                }, 4000);
            }
        }));
    });
</script>
