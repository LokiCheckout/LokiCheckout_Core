    <?= /* @noEscape */ $imageOutput->icon('arrow-right', $block) ?>
</div>

<div x-cloak x-show="loading" class="<?= /* @noEscape */ $css('inline-block mr-3 w-4 animate-spin fill-white', 'icon') ?>">
    <?= /* @noEscape */ $imageOutput->icon('spinner', $block) ?>
</div>
