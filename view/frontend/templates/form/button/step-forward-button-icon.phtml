<?php
declare(strict_types=1);

use Loki\CssUtils\Util\CssClass;
use LokiCheckout\Core\Step\StepNavigator;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Factory\ViewModelFactory;
use Loki\Components\Util\Block\ImageRenderer;

/** @version 2.3.25 */
/** @var Template $block */
/** @var CssClass $css */
/** @var ViewModelFactory $viewModelFactory */
/** @var ImageRenderer $imageRenderer */
/** @var Escaper $escaper */
/** @var StepNavigator $stepNavigator */

$regularIconId = $block->getRegularIcon() ?? 'LokiCheckout_Core::images/chevron-right.svg';
$finalIconId = $block->getFinalIcon() ?? 'LokiCheckout_Core::images/lock.svg';

$stepNavigator = $viewModelFactory->create(StepNavigator::class);
$iconId = ($stepNavigator->isLastStep()) ? $finalIconId : $regularIconId;

?>
<div x-show="notLoading" class="<?= $escaper->escapeHtml($css('inline-block mr-3', 'icon')) ?>">
    <?= /* @noEscape */ $imageRenderer->icon($block, $iconId) ?>
</div>

<div x-cloak x-show="loading" class="<?= $escaper->escapeHtml($css('inline-block mr-3 animate-spin', 'icon')) ?>">
    <?= /* @noEscape */ $imageRenderer->icon($block, 'spinner') ?>
</div>
