<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Magewire\Form\Button\StepForwardButton;
use Yireo\LokiCheckout\Util\Block\BlockAttribute;
use Yireo\LokiCheckout\Util\Block\CssClass;

/** @var Template $block */
/** @var StepForwardButton $magewire */
/** @var CssClass $css */
/** @var BlockAttribute $blockAttribute */

if (false === $magewire instanceof StepForwardButton) {
    echo '<div>Not a valid button class: '.get_class($magewire).'</div>';

    return;
}

/*if (false === $magewire->isVisible()) {
    echo '<div></div>';

    return;
}*/
?>
<div id="<?= $magewire->getElementId() ?>" <?= $blockAttribute() ?> <?= $css('') ?> x-data="<?= $magewire->getJsName() ?>">
    <button x-show="<?= $magewire->isVisible() ? 'true' : 'false' ?>" class="<?= $css('btn m-2', 'button') ?>"
            type="button"
            :disabled="!valid"
            :class="valid ? 'btn-primary' : 'disabled:opacity-75'"
        <?= $magewire->allow() ? '' : 'disabled="disabled"' ?>
            x-on:click="submit"
            wire:loading.attr="disabled">
        <?= __((string)$block->getButtonLabel()) ?>
    </button>

    <?= $block->getChildBlock('script')->addData(['component' => $magewire])->toHtml(); ?>
</div>
