<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Magewire\Form\Button\StepForwardButton;
use Yireo\LokiCheckout\Util\Block\CssClass;

/** @var Template $block */
/** @var StepForwardButton $magewire */
/** @var CssClass $css */

if (false === $magewire instanceof StepForwardButton) {
    echo '<div></div>';

    return;
}
?>
<div id="<?= $magewire->getElementId() ?>" <?= $css('') ?> x-data="<?= $magewire->getJsName() ?>">
    <?php if ($magewire->isVisible()): ?>
    <button class="<?= $css('btn btn-primary m-2', 'button') ?>"
            type="button"
            :disabled="isDisabled"
            x-on:click="submit"
            wire:loading.attr="disabled">
        <?= __((string)$block->getButtonLabel()) ?>
    </button>
    <?php endif; ?>

    <?= $block->getChildBlock('script')->addData(['component' => $magewire])->toHtml(); ?>
</div>
