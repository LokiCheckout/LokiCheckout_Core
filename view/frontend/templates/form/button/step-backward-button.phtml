<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Magewire\Form\Button\StepBackwardButton;
use Yireo\LokiCheckout\Util\Block\CssClass;

/** @var Template $block */
/** @var StepBackwardButton $magewire */
/** @var CssClass $css */

if (false === $magewire instanceof StepBackwardButton) {
    echo '<div>Not a valid button class: '.get_class($magewire).'</div>';

    return;
}
?>
<div id="<?= $magewire->getElementId() ?>"  <?= $css('') ?> x-data="<?= $magewire->getJsName() ?>">
    <button x-show="<?= $magewire->isVisible() ? 'true' : 'false' ?>" class="hidden <?= $css('btn m-2', 'button') ?> <?= $magewire->allow() ? 'btn-secondary' : 'disabled:opacity-75' ?>"
            type="button"
        <?= $magewire->allow() ? '' : 'disabled="disabled"' ?>
            wire:click="submit"
            wire:loading.attr="disabled">
        <?= __((string)$block->getButtonLabel()) ?>
    </button>

    <?= $block->getChildBlock('script')->addData(['component' => $magewire])->toHtml(); ?>
</div>
