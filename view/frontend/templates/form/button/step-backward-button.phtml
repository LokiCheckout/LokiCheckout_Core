<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Magewire\Form\Button\StepBackwardButton;
use Yireo\LokiCheckout\Util\Block\BlockAttribute;
use Yireo\LokiCheckout\Util\Block\BlockCssClass;

/** @var Template $block */
/** @var StepBackwardButton $magewire */
/** @var BlockCssClass $blockCss */
/** @var BlockAttribute $blockAttribute */

if (false === $magewire instanceof StepBackwardButton) {
    echo '<div>Not a valid button class: '.get_class($magewire).'</div>';

    return;
}

if (false === $magewire->isVisible()) {
    echo '<div></div>';
    return;
}
?>
<div id="<?= $magewire->getElementId() ?>" <?= $blockAttribute() ?> x-data="<?= $magewire->getJsName() ?>">
    <button class="<?= $blockCss('btn m-2') ?> <?= $magewire->allow() ? 'btn-secondary' : 'disabled:opacity-75' ?>"
            type="button"
        <?= $magewire->allow() ? '' : 'disabled="disabled"' ?>
            wire:click="execute"
            wire:loading.attr="disabled">
        <?= __((string)$block->getButtonLabel()) ?>
    </button>

    <?= $block->getChildBlock('script')->addData(['component' => $magewire])->toHtml(); ?>
</div>
