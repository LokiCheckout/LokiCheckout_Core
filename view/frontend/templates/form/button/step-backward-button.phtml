<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Magewire\Form\Button\StepBackwardButton;
use Yireo\LokiCheckout\Util\Block\CssClass;

/** @var Template $block */
/** @var StepBackwardButton $magewire */
/** @var CssClass $css */

if (false === $magewire instanceof StepBackwardButton) {
    echo '<div></div>';

    return;
}
?>
<div id="<?= $magewire->getElementId() ?>"  <?= $css('') ?> x-data="<?= $magewire->getJsName() ?>" x-title="<?= $magewire->getJsName() ?>">
    <?php if ($magewire->isVisible()): ?>
    <button class="<?= $css('btn btn-secondary m-2', 'button') ?>"
            type="button"
            :disabled="!valid"
            wire:click="submit"
            wire:loading.attr="disabled">
        <?= __((string)$block->getButtonLabel()) ?>
    </button>
    <?php endif; ?>

    <?= $block->getChildBlock('script')->addData(['component' => $magewire])->toHtml(); ?>
</div>
