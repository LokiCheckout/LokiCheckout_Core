<?php
declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Yireo\LokiCheckout\Util\Component\AlpineComponentData;
use Yireo\LokiComponents\Factory\ViewModelFactory;
use Yireo\LokiCheckout\Component\Checkout\Step\BillingStep;
use Yireo\LokiCheckout\Step\StepNavigator;
use Yireo\LokiCheckout\Util\Block\CssClass;
use Yireo\LokiCheckout\Util\Block\BlockRenderer;
use Yireo\LokiCheckout\ViewModel\CheckoutState;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var BillingStep $viewModel */
/** @var CssClass $css */
/** @var BlockRenderer $blockRenderer */
/** @var AlpineComponentData $alpineComponentData */
$alpineComponentData = $viewModelFactory->create(AlpineComponentData::class);
$stepNavigator = $viewModelFactory->create(StepNavigator::class);
$checkoutState = $viewModelFactory->create(CheckoutState::class);
$isCurrent = $stepNavigator->getCurrentStep()->getCode() === 'shipping';
$duration = $viewModel->getBlock()->getDuration() ?? '300ms';
?>
<div class="<?= $css('') ?>"
     x-data="LokiCheckoutStep"
     x-title="<?= $alpineComponentData->getName($block) ?>"
     x-init-data='<?= $alpineComponentData->getJson($viewModel) ?>'
     <?php if (false === $isCurrent): ?>x-cloak<?php endif; ?>
     x-show="visible"
     x-transition.duration.<?= $duration ?>.opacity
>
    <?= $block->getChildHtml() ?>
</div>
