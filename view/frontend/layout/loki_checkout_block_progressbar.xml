<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <block name="loki-checkout.progressbar" template="Yireo_LokiCheckout::checkout/progressbar.phtml">
            <arguments>
                <argument name="component" xsi:type="object">Yireo\LokiCheckout\Component\Checkout\Progressbar</argument>
            </arguments>

            <block name="loki-checkout.progressbar.step" as="step" template="Yireo_LokiCheckout::checkout/progressbar/step.phtml"/>
        </block>

        <referenceContainer name="before.body.end">
            <block name="loki-checkout.script.progressbar" template="Yireo_LokiCheckout::script/progressbar.phtml"/>
        </referenceContainer>
    </body>
</page>
