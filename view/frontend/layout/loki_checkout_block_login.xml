<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <block
            name="loki-checkout.login"
            template="LokiCheckout_Core::checkout/login.phtml">
            <arguments>
                <argument name="js_component_name" xsi:type="string">LokiModal</argument>
            </arguments>

            <block
                name="loki-checkout.login.logged-in" as="logged-in"
                template="LokiCheckout_Core::checkout/login/logged-in.phtml">
                <arguments>
                    <argument name="show_customer_email" xsi:type="boolean">false</argument>
                </arguments>

                <block
                    name="loki-checkout.login.logged-in.logout" as="logout"
                    template="LokiCheckout_Core::checkout/login/logged-in/logout.phtml">
                    <arguments>
                        <argument name="show_logout_link" xsi:type="boolean">true</argument>
                    </arguments>
                </block>
            </block>

            <block
                name="loki-checkout.login.form" as="form"
                template="LokiCheckout_Core::checkout/login/form.phtml">
                <arguments>
                    <argument name="button_label" xsi:type="string">Sign In</argument>
                </arguments>

                <container
                    name="loki-checkout.login.form.before"
                    as="before"/>

                <block
                    name="loki-checkout.login.form.inner" as="form"
                    template="LokiCheckout_Core::customer/login.phtml">
                    <arguments>
                        <argument name="unfiltered_properties" xsi:type="array">
                            <item name="password" xsi:type="string">password</item>
                        </argument>
                    </arguments>

                    <container name="form.additional.info" as="form_additional_info"/>

                    <block
                        name="loki-checkout.login.form.recaptcha" as="recaptcha"
                        template="LokiCheckout_Core::checkout/other/recaptcha.phtml">
                        <arguments>
                            <argument name="form_id" xsi:type="string">customer_login</argument>
                        </arguments>

                        <block
                            name="loki-checkout.login.form.recaptcha.legal-notice" as="legal-notice"
                            template="LokiCheckout_Core::checkout/other/recaptcha/legal-notice.phtml"/>
                    </block>
                </block>

                <container
                    name="loki-checkout.login.form.after"
                    as="after"/>
            </block>
        </block>

        <referenceBlock name="loki.script.component-partial">
            <block
                name="loki-checkout.script.component-partial.login-component"
                template="LokiCheckout_Core::script/component-partial/login-component-partial.phtml"/>
        </referenceBlock>

        <referenceBlock name="loki.script.component">
            <block
                name="loki-checkout.script.component.login-component"
                template="LokiCheckout_Core::script/component/login-component.phtml"/>
        </referenceBlock>
    </body>
</page>
