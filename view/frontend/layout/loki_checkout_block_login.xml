<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <block
            name="loki-checkout.login"
            template="Yireo_LokiCheckout::checkout/login.phtml">
            <arguments>
                <argument name="magewire" xsi:type="object">Yireo\LokiCheckout\Magewire\Checkout\Login
                </argument>
            </arguments>

            <block class="Magento\Customer\Block\Form\Login" name="loki-checkout.login.form" as="form" template="Magento_Customer::form/login.phtml">
                <arguments>
                    <argument name="button_lock_manager" xsi:type="object">Magento\Framework\View\Element\ButtonLockManager</argument>
                </arguments>

                <container name="form.additional.info" as="form_additional_info"/>
            </block>
        </block>
    </body>
</page>
