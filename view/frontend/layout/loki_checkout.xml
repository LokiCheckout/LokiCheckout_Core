<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <!-- Cleanup -->
    <update handle="loki_checkout_clean"/>

    <!-- Block definition -->
    <update handle="loki_checkout_block_sidebar"/>
    <update handle="loki_checkout_block_progressbar"/>
    <update handle="loki_checkout_block_login"/>

    <update handle="loki_checkout_block_customer"/>
    <update handle="loki_checkout_block_other"/>
    <update handle="loki_checkout_block_utils"/>
    <update handle="loki_checkout_block_shipping_other"/>
    <update handle="loki_checkout_block_shipping_address"/>
    <update handle="loki_checkout_block_shipping_methods"/>

    <update handle="loki_checkout_block_billing_other"/>
    <update handle="loki_checkout_block_billing_address"/>
    <update handle="loki_checkout_block_payment_methods"/>

    <!-- Misc -->
    <update handle="loki_checkout_misc"/>

    <body>
        <referenceContainer name="content">
            <block name="loki-checkout" cacheable="false">
                <arguments>
                    <argument name="magewire" xsi:type="object">Yireo\LokiCheckout\Magewire\Checkout</argument>
                </arguments>

                <block name="loki-checkout.steps" as="steps"/>
            </block>
        </referenceContainer>

        <referenceContainer name="after.body.start">
            <block name="loki-checkout.script.logger" template="Yireo_LokiCheckout::script/logger.phtml"/>
            <block name="loki-checkout.script.alpine-call" template="Yireo_LokiCheckout::script/alpine-call.phtml"/>
            <block name="loki-checkout.script.components-store" template="Yireo_LokiCheckout::script/components-store.phtml"/>
            <block name="loki-checkout.script.component-extender" template="Yireo_LokiCheckout::script/component-extender.phtml"/>
            <block name="loki-checkout.script.messenger" template="Yireo_LokiCheckout::script/messenger.phtml"/>
            <block name="loki-checkout.script.validator" template="Yireo_LokiCheckout::script/validator.phtml"/>
        </referenceContainer>

        <referenceContainer name="before.body.end">
            <block name="loki-checkout.script.step-path" template="Yireo_LokiCheckout::script/step-path.phtml"/>
            <block name="loki-checkout.script.aria-invalid" template="Yireo_LokiCheckout::script/aria-invalid.phtml"/>
            <block name="loki-checkout.script.magic-component" template="Yireo_LokiCheckout::script/magic-component.phtml"/>

            <block name="loki-checkout.script.validator-rules.email" template="Yireo_LokiCheckout::script/validator-rules/email.phtml"/>
            <block name="loki-checkout.script.validator-rules.number" template="Yireo_LokiCheckout::script/validator-rules/number.phtml"/>

            <container name="loki-checkout.script.alpine-components">
                <block name="loki-checkout.script.components.field-component" template="Yireo_LokiCheckout::script/component/field-component.phtml" />
                <block name="loki-checkout.script.components.step-component" template="Yireo_LokiCheckout::script/component/step-component.phtml" />
            </container>
        </referenceContainer>

        <block name="loki-checkout.generic.title" template="Yireo_LokiCheckout::generic/title.phtml"/>
        <block name="loki-checkout.utils.loader" template="Yireo_LokiCheckout::utils/loader.phtml"/>

        <block name="loki-checkout.utils.loader-small" template="Yireo_LokiCheckout::utils/loader-small.phtml">
            <arguments>
                <argument name="size" xsi:type="number">20</argument>
            </arguments>
        </block>

        <block name="loki-checkout.utils.loader-overlay" template="Yireo_LokiCheckout::utils/loader-overlay.phtml">
            <arguments>
                <argument name="size" xsi:type="number">50</argument>
            </arguments>
        </block>

        <block name="loki-checkout.utils.required" template="Yireo_LokiCheckout::utils/required.phtml"/>
        <block name="loki-checkout.utils.separator" template="Yireo_LokiCheckout::utils/separator.phtml"/>
        <block name="loki-checkout.utils.debug" template="Yireo_LokiCheckout::utils/debug.phtml"/>
        <block name="loki-checkout.utils.errors" template="Yireo_LokiCheckout::utils/errors.phtml"/>

        <block name="loki-checkout.defaults"/>

        <block name="loki-checkout.defaults.form.field">
            <arguments>
                <argument name="css_classes" xsi:type="array">
                    <item name="block" xsi:type="array">
                        <item name="grid" xsi:type="string">col-span-6</item>
                    </item>
                </argument>
            </arguments>
        </block>
    </body>
</page>
