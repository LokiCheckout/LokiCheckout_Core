<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <update handle="loki_components"/>
    <update handle="loki_field_components"/>

    <!-- Cleanup -->
    <update handle="loki_checkout_clean"/>

    <!-- Block definition -->
    <update handle="loki_checkout_block_sidebar"/>
    <update handle="loki_checkout_block_progressbar"/>
    <update handle="loki_checkout_block_login"/>

    <update handle="loki_checkout_block_customer"/>
    <update handle="loki_checkout_block_other"/>
    <update handle="loki_checkout_block_utils"/>
    <update handle="loki_checkout_block_shipping_other"/>
    <update handle="loki_checkout_block_shipping_address"/>
    <update handle="loki_checkout_block_shipping_methods"/>

    <update handle="loki_checkout_block_billing_other"/>
    <update handle="loki_checkout_block_billing_address"/>
    <update handle="loki_checkout_block_payment_methods"/>

    <!-- Other -->
    <update handle="loki_checkout_script"/>
    <update handle="loki_checkout_misc"/>

    <body>
        <referenceContainer name="content">
            <block name="loki-checkout" cacheable="false">
                <block name="loki-checkout.steps" as="steps"/>
            </block>
        </referenceContainer>

        <block
            name="loki-checkout.fast_checkout"
            template="Yireo_LokiCheckout::checkout/fast-checkout.phtml"/>

        <block
            name="loki-checkout.generic.title"
            template="Yireo_LokiCheckout::generic/title.phtml"/>

        <block
            name="loki-checkout.utils.separator"
            template="Yireo_LokiCheckout::utils/separator.phtml"/>

        <block
            name="loki-checkout.utils.disabled-overlay"
            template="Yireo_LokiCheckout::utils/disabled-overlay.phtml"/>

        <block
            name="loki-checkout.utils.debug"
            template="Yireo_LokiCheckout::utils/debug.phtml"/>
    </body>
</page>
