<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <block
            name="loki-checkout.agreements"
            ifconfig="checkout/options/enable_agreements"
            template="Yireo_LokiCheckout::checkout/other/agreements.phtml">
            <arguments>
                <argument name="error_text" xsi:type="string">Please agree to all the terms and conditions before placing the order.</argument>
            </arguments>
        </block>

        <block
            name="loki-checkout.newsletter" as="newsletter"
            ifconfig="newsletter/general/active"
            template="Yireo_LokiFieldComponents::form/field.phtml">
            <arguments>
                <argument name="field_type" xsi:type="string">checkbox</argument>
                <argument name="show_field_label" xsi:type="boolean">false</argument>
            </arguments>
        </block>
    </body>
</page>
