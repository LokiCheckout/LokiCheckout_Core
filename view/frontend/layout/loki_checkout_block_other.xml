<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <block
            name="loki-checkout.agreements"
            ifconfig="checkout/options/enable_agreements"
            template="LokiCheckout_Core::checkout/other/agreements.phtml">
            <arguments>
                <!--<argument name="message_area" xsi:type="string">global</argument>-->
                <argument name="error_text" xsi:type="string" translate="true">
                    Please agree to all the terms and conditions before placing the order.
                </argument>
            </arguments>

            <block
                name="loki-checkout.agreements.agreement" as="agreement"
                template="LokiCheckout_Core::checkout/other/agreement.phtml">

                <block
                    name="loki-checkout.agreements.agreement.input" as="input"
                    template="LokiCheckout_Core::checkout/other/agreement/input.phtml"/>

                <block
                    name="loki-checkout.agreements.agreement.label" as="label"
                    template="LokiCheckout_Core::checkout/other/agreement/label.phtml"/>

                <block
                    name="loki-checkout.agreements.agreement.modal" as="modal"
                    template="LokiCheckout_Core::checkout/other/agreement/modal.phtml">
                    <block
                        name="loki-checkout.agreements.agreement.modal.content" as="content"
                        template="LokiCheckout_Core::checkout/other/agreement/modal/content.phtml"/>
                </block>
            </block>
        </block>

        <block
            name="loki-checkout.newsletter" as="newsletter"
            ifconfig="newsletter/general/active"
            template="Loki_FieldComponents::form/field.phtml">
            <arguments>
                <argument name="field_type" xsi:type="string">checkbox</argument>
                <argument name="show_field_label" xsi:type="boolean">false</argument>
            </arguments>
        </block>
    </body>
</page>
