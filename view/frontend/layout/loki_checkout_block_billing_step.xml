<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <block
            name="loki-checkout.billing-step.billing-as-shipping"
            template="Yireo_LokiCheckout::checkout/billing/billing-as-shipping.phtml"
        />

        <block
            name="loki-checkout.billing-step.backward-button"
            template="Yireo_LokiCheckout::form/button/step-backward-button.phtml">
            <arguments>
                <argument name="magewire" xsi:type="object" shared="false">
                    Yireo\LokiCheckout\Magewire\Form\Button\StepBackwardButton
                </argument>
                <argument name="button_label" xsi:type="string">Back to shipping</argument>
            </arguments>
            <block
                name="loki-checkout.billing-step.backward-button.script" as="script"
                template="Yireo_LokiCheckout::form/button/step-backward-button/script.phtml"/>
        </block>

        <block
            name="loki-checkout.billing-step.forward-button"
            template="Yireo_LokiCheckout::form/button/step-forward-button.phtml">
            <arguments>
                <argument name="magewire" xsi:type="object" shared="false">
                    Yireo\LokiCheckout\Magewire\Form\Button\StepForwardButton
                </argument>
                <argument name="button_label" xsi:type="string">Proceed to Review &amp; Payments</argument>
            </arguments>
            <block
                name="loki-checkout.billing-step.forward-button.script" as="script"
                template="Yireo_LokiCheckout::form/button/step-forward-button/script.phtml"/>
        </block>
    </body>
</page>
