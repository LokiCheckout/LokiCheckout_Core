<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <block name="loki-checkout.sidebar" template="LokiCheckout_Core::checkout/sidebar.phtml">
            <block name="loki-checkout.sidebar.summary" as="summary" template="LokiCheckout_Core::checkout/sidebar/summary.phtml">
                <block
                    name="loki-checkout.sidebar.title" as="title"
                    template="LokiCheckout_Core::generic/title.phtml" before="-">
                    <arguments>
                        <argument name="title" xsi:type="string" translate="true">Order Summary</argument>
                    </arguments>
                </block>

                <block name="loki-checkout.sidebar.coupon_code" as="coupon_code" template="LokiCheckout_Core::checkout/sidebar/coupon_code.phtml">
                    <block name="loki-checkout.sidebar.coupon_code.value" as="value" template="LokiCheckout_Core::checkout/sidebar/coupon_code/value.phtml"/>
                    <block name="loki-checkout.sidebar.coupon_code.summary" as="summary" template="LokiCheckout_Core::checkout/sidebar/coupon_code/summary.phtml"/>
                    <block name="loki-checkout.sidebar.coupon_code.form" as="form" template="LokiCheckout_Core::checkout/sidebar/coupon_code/form.phtml"/>
                </block>

                <block name="loki-checkout.sidebar.items" as="items" template="LokiCheckout_Core::checkout/sidebar/items.phtml">
                    <container name="loki-checkout.sidebar.items.before" as="before"/>
                    <block name="loki-checkout.sidebar.items.item" as="item" template="LokiCheckout_Core::checkout/sidebar/items/item.phtml"/>
                    <container name="loki-checkout.sidebar.items.after" as="after"/>
                </block>

                <block name="loki-checkout.sidebar.totals" as="totals" template="LokiCheckout_Core::checkout/sidebar/totals.phtml">
                    <block name="loki-checkout.sidebar.totals.grand_total" as="grand_total" template="LokiCheckout_Core::checkout/sidebar/totals/grand_total.phtml"/>
                </block>
            </block>

            <block name="loki-checkout.sidebar.preview" as="preview" template="LokiCheckout_Core::checkout/sidebar/preview.phtml">
                <block
                    name="loki-checkout.sidebar.preview.title" as="title"
                    template="LokiCheckout_Core::generic/title.phtml" before="-">
                    <arguments>
                        <argument name="title" xsi:type="string" translate="true">Order Preview</argument>
                    </arguments>
                </block>

                <block name="loki-checkout.sidebar.preview.quote_details" as="quote_details" template="LokiCheckout_Core::checkout/sidebar/preview/quote_details.phtml">
                    <block name="loki-checkout.sidebar.preview.quote_details.customer_email" as="customer_email" template="LokiCheckout_Core::checkout/sidebar/preview/quote_details/customer_email.phtml"/>
                    <block ifconfig="customer/address/gender_show" name="loki-checkout.sidebar.preview.quote_details.customer_gender" as="customer_gender" template="LokiCheckout_Core::checkout/sidebar/preview/quote_details/customer_gender.phtml"/>
                    <block name="loki-checkout.sidebar.preview.quote_details.customer_dob" as="customer_dob" template="LokiCheckout_Core::checkout/sidebar/preview/quote_details/customer_dob.phtml"/>
                </block>

                <block name="loki-checkout.sidebar.preview.shipping_details" as="shipping_details" template="LokiCheckout_Core::checkout/sidebar/preview/shipping_details.phtml">
                    <container name="loki-checkout.sidebar.preview.shipping_details.additional_address_info" as="additional_address_info"/>
                    <container name="loki-checkout.sidebar.preview.shipping_details.additional_method_info" as="additional_method_info"/>
                </block>

                <block name="loki-checkout.sidebar.preview.billing_address" as="billing_address" template="LokiCheckout_Core::checkout/sidebar/preview/billing_address.phtml">
                    <container name="loki-checkout.sidebar.preview.billing_address.additional_address_info" as="additional_address_info"/>
                </block>

                <block name="loki-checkout.sidebar.preview.payment_details" as="payment_details" template="LokiCheckout_Core::checkout/sidebar/preview/payment_details.phtml"/>
            </block>

            <block name="loki-checkout.sidebar.other" as="other" template="LokiCheckout_Core::checkout/sidebar/other.phtml"/>
        </block>
    </body>
</page>
