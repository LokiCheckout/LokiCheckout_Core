<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>

        <block
            name="loki-checkout.steps.shipping.backward-button"
            template="Loki_FieldComponents::form/button/button.phtml">
            <arguments>
                <argument name="step_code" xsi:type="string">shipping</argument>
                <argument name="button_label" xsi:type="string" translate="true">Back to previous step</argument>
            </arguments>
        </block>

        <block
            name="loki-checkout.steps.shipping.forward-button"
            template="Loki_FieldComponents::form/button/button.phtml">
            <arguments>
                <argument name="step_code" xsi:type="string">shipping</argument>
                <argument name="button_label" xsi:type="string" translate="true">Proceed to Review &amp;amp; Payments</argument>
                <argument name="button_hint" xsi:type="string" translate="true">Please fill in all required fields before proceeding</argument>
                <argument name="css_classes" xsi:type="array">
                    <item name="button" xsi:type="array">
                        <item name="default" xsi:type="string">btn btn-primary m-2</item>
                    </item>
                </argument>
            </arguments>

            <block
                name="loki-checkout.steps.shipping.forward-button-icon" as="icon"
                template="LokiCheckout_Core::form/button/step-forward-button-icon.phtml"/>
        </block>
    </body>
</page>
