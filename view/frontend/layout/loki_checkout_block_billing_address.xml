<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <block
            name="loki-checkout.billing.address"
            template="LokiCheckout_Core::checkout/billing/address.phtml">

            <block
                ifconfig="loki_checkout/fields/enable_same_as_billing"
                name="loki-checkout.billing.address.shipping-as-billing" as="shipping-as-billing"
                template="LokiCheckout_Core::checkout/billing/shipping-as-billing.phtml"/>

            <block
                name="loki-checkout.billing.address.view" as="view"
                template="LokiCheckout_Core::checkout/billing/address-view.phtml">
            </block>

            <block
                name="loki-checkout.billing.address.select" as="select"
                template="Loki_FieldComponents::form/field.phtml">
                <arguments>
                    <argument name="field_type" xsi:type="string">select</argument>
                    <argument name="show_empty_select_option" xsi:type="boolean">true</argument>
                    <argument name="option_model" xsi:type="object">
                        LokiCheckout\Core\ViewModel\OptionModel\CustomerAddressOptionModel
                    </argument>
                </arguments>
            </block>

            <block
                name="loki-checkout.billing.address.toggle-select" as="toggle-select"
                template="LokiCheckout_Core::checkout/billing/address-toggle-select.phtml"/>

            <block
                name="loki-checkout.billing.address.form-title" as="form-title"
                template="LokiCheckout_Core::generic/title.phtml">
                <arguments>
                    <argument name="title" xsi:type="string" translate="true">Billing Address</argument>
                </arguments>
            </block>

            <block
                name="loki-checkout.billing.address.form" as="form"
                template="LokiCheckout_Core::checkout/billing/address-form.phtml">
                <arguments>
                    <argument name="grid" xsi:type="boolean">true</argument>
                </arguments>

                <block
                    name="loki-checkout.billing.address.prefix" as="prefix"
                    ifconfig="customer/address/prefix_show"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="field_type" xsi:type="string">text_select</argument>
                        <argument name="option_model" xsi:type="object">
                            LokiCheckout\Core\ViewModel\OptionModel\PrefixOptionModel
                        </argument>
                        <argument name="max_length" xsi:type="number">6</argument>
                        <argument name="lazy_update" xsi:type="boolean">true</argument>
                        <argument name="autocomplete" xsi:type="string">billing honorific-prefix</argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.billing.address.firstname" as="firstname"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="autocomplete" xsi:type="string">billing given-name</argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.billing.address.middlename" as="middlename"
                    ifconfig="customer/address/middlename_show"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="lazy_update" xsi:type="boolean">true</argument>
                        <argument name="autocomplete" xsi:type="string">billing additional-name</argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.billing.address.lastname" as="lastname"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="autocomplete" xsi:type="string">billing family-name</argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.billing.address.suffix" as="suffix"
                    ifconfig="customer/address/suffix_show"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="lazy_update" xsi:type="boolean">true</argument>
                        <argument name="autocomplete" xsi:type="string">billing honorific-suffix</argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.billing.address.street0" as="street0"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="field_label" xsi:type="string">Street</argument>
                        <argument name="autocomplete" xsi:type="string">billing address-line1</argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.billing.address.street1" as="street1"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="field_label" xsi:type="string">-</argument>
                        <argument name="autocomplete" xsi:type="string">billing address-line2</argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.billing.address.street2" as="street2"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="field_label" xsi:type="string">-</argument>
                        <argument name="autocomplete" xsi:type="string">billing address-line3</argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.billing.address.street3" as="street3"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="field_label" xsi:type="string">-</argument>
                        <argument name="autocomplete" xsi:type="string">billing address-line4</argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.billing.address.postcode" as="postcode"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="is_required" xsi:type="boolean">true</argument>
                        <argument name="autocomplete" xsi:type="string">billing postal-code</argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.billing.address.city" as="city"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="autocomplete" xsi:type="string">billing address-level2</argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.billing.address.region" as="region"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="field_type" xsi:type="string">text_select</argument>
                        <argument name="option_model" xsi:type="object">
                            LokiCheckout\Core\ViewModel\OptionModel\RegionOptionModel
                        </argument>
                        <argument name="autocomplete" xsi:type="string">billing address-level1</argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.billing.address.country_id" as="country_id"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="field_type" xsi:type="string">select</argument>
                        <argument name="option_model" xsi:type="object">
                            LokiCheckout\Core\ViewModel\OptionModel\CountryOptionModel
                        </argument>
                        <argument name="autocomplete" xsi:type="string">billing country</argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.billing.address.company" as="company"
                    ifconfig="customer/address/company_show"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="autocomplete" xsi:type="string">billing organization</argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.billing.address.telephone" as="telephone"
                    ifconfig="customer/address/telephone_show"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="autocomplete" xsi:type="string">billing tel</argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.billing.address.fax" as="fax"
                    ifconfig="customer/address/fax_show"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="lazy_update" xsi:type="boolean">true</argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.billing.address.vat_id" as="vat_id"
                    ifconfig="customer/address/taxvat_show"
                    template="Loki_FieldComponents::form/field.phtml"/>

                <block
                    name="loki-checkout.billing.address.save_in_address_book" as="save_in_address_book"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="field_type" xsi:type="string">checkbox</argument>
                        <argument name="show_field_label" xsi:type="boolean">false</argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.billing.address.form.grid-layout" as="grid_layout"
                    template="LokiCheckout_Core::checkout/address/grid-layout.phtml"/>
            </block>

        </block>
    </body>
</page>
