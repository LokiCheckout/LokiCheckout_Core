<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <referenceBlock name="loki.script">
            <block
                name="loki-checkout.script.logger"
                after="loki-components.script.logger"
                template="LokiCheckout_Core::script/logger.phtml"/>
            <block
                name="loki-checkout.script.translations"
                after="loki-components.script.translations"
                template="LokiCheckout_Core::script/translations.phtml"/>
            <block
                name="loki-checkout.script.checkout-config"
                template="LokiCheckout_Core::script/checkout-config.phtml"/>
            <block
                name="loki-checkout.script.checkout-store"
                template="LokiCheckout_Core::script/checkout-store.phtml"/>
            <!--<block
                name="loki-checkout.script.component-extender"
                template="LokiCheckout_Core::script/component-extender.phtml"/>-->
            <block
                name="loki-checkout.script.html-updater"
                template="LokiCheckout_Core::script/html-updater.phtml"/>
            <block
                name="loki-checkout.script.aria-invalid"
                template="LokiCheckout_Core::script/aria-invalid.phtml"/>

            <block
                name="loki-checkout.script.validators.email"
                template="LokiCheckout_Core::script/validator/email.phtml"/>
            <block
                name="loki-checkout.script.validators.number"
                template="LokiCheckout_Core::script/validator/number.phtml"/>
            <block
                name="loki-checkout.script.validators.postcode"
                template="LokiCheckout_Core::script/validator/postcode.phtml"/>

            <referenceBlock name="loki.script.component-partial">
                <block
                    name="loki-checkout.script.component-partial.apple-pay"
                    template="LokiCheckout_Core::script/component-partial/apple-pay-component-partial.phtml"/>
            </referenceBlock>

            <referenceBlock name="loki.script.component-type">
                <block
                    name="loki-checkout.script.component-type.checkout"
                    template="LokiCheckout_Core::script/component-type/checkout-component-type.phtml"/>

                <block
                    name="loki-checkout.script.component-type.apple-pay"
                    template="LokiCheckout_Core::script/component-type/apple-pay-component-type.phtml"/>
            </referenceBlock>

            <referenceBlock name="loki.script.component">
                <block
                    name="loki-checkout.script.components.private-data-component"
                    template="LokiCheckout_Core::script/component/private-data-component.phtml"/>
                <block
                    name="loki-checkout.script.components.checkout-component"
                    template="LokiCheckout_Core::script/component/checkout-component.phtml"/>
                <block
                    name="loki-checkout.script.components.progress-bar-component"
                    template="LokiCheckout_Core::script/component/progress-bar-component.phtml"/>
                <block
                    name="loki-checkout.script.components.step-component"
                    template="LokiCheckout_Core::script/component/step-component.phtml"/>
                <block
                    name="loki-checkout.script.components.step-backward-button"
                    template="LokiCheckout_Core::script/component/step-backward-button-component.phtml"/>
                <block
                    name="loki-checkout.script.components.step-forward-button"
                    template="LokiCheckout_Core::script/component/step-forward-button-component.phtml"/>
                <block
                    name="loki-checkout.script.components.address"
                    template="LokiCheckout_Core::script/component/address-component.phtml"/>
                <block
                    name="loki-checkout.script.components.shipping-methods"
                    template="LokiCheckout_Core::script/component/shipping-methods-component.phtml"/>
                <block
                    name="loki-checkout.script.components.payment-methods"
                    template="LokiCheckout_Core::script/component/payment-methods-component.phtml"/>
                <block
                    name="loki-checkout.script.components.payment-method"
                    template="LokiCheckout_Core::script/component/payment-method-component.phtml"/>
                <block
                    name="loki-checkout.script.components.coupon-code"
                    template="LokiCheckout_Core::script/component/coupon-code-component.phtml"/>
                <block
                    name="loki-checkout.script.components.agreements"
                    template="LokiCheckout_Core::script/component/agreements-component.phtml"/>
                <block
                    name="loki-checkout.script.components.agreement"
                    template="LokiCheckout_Core::script/component/agreement-component.phtml"/>
                <block
                    name="loki-checkout.script.components.newsletter"
                    template="LokiCheckout_Core::script/component/newsletter-component.phtml"/>
                <block
                    name="loki-checkout.script.components.grid-layout-component"
                    template="LokiCheckout_Core::script/component/grid-layout-component.phtml"/>
            </referenceBlock>
        </referenceBlock>

        <referenceContainer name="loki.script.directive">
            <block
                name="loki-checkout.script.directive.date"
                template="LokiCheckout_Core::script/directive/date-directive.phtml"/>

            <block
                name="loki-checkout.script.directive.money"
                template="LokiCheckout_Core::script/directive/money-directive.phtml"/>

            <block
                name="loki-checkout.script.directive.tooltip"
                template="LokiCheckout_Core::script/directive/tooltip-directive.phtml"/>

        </referenceContainer>
    </body>
</page>
