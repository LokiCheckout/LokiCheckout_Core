<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <!-- @todo <referenceContainer name="loki-component-before-body-end"> -->
        <referenceContainer name="after.body.start">
            <block
                name="loki-checkout.script.logger"
                after="loki-components.script.logger"
                template="Yireo_LokiCheckout::script/logger.phtml"/>
            <block
                name="loki-checkout.script.checkout-store"
                template="Yireo_LokiCheckout::script/checkout-store.phtml"/>
            <block
                name="loki-checkout.script.component-extender"
                template="Yireo_LokiCheckout::script/component-extender.phtml"/>
        </referenceContainer>

        <referenceContainer name="loki-scripts">
            <block
                name="loki-checkout.script.aria-invalid"
                template="Yireo_LokiCheckout::script/aria-invalid.phtml"/>
            <block
                name="loki-checkout.script.directive-date"
                template="Yireo_LokiCheckout::script/directive-date.phtml"/>
            <block
                name="loki-checkout.script.directive-money"
                template="Yireo_LokiCheckout::script/directive-money.phtml"/>
            <block
                name="loki-checkout.script.validators.email"
                template="Yireo_LokiCheckout::script/validator/email.phtml"/>
            <block
                name="loki-checkout.script.validators.number"
                template="Yireo_LokiCheckout::script/validator/number.phtml"/>
            <block
                name="loki-checkout.script.validators.postcode"
                template="Yireo_LokiCheckout::script/validator/postcode.phtml"/>
            <block
                name="loki-checkout.script.hacks"
                template="Yireo_LokiCheckout::script/hacks.phtml"/>

            <referenceContainer name="loki-component-partials">
                <block
                    name="loki-checkout.script.component-partial.apple-pay"
                    template="Yireo_LokiCheckout::script/component-partial/apple-pay-component-partial.phtml"/>
            </referenceContainer>

            <referenceContainer name="loki-component-types">
                <block
                    name="loki-checkout.script.component-type.checkout"
                    template="Yireo_LokiCheckout::script/component-type/checkout-component-type.phtml"/>

                <block
                    name="loki-checkout.script.component-type.apple-pay"
                    template="Yireo_LokiCheckout::script/component-type/apple-pay-component-type.phtml"/>
            </referenceContainer>

            <referenceContainer name="loki-components">
                <block
                    name="loki-checkout.script.components.checkout-component"
                    template="Yireo_LokiCheckout::script/component/checkout-component.phtml"/>
                <block
                    name="loki-checkout.script.components.steps-component"
                    template="Yireo_LokiCheckout::script/component/steps-component.phtml"/>
                <block
                    name="loki-checkout.script.components.step-component"
                    template="Yireo_LokiCheckout::script/component/step-component.phtml"/>
                <block
                    name="loki-checkout.script.components.step-backward-button"
                    template="Yireo_LokiCheckout::script/component/step-backward-button-component.phtml"/>
                <block
                    name="loki-checkout.script.components.step-forward-button"
                    template="Yireo_LokiCheckout::script/component/step-forward-button-component.phtml"/>
                <block
                    name="loki-checkout.script.components.address"
                    template="Yireo_LokiCheckout::script/component/address-component.phtml"/>
                <block
                    name="loki-checkout.script.components.shipping-methods"
                    template="Yireo_LokiCheckout::script/component/shipping-methods-component.phtml"/>
                <block
                    name="loki-checkout.script.components.payment-methods"
                    template="Yireo_LokiCheckout::script/component/payment-methods-component.phtml"/>
                <!-- @todo: Only load this on the page if this is actually needed -->
                <block
                    name="loki-checkout.script.components.payment-method"
                    template="Yireo_LokiCheckout::script/component/payment-method-component.phtml"/>
                <block
                    name="loki-checkout.script.components.coupon-code"
                    template="Yireo_LokiCheckout::script/component/coupon-code-component.phtml"/>
                <block
                    name="loki-checkout.script.components.agreements"
                    template="Yireo_LokiCheckout::script/component/agreements-component.phtml"/>
                <block
                    name="loki-checkout.script.components.grid-layout-component"
                    template="Yireo_LokiCheckout::script/component/grid-layout-component.phtml"/>
            </referenceContainer>
        </referenceContainer>
    </body>
</page>
