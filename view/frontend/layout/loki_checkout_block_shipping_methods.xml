<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <block
            name="loki-checkout.shipping.methods"
            template="LokiCheckout_Core::checkout/shipping/shipping-methods.phtml">
            <arguments>
                <argument name="render_order" xsi:type="number">-1</argument>
            </arguments>

            <block
                name="loki-checkout.shipping.methods.title" as="title"
                template="LokiCheckout_Core::generic/title.phtml">
                <arguments>
                    <argument name="css_class_groups" xsi:type="array">
                        <item name="title" xsi:type="string">title</item>
                    </argument>
                    <argument name="title" xsi:type="string" translate="true">Shipping Methods</argument>
                </arguments>
            </block>

            <block
                name="loki-checkout.shipping.methods.list"
                as="list"
                template="LokiCheckout_Core::checkout/shipping/shipping-methods/list.phtml">

                <container name="loki-checkout.shipping.methods.before" as="before-methods"/>
                <container name="loki-checkout.shipping.methods.after" as="after-methods"/>

                <block
                    name="loki-checkout.shipping.methods.item" as="item"
                    template="LokiCheckout_Core::checkout/shipping/shipping-methods/item.phtml">
                    <block
                        name="loki-checkout.shipping.methods.item.amount" as="amount"
                        template="LokiCheckout_Core::checkout/shipping/shipping-methods/item/amount.phtml"/>
                    <block
                        name="loki-checkout.shipping.methods.item.label" as="label"
                        template="LokiCheckout_Core::checkout/shipping/shipping-methods/item/label.phtml"/>
                </block>

                <block
                    name="loki-checkout.shipping.methods.empty" as="empty"
                    template="LokiCheckout_Core::checkout/shipping/shipping-methods/empty.phtml"/>
            </block>
        </block>

        <block name="loki-checkout.shipping.buttons" template="LokiCheckout_Core::checkout/shipping/shipping-method/tab-buttons.phtml">
            <arguments>
                <argument name="buttons" xsi:type="array">
                    <item name="delivery-dates" xsi:type="string">Delivery</item>
                    <item name="locations" xsi:type="string">Pickup</item>
                </argument>
            </arguments>
        </block>

        <block
            name="loki-checkout.shipping.delivery-dates"
            template="LokiCheckout_Core::checkout/shipping/shipping-method/delivery-dates.phtml">
            <arguments>
                <argument name="tab_id" xsi:type="string">delivery-dates</argument>
            </arguments>

            <block
                name="loki-checkout.shipping.delivery-dates.collapse-button"
                as="collapse-button"
                template="LokiCheckout_Core::checkout/shipping/shipping-method/delivery-dates/collapse-button.phtml"
            />

            <block
                name="loki-checkout.shipping.delivery-dates.expand-button"
                as="expand-button"
                template="LokiCheckout_Core::checkout/shipping/shipping-method/delivery-dates/expand-button.phtml"
            />

            <block
                name="loki-checkout.shipping.delivery-dates.expand-all-button"
                as="expand-all-button"
                template="LokiCheckout_Core::checkout/shipping/shipping-method/delivery-dates/expand-all-button.phtml"
            />

            <block
                name="loki-checkout.shipping.delivery-dates.loading-bricks"
                as="loading-bricks"
                template="LokiCheckout_Core::checkout/shipping/shipping-method/loading-bricks.phtml"
            />
        </block>

        <block name="loki-checkout.shipping.delivery-date" template="LokiCheckout_Core::checkout/shipping/shipping-method/delivery-date.phtml"/>

        <block name="loki-checkout.shipping.delivery-date.timeframes" template="LokiCheckout_Core::checkout/shipping/shipping-method/delivery-date/timeframes.phtml"/>

        <block name="loki-checkout.shipping.delivery-date.timeframe" template="LokiCheckout_Core::checkout/shipping/shipping-method/delivery-date/timeframe.phtml"/>

        <block name="loki-checkout.shipping.delivery-date.timeframe.input" template="LokiCheckout_Core::checkout/shipping/shipping-method/delivery-date/timeframe/input.phtml"/>

        <block name="loki-checkout.shipping.delivery-date.timeframe.image" template="LokiCheckout_Core::checkout/shipping/shipping-method/delivery-date/timeframe/image.phtml"/>

        <block name="loki-checkout.shipping.delivery-date.timeframe.label" template="LokiCheckout_Core::checkout/shipping/shipping-method/delivery-date/timeframe/label.phtml"/>

        <block name="loki-checkout.shipping.delivery-date.timeframe.times" template="LokiCheckout_Core::checkout/shipping/shipping-method/delivery-date/timeframe/times.phtml"/>

        <block name="loki-checkout.shipping.delivery-date.timeframe.price" template="LokiCheckout_Core::checkout/shipping/shipping-method/delivery-date/timeframe/price.phtml"/>

        <block name="loki-checkout.shipping.locations" template="LokiCheckout_Core::checkout/shipping/shipping-method/locations.phtml">
            <arguments>
                <argument name="tab_id" xsi:type="string">locations</argument>
            </arguments>

            <block
                name="loki-checkout.shipping.locations.collapse-button"
                as="collapse-button"
                template="LokiCheckout_Core::checkout/shipping/shipping-method/locations/collapse-button.phtml"
            />

            <block
                name="loki-checkout.shipping.locations.expand-button"
                as="expand-button"
                template="LokiCheckout_Core::checkout/shipping/shipping-method/locations/expand-button.phtml"
            />

            <block
                name="loki-checkout.shipping.locations.expand-all-button"
                as="expand-all-button"
                template="LokiCheckout_Core::checkout/shipping/shipping-method/locations/expand-all-button.phtml"
            />

            <block
                name="loki-checkout.shipping.locations.loading-bricks"
                as="loading-bricks"
                template="LokiCheckout_Core::checkout/shipping/shipping-method/loading-bricks.phtml"
            />
        </block>

        <block name="loki-checkout.shipping.location" template="LokiCheckout_Core::checkout/shipping/shipping-method/location.phtml"/>

        <block name="loki-checkout.shipping.location.additional" template="LokiCheckout_Core::checkout/shipping/shipping-method/location/additional.phtml"/>

        <block name="loki-checkout.shipping.location.address" template="LokiCheckout_Core::checkout/shipping/shipping-method/location/address.phtml"/>

        <block name="loki-checkout.shipping.location.business-hours" template="LokiCheckout_Core::checkout/shipping/shipping-method/location/business-hours.phtml"/>

        <block name="loki-checkout.shipping.location.input" template="LokiCheckout_Core::checkout/shipping/shipping-method/location/input.phtml"/>

        <block name="loki-checkout.shipping.location.label" template="LokiCheckout_Core::checkout/shipping/shipping-method/location/label.phtml"/>
        <block name="loki-checkout.shipping.location.carrier" template="LokiCheckout_Core::checkout/shipping/shipping-method/location/carrier.phtml"/>
        <block name="loki-checkout.shipping.location.distance" template="LokiCheckout_Core::checkout/shipping/shipping-method/location/distance.phtml"/>
        <block name="loki-checkout.shipping.location.pickup-from" template="LokiCheckout_Core::checkout/shipping/shipping-method/location/pickup-from.phtml"/>
    </body>
</page>
