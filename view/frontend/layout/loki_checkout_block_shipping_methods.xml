<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <block
            name="loki-checkout.shipping.methods"
            template="Yireo_LokiCheckout::checkout/shipping/shipping-methods.phtml">
            <container name="loki-checkout.shipping.methods.before" as="before-methods"/>
            <container name="loki-checkout.shipping.methods.after" as="after-methods"/>

            <block
                name="loki-checkout.shipping.shipping-methods.item" as="item"
                template="Yireo_LokiCheckout::checkout/shipping/shipping-methods/item.phtml"/>
        </block>

        <referenceContainer name="loki-checkout.script.alpine-components">
            <block name="loki-checkout.script.components.shipping-methods-component"
                   template="Yireo_LokiCheckout::script/component/shipping-methods-component.phtml" />
        </referenceContainer>
    </body>
</page>
