<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <block
            name="loki-checkout.shipping.shipping-methods"
            template="Yireo_LokiCheckout::checkout/shipping/shipping-methods.phtml">
            <arguments>
                <argument name="magewire" xsi:type="object">
                    Yireo\LokiCheckout\Magewire\Checkout\Shipping\ShippingMethods
                </argument>
            </arguments>

            <block
                name="loki-checkout.shipping.shipping-methods.item" as="item"
                template="Yireo_LokiCheckout::checkout/shipping/shipping-methods/item.phtml"/>
        </block>

        <referenceBlock name="loki-checkout.script.alpine-component-initializer">
            <arguments>
                <argument name="components" xsi:type="array">
                    <item name="loki-checkout.shipping.shipping-methods" xsi:type="string">
                        Yireo_LokiCheckout::checkout/shipping/shipping-methods/script.phtml
                    </item>

                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
