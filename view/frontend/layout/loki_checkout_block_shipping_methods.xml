<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <block
            name="loki-checkout.shipping.methods"
            template="LokiCheckout_Core::checkout/shipping/shipping-methods.phtml">
            <arguments>
                <argument name="render_order" xsi:type="number">-1</argument>
            </arguments>

            <block
                name="loki-checkout.shipping.methods.title" as="title"
                template="LokiCheckout_Core::generic/title.phtml">
                <arguments>
                    <argument name="title" xsi:type="string" translate="true">Shipping Methods</argument>
                </arguments>
            </block>

            <block
                name="loki-checkout.shipping.methods.list"
                as="list"
                template="LokiCheckout_Core::checkout/shipping/shipping-methods/list.phtml">

                <container name="loki-checkout.shipping.methods.before" as="before-methods"/>
                <container name="loki-checkout.shipping.methods.after" as="after-methods"/>

                <block
                    name="loki-checkout.shipping.methods.item" as="item"
                    template="LokiCheckout_Core::checkout/shipping/shipping-methods/item.phtml"/>

                <block
                    name="loki-checkout.shipping.methods.empty" as="empty"
                    template="LokiCheckout_Core::checkout/shipping/shipping-methods/empty.phtml"/>
            </block>
        </block>

        <block name="loki-checkout.shipping.js.buttons" template="LokiCheckout_Core::checkout/shipping/shipping-method-js/tab-buttons.phtml">
            <arguments>
                <argument name="buttons" xsi:type="array">
                    <item name="delivery-dates" xsi:type="string">Delivery</item>
                    <item name="locations" xsi:type="string">Pickup</item>
                </argument>
            </arguments>
        </block>

        <block
            name="loki-checkout.shipping.js.delivery-dates"
            template="LokiCheckout_Core::checkout/shipping/shipping-method-js/delivery-dates.phtml">
            <arguments>
                <argument name="tab_id" xsi:type="string">delivery-dates</argument>
            </arguments>

            <block
                name="loki-checkout.shipping.js.delivery-dates.expand-button"
                as="expand-button"
                template="LokiCheckout_Core::checkout/shipping/shipping-method-js/delivery-dates/expand-button.phtml"
            />

            <block
                name="loki-checkout.shipping.js.delivery-dates.expand-all-button"
                as="expand-all-button"
                template="LokiCheckout_Core::checkout/shipping/shipping-method-js/delivery-dates/expand-all-button.phtml"
            />
        </block>

        <block name="loki-checkout.shipping.js.delivery-date" template="LokiCheckout_Core::checkout/shipping/shipping-method-js/delivery-date.phtml"/>

        <block name="loki-checkout.shipping.js.delivery-date.timeframes" template="LokiCheckout_Core::checkout/shipping/shipping-method-js/delivery-date/timeframes.phtml"/>

        <block name="loki-checkout.shipping.js.delivery-date.timeframe" template="LokiCheckout_Core::checkout/shipping/shipping-method-js/delivery-date/timeframe.phtml"/>

        <block name="loki-checkout.shipping.js.delivery-date.timeframe.input" template="LokiCheckout_Core::checkout/shipping/shipping-method-js/delivery-date/timeframe/input.phtml"/>

        <block name="loki-checkout.shipping.js.delivery-date.timeframe.image" template="LokiCheckout_Core::checkout/shipping/shipping-method-js/delivery-date/timeframe/image.phtml"/>

        <block name="loki-checkout.shipping.js.delivery-date.timeframe.name" template="LokiCheckout_Core::checkout/shipping/shipping-method-js/delivery-date/timeframe/name.phtml"/>

        <block name="loki-checkout.shipping.js.delivery-date.timeframe.price" template="LokiCheckout_Core::checkout/shipping/shipping-method-js/delivery-date/timeframe/price.phtml"/>

        <block name="loki-checkout.shipping.js.locations" template="LokiCheckout_Core::checkout/shipping/shipping-method-js/locations.phtml">
            <arguments>
                <argument name="tab_id" xsi:type="string">locations</argument>
            </arguments>

            <block
                name="loki-checkout.shipping.js.locations.expand-button"
                as="expand-button"
                template="LokiCheckout_Core::checkout/shipping/shipping-method-js/locations/expand-button.phtml"
            />

            <block
                name="loki-checkout.shipping.js.locations.expand-all-button"
                as="expand-all-button"
                template="LokiCheckout_Core::checkout/shipping/shipping-method-js/locations/expand-all-button.phtml"
            />
        </block>

        <block name="loki-checkout.shipping.js.location" template="LokiCheckout_Core::checkout/shipping/shipping-method-js/location.phtml"/>

        <block name="loki-checkout.shipping.js.location.additional" template="LokiCheckout_Core::checkout/shipping/shipping-method-js/location/additional.phtml"/>

        <block name="loki-checkout.shipping.js.location.address" template="LokiCheckout_Core::checkout/shipping/shipping-method-js/location/address.phtml"/>

        <block name="loki-checkout.shipping.js.location.business-hours" template="LokiCheckout_Core::checkout/shipping/shipping-method-js/location/business-hours.phtml"/>

        <block name="loki-checkout.shipping.js.location.input" template="LokiCheckout_Core::checkout/shipping/shipping-method-js/location/input.phtml"/>

        <block name="loki-checkout.shipping.js.location.name" template="LokiCheckout_Core::checkout/shipping/shipping-method-js/location/name.phtml"/>

        <block name="loki-checkout.shipping.js.location.pickup-details" template="LokiCheckout_Core::checkout/shipping/shipping-method-js/location/pickup-details.phtml"/>
    </body>
</page>
