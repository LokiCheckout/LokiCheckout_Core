<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <referenceBlock name="magewire.checkout">
            <block name="magewire.checkout.sidebar" as="sidebar" template="Yireo_MagewireCheckout::checkout/sidebar.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">Yireo\MagewireCheckout\Magewire\Checkout\Sidebar</argument>
                </arguments>

                <block name="magewire.checkout.sidebar.coupon_code" as="coupon_code" template="Yireo_MagewireCheckout::checkout/sidebar/coupon_code.phtml">
                    <arguments>
                        <argument name="magewire" xsi:type="object">Yireo\MagewireCheckout\Magewire\Checkout\Sidebar\CouponCode</argument>
                    </arguments>

                    <block name="magewire.checkout.sidebar.coupon_code.script" as="script" template="Yireo_MagewireCheckout::checkout/sidebar/coupon_code/script.phtml"/>
                </block>

                <block name="magewire.checkout.sidebar.items" as="items" template="Yireo_MagewireCheckout::checkout/sidebar/items.phtml">
                    <arguments>
                        <argument name="magewire" xsi:type="object">Yireo\MagewireCheckout\Magewire\Checkout\Sidebar\Items</argument>
                    </arguments>

                    <block name="magewire.checkout.sidebar.items.item" as="item" template="Yireo_MagewireCheckout::checkout/sidebar/items/item.phtml"/>
                </block>

                <block name="magewire.checkout.sidebar.totals" as="totals" template="Yireo_MagewireCheckout::checkout/sidebar/totals.phtml">
                    <arguments>
                        <argument name="magewire" xsi:type="object">
                            Yireo\MagewireCheckout\Magewire\Checkout\Sidebar\Totals
                        </argument>
                    </arguments>
                </block>

                <block name="magewire.checkout.sidebar.shipping_address" as="shipping_address" template="Yireo_MagewireCheckout::checkout/sidebar/shipping_address.phtml">
                    <arguments>
                        <argument name="magewire" xsi:type="object">
                            Yireo\MagewireCheckout\Magewire\Checkout\Sidebar\ShippingAddress
                        </argument>
                    </arguments>
                </block>

                <block name="magewire.checkout.sidebar.order_comment" as="order_comment" template="Yireo_MagewireCheckout::checkout/sidebar/order_comment.phtml">
                    <arguments>
                        <argument name="magewire" xsi:type="object">
                            Yireo\MagewireCheckout\Magewire\Checkout\Sidebar\OrderComment
                        </argument>
                    </arguments>
                </block>
            </block>
        </referenceBlock>
    </body>
</page>
