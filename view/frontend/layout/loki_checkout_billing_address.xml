<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <block
            name="loki.checkout.billing-step.address-form"
            template="Yireo_LokiCheckout::checkout/billing/address-form.phtml">
            <arguments>
                <argument name="magewire" xsi:type="object">
                    Yireo\LokiCheckout\Magewire\Checkout\BillingStep\BillingAddress
                </argument>
            </arguments>

            <block
                name="loki.checkout.billing-step.billing-address.prefix" as="prefix"
                ifconfig="customer/address/prefix_show"
                template="Yireo_LokiCheckout::form/field.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Yireo\LokiCheckout\Magewire\Checkout\BillingStep\BillingAddress\Prefix
                    </argument>
                    <argument name="option_model" xsi:type="object">
                        Yireo\LokiCheckout\ViewModel\OptionModel\PrefixOptionModel
                    </argument>
                    <argument name="grid-col-span" xsi:type="number">12</argument>
                </arguments>
            </block>

            <block
                name="loki.checkout.billing-step.billing-address.firstname" as="firstname"
                template="Yireo_LokiCheckout::form/field.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Yireo\LokiCheckout\Magewire\Checkout\BillingStep\BillingAddress\Firstname
                    </argument>
                </arguments>
            </block>

            <block
                name="loki.checkout.billing-step.billing-address.middlename" as="middlename"
                ifconfig="customer/address/middlename_show"
                template="Yireo_LokiCheckout::form/field.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Yireo\LokiCheckout\Magewire\Checkout\BillingStep\BillingAddress\Middlename
                    </argument>
                </arguments>
            </block>

            <block
                name="loki.checkout.billing-step.billing-address.lastname" as="lastname"
                template="Yireo_LokiCheckout::form/field.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Yireo\LokiCheckout\Magewire\Checkout\BillingStep\BillingAddress\Lastname
                    </argument>
                </arguments>
            </block>

            <block
                name="loki.checkout.billing-step.billing-address.suffix" as="suffix"
                ifconfig="customer/address/suffix_show"
                template="Yireo_LokiCheckout::form/field.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Yireo\LokiCheckout\Magewire\Checkout\BillingStep\BillingAddress\Suffix
                    </argument>
                </arguments>
            </block>

            <block
                name="loki.checkout.billing-step.billing-address.street" as="street"
                template="Yireo_LokiCheckout::form/field.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Yireo\LokiCheckout\Magewire\Checkout\BillingStep\BillingAddress\Street
                    </argument>
                    <argument name="grid-col-span" xsi:type="number">12</argument>
                </arguments>
            </block>

            <block
                name="loki.checkout.billing-step.billing-address.postcode" as="postcode"
                template="Yireo_LokiCheckout::form/field.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Yireo\LokiCheckout\Magewire\Checkout\BillingStep\BillingAddress\Postcode
                    </argument>
                </arguments>
            </block>

            <block
                name="loki.checkout.billing-step.billing-address.city" as="city"
                template="Yireo_LokiCheckout::form/field.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Yireo\LokiCheckout\Magewire\Checkout\BillingStep\BillingAddress\City
                    </argument>
                </arguments>
            </block>

            <block
                name="loki.checkout.billing-step.billing-address.region" as="region"
                template="Yireo_LokiCheckout::form/field.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Yireo\LokiCheckout\Magewire\Checkout\BillingStep\BillingAddress\Region
                    </argument>
                    <argument name="option_model" xsi:type="object">
                        Yireo\LokiCheckout\ViewModel\OptionModel\RegionOptionModel
                    </argument>
                </arguments>
            </block>

            <block
                name="loki.checkout.billing-step.billing-address.country_id" as="country_id"
                template="Yireo_LokiCheckout::form/field.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Yireo\LokiCheckout\Magewire\Checkout\BillingStep\BillingAddress\CountryId
                    </argument>
                    <argument name="option_model" xsi:type="object">
                        Yireo\LokiCheckout\ViewModel\OptionModel\CountryOptionModel
                    </argument>
                </arguments>
            </block>

            <block
                name="loki.checkout.billing-step.billing-address.company" as="company"
                ifconfig="customer/address/company_show"
                template="Yireo_LokiCheckout::form/field.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Yireo\LokiCheckout\Magewire\Checkout\BillingStep\BillingAddress\Company
                    </argument>
                </arguments>
            </block>

            <block
                name="loki.checkout.billing-step.billing-address.telephone" as="telephone"
                ifconfig="customer/address/telephone_show"
                template="Yireo_LokiCheckout::form/field.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Yireo\LokiCheckout\Magewire\Checkout\BillingStep\BillingAddress\Telephone
                    </argument>
                </arguments>
            </block>

            <block
                name="loki.checkout.billing-step.billing-address.vat_id" as="vat_id"
                ifconfig="customer/address/taxvat_show"
                template="Yireo_LokiCheckout::form/field.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Yireo\LokiCheckout\Magewire\Checkout\BillingStep\BillingAddress\VatId
                    </argument>
                </arguments>
            </block>
        </block>
    </body>
</page>
