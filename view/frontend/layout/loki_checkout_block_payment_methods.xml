<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <block
            name="loki-checkout.payment.methods"
            template="LokiCheckout_Core::checkout/payment/payment-methods.phtml">

            <block
                name="loki-checkout.payment.methods.title" as="title"
                template="LokiCheckout_Core::generic/title.phtml">
                <arguments>
                    <argument name="title" xsi:type="string" translate="true">Payment Methods</argument>
                </arguments>
            </block>

            <block
                name="loki-checkout.payment.methods.item" as="item"
                template="LokiCheckout_Core::checkout/payment/payment-methods/item.phtml"/>
        </block>

        <block
            name="loki-checkout.payment.methods.banktransfer.additional"
            template="LokiCheckout_Core::checkout/payment/payment-method-additional/banktransfer.phtml">
        </block>

        <block
            name="loki-checkout.payment.methods.cashondelivery.additional"
            template="LokiCheckout_Core::checkout/payment/payment-method-additional/cashondelivery.phtml">
        </block>

        <block name="loki-checkout.payment.methods.checkmo.additional"
               template="LokiCheckout_Core::checkout/payment/payment-method-additional/checkmo.phtml">
        </block>

        <referenceBlock name="loki.script.component">
            <block name="loki-checkout.script.components.payment-methods-component"
                   template="LokiCheckout_Core::script/component/payment-methods-component.phtml"/>
        </referenceBlock>
    </body>
</page>
