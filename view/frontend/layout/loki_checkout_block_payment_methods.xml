<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <block
            name="loki.checkout.billing-step.payment-methods"
            template="Yireo_LokiCheckout::checkout/billing/payment-methods.phtml">
            <arguments>
                <argument name="magewire" xsi:type="object">
                    Yireo\LokiCheckout\Magewire\Checkout\BillingStep\PaymentMethods
                </argument>
            </arguments>
            <block
                name="loki.checkout.billing-step.payment-methods.script"
                as="script"
                template="Yireo_LokiCheckout::checkout/billing/payment-methods/script.phtml">
            </block>
        </block>

        <block
            name="loki.checkout.billing-step.payment-methods.purchaseorder.form"
            template="Yireo_LokiCheckout::form/field.phtml">
            <arguments>
                <argument name="magewire" xsi:type="object">
                    Yireo\LokiCheckout\Magewire\Checkout\BillingStep\PaymentMethod\PurchaseOrder
                </argument>
                <argument name="additional_css" xsi:type="string">p-4 border border-zinc-200 bg-zinc-100</argument>
            </arguments>
        </block>

        <block
            name="loki.checkout.billing-step.payment-methods.banktransfer.additional"
            template="Yireo_LokiCheckout::checkout/billing/payment-method-additional/banktransfer.phtml">
        </block>

        <block
            name="loki.checkout.billing-step.payment-methods.cashondelivery.additional"
            template="Yireo_LokiCheckout::checkout/billing/payment-method-additional/cashondelivery.phtml">
        </block>

        <block
            name="loki.checkout.billing-step.payment-methods.checkmo.additional"
            template="Yireo_LokiCheckout::checkout/billing/payment-method-additional/checkmo.phtml">
        </block>
    </body>
</page>
