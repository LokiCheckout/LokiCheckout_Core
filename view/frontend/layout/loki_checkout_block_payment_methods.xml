<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <block
            name="loki-checkout.billing.payment-methods"
            template="Yireo_LokiCheckout::checkout/billing/payment-methods.phtml">
            <arguments>
                <argument name="magewire" xsi:type="object">
                    Yireo\LokiCheckout\Magewire\Checkout\Billing\PaymentMethods
                </argument>
            </arguments>
            <block
                name="loki-checkout.billing.payment-methods.item" as="item"
                template="Yireo_LokiCheckout::checkout/billing/payment-methods/item.phtml"/>
        </block>

        <block
            name="loki-checkout.billing.payment-methods.banktransfer.additional"
            template="Yireo_LokiCheckout::checkout/billing/payment-method-additional/banktransfer.phtml">
        </block>

        <block
            name="loki-checkout.billing.payment-methods.cashondelivery.additional"
            template="Yireo_LokiCheckout::checkout/billing/payment-method-additional/cashondelivery.phtml">
        </block>

        <block name="loki-checkout.billing.payment-methods.checkmo.additional"
               template="Yireo_LokiCheckout::checkout/billing/payment-method-additional/checkmo.phtml">
        </block>

        <referenceContainer name="loki-checkout.script.alpine-components">
            <block name="loki-checkout.script.components.payment-methods-component"
                   template="Yireo_LokiCheckout::script/component/payment-methods-component.phtml"/>
        </referenceContainer>

        <referenceContainer name="before.body.end">
            <block name="loki-checkout.billing.payment-methods.script-toggler"
                   template="Yireo_LokiCheckout::script/payment-method-toggler.phtml"/>
        </referenceContainer>
    </body>
</page>
