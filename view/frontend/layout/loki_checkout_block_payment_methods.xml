<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <block
            name="loki-checkout.payment.methods"
            template="Yireo_LokiCheckout::checkout/payment/payment-methods.phtml">

            <block
                name="loki-checkout.payment.payment-methods.item" as="item"
                template="Yireo_LokiCheckout::checkout/payment/payment-methods/item.phtml"/>
        </block>

        <block
            name="loki-checkout.payment.payment-methods.banktransfer.additional"
            template="Yireo_LokiCheckout::checkout/payment/payment-method-additional/banktransfer.phtml">
        </block>

        <block
            name="loki-checkout.payment.payment-methods.cashondelivery.additional"
            template="Yireo_LokiCheckout::checkout/payment/payment-method-additional/cashondelivery.phtml">
        </block>

        <block name="loki-checkout.payment.payment-methods.checkmo.additional"
               template="Yireo_LokiCheckout::checkout/payment/payment-method-additional/checkmo.phtml">
        </block>

        <referenceContainer name="loki-components">
            <block name="loki-checkout.script.components.payment-methods-component"
                   template="Yireo_LokiCheckout::script/component/payment-methods-component.phtml"/>
        </referenceContainer>
    </body>
</page>
