<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <block
            name="loki-checkout.shipping.address"
            template="LokiCheckout_Core::checkout/shipping/address.phtml">

            <block
                name="loki-checkout.shipping.address.view" as="view"
                template="LokiCheckout_Core::checkout/shipping/address-view.phtml"/>

            <block
                name="loki-checkout.shipping.address.select" as="select"
                template="Loki_FieldComponents::form/field.phtml">
                <arguments>
                    <argument name="field_type" xsi:type="string">select</argument>
                    <argument name="show_empty_select_option" xsi:type="boolean">true</argument>
                    <argument name="option_model" xsi:type="object">
                        LokiCheckout\Core\ViewModel\OptionModel\CustomerAddressOptionModel
                    </argument>
                </arguments>
            </block>

            <block
                name="loki-checkout.shipping.address.toggle-select" as="toggle-select"
                template="LokiCheckout_Core::checkout/shipping/address-toggle-select.phtml"/>

            <block
                name="loki-checkout.shipping.address.form-title" as="form-title"
                template="LokiCheckout_Core::checkout/shipping/address-form-title.phtml"/>

            <block
                name="loki-checkout.shipping.address.form" as="form"
                template="LokiCheckout_Core::checkout/shipping/address-form.phtml">
                <arguments>
                    <argument name="grid" xsi:type="boolean">true</argument>
                </arguments>

                <block
                    name="loki-checkout.shipping.address.prefix" as="prefix"
                    ifconfig="customer/address/prefix_show"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="field_type" xsi:type="string">text_select</argument>
                        <argument name="option_model" xsi:type="object">
                            LokiCheckout\Core\ViewModel\OptionModel\PrefixOptionModel
                        </argument>
                        <argument name="max_length" xsi:type="number">6</argument>
                        <argument name="lazy_update" xsi:type="boolean">true</argument>
                        <argument name="autocomplete" xsi:type="string">shipping honorific-prefix</argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.shipping.address.firstname" as="firstname"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="lazy_update" xsi:type="boolean">true</argument>
                        <argument name="autocomplete" xsi:type="string">shipping given-name</argument>
                        <argument name="field_attributes" xsi:type="array">
                            <item name="max" xsi:type="number">255</item>
                        </argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.shipping.address.middlename" as="middlename"
                    ifconfig="customer/address/middlename_show"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="lazy_update" xsi:type="boolean">true</argument>
                        <argument name="autocomplete" xsi:type="string">shipping additional-name</argument>
                        <argument name="field_attributes" xsi:type="array">
                            <item name="max" xsi:type="number">255</item>
                        </argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.shipping.address.lastname" as="lastname"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="lazy_update" xsi:type="boolean">true</argument>
                        <argument name="autocomplete" xsi:type="string">shipping family-name</argument>
                        <argument name="field_attributes" xsi:type="array">
                            <item name="max" xsi:type="number">255</item>
                        </argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.shipping.address.suffix" as="suffix"
                    ifconfig="customer/address/suffix_show"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="lazy_update" xsi:type="boolean">true</argument>
                        <argument name="autocomplete" xsi:type="string">shipping honorific-suffix</argument>
                        <argument name="max_length" xsi:type="number">20</argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.shipping.address.street0" as="street0"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="field_label" xsi:type="string">Street</argument>
                        <argument name="autocomplete" xsi:type="string">shipping address-line1</argument>
                        <argument name="field_attributes" xsi:type="array">
                            <item name="max" xsi:type="number">255</item>
                        </argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.shipping.address.street1" as="street1"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="field_label" xsi:type="string">-</argument>
                        <argument name="autocomplete" xsi:type="string">shipping address-line2</argument>
                        <argument name="field_attributes" xsi:type="array">
                            <item name="max" xsi:type="number">255</item>
                        </argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.shipping.address.street2" as="street2"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="field_label" xsi:type="string">-</argument>
                        <argument name="autocomplete" xsi:type="string">shipping address-line3</argument>
                        <argument name="field_attributes" xsi:type="array">
                            <item name="max" xsi:type="number">255</item>
                        </argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.shipping.address.street3" as="street3"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="field_label" xsi:type="string">-</argument>
                        <argument name="autocomplete" xsi:type="string">shipping address-line4</argument>
                        <argument name="field_attributes" xsi:type="array">
                            <item name="max" xsi:type="number">255</item>
                        </argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.shipping.address.postcode" as="postcode"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="is_required" xsi:type="boolean">true</argument>
                        <argument name="autocomplete" xsi:type="string">shipping postal-code</argument>
                        <argument name="field_attributes" xsi:type="array">
                            <item name="max" xsi:type="number">20</item>
                        </argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.shipping.address.city" as="city"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="autocomplete" xsi:type="string">shipping address-level2</argument>
                        <argument name="field_attributes" xsi:type="array">
                            <item name="max" xsi:type="number">255</item>
                        </argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.shipping.address.region" as="region"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="field_type" xsi:type="string">text_select</argument>
                        <argument name="option_model" xsi:type="object">
                            LokiCheckout\Core\ViewModel\OptionModel\RegionOptionModel
                        </argument>
                        <argument name="autocomplete" xsi:type="string">shipping address-level1</argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.shipping.address.country_id" as="country_id"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="field_type" xsi:type="string">select</argument>
                        <argument name="option_model" xsi:type="object">
                            LokiCheckout\Core\ViewModel\OptionModel\CountryOptionModel
                        </argument>
                        <argument name="autocomplete" xsi:type="string">shipping country</argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.shipping.address.company" as="company"
                    ifconfig="customer/address/company_show"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="autocomplete" xsi:type="string">shipping organization</argument>
                        <argument name="field_attributes" xsi:type="array">
                            <item name="max" xsi:type="number">255</item>
                        </argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.shipping.address.telephone" as="telephone"
                    ifconfig="customer/address/telephone_show"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="autocomplete" xsi:type="string">shipping tel</argument>
                        <argument name="field_attributes" xsi:type="array">
                            <item name="max" xsi:type="number">30</item>
                        </argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.shipping.address.fax" as="fax"
                    ifconfig="customer/address/fax_show"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="lazy_update" xsi:type="boolean">true</argument>
                        <argument name="field_attributes" xsi:type="array">
                            <item name="max" xsi:type="number">30</item>
                        </argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.shipping.address.vat_id" as="vat_id"
                    ifconfig="customer/address/taxvat_show"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="field_attributes" xsi:type="array">
                            <item name="max" xsi:type="number">30</item>
                        </argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.shipping.address.save_in_address_book" as="save_in_address_book"
                    template="Loki_FieldComponents::form/field.phtml">
                    <arguments>
                        <argument name="field_type" xsi:type="string">checkbox</argument>
                        <argument name="show_field_label" xsi:type="boolean">false</argument>
                    </arguments>
                </block>

                <block
                    name="loki-checkout.shipping.address.form.grid-layout" as="grid_layout"
                    template="LokiCheckout_Core::checkout/address/grid-layout.phtml"/>
            </block>
        </block>
    </body>
</page>
