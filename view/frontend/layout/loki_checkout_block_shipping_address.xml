<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <block
            name="loki.checkout.shipping-step.address-form"
            template="Yireo_LokiCheckout::checkout/shipping/address-form.phtml">
            <arguments>
                <argument name="magewire" xsi:type="object">
                    Yireo\LokiCheckout\Magewire\Checkout\ShippingStep\ShippingAddress
                </argument>
            </arguments>

            <block
                name="loki.checkout.shipping-step.shipping-address.prefix" as="prefix"
                ifconfig="customer/address/prefix_show"
                template="Yireo_LokiCheckout::form/field.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Yireo\LokiCheckout\Magewire\Checkout\ShippingStep\ShippingAddress\Prefix
                    </argument>
                    <argument name="option_model" xsi:type="object">
                        Yireo\LokiCheckout\ViewModel\OptionModel\PrefixOptionModel
                    </argument>
                    <argument name="css_classes" xsi:type="array">
                        <item name="block" xsi:type="array">
                            <item name="col-span" xsi:type="string">col-span-2</item>
                        </item>
                    </argument>
                    <argument name="max_length" xsi:type="number">6</argument>
                </arguments>
            </block>

            <block
                name="loki.checkout.shipping-step.shipping-address.firstname" as="firstname"
                template="Yireo_LokiCheckout::form/field.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Yireo\LokiCheckout\Magewire\Checkout\ShippingStep\ShippingAddress\Firstname
                    </argument>
                    <argument name="css_classes" xsi:type="array">
                        <item name="block" xsi:type="array">
                            <item name="col-span" xsi:type="string">col-span-5</item>
                        </item>
                    </argument>
                </arguments>
            </block>

            <block
                name="loki.checkout.shipping-step.shipping-address.middlename" as="middlename"
                ifconfig="customer/address/middlename_show"
                template="Yireo_LokiCheckout::form/field.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Yireo\LokiCheckout\Magewire\Checkout\ShippingStep\ShippingAddress\Middlename
                    </argument>
                </arguments>
            </block>

            <block
                name="loki.checkout.shipping-step.shipping-address.lastname" as="lastname"
                template="Yireo_LokiCheckout::form/field.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Yireo\LokiCheckout\Magewire\Checkout\ShippingStep\ShippingAddress\Lastname
                    </argument>
                    <argument name="css_classes" xsi:type="array">
                        <item name="block" xsi:type="array">
                            <item name="col-span" xsi:type="string">col-span-5</item>
                        </item>
                    </argument>
                    <argument name="field_label" xsi:type="string">Surname</argument>
                </arguments>
            </block>

            <block
                name="loki.checkout.shipping-step.shipping-address.suffix" as="suffix"
                ifconfig="customer/address/suffix_show"
                template="Yireo_LokiCheckout::form/field.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Yireo\LokiCheckout\Magewire\Checkout\ShippingStep\ShippingAddress\Suffix
                    </argument>
                    <argument name="css_classes" xsi:type="array">
                        <item name="block" xsi:type="array">
                            <item name="col-span" xsi:type="string">col-span-2</item>
                        </item>
                    </argument>
                </arguments>
            </block>

            <block
                name="loki.checkout.shipping-step.shipping-address.street0" as="street0"
                template="Yireo_LokiCheckout::form/field.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Yireo\LokiCheckout\Magewire\Checkout\ShippingStep\ShippingAddress\Street0
                    </argument>
                    <argument name="css_classes" xsi:type="array">
                        <item name="block" xsi:type="array">
                            <item name="col-span" xsi:type="string">col-span-12</item>
                        </item>
                    </argument>
                    <argument name="field_label" xsi:type="string">Street</argument>
                </arguments>

                <!--
                <block
                    name="loki.checkout.shipping-step.shipping-address.street0.additional_script"
                    as="additional_script"
                    template="Yireo_LokiCheckout::form/field/street0/additional_script.phtml"
                />
                -->
            </block>

            <block
                name="loki.checkout.shipping-step.shipping-address.street1" as="street1"
                template="Yireo_LokiCheckout::form/field.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Yireo\LokiCheckout\Magewire\Checkout\ShippingStep\ShippingAddress\Street1
                    </argument>
                    <argument name="css_classes" xsi:type="array">
                        <item name="block" xsi:type="array">
                            <item name="col-span" xsi:type="string">col-span-12</item>
                        </item>
                    </argument>
                    <argument name="field_label" xsi:type="string">-</argument>
                </arguments>

                <!--
                <block
                    name="loki.checkout.shipping-step.shipping-address.street1.additional_script"
                    as="additional_script"
                    template="Yireo_LokiCheckout::form/field/street1/additional_script.phtml"
                />
                -->
            </block>

            <block
                name="loki.checkout.shipping-step.shipping-address.street2" as="street2"
                template="Yireo_LokiCheckout::form/field.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Yireo\LokiCheckout\Magewire\Checkout\ShippingStep\ShippingAddress\Street2
                    </argument>
                    <argument name="css_classes" xsi:type="array">
                        <item name="block" xsi:type="array">
                            <item name="col-span" xsi:type="string">col-span-12</item>
                        </item>
                    </argument>
                    <argument name="field_label" xsi:type="string">-</argument>
                </arguments>

                <!--
                <block
                    name="loki.checkout.shipping-step.shipping-address.street2.additional_script"
                    as="additional_script"
                    template="Yireo_LokiCheckout::form/field/street2/additional_script.phtml"
                />
                -->
            </block>

            <block
                name="loki.checkout.shipping-step.shipping-address.street3" as="street3"
                template="Yireo_LokiCheckout::form/field.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Yireo\LokiCheckout\Magewire\Checkout\ShippingStep\ShippingAddress\Street3
                    </argument>
                    <argument name="css_classes" xsi:type="array">
                        <item name="block" xsi:type="array">
                            <item name="col-span" xsi:type="string">col-span-12</item>
                        </item>
                    </argument>
                    <argument name="field_label" xsi:type="string">-</argument>
                </arguments>

                <!--
                <block
                    name="loki.checkout.shipping-step.shipping-address.street3.additional_script"
                    as="additional_script"
                    template="Yireo_LokiCheckout::form/field/street3/additional_script.phtml"
                />
                -->
            </block>

            <block
                name="loki.checkout.shipping-step.shipping-address.postcode" as="postcode"
                template="Yireo_LokiCheckout::form/field.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Yireo\LokiCheckout\Magewire\Checkout\ShippingStep\ShippingAddress\Postcode
