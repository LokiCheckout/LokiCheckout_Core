<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <block
            name="loki-checkout.customer.email" as="customer_email"
            template="Yireo_LokiCheckout::form/field.phtml">
            <arguments>
                <argument name="magewire" xsi:type="object" >
                    Yireo\LokiCheckout\Magewire\Checkout\Quote\CustomerEmail
                </argument>
                <argument name="placeholder" xsi:type="string">Enter your emailaddress</argument>
            </arguments>
        </block>

        <block
            name="loki-checkout.customer.gender" as="customer_gender"
            ifconfig="customer/address/gender_show"
            template="Yireo_LokiCheckout::form/field.phtml">
            <arguments>
                <argument name="magewire" xsi:type="object">
                    Yireo\LokiCheckout\Magewire\Checkout\Quote\CustomerGender
                </argument>
                <argument name="field_type" xsi:type="string">select</argument>
                <argument name="option_model" xsi:type="object">
                    Yireo\LokiCheckout\ViewModel\OptionModel\GenderOptionModel
                </argument>
            </arguments>
        </block>

        <block
            name="loki-checkout.customer.dob" as="customer_dob"
            ifconfig="customer/address/dob_show"
            template="Yireo_LokiCheckout::form/field.phtml">
            <arguments>
                <argument name="magewire" xsi:type="object">
                    Yireo\LokiCheckout\Magewire\Checkout\Quote\CustomerDob
                </argument>
            </arguments>
        </block>
    </body>
</page>
