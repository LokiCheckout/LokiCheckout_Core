<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <block name="loki-checkout.customer" template="LokiCheckout_Core::generic/container.phtml">
            <arguments>
                <argument name="css_classes" xsi:type="array">
                    <item name="block" xsi:type="array">
                        <item name="default" xsi:type="string">grid gap-4</item>
                    </item>
                </argument>
            </arguments>

            <block
                name="loki-checkout.customer.customer_email" as="customer_email"
                template="Loki_FieldComponents::form/field.phtml">
                <arguments>
                    <argument name="placeholder" xsi:type="string" translate="true">Enter your emailaddress</argument>
                    <argument name="autocomplete" xsi:type="string">email</argument>
                    <argument name="field_attributes" xsi:type="array">
                        <item name="inputmode" xsi:type="string">email</item>
                        <item name="min" xsi:type="number">5</item>
                        <item name="max" xsi:type="number">255</item>
                    </argument>
                </arguments>
            </block>

            <block
                name="loki-checkout.customer.customer_gender" as="customer_gender"
                ifconfig="customer/address/gender_show"
                template="Loki_FieldComponents::form/field.phtml">
                <arguments>
                    <argument name="field_type" xsi:type="string">select</argument>
                    <argument name="option_model" xsi:type="object">
                        LokiCheckout\Core\ViewModel\OptionModel\GenderOptionModel
                    </argument>
                    <argument name="autocomplete" xsi:type="string">sex</argument>
                </arguments>
            </block>

            <block
                name="loki-checkout.customer.customer_dob" as="customer_dob"
                ifconfig="customer/address/dob_show"
                template="Loki_FieldComponents::form/field.phtml">
                <arguments>
                    <argument name="autocomplete" xsi:type="string">bday</argument>
                </arguments>
            </block>
        </block>
    </body>
</page>
