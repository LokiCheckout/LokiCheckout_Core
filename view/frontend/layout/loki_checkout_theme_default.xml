<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <referenceBlock name="loki-checkout" template="Yireo_LokiCheckout::checkout-theme-default.phtml"/>

        <referenceBlock name="loki-checkout.steps" >
            <block name="loki-checkout.shipping-step" as="shipping-step" template="Yireo_LokiCheckout::checkout/shipping-step.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">Yireo\LokiCheckout\Magewire\Checkout\ShippingStep
                    </argument>
                </arguments>

                <block
                    name="loki-checkout.shipping-step.title" as="title"
                    template="Yireo_LokiCheckout::generic/title.phtml">
                    <arguments>
                        <argument name="title" xsi:type="string">Shipping</argument>
                    </arguments>
                </block>

                <block name="loki-checkout.shipping-step.buttons" as="buttons" template="Yireo_LokiCheckout::form/button/buttons.phtml" />
            </block>

            <block name="loki-checkout.billing-step" as="billing-step" template="Yireo_LokiCheckout::checkout/billing-step.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">Yireo\LokiCheckout\Magewire\Checkout\BillingStep
                    </argument>
                </arguments>

                <block
                    name="loki-checkout.billing-step.title" as="title"
                    template="Yireo_LokiCheckout::generic/title.phtml">
                    <arguments>
                        <argument name="title" xsi:type="string">Billing</argument>
                    </arguments>
                </block>

                <block name="loki-checkout.billing-step.buttons" as="buttons" template="Yireo_LokiCheckout::form/button/buttons.phtml" />
            </block>
        </referenceBlock>

        <!-- Shipping step -->
        <move element="loki-checkout.customer.email" destination="loki-checkout.shipping-step" as="email"/>
        <move element="loki-checkout.shipping-address" destination="loki-checkout.shipping-step" as="shipping-address"/>
        <move element="loki-checkout.shipping.shipping-methods" destination="loki-checkout.shipping-step" as="shipping-methods"/>
        <move element="loki-checkout.shipping-step.backward-button" destination="loki-checkout.shipping-step.buttons" as="backward-button"/>
        <move element="loki-checkout.shipping-step.forward-button" destination="loki-checkout.shipping-step.buttons" as="forward-button"/>

        <!-- Billing step -->
        <move element="loki-checkout.billing-address" destination="loki-checkout.billing-step" as="billing-address"/>
        <move element="loki-checkout.billing.payment-methods" destination="loki-checkout.billing-step" as="payment-methods"/>
        <move element="loki-checkout.billing-step.backward-button" destination="loki-checkout.billing-step.buttons" as="backward-button"/>
        <move element="loki-checkout.billing-step.forward-button" destination="loki-checkout.billing-step.buttons" as="forward-button"/>

        <!-- Sidebar -->
        <move element="loki-checkout.sidebar" destination="loki-checkout" as="sidebar"/>
    </body>
</page>
