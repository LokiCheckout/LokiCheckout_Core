<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <referenceBlock name="loki.checkout.steps">
            <block name="loki.checkout.shipping-step" as="shipping-step" template="Yireo_LokiCheckout::checkout/shipping-step.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">Yireo\LokiCheckout\Magewire\Checkout\ShippingStep
                    </argument>
                </arguments>

                <block
                    name="loki.checkout.shipping-step.backward-button" as="backward-button"
                    template="Yireo_LokiCheckout::form/button/step-backward-button.phtml">
                    <arguments>
                        <argument name="magewire" xsi:type="object" shared="false">
                            Yireo\LokiCheckout\Magewire\Form\Button\StepBackwardButton
                        </argument>
                        <argument name="button_label" xsi:type="string">Back to billing</argument>
                    </arguments>
                    <block
                        name="loki.checkout.shipping-step.backward-button.script" as="script"
                        template="Yireo_LokiCheckout::form/button/step-backward-button/script.phtml"/>
                </block>

                <block
                    name="loki.checkout.shipping-step.forward-button" as="forward-button"
                    template="Yireo_LokiCheckout::form/button/step-forward-button.phtml">
                    <arguments>
                        <argument name="magewire" xsi:type="object" shared="false">
                            Yireo\LokiCheckout\Magewire\Form\Button\StepForwardButton
                        </argument>
                        <argument name="button_label" xsi:type="string">Proceed to review &amp;amp; payments</argument>
                    </arguments>
                    <block
                        name="loki.checkout.shipping-step.forward-button.script" as="script"
                        template="Yireo_LokiCheckout::form/button/step-forward-button/script.phtml"/>
                </block>
            </block>

            <block name="loki.checkout.billing-step" as="billing-step" template="Yireo_LokiCheckout::checkout/billing-step.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">Yireo\LokiCheckout\Magewire\Checkout\BillingStep
                    </argument>
                </arguments>

                <block
                    name="loki.checkout.billing-step.backward-button" as="backward-button"
                    template="Yireo_LokiCheckout::form/button/step-backward-button.phtml">
                    <arguments>
                        <argument name="magewire" xsi:type="object" shared="false">
                            Yireo\LokiCheckout\Magewire\Form\Button\StepBackwardButton
                        </argument>
                        <argument name="button_label" xsi:type="string">Back to shipping</argument>
                    </arguments>
                    <block
                        name="loki.checkout.billing-step.backward-button.script" as="script"
                        template="Yireo_LokiCheckout::form/button/step-backward-button/script.phtml"/>
                </block>

                <block
                    name="loki.checkout.billing-step.forward-button" as="forward-button"
                    template="Yireo_LokiCheckout::form/button/step-forward-button.phtml">
                    <arguments>
                        <argument name="magewire" xsi:type="object" shared="false">
                            Yireo\LokiCheckout\Magewire\Form\Button\StepForwardButton
                        </argument>
                        <argument name="button_label" xsi:type="string">Proceed to review &amp; payments</argument>
                    </arguments>
                    <block
                        name="loki.checkout.billing-step.forward-button.script" as="script"
                        template="Yireo_LokiCheckout::form/button/step-forward-button/script.phtml"/>
                </block>
            </block>
        </referenceBlock>

        <move element="loki.checkout.login" destination="loki.checkout.sidebar.begin" as="begin"/>
        <move element="loki.checkout.other.agreements" destination="loki.checkout.sidebar.end"/>
        <move element="loki.checkout.other.newsletter" destination="loki.checkout.sidebar.end"/>

        <move element="loki.checkout.progressbar" destination="loki.checkout" as="progressbar" />
        <move element="loki.checkout.sidebar" destination="loki.checkout" as="sidebar"/>

        <move element="loki.checkout.customer.email" destination="loki.checkout.shipping-step" as="email"/>
        <move element="loki.checkout.customer.dob" destination="loki.checkout.shipping-step.address-form" as="dob"/>
        <move element="loki.checkout.customer.gender" destination="loki.checkout.shipping-step.address-form" as="gender"/>

        <move element="loki.checkout.shipping-step.address-form" destination="loki.checkout.shipping-step" as="address-form"/>
        <move element="loki.checkout.shipping-step.shipping-methods" destination="loki.checkout.shipping-step" as="methods"/>

        <move element="loki.checkout.billing-step.address-view" destination="loki.checkout.billing-step" as="address-view"/>
        <move element="loki.checkout.billing-step.address-form" destination="loki.checkout.billing-step" as="address-form"/>
        <move element="loki.checkout.billing-step.payment-methods" destination="loki.checkout.billing-step" as="methods"/>
    </body>
</page>
