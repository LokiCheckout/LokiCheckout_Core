<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <referenceBlock name="magewire.checkout">
            <block name="magewire.checkout.billing-step" as="billing-step" template="Yireo_MagewireCheckout::checkout/billing.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">Yireo\MagewireCheckout\Magewire\Checkout\BillingStep
                    </argument>
                </arguments>

            <block
                name="magewire.checkout.billing-step.billing-view" as="billing-view"
                template="Yireo_MagewireCheckout::checkout/billing/view.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Yireo\MagewireCheckout\Magewire\Checkout\BillingStep\BillingView
                    </argument>
                </arguments>
            </block>

                <block
                    name="magewire.checkout.billing-step.billing-address" as="billing-address"
                    template="Yireo_MagewireCheckout::checkout/billing/address.phtml">
                    <arguments>
                        <argument name="magewire" xsi:type="object">
                            Yireo\MagewireCheckout\Magewire\Checkout\BillingStep\BillingAddress
                        </argument>
                    </arguments>

                    <block
                        name="magewire.checkout.billing-step.billing-address.prefix" as="prefix"
                        ifconfig="customer/address/prefix_show"
                        template="Yireo_MagewireCheckout::generic/field.phtml">
                        <arguments>
                            <argument name="magewire" xsi:type="object" shared="false">
                                Yireo\MagewireCheckout\Magewire\Checkout\BillingStep\BillingAddress\Prefix
                            </argument>
                            <argument name="grid-col-span" xsi:type="number">12</argument>
                        </arguments>
                    </block>

                    <block
                        name="magewire.checkout.billing-step.billing-address.firstname" as="firstname"
                        template="Yireo_MagewireCheckout::generic/field.phtml">
                        <arguments>
                            <argument name="magewire" xsi:type="object" shared="false">
                                Yireo\MagewireCheckout\Magewire\Checkout\BillingStep\BillingAddress\Firstname
                            </argument>
                        </arguments>
                    </block>

                    <block
                        name="magewire.checkout.billing-step.billing-address.middlename" as="middlename"
                        ifconfig="customer/address/middlename_show"
                        template="Yireo_MagewireCheckout::generic/field.phtml">
                        <arguments>
                            <argument name="magewire" xsi:type="object" shared="false">
                                Yireo\MagewireCheckout\Magewire\Checkout\BillingStep\BillingAddress\Middlename
                            </argument>
                        </arguments>
                    </block>

                    <block
                        name="magewire.checkout.billing-step.billing-address.lastname" as="lastname"
                        template="Yireo_MagewireCheckout::generic/field.phtml">
                        <arguments>
                            <argument name="magewire" xsi:type="object" shared="false">
                                Yireo\MagewireCheckout\Magewire\Checkout\BillingStep\BillingAddress\Lastname
                            </argument>
                        </arguments>
                    </block>

                    <block
                        name="magewire.checkout.billing-step.billing-address.suffix" as="suffix"
                        ifconfig="customer/address/suffix_show"
                        template="Yireo_MagewireCheckout::generic/field.phtml">
                        <arguments>
                            <argument name="magewire" xsi:type="object" shared="false">
                                Yireo\MagewireCheckout\Magewire\Checkout\BillingStep\BillingAddress\Suffix
                            </argument>
                        </arguments>
                    </block>

                    <block
                        name="magewire.checkout.billing-step.billing-address.street" as="street"
                        template="Yireo_MagewireCheckout::generic/field.phtml">
                        <arguments>
                            <argument name="magewire" xsi:type="object" shared="false">
                                Yireo\MagewireCheckout\Magewire\Checkout\BillingStep\BillingAddress\Street
                            </argument>
                            <argument name="grid-col-span" xsi:type="number">12</argument>
                        </arguments>
                    </block>

                    <block
                        name="magewire.checkout.billing-step.billing-address.postcode" as="postcode"
                        template="Yireo_MagewireCheckout::generic/field.phtml">
                        <arguments>
                            <argument name="magewire" xsi:type="object" shared="false">
                                Yireo\MagewireCheckout\Magewire\Checkout\BillingStep\BillingAddress\Postcode
                            </argument>
                        </arguments>
                    </block>

                    <block
                        name="magewire.checkout.billing-step.billing-address.city" as="city"
                        template="Yireo_MagewireCheckout::generic/field.phtml">
                        <arguments>
                            <argument name="magewire" xsi:type="object" shared="false">
                                Yireo\MagewireCheckout\Magewire\Checkout\BillingStep\BillingAddress\City
                            </argument>
                        </arguments>
                    </block>

                    <block
                        name="magewire.checkout.billing-step.billing-address.region" as="region"
                        template="Yireo_MagewireCheckout::generic/field.phtml">
                        <arguments>
                            <argument name="magewire" xsi:type="object" shared="false">
                                Yireo\MagewireCheckout\Magewire\Checkout\BillingStep\BillingAddress\Region
                            </argument>
                        </arguments>
                    </block>

                    <block
                        name="magewire.checkout.billing-step.billing-address.country_id" as="country_id"
                        template="Yireo_MagewireCheckout::generic/field.phtml">
                        <arguments>
                            <argument name="magewire" xsi:type="object" shared="false">
                                Yireo\MagewireCheckout\Magewire\Checkout\BillingStep\BillingAddress\CountryId
                            </argument>
                        </arguments>
                    </block>

                    <block
                        name="magewire.checkout.billing-step.billing-address.company" as="company"
                        ifconfig="customer/address/company_show"
                        template="Yireo_MagewireCheckout::generic/field.phtml">
                        <arguments>
                            <argument name="magewire" xsi:type="object" shared="false">
                                Yireo\MagewireCheckout\Magewire\Checkout\BillingStep\BillingAddress\Company
                            </argument>
                        </arguments>
                    </block>

                    <block
                        name="magewire.checkout.billing-step.billing-address.telephone" as="telephone"
                        ifconfig="customer/address/telephone_show"
                        template="Yireo_MagewireCheckout::generic/field.phtml">
                        <arguments>
                            <argument name="magewire" xsi:type="object" shared="false">
                                Yireo\MagewireCheckout\Magewire\Checkout\BillingStep\BillingAddress\Telephone
                            </argument>
                        </arguments>
                    </block>

                    <block
                        name="magewire.checkout.billing-step.billing-address.vat_id" as="vat_id"
                        ifconfig="customer/address/taxvat_show"
                        template="Yireo_MagewireCheckout::generic/field.phtml">
                        <arguments>
                            <argument name="magewire" xsi:type="object" shared="false">
                                Yireo\MagewireCheckout\Magewire\Checkout\BillingStep\BillingAddress\VatId
                            </argument>
                        </arguments>
                    </block>
                </block>

                <block
                    name="magewire.checkout.billing-step.payment-methods" as="billing-methods"
                    template="Yireo_MagewireCheckout::checkout/billing/methods.phtml">
                    <arguments>
                        <argument name="magewire" xsi:type="object">
                            Yireo\MagewireCheckout\Magewire\Checkout\BillingStep\PaymentMethods
                        </argument>
                    </arguments>
                </block>

                <block
                    name="magewire.checkout.billing-step.backward-button" as="backward-button"
                    template="Yireo_MagewireCheckout::checkout/step-backward-button.phtml">
                    <arguments>
                        <argument name="magewire" xsi:type="object">
                            Yireo\MagewireCheckout\Magewire\Checkout\StepBackwardButton
                        </argument>
                        <argument name="button_label" xsi:type="string">Back to shipping</argument>
                    </arguments>
                </block>

                <block
                    name="magewire.checkout.billing-step.forward-button" as="forward-button"
                    template="Yireo_MagewireCheckout::checkout/step-forward-button.phtml">
                    <arguments>
                        <argument name="magewire" xsi:type="object">
                            Yireo\MagewireCheckout\Magewire\Checkout\StepForwardButton
                        </argument>
                        <argument name="button_label" xsi:type="string">Proceed to review &amp; payments</argument>
                    </arguments>
                </block>
            </block>
        </referenceBlock>
    </body>
</page>
