<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <body>
        <referenceBlock name="loki-checkout.progressbar" remove="true"/>

        <!-- Theme layout -->
        <referenceBlock name="loki-checkout" template="Yireo_LokiCheckout::theme/onestep/checkout.phtml"/>
        <referenceBlock name="loki-checkout.steps" template="Yireo_LokiCheckout::theme/onestep/steps.phtml">
            <block name="loki-checkout.steps.one" as="one" template="Yireo_LokiCheckout::theme/onestep/one-step.phtml">
                <container name="loki-checkout.steps.one.col1" as="col1" htmlTag="div" htmlClass="col1">
                    <container name="loki-checkout.steps.one.col1.customer-fields" htmlTag="div" htmlClass="grid gap-8 mb-8"/>
                </container>
                <container name="loki-checkout.steps.one.col2" as="col2" htmlTag="div" htmlClass="col2"/>
            </block>
        </referenceBlock>

        <!-- Column 1 -->
        <move element="loki-checkout.customer.customer_email" destination="loki-checkout.steps.one.col1.customer-fields" as="customer_email"/>
        <move element="loki-checkout.customer.customer_gender" destination="loki-checkout.steps.one.col1.customer-fields" as="customer_gender"/>
        <move element="loki-checkout.customer.customer_dob" destination="loki-checkout.steps.one.col1.customer-fields" as="customer_dob"/>
        <move element="loki-checkout.shipping.address" destination="loki-checkout.steps.one.col1" as="shipping-address"/>
        <move element="loki-checkout.billing.address" destination="loki-checkout.steps.one.col1" as="billing-address"/>

        <!-- Column 2 -->
        <move element="loki-checkout.shipping.methods" destination="loki-checkout.steps.one.col2" as="shipping-methods"/>
        <move element="loki-checkout.payment.methods" destination="loki-checkout.steps.one.col2" as="payment-methods"/>

        <!-- Sidebar -->
        <move element="loki-checkout.sidebar" destination="loki-checkout" as="sidebar"/>
        <move element="loki-checkout.steps.billing.forward-button" destination="loki-checkout.sidebar" as="submit-button"/>
    </body>
</page>
